    "headings": [
      "Warm-up: Notice and Wonder: Prism Pieces (10 minutes)",
      "Activity 1: Compare Expressions (10 minutes)",
      "Activity 2: Find the Volume in Different Ways (25 minutes)",
      "Lesson Synthesis",
      "Cool-down: Expressions as Volume (5 minutes)"
    ],
