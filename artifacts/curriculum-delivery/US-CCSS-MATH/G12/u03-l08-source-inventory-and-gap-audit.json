      "FirstPartyIndependentMathQuestionVerified": true,
      "TeacherRubricVerified": true,
      "RequiresGraph": false,
      "TeacherKey": "x² gives the same output for ±x, so is not injective over all real inputs. x³ is strictly increasing, so its inverse cube root is a function."
    },
    {
      "Number": 2,
      "TaskFamily": "VERBAL",
      "OriginalSourceSection": "3.8",
      "SourceLocallyLocated": true,
      "OriginalMathematicalAnswerIndividuallyVerified": true,
      "FirstPartyIndependentMathQuestionVerified": true,
      "TeacherRubricVerified": true,
      "RequiresGraph": false,
      "TeacherKey": "Restrict original x≥0; then the inverse outputs are nonnegative and its domain is x≥6."
    },
    {
      "Number": 3,
      "TaskFamily": "VERBAL",
      "OriginalSourceSection": "3.8",
      "SourceLocallyLocated": true,
      "OriginalMathematicalAnswerIndividuallyVerified": true,
      "FirstPartyIndependentMathQuestionVerified": true,
      "TeacherRubricVerified": true,
      "RequiresGraph": false,
      "TeacherKey": "The inverse f⁻¹(x)=x²−2 has domain x≥0, because original square-root outputs are nonnegative."
    },
    {
      "Number": 4,
      "TaskFamily": "VERBAL",
      "OriginalSourceSection": "3.8",
      "SourceLocallyLocated": true,
      "OriginalMathematicalAnswerIndividuallyVerified": true,
      "FirstPartyIndependentMathQuestionVerified": true,
      "TeacherRubricVerified": true,
      "RequiresGraph": false,
      "TeacherKey": "Inverse f⁻¹(x)=h+√(x−k), x≥k."
    },
