    {
      "Number": 1,
      "SourceSection": "3.7",
      "TaskFamily": "VERBAL",
      "AcademicSourceVerified": true,
      "FirstPartyIndependentMathQuestionVerified": false,
      "TeacherAnswerVerified": true,
      "RequiresGraph": false,
      "SourceOriginalGraphicCopied": false,
      "SourceMathReview": "REVIEWED_WITH_TEACHER_EXPECTED_MATH",
      "SourceTeacherExpectedMath": "A polynomial has only nonnegative integer powers; a rational function is p(x)/q(x), with q a nonzero polynomial. Every polynomial may also be written over denominator 1."
    },
    {
      "Number": 2,
      "SourceSection": "3.7",
      "TaskFamily": "VERBAL",
      "AcademicSourceVerified": true,
      "FirstPartyIndependentMathQuestionVerified": false,
      "TeacherAnswerVerified": true,
      "RequiresGraph": false,
      "SourceOriginalGraphicCopied": false,
      "SourceMathReview": "REVIEWED_WITH_TEACHER_EXPECTED_MATH",
      "SourceTeacherExpectedMath": "Polynomial graphs are continuous on all real x, while rational graphs can have vertical asymptotes or removable discontinuities where the original denominator vanishes."
    },
    {
      "Number": 3,
      "SourceSection": "3.7",
      "TaskFamily": "VERBAL",
      "AcademicSourceVerified": true,
      "FirstPartyIndependentMathQuestionVerified": false,
      "TeacherAnswerVerified": true,
      "RequiresGraph": false,
      "SourceOriginalGraphicCopied": false,
      "SourceMathReview": "REVIEWED_WITH_TEACHER_EXPECTED_MATH",
      "SourceTeacherExpectedMath": "Numerator and denominator share a factor whose zero is cancelled algebraically, but remains excluded from the original domain."
    },
    {
      "Number": 4,
      "SourceSection": "3.7",
      "TaskFamily": "VERBAL",
      "AcademicSourceVerified": true,
      "FirstPartyIndependentMathQuestionVerified": false,
      "TeacherAnswerVerified": true,
      "RequiresGraph": false,
      "SourceOriginalGraphicCopied": false,
      "SourceMathReview": "REVIEWED_WITH_TEACHER_EXPECTED_MATH",
      "SourceTeacherExpectedMath": "Yes. A denominator may have no real roots (such as x²+1), or all its real zero factors may cancel to produce holes rather than vertical asymptotes."
    },
    {
      "Number": 5,
      "SourceSection": "3.7",
      "TaskFamily": "VERBAL",
      "AcademicSourceVerified": true,
      "FirstPartyIndependentMathQuestionVerified": false,
      "TeacherAnswerVerified": true,
      "RequiresGraph": false,
      "SourceOriginalGraphicCopied": false,
      "SourceMathReview": "REVIEWED_WITH_TEACHER_EXPECTED_MATH",
      "SourceTeacherExpectedMath": "Yes. The numerator may have no real roots, or all its real roots may be removed by original denominator restrictions."
    },
