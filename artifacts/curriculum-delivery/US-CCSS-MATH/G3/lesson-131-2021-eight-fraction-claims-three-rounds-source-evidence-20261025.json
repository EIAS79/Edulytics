  "originalPublicHTMLStatementSummaries": [
    {
      "sourceLabel": "A",
      "summary": "All fractions are less than 1",
      "teacherGuide": "Disagree: 5/4 and 3/2 exceed one whole"
    },
    {
      "sourceLabel": "B",
      "summary": "Fractions can appear on a number line",
      "teacherGuide": "Agree: equal-length unit intervals partitioned into parts"
    },
    {
      "sourceLabel": "C",
      "summary": "Numerator determines piece size",
      "teacherGuide": "Disagree in standard unit-fraction models: denominator determines equal piece size; numerator counts how many parts"
    },
    {
      "sourceLabel": "D",
      "summary": "Denominator indicates number of parts",
      "teacherGuide": "Agree when referring to the number of equal parts making one whole"
    },
    {
      "sourceLabel": "E",
      "summary": "Whole numbers are fractions",
      "teacherGuide": "Agree: any whole number n is n/1"
    },
    {
      "sourceLabel": "F",
      "summary": "All fractions are whole numbers",
      "teacherGuide": "Disagree: 1/8 is not a whole number; some fractions like 6/2 are"
    },
    {
      "sourceLabel": "G",
      "summary": "One half is always greater than one third",
      "teacherGuide": "Conditional: true only when the fractions refer to the same-size whole; not necessarily if wholes differ"
    },
    {
      "sourceLabel": "H",
      "summary": "Fractions can express lengths",
      "teacherGuide": "Agree: one third of a meter can be described by a unit-length interval"
    }
  ],
