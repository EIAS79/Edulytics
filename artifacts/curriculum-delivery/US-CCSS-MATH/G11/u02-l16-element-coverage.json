    {
      "SourceElementId": "G11-U02-L16-ACTIVITY-013",
      "SourceSection": "16.3: Calculating Surface Area",
      "SourceExcerpt": "We can model a standard 12 ounce soda can as a cylinder with a volume of 410.5 cubic centimeters, a height of about 12 centimeters and a radius of about 3.3 centimeters.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l16.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
