    },
    {
      "SourceElementId": "G11-U03-L12-ACTIVITY-018",
      "SourceSection": "12.3: Multiplication on the Complex Plane",
      "SourceExcerpt": "Plot \\(2i\\), \\((2i)^2\\), \\((2i)^3\\), and \\((2i)^4\\) on the complex plane.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u03-l12.rich-lesson-v2.json",
