    {
      "SourceElementId": "G11-U02-L02-ACTIVITY-003",
      "SourceSection": "2.1: Notice and Wonder: Writing Numbers",
      "SourceExcerpt": "\\(3(10^2) + 2(10^1) + 9(10^0)\\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l02.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
