    },
    {
      "SourceElementId": "G11-U03-L10-ACTIVITY-015",
      "SourceSection": "10.3: Imaginary Numbers",
      "SourceExcerpt": "What is the relationship between the absolute value of a real number and the absolute value of the square of that number?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u03-l10.rich-lesson-v2.json",
