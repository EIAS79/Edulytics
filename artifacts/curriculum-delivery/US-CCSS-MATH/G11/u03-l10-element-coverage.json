    {
      "SourceElementId": "G11-U03-L10-ACTIVITY-016",
      "SourceSection": "10.3: Imaginary Numbers",
      "SourceExcerpt": "If we want \\(\\sqrt{\\text- 1}\\) and its square to have this same relationship, then what should the absolute value of \\(\\sqrt{\\text-1}\\) be?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u03-l10.rich-lesson-v2.json",
