    },
    {
      "SourceElementId": "G11-U06-L04-ACTIVITY-006",
      "SourceSection": "4.3: Angle Coordinates Galore",
      "SourceExcerpt": "Find and label the coordinates of the points assigned to you where the angles intersect the circle.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l04.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U06-L04-ACTIVITY-007",
      "SourceSection": "4.3: Angle Coordinates Galore",
      "SourceExcerpt": "Compare and share your values with your group.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l04.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
