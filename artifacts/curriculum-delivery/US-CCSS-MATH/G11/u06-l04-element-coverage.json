    },
    {
      "SourceElementId": "G11-U06-L04-ACTIVITY-003",
      "SourceSection": "4.2: Angles Everywhere",
      "SourceExcerpt": "Draw and label angles, with the positive \\(x\\)-axis as the starting ray for each angle, measuring \\(\\frac{\\pi}{12},\\frac{\\pi}{6},\\frac{\\pi}{4} \\ldots, 2\\pi\\) in the counterclockwise direction. Four of these angles, one in each quadrant,…",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l04.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U06-L04-ACTIVITY-004",
      "SourceSection": "4.2: Angles Everywhere",
      "SourceExcerpt": "Label the points, where the rays meet the unit circle, for which you know the exact coordinate values.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l04.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U06-L04-ACTIVITY-005",
      "SourceSection": "4.3: Angle Coordinates Galore",
      "SourceExcerpt": "Your teacher will assign you a section of the unit circle.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l04.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
