    {
      "SourceElementId": "G11-U06-L12-ACTIVITY-004",
      "SourceSection": "12.2: A Tangent Ratio",
      "SourceExcerpt": "Where does the line \\(x=1\\) intersect the line that passes through the origin and the point corresponding to the angle \\(\\frac{\\pi}{6}\\)?",
