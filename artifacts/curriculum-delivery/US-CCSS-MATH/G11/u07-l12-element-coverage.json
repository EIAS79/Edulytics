    },
    {
      "SourceElementId": "G11-U07-L12-ACTIVITY-003",
      "SourceSection": "12.1: Rolling Distribution",
      "SourceExcerpt": "If you rolled the number cube one million times and found the mean of all the values, what do you expect for the mean? Explain your reasoning.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l12.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U07-L12-ACTIVITY-004",
      "SourceSection": "12.2: Rolling for Means",
      "SourceExcerpt": "Roll your number cube applet 35 times, recording the values as you do so.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l12.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U07-L12-ACTIVITY-005",
      "SourceSection": "12.2: Rolling for Means",
      "SourceExcerpt": "Every 5 values, find the mean.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l12.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U07-L12-ACTIVITY-006",
      "SourceSection": "12.2: Rolling for Means",
      "SourceExcerpt": "Share your means with your group and create a dot plot of all the means from your group.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l12.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U07-L12-ACTIVITY-007",
      "SourceSection": "12.2: Rolling for Means",
      "SourceExcerpt": "What do you notice about the shape of the distribution of means?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l12.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U07-L12-ACTIVITY-008",
      "SourceSection": "12.2: Rolling for Means",
      "SourceExcerpt": "Using the dot plot of means, what do you think is a good estimate for the mean of all 140 rolls from your group? How does this value compare to your estimate from the warm-up?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l12.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U07-L12-ACTIVITY-009",
      "SourceSection": "12.3: Margin of Error for Means",
      "SourceExcerpt": "As with the means of sample proportions, the means of sample means are usually within 2 standard deviations of the population mean when there is a large sample size or when the population distribution is approximately normal. For each…",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l12.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U07-L12-ACTIVITY-010",
      "SourceSection": "12.3: Margin of Error for Means",
      "SourceExcerpt": "Use the sample means to estimate the mean of the population.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l12.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
