    {
      "SourceElementId": "G11-U07-L12-ACTIVITY-002",
      "SourceSection": "12.1: Rolling Distribution",
      "SourceExcerpt": "Draw a dot plot that shows the distribution of values you might expect for the rolls. Explain your reasoning.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l12.rich-lesson-v2.json",
