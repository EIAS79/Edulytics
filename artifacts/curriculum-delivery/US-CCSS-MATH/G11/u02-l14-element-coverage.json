    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-006",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "Your teacher will give you either a problem card or a data card. Do not show or read your card to your partner.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-007",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "If your teacher gives you the data card:",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-008",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "Silently read the information on your card.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-009",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "Ask your partner, “What specific information do you need?” and wait for your partner to ask for information. Only give information that is on your card. (Do not figure out anything for your partner!)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-010",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "Before telling your partner the information, ask, “Why do you need to know (that piece of information)?”",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-011",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "Read the problem card, and solve the problem independently.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-012",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "Share the data card, and discuss your reasoning.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-013",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "If your teacher gives you the problem card:",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-014",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "Silently read your card and think about what information you need to answer the question.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-015",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "Ask your partner for the specific information that you need.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-016",
      "SourceSection": "14.2: Info Gap: More Polynomials",
      "SourceExcerpt": "Explain to your partner how you are using the information to solve the problem.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
