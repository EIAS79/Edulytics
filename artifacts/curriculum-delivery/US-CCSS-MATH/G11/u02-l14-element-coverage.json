      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-023",
      "SourceSection": "14.3: Even More Polynomials",
      "SourceExcerpt": "Without letting your partner see, do the following:",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L14-ACTIVITY-024",
      "SourceSection": "14.3: Even More Polynomials",
      "SourceExcerpt": "On a separate slip of paper, write the standard form of your polynomial along with 1 of the factors (or 2 factors, if the polynomial has degree 4). Trade slips with your partner.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
