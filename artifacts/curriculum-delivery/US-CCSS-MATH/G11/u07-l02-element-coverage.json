    {
      "SourceElementId": "G11-U07-L02-ACTIVITY-015",
      "SourceSection": "2.3: Relaxing Television",
      "SourceExcerpt": "A study of 1,000 people aged 20–30 asked how much television each person watches each night and how each person would rate their energy level in the evenings. The study showed that people who watch television for at least 2 hours every…",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u07-l02.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
