    },
    {
      "SourceElementId": "G11-U02-L01-ACTIVITY-005",
      "SourceSection": "1.3: Building the Biggest Box",
      "SourceExcerpt": "Attribution: Balancing Boxes, by publicdomainpictures. Public Domain. publicdomainpictures. Source.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l01.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
