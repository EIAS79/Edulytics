    {
      "SourceElementId": "G11-U02-L01-ACTIVITY-003",
      "SourceSection": "1.2: Building Boxes",
      "SourceExcerpt": "Construct an open-top box from a sheet of paper by cutting out a square from each corner and then folding up the sides.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l01.rich-lesson-v2.json",
