    },
    {
      "SourceElementId": "G11-U04-L10-ACTIVITY-014",
      "SourceSection": "10.3: Exponential and Logarithmic Forms",
      "SourceExcerpt": "Write two equations—one in exponential form and one in logarithmic form—to represent each question. Use “?” for the unknown value.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l10.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
