    {
      "SourceElementId": "G11-U02-L20-ACTIVITY-012",
      "SourceSection": "20.3: Batting Averages",
      "SourceExcerpt": "Tyler is on a school baseball team and he has had 24 base hits out of 110 at bats this year.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l20.rich-lesson-v2.json",
