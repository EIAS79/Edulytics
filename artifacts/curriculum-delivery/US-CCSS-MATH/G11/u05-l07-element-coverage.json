    },
    {
      "SourceElementId": "G11-U05-L07-ACTIVITY-013",
      "SourceSection": "7.3: An Even Better Fit",
      "SourceExcerpt": "How does Han’s model compare to yours?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u05-l07.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
