    },
    {
      "SourceElementId": "G11-U02-L26-ACTIVITY-016",
      "SourceSection": "26.3: Back to Funding the Future",
      "SourceExcerpt": "We know that at the end of year 1 the amount in the account is \\$206. At the end of year 2 the amount in the account is \\$418.18 since \\(200(1.03)^2 + 200(1.03)=418.18\\). At the start of year 30, for example, that original \\$200 has been…",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l26.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
