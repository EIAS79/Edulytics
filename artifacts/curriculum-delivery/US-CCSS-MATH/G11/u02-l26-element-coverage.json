    },
    {
      "SourceElementId": "G11-U02-L26-ACTIVITY-008",
      "SourceSection": "26.2: That’s a lot of Houses",
      "SourceExcerpt": "Predict the total number of house sales from 2012 to 2017. Explain your reasoning.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l26.rich-lesson-v2.json",
