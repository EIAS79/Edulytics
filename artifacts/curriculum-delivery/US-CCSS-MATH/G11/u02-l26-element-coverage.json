    {
      "SourceElementId": "G11-U02-L26-ACTIVITY-005",
      "SourceSection": "26.2: That’s a lot of Houses",
      "SourceExcerpt": "In 2012, about 71 thousand homes were sold in the United Kingdom. For the next 3 years, the number of homes sold increased by about 18% annually. Assuming the sales trend continues,",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l26.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L26-ACTIVITY-006",
      "SourceSection": "26.2: That’s a lot of Houses",
      "SourceExcerpt": "How many homes were sold in 2013? In 2014?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l26.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L26-ACTIVITY-007",
      "SourceSection": "26.2: That’s a lot of Houses",
      "SourceExcerpt": "What information does the value of the expression \\(71 \\frac{(1-1.18^{11})}{(1-1.18)}\\) tell us?",
