    },
    {
      "SourceElementId": "G11-U05-L05-ACTIVITY-009",
      "SourceSection": "5.3: Card Sort: Two Types of Coordinates",
      "SourceExcerpt": "Can a non-zero function whose domain is all real numbers have a graph that is symmetrical around the \\(x\\)-axis? Give an example if it is possible or explain why it is not possible.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u05-l05.rich-lesson-v2.json",
