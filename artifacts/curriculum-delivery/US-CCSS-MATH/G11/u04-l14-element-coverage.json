    {
      "SourceElementId": "G11-U04-L14-ACTIVITY-016",
      "SourceSection": "14.3: Solving Exponential Equations",
      "SourceExcerpt": "Solve the equations \\(10^{n} = 16\\) and \\(10^{n} = 2\\). Express your answers as logarithms.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l14.rich-lesson-v2.json",
