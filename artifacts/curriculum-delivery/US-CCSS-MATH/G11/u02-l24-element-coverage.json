      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L24-ACTIVITY-016",
      "SourceSection": "24.3: Identifying Identities",
      "SourceExcerpt": "\\(a^2-2ab+b^2=(a-b)^2\\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l24.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L24-ACTIVITY-017",
      "SourceSection": "24.3: Identifying Identities",
      "SourceExcerpt": "\\(a^2-b^2 = (a-b)(a-b)\\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l24.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L24-ACTIVITY-018",
      "SourceSection": "24.3: Identifying Identities",
      "SourceExcerpt": "\\((a+b)(a^2-ab+b^2)=a^3-b^3\\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l24.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L24-ACTIVITY-019",
      "SourceSection": "24.3: Identifying Identities",
      "SourceExcerpt": "\\((a-b)^3=a^3-b^3-3ab(a+b)\\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l24.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L24-ACTIVITY-020",
      "SourceSection": "24.3: Identifying Identities",
      "SourceExcerpt": "\\(a^2(a-b)^4-b^2(a-b)^4 = (a-b)^5(a+b)\\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l24.rich-lesson-v2.json",
