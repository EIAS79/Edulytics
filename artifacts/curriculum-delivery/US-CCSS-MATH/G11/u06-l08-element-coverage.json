    },
    {
      "SourceElementId": "G11-U06-L08-ACTIVITY-014",
      "SourceSection": "8.3: Card Sort: Graphs of Functions",
      "SourceExcerpt": "Sort the cards into categories of your choosing. Be prepared to describe your categories. Pause for a whole-class discussion.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l08.rich-lesson-v2.json",
