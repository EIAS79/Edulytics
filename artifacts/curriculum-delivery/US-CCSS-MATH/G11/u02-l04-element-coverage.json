    {
      "SourceElementId": "G11-U02-L04-ACTIVITY-020",
      "SourceSection": "4.3: Experimenting with Polynomials",
      "SourceExcerpt": "If you add or subtract two polynomials, will you always get a polynomial?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l04.rich-lesson-v2.json",
