    {
      "SourceElementId": "G11-U02-L07-ACTIVITY-015",
      "SourceSection": "7.3: What’s the Equation?",
      "SourceExcerpt": "We can use the zeros of a polynomial function to figure out what an expression for the polynomial might be.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l07.rich-lesson-v2.json",
