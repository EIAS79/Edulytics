    {
      "SourceElementId": "G11-U06-L10-ACTIVITY-012",
      "SourceSection": "10.3: Back to Where We Started",
      "SourceExcerpt": "The point \\(P\\) on the unit circle has coordinates \\((1,0)\\). For each angle of rotation, state the number of rotations defined by the angle and then identify the coordinates of \\(P\\) after the given rotation.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l10.rich-lesson-v2.json",
