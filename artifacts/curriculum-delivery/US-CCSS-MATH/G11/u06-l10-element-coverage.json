    {
      "SourceElementId": "G11-U06-L10-ACTIVITY-014",
      "SourceSection": "10.3: Back to Where We Started",
      "SourceExcerpt": "For each angle of rotation in the activity, determine the minimum number of times you could repeat the rotation to end up back at the point \\(P\\).",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l10.rich-lesson-v2.json",
