    {
      "SourceElementId": "G11-U06-L10-ACTIVITY-013",
      "SourceSection": "10.3: Back to Where We Started",
      "SourceExcerpt": "In general, if \\(\\theta\\) is greater than \\(2\\pi\\) radians, explain how you can use the unit circle to make sense of \\(\\cos(\\theta)\\) and \\(\\sin(\\theta)\\).",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l10.rich-lesson-v2.json",
