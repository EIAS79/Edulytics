    {
      "SourceElementId": "G11-U06-L10-ACTIVITY-017",
      "SourceSection": "10.3: Back to Where We Started",
      "SourceExcerpt": "Here is a table showing different counterclockwise rotation amounts and the \\(x\\)-coordinate of the corresponding point.",
