    {
      "SourceElementId": "G11-U06-L01-ACTIVITY-002",
      "SourceSection": "1.2: Around and Around",
      "SourceExcerpt": "A ladybug lands on the end of a clock’s second hand when the hand is pointing straight up. The second hand is 1 foot long and when it rotates and points directly to the right, the ladybug is 10 feet above the ground.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l01.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U06-L01-ACTIVITY-003",
      "SourceSection": "1.2: Around and Around",
      "SourceExcerpt": "How far above the ground is the ladybug after 0, 30, 45, and 60 seconds have passed? Pause here for a class discussion.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l01.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U06-L01-ACTIVITY-004",
      "SourceSection": "1.2: Around and Around",
      "SourceExcerpt": "Estimate how far above the ground the ladybug is after 10, 20, and 40 seconds. Be prepared to explain your reasoning.",
