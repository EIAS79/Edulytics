    {
      "SourceElementId": "G11-U04-L16-ACTIVITY-012",
      "SourceSection": "16.2: Bacteria in Different Conditions",
      "SourceExcerpt": "The functions \\(f\\) and \\(g\\) are given by \\(f(t) = 10e^{0.5t}\\) and \\(g(t) = 8e^{0.4t}\\).",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l16.rich-lesson-v2.json",
