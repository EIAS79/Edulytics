    {
      "SourceElementId": "G11-U02-L19-ACTIVITY-012",
      "SourceSection": "19.3: Exploring End Behavior",
      "SourceExcerpt": "Under what conditions would the end behavior of the graph of a rational function approach a line that is not horizontal?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l19.rich-lesson-v2.json",
