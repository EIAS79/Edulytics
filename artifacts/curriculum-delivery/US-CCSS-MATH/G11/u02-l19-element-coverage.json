      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L19-ACTIVITY-016",
      "SourceSection": "19.3: Exploring End Behavior",
      "SourceExcerpt": "The line \\(y =c\\) is a horizontal asymptote of a function if the outputs of the function get closer and closer to \\(c\\) as the inputs get larger and larger in either the positive or negative direction. This means the graph gets closer and…",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l19.rich-lesson-v2.json",
