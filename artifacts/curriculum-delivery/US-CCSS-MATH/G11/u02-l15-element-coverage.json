    },
    {
      "SourceElementId": "G11-U02-L15-ACTIVITY-009",
      "SourceSection": "15.2: The Unknown Coefficient",
      "SourceExcerpt": "What is the remainder of each of these divisions?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l15.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L15-ACTIVITY-010",
      "SourceSection": "15.2: The Unknown Coefficient",
      "SourceExcerpt": "For each division, how does the degree of the remainder compare to the degree of the divisor?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l15.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L15-ACTIVITY-011",
      "SourceSection": "15.2: The Unknown Coefficient",
      "SourceExcerpt": "Could the remainder ever have the same degree as the divisor, or a higher degree? Give an example to show that this is possible, or explain why it is not possible.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l15.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
