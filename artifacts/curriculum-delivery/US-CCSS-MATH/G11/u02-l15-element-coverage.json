  "Goals": [
    "Comprehend that for a polynomial $p(x)$, $(x-a)$ is a factor if $p(a)=0$ and, conversely, that $p(a)=0$ if $(x-a)$ is a factor.",
    "Comprehend that for a polynomial $p(x)$ and a number $a$, the remainder on division by $(x - a)$ is $p(a)$."
  ],
