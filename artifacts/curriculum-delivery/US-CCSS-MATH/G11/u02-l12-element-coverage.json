    },
    {
      "SourceElementId": "G11-U02-L12-ACTIVITY-011",
      "SourceSection": "12.3: More Factoring with Diagrams",
      "SourceExcerpt": "\\(A(x)=x^3 - 7x^2 - 16x + 112\\), \\((x-7)\\)",
