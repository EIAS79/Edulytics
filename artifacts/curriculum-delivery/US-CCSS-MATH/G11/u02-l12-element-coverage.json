    },
    {
      "SourceElementId": "G11-U02-L12-ACTIVITY-016",
      "SourceSection": "12.3: More Factoring with Diagrams",
      "SourceExcerpt": "\\(F(x)=4x^4 - 15x^3 - 48x^2 + 109x + 30\\), \\((x-5)\\), \\((x-2)\\), \\((x+3)\\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l12.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
