      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-015",
      "SourceSection": "18.3: pH Ratings",
      "SourceExcerpt": "Vinegar has a pH of 2.4. Where on the graph would a point that represents vinegar be plotted?",
