    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-007",
      "SourceSection": "18.2: How Acidic Is It?",
      "SourceExcerpt": "A logarithm is used to translate hydrogen ion concentrations to pH values. With a partner, discuss how the hydrogen ion concentrations might be related to the pH. Use words or expressions to describe the relationship you notice.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-008",
      "SourceSection": "18.3: pH Ratings",
      "SourceExcerpt": "This table shows the relationship between hydrogen ion concentrations and pH ratings (acidity) for different substances.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-009",
      "SourceSection": "18.3: pH Ratings",
      "SourceExcerpt": "Write an equation to represent the pH rating, \\(p\\), in terms of the hydrogen ion concentration \\(h\\), in moles per liter.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
