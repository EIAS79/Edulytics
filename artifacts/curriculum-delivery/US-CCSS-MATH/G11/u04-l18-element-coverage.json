    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-010",
      "SourceSection": "18.3: pH Ratings",
      "SourceExcerpt": "Test your equation by using the hydrogen ion concentration of a substance from the table as the input. Does it produce the right pH rating as the output? If not, revise your equation and test it again.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-011",
      "SourceSection": "18.3: pH Ratings",
      "SourceExcerpt": "Magnesium hydroxide (also called “milk of magnesia”) is a medication used to treat stomach indigestion. It has a hydrogen concentration \\(5.6 \\times 10^{\\text-11}\\) mole per liter. Estimate a pH rating for magnesium hydroxide. Explain or…",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-012",
      "SourceSection": "18.3: pH Ratings",
      "SourceExcerpt": "As shown in the table, apple has a pH of 3 and milk has a pH of 6. How many times more acidic is the apple than milk?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-013",
      "SourceSection": "18.3: pH Ratings",
      "SourceExcerpt": "The graph shows points representing the hydrogen ion concentration, in moles per liter, and pH ratings of the different substances you saw earlier.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
