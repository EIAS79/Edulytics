    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-003",
      "SourceSection": "18.2: How Acidic Is It?",
      "SourceExcerpt": "Here is a table showing the hydrogen ion concentration (in moles per liter) and the pH of some different liquids:",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-004",
      "SourceSection": "18.2: How Acidic Is It?",
      "SourceExcerpt": "Which of the drinks listed, water, coffee, root beer, or orange juice, is the most acidic? Which is the least acidic? Explain how you know.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L18-ACTIVITY-005",
      "SourceSection": "18.2: How Acidic Is It?",
      "SourceExcerpt": "Seawater has a pH of 8. Is it more acidic or less acidic than water? Record the hydrogen ion concentration of seawater in the table.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l18.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
