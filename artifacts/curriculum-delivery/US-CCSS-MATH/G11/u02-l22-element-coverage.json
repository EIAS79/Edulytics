    },
    {
      "SourceElementId": "G11-U02-L22-ACTIVITY-012",
      "SourceSection": "22.3: More Rational Solving",
      "SourceExcerpt": "\\(\\dfrac{x^2+x-6}{x-2} = 5\\)",
