    {
      "SourceElementId": "G11-U02-L22-PRACTICE-006",
      "SourceSection": "Problem 2",
      "SourceExcerpt": "Kiran is solving \\(\\frac{2x-3}{x-1} = \\frac{2}{x(x-1)}\\) for \\(x\\), and he uses these steps:",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l22.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L22-PRACTICE-007",
      "SourceSection": "Problem 2",
      "SourceExcerpt": "\\(\\begin{align} \\frac{2x-3}{x-1} &= \\frac{2}{x(x-1)}\\\\ (x-1)\\left(\\frac{2x-3}{x-1} \\right) &= x(x-1) \\left( \\frac{2}{x(x-1)} \\right)\\\\ 2x-3 &= 2\\\\ 2x &= 5 \\\\ x &= 2.5 \\\\ \\end{align} \\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l22.rich-lesson-v2.json",
