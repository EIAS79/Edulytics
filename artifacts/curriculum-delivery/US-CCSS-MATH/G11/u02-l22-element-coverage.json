    },
    {
      "SourceElementId": "G11-U02-L22-ACTIVITY-019",
      "SourceSection": "22.3: More Rational Solving",
      "SourceExcerpt": "\\(\\dfrac{1}{x-3} = \\dfrac{1}{x(x-3)}\\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l22.rich-lesson-v2.json",
