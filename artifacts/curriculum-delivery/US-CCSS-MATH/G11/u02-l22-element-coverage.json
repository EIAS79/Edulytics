      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L22-ACTIVITY-003",
      "SourceSection": "22.2: Rational Solving",
      "SourceExcerpt": "Jada is working to find values of \\(x\\) that make this equation true:",
