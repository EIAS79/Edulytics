    },
    {
      "SourceElementId": "G11-U02-L22-ACTIVITY-002",
      "SourceSection": "22.1: Notice and Wonder: Thoughtful Multiplication",
      "SourceExcerpt": "\\(\\displaystyle \\begin{align} \\frac{3}{x(x-2)} &= \\frac{2x+1}{x-2} \\\\ \\frac{3}{x(x-2)} \\boldcdot x(x-2) &= \\frac{2x+1}{x-2} \\boldcdot x(x-2) \\\\ 3 &= 2x^2 + x \\\\ 0 &= 2x^2+x-3 \\\\ \\end{align}\\)",
