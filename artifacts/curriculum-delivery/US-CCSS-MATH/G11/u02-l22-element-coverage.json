    },
    {
      "SourceElementId": "G11-U02-L22-ACTIVITY-015",
      "SourceSection": "22.3: More Rational Solving",
      "SourceExcerpt": "\\(\\dfrac{x^2+x+1}{13} = \\dfrac{2}{x-1}\\)",
