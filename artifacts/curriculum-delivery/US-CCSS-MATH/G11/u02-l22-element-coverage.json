    {
      "SourceElementId": "G11-U02-L22-ACTIVITY-018",
      "SourceSection": "22.3: More Rational Solving",
      "SourceExcerpt": "\\(\\dfrac{x+2}{x} = \\dfrac{3}{x-2}\\)",
