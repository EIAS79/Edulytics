      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L22-ACTIVITY-005",
      "SourceSection": "22.2: Rational Solving",
      "SourceExcerpt": "She says, “If I multiply both sides by \\(x(x+1)\\), I find that the solutions are \\(x=1\\) and \\(x= \\text-1\\), but when I substitute in \\(x= \\text-1\\), the equation does not make any sense.”",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l22.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L22-ACTIVITY-006",
      "SourceSection": "22.2: Rational Solving",
      "SourceExcerpt": "Is Jada’s work correct? Explain or show your reasoning.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l22.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
