    {
      "SourceElementId": "G11-U02-L22-ACTIVITY-017",
      "SourceSection": "22.3: More Rational Solving",
      "SourceExcerpt": "\\(\\dfrac{1}{x} = \\dfrac{1}{x(x+1)}\\)",
