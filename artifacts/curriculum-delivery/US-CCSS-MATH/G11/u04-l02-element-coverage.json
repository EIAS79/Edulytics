    {
      "SourceElementId": "G11-U04-L02-ACTIVITY-004",
      "SourceSection": "2.2: Climbing Cost",
      "SourceExcerpt": "The tuition at a college was $30,000 in 2012, $31,200 in 2013, and $32,448 in 2014. The tuition has been increasing by the same percentage since the year 2000.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l02.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L02-ACTIVITY-005",
      "SourceSection": "2.2: Climbing Cost",
      "SourceExcerpt": "The equation \\(c(t)=30,\\!000 \\boldcdot (1.04)^t\\) represents the cost of tuition, in dollars, as a function of \\(t\\), the number of years since 2012. Explain what the 30,000 and 1.04 tell us about this situation.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l02.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L02-ACTIVITY-006",
      "SourceSection": "2.2: Climbing Cost",
      "SourceExcerpt": "What is the percent increase in tuition from year to year?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l02.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
