    },
    {
      "SourceElementId": "G11-U04-L02-ACTIVITY-012",
      "SourceSection": "2.3: Two Vans and Their Values",
      "SourceExcerpt": "Which graph correctly represents the value of the van as a function of years since its purchase? Be prepared to explain why each of the other graphs could not represent the function.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l02.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U04-L02-ACTIVITY-013",
      "SourceSection": "2.3: Two Vans and Their Values",
      "SourceExcerpt": "Find the value of the van 8 years after its purchase. Show your reasoning.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u04-l02.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
