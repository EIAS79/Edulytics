      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u03-l14.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
