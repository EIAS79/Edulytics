    },
    {
      "SourceElementId": "G11-U03-L17-ACTIVITY-022",
      "SourceSection": "17.4: Can You See the Solutions on a Graph?",
      "SourceExcerpt": "\\(\\displaystyle x^2 = \\text-k\\)",
