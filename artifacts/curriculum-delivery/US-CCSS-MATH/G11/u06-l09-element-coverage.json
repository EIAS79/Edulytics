    {
      "SourceElementId": "G11-U06-L09-ACTIVITY-014",
      "SourceSection": "9.3: Graphs of Cosine and Sine",
      "SourceExcerpt": "\\(y=\\cos^2(\\theta)+\\sin^2(\\theta)\\)",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l09.rich-lesson-v2.json",
