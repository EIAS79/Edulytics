    },
    {
      "SourceElementId": "G11-U06-L09-ACTIVITY-015",
      "SourceSection": "9.3: Graphs of Cosine and Sine",
      "SourceExcerpt": "For each of these equations, first predict what the graph looks like, and then check your prediction using technology.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u06-l09.rich-lesson-v2.json",
