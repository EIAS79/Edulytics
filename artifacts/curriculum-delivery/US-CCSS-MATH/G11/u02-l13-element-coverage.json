      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L13-ACTIVITY-013",
      "SourceSection": "13.3: More Long Division",
      "SourceExcerpt": "\\(A(x)=x^3 - 7x^2 - 16x + 112\\), \\((x-7)\\) \\(\\displaystyle \\displaystyle \\require{enclose} \\begin{array}{r} x^2\\phantom{55555555555} \\\\ x-7 \\enclose{longdiv}{x^3 - 7x^2 -16x+112} \\\\ \\underline{\\text-x^3 + 7x^2} \\phantom{.55555555555} \\\\…",
