      "SourceExcerpt": "\\(\\displaystyle \\displaystyle \\require{enclose} \\begin{array}{r} 3x-5 \\\\ 2x+1 \\enclose{longdiv}{6x^2 - 7x - 5} \\\\ \\underline{\\text-6x^2 - 3x} \\phantom{-55} \\\\ \\text-10x-5 \\\\ \\underline{10x+5} \\\\ 0 \\end{array} \\)",
