    },
    {
      "SourceElementId": "G11-U02-L13-ACTIVITY-010",
      "SourceSection": "13.2: Polynomial Long Division",
      "SourceExcerpt": "What is \\((x^4-1) \\div (x-1)\\)?",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l13.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L13-ACTIVITY-011",
      "SourceSection": "13.2: Polynomial Long Division",
      "SourceExcerpt": "Use your response to predict what \\((x^7-1) \\div (x-1)\\) is, and then use division to check your prediction.",
      "SourceLessonArtifact": "src/Edulytics.Core/Curriculum/LessonContent/RichV2/us-ccss-hs-alg2-u02-l13.rich-lesson-v2.json",
      "Treatment": "SOURCE_SCOPED_AUTHORING_WITH_TEACHER_REVIEW",
      "TestsExecuted": "NOT_RUN"
    },
    {
      "SourceElementId": "G11-U02-L13-ACTIVITY-012",
      "SourceSection": "13.3: More Long Division",
      "SourceExcerpt": "Here are some polynomial functions with known factors. Rewrite each polynomial as a product of linear factors using long division.",
