    },
    {
      "SourceElementId": "G11-U02-L13-ACTIVITY-006",
      "SourceSection": "13.2: Polynomial Long Division",
      "SourceExcerpt": "\\(\\displaystyle \\displaystyle \\require{enclose} \\begin{array}{r} 2x^2 \\phantom{+x+100} \\\\ x-2 \\enclose{longdiv}{2x^3-7x^2+x+10} \\\\ \\underline{\\text-2x^3+4x^2} \\phantom{+x+100} \\end{array}\\)",
