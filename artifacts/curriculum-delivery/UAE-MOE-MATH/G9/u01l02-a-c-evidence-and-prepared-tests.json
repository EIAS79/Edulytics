  "objectives": [
    {
      "id": "O1",
      "text": "يحسب التعابير مع الجمع والطرح وفق ترتيب العمليات"
    },
    {
      "id": "O2",
      "text": "يستخدم الضرب والقسمة من اليسار إلى اليمين"
    },
    {
      "id": "O3",
      "text": "يحسب القوى والأقواس متداخلة مع بقية العمليات"
    },
    {
      "id": "O4",
      "text": "يحسب تعابير ذات متغيرات بعد التعويض ويحل مسائل تطبيقية"
    },
    {
      "id": "O5",
      "text": "يبرر اختيار العملية التالية ويفسر الاختلاف بين إجابتين"
    }
  ],
