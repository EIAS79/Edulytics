      "id": "O1",
      "text": "يحدد المعادلة والحل ومجموعة الحل"
    },
    {
      "id": "O2",
      "text": "يتحقق من الحل بالتعويض"
    },
    {
      "id": "O3",
      "text": "يستخدم خواص المساواة والعمليات العكسية لحل المعادلات"
    },
    {
      "id": "O4",
      "text": "يضع معادلات لتكاليف وهندسة ويحلها ويفسرها"
    }
