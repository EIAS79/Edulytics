@using System.Globalization
@using Edulytics.Core.Constants
@using Edulytics.Core.Reports
@using Edulytics.Web.ViewModels.Reports
@model Edulytics.Web.ViewModels.Reports.ReportIndexViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.ReportResource> R

@{
    var canRequestReportExport =
        User.IsInRole(RoleNames.SubjectSupervisor) ||
        User.IsInRole(RoleNames.Teacher);

    var hasPendingExports =
        Model.Jobs.Any(x => x.Status == ReportExportJobStatus.Pending);

    var selectedYearName = Model.Request.AcademicYearId.HasValue
        ? Model.Catalog.AcademicYears.FirstOrDefault(x => x.Id == Model.Request.AcademicYearId.Value)?.Name
        : null;
    var selectedClassName = Model.Request.ClassGroupId.HasValue
        ? Model.Catalog.ClassGroups.FirstOrDefault(x => x.Id == Model.Request.ClassGroupId.Value)?.Name
        : null;
    var selectedStudentName = Model.Request.StudentProfileId.HasValue
        ? Model.Catalog.Students.FirstOrDefault(x => x.Id == Model.Request.StudentProfileId.Value)?.Name
        : null;
    var isPolish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "pl";

    ViewData["Title"] = R["ReportsTitle"].Value;
}

<section class="analytics-page report-page">
    <header class="analytics-header report-no-print">
        <div>
            <div class="user-eyebrow">@R["ReportsTitle"]</div>
            <h1>@R["ReportsTitle"]</h1>
            <p>@(canRequestReportExport ? R["ReportsSubtitle"] : R["ReportsViewSubtitle"])</p>
        </div>

        <a class="school-button school-button-secondary"
           asp-controller="SchoolHome"
           asp-action="Dashboard">
            @R["BackToDashboard"]
        </a>
    </header>

    @if (TempData["ReportSuccess"] is string success)
    {
        <div class="school-alert school-alert-success report-no-print" role="status">
            @success
        </div>
    }

    @if (TempData["ReportError"] is string error)
    {
        <div class="school-alert school-alert-error report-no-print" role="alert">
            @error
        </div>
    }

    <form method="get"
          asp-controller="Reports"
          asp-action="Index"
          class="analytics-filter-card report-no-print"
          data-report-filter-form>

        <h2>@R["ReportFilters"]</h2>

        <div class="analytics-filter-grid">
            <div>
                <label for="kind">@R["ReportType"]</label>
                <select id="kind" name="kind" data-report-kind-filter data-report-cascade>
                    @foreach (var item in Model.Catalog.AllowedKinds)
                    {
                        <option value="@item"
                                selected="@(Model.Request.Kind == item ? "selected" : null)">
                            @R[ReportIndexViewModel.KindKey(item)]
                        </option>
                    }
                </select>
            </div>

            @if (ReportIndexViewModel.ShowAcademicYear(Model.Request.Kind))
            {
                <div>
                    <label for="academicYearId">@R["AcademicYear"]</label>
                    <select id="academicYearId" name="academicYearId" data-report-cascade="year">
                        <option value="">
                            @(ReportIndexViewModel.RequireAcademicYear(Model.Request.Kind)
                                ? R["Select"]
                                : R["All"])
                        </option>
                        @foreach (var item in Model.Catalog.AcademicYears)
                        {
                            <option value="@item.Id"
                                    selected="@(Model.Request.AcademicYearId == item.Id ? "selected" : null)">
                                @item.Name
                            </option>
                        }
                    </select>
                </div>
            }

            @if (ReportIndexViewModel.ShowClass(Model.Request.Kind))
            {
                <div>
                    <label for="classGroupId">@R["Class"]</label>
                    <select id="classGroupId"
                            name="classGroupId"
                            data-report-cascade="class"
                            disabled="@(Model.Request.AcademicYearId.HasValue ? null : "disabled")">
                        <option value="">
                            @(ReportIndexViewModel.RequireClass(Model.Request.Kind)
                                ? R["Select"]
                                : R["All"])
                        </option>
                        @foreach (var item in Model.Catalog.ClassGroups)
                        {
                            <option value="@item.Id"
                                    selected="@(Model.Request.ClassGroupId == item.Id ? "selected" : null)">
                                @item.Name
                            </option>
                        }
                    </select>
                </div>
            }

            @if (ReportIndexViewModel.ShowSubject(Model.Request.Kind))
            {
                <div>
                    <label for="subjectId">@R["Subject"]</label>
                    <select id="subjectId"
                            name="subjectId"
                            data-report-cascade="subject"
                            disabled="@(Model.Request.ClassGroupId.HasValue ? null : "disabled")">
                        <option value="">@R["Select"]</option>
                        @foreach (var item in Model.Catalog.Subjects)
                        {
                            <option value="@item.Id"
                                    selected="@(Model.Request.SubjectId == item.Id ? "selected" : null)">
                                @item.Name
                            </option>
                        }
                    </select>
                </div>
            }

            @if (ReportIndexViewModel.ShowStudent(Model.Request.Kind))
            {
                <div>
                    <label for="studentProfileId">@R["Student"]</label>
                    <select id="studentProfileId"
                            name="studentProfileId"
                            disabled="@(Model.Request.ClassGroupId.HasValue ? null : "disabled")">
                        <option value="">@R["Select"]</option>
                        @if (Model.Request.ClassGroupId.HasValue)
                        {
                            @foreach (var item in Model.Catalog.Students)
                            {
                                <option value="@item.Id"
                                        selected="@(Model.Request.StudentProfileId == item.Id ? "selected" : null)">
                                    @item.Name
                                </option>
                            }
                        }
                    </select>
                </div>
            }

            @if (ReportIndexViewModel.ShowLearningOutcome(Model.Request.Kind))
            {
                <div>
                    <label for="learningOutcomeId">@R["LearningOutcome"]</label>
                    <select id="learningOutcomeId"
                            name="learningOutcomeId"
                            disabled="@(Model.Request.SubjectId.HasValue ? null : "disabled")">
                        <option value="">@R["Select"]</option>
                        @foreach (var item in Model.Catalog.LearningOutcomes)
                        {
                            <option value="@item.Id"
                                    selected="@(Model.Request.LearningOutcomeId == item.Id ? "selected" : null)">
                                @item.Name
                            </option>
                        }
                    </select>
                </div>
            }

            <button type="submit" class="school-button school-button-primary">
                @R["GenerateReport"]
            </button>
        </div>
    </form>

    @if (ReportIndexViewModel.ShowClass(Model.Request.Kind) &&
         Model.Request.AcademicYearId.HasValue &&
         Model.Catalog.ClassGroups.Count == 0)
    {
        <section class="analytics-empty report-no-print">
            <h2>@R["NoAuthorizedClasses"]</h2>
        </section>
    }
    else if (!ReportIndexViewModel.HasRequiredSelection(Model.Request))
    {
        <section class="analytics-empty report-no-print">
            <h2>@R["SelectRequiredFilter"]</h2>
            <p>@R["SelectRequiredFilterHelp"]</p>
        </section>
    }
    else if (Model.Document is not null)
    {
        <section class="analytics-panel report-document">
            <header class="report-document-header">
                <div>
                    <h2>@R[Model.Document.TitleKey]</h2>
                    @if (Model.Request.Kind == ReportKind.Student)
                    {
                        <p>
                            <strong>@selectedStudentName</strong>
                            @if (!string.IsNullOrWhiteSpace(selectedClassName))
                            {
                                <span> · @selectedClassName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedYearName))
                            {
                                <span> · @selectedYearName</span>
                            }
                        </p>
                    }
                    <p>
                        @Model.Catalog.SchoolName · @R["GeneratedAt"]:
                        @Model.Document.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")
                    </p>
                </div>

                <div class="report-actions report-no-print">
                    <button type="button"
                            class="school-button school-button-secondary"
                            data-print-report>
                        @R["PrintReport"]
                    </button>

                    @if (canRequestReportExport)
                    {
                        <form asp-controller="Reports" asp-action="RequestExport" method="post" class="report-inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="_idempotencyKey" value="@Model.CsvIdempotencyKey" />
                            <input type="hidden" name="kind" value="@Model.Request.Kind" />
                            <input type="hidden" name="format" value="@ReportExportFormat.Csv" />
                            <input type="hidden" name="academicYearId" value="@Model.Request.AcademicYearId" />
                            <input type="hidden" name="classGroupId" value="@Model.Request.ClassGroupId" />
                            <input type="hidden" name="subjectId" value="@Model.Request.SubjectId" />
                            <input type="hidden" name="studentProfileId" value="@Model.Request.StudentProfileId" />
                            <input type="hidden" name="learningOutcomeId" value="@Model.Request.LearningOutcomeId" />
                            <button type="submit" class="school-button school-button-primary">@R["ExportCsv"]</button>
                        </form>

                        <form asp-controller="Reports" asp-action="RequestExport" method="post" class="report-inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="_idempotencyKey" value="@Model.XlsxIdempotencyKey" />
                            <input type="hidden" name="kind" value="@Model.Request.Kind" />
                            <input type="hidden" name="format" value="@ReportExportFormat.Xlsx" />
                            <input type="hidden" name="academicYearId" value="@Model.Request.AcademicYearId" />
                            <input type="hidden" name="classGroupId" value="@Model.Request.ClassGroupId" />
                            <input type="hidden" name="subjectId" value="@Model.Request.SubjectId" />
                            <input type="hidden" name="studentProfileId" value="@Model.Request.StudentProfileId" />
                            <input type="hidden" name="learningOutcomeId" value="@Model.Request.LearningOutcomeId" />
                            <button type="submit" class="school-button school-button-primary">@R["ExportXlsx"]</button>
                        </form>
                    }
                </div>
            </header>

            @if (Model.Document.Truncated)
            {
                <div class="school-alert school-alert-warning report-no-print">
                    @R["ReportPreviewTruncated"]
                </div>
            }

            @if (Model.Document.Rows.Count == 0)
            {
                <p class="analytics-empty-inline">
                    @R[ReportIndexViewModel.EmptyStateKey(Model.Request.Kind)]
                </p>
            }
            else if (Model.Request.Kind == ReportKind.Student)
            {
                <div class="analytics-table-wrap">
                    <table class="analytics-table report-table report-student-mastery-table">
                        <thead>
                            <tr>
                                <th>@R["LearningOutcome"]</th>
                                <th>@R["Score"]</th>
                                <th>@R["ColumnMastery"]</th>
                                <th>@R["ColumnEvidence"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Document.Rows)
                            {
                                var fullCode = row.Cells[1].TextValue ?? string.Empty;
                                var separator = fullCode.LastIndexOf(':');
                                var shortCode = separator >= 0 && separator < fullCode.Length - 1
                                    ? fullCode[(separator + 1)..]
                                    : fullCode;
                                <tr>
                                    <td data-label="@R["LearningOutcome"]">
                                        <strong>@row.Cells[0].TextValue — @shortCode</strong>
                                    </td>
                                    <td data-label="@R["Score"]">
                                        @ReportIndexViewModel.Display(row.Cells[3]) / @ReportIndexViewModel.Display(row.Cells[4])
                                    </td>
                                    <td data-label="@R["ColumnMastery"]">
                                        <strong>@ReportIndexViewModel.Display(row.Cells[5])</strong>
                                    </td>
                                    <td data-label="@R["ColumnEvidence"]">
                                        @ReportIndexViewModel.Display(row.Cells[6])
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="report-curriculum-note">
                    @(isPolish
                        ? "Kody efektów uczenia się są wyświetlane wyłącznie jako odwołania do programu nauczania; oficjalne, chronione prawem autorskim brzmienie nie jest powielane."
                        : "Learning-outcome codes are shown only as curriculum references; official copyrighted wording is not reproduced.")
                </p>
            }
            else
            {
                <div class="analytics-table-wrap">
                    <table class="analytics-table report-table">
                        <thead>
                            <tr>
                                @foreach (var column in Model.Document.Columns)
                                {
                                    <th>@R[column.HeaderKey]</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Document.Rows)
                            {
                                <tr>
                                    @for (var i = 0; i < row.Cells.Count; i++)
                                    {
                                        <td data-label="@R[Model.Document.Columns[i].HeaderKey]">
                                            @ReportIndexViewModel.Display(row.Cells[i])
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <section class="analytics-panel report-no-print">
        <header>
            <h2>@R["RecentExports"]</h2>
            <p>@R["RecentExportsHelp"]</p>
        </header>

        @if (Model.Jobs.Count == 0)
        {
            <p class="analytics-empty-inline">@R["NoExports"]</p>
        }
        else
        {
            <div class="analytics-table-wrap">
                <table class="analytics-table report-table">
                    <thead>
                        <tr>
                            <th>@R["ReportType"]</th>
                            <th>@R["Format"]</th>
                            <th>@R["Status"]</th>
                            <th>@R["Rows"]</th>
                            <th>@R["CreatedAt"]</th>
                            <th>@R["ExpiresAt"]</th>
                            <th>@R["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.Jobs)
                        {
                            <tr>
                                <td data-label="@R["ReportType"]">@R[ReportIndexViewModel.KindKey(job.ReportKind)]</td>
                                <td data-label="@R["Format"]">@R[ReportIndexViewModel.FormatKey(job.ExportFormat)]</td>
                                <td data-label="@R["Status"]">@R[ReportIndexViewModel.StatusKey(job.Status)]</td>
                                <td data-label="@R["Rows"]">@(job.RowCount?.ToString() ?? "—")</td>
                                <td data-label="@R["CreatedAt"]">@job.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                <td data-label="@R["ExpiresAt"]">@job.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                <td data-label="@R["Actions"]">
                                    @if (job.Status == ReportExportJobStatus.Completed && job.ExpiresAtUtc > DateTime.UtcNow)
                                    {
                                        <a class="school-button school-button-secondary school-button-small"
                                           asp-controller="Reports"
                                           asp-action="Download"
                                           asp-route-exportJobId="@job.Id">
                                            @R["Download"]
                                        </a>
                                    }
                                    else if (job.Status == ReportExportJobStatus.Pending)
                                    {
                                        <span class="report-export-generating" role="status">
                                            @(isPolish ? "Generowanie…" : "Generating…")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

<script>
(() => {
    const form = document.querySelector('[data-report-filter-form]');
    if (!form) return;

    const kind = form.querySelector('[data-report-kind-filter]');
    const year = form.querySelector('[data-report-cascade="year"]');
    const classGroup = form.querySelector('[data-report-cascade="class"]');
    const subject = form.querySelector('[data-report-cascade="subject"]');
    const student = form.querySelector('#studentProfileId');
    const outcome = form.querySelector('#learningOutcomeId');

    const clear = (control) => {
        if (control) control.value = '';
    };

    if (kind) {
        kind.addEventListener('change', () => {
            clear(year);
            clear(classGroup);
            clear(subject);
            clear(student);
            clear(outcome);
            form.requestSubmit();
        });
    }

    if (year) {
        year.addEventListener('change', () => {
            clear(classGroup);
            clear(subject);
            clear(student);
            clear(outcome);
            form.requestSubmit();
        });
    }

    if (classGroup) {
        classGroup.addEventListener('change', () => {
            clear(subject);
            clear(student);
            clear(outcome);
            form.requestSubmit();
        });
    }

    if (subject) {
        subject.addEventListener('change', () => {
            clear(outcome);
            form.requestSubmit();
        });
    }

    @if (hasPendingExports)
    {
        <text>
        window.setTimeout(() => window.location.reload(), 2500);
        </text>
    }
})();
</script>
