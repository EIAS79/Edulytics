@using System.Globalization
@using Edulytics.Core.Constants
@using Edulytics.Core.Enums
@using Edulytics.Services.Imports
@model Edulytics.Web.ViewModels.Imports.ImportDetailsViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.ImportResource> I

@{
    var canManageImports =
        User.IsInRole(RoleNames.SchoolAdmin) ||
        User.IsInRole(RoleNames.SubjectSupervisor) ||
        User.IsInRole(RoleNames.Teacher);
    var isPolish = string.Equals(
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
        "pl",
        StringComparison.OrdinalIgnoreCase);
    string L(string en, string pl) => isPolish ? pl : en;
    string TypeLabel(ImportType type) => type switch
    {
        ImportType.Teachers => L("Teachers", "Nauczyciele"),
        ImportType.SubjectSupervisors => L("Subject supervisors", "Opiekunowie przedmiotu"),
        ImportType.AssessmentResults => L("Assessment results", "Wyniki sprawdzianów"),
        _ => I[$"Type{type}"].Value
    };
    string ValidationMessage(ImportValidationErrorItem item)
    {
        var raw = item.RawValue?.Trim() ?? string.Empty;
        if (Model.Batch.Type == ImportType.Students)
        {
            if (item.Code == "ExistingConflict" && item.ColumnName.Equals("Email", StringComparison.OrdinalIgnoreCase))
                return L("This email is already registered.", "Ten adres email jest już zarejestrowany.");
            if (item.Code == "ExistingConflict" && item.ColumnName.Equals("StudentNumber", StringComparison.OrdinalIgnoreCase))
                return L($"Student number {raw} is already registered.", $"Numer ucznia {raw} jest już zarejestrowany.");
            if (item.Code == "DuplicateRow" && item.ColumnName.Equals("Email", StringComparison.OrdinalIgnoreCase))
                return L("This email appears more than once in this file.", "Ten adres email występuje w pliku więcej niż raz.");
            if (item.Code == "DuplicateRow" && item.ColumnName.Equals("StudentNumber", StringComparison.OrdinalIgnoreCase))
                return L($"Student number {raw} appears more than once in this file.", $"Numer ucznia {raw} występuje w pliku więcej niż raz.");
        }
        if (Model.Batch.Type == ImportType.Teachers && item.ColumnName.Equals("Email", StringComparison.OrdinalIgnoreCase))
        {
            if (item.Code == "ExistingConflict")
                return L("This teacher email is already registered or this teacher is already assigned to the selected class.", "Ten adres email nauczyciela jest już zarejestrowany albo nauczyciel jest już przypisany do wybranej klasy.");
            if (item.Code == "DuplicateRow")
                return L("This teacher and class assignment appears more than once in this file.", "To przypisanie nauczyciela do klasy występuje w pliku więcej niż raz.");
        }
        if (Model.Batch.Type == ImportType.SubjectSupervisors && item.ColumnName.Equals("Email", StringComparison.OrdinalIgnoreCase))
        {
            if (item.Code == "ExistingConflict")
                return L("This email is already registered.", "Ten adres email jest już zarejestrowany.");
            if (item.Code == "DuplicateRow")
                return L("This email appears more than once in this file.", "Ten adres email występuje w pliku więcej niż raz.");
        }
        if (Model.Batch.Type == ImportType.AssessmentResults &&
            item.ColumnName.Equals("StudentNumber", StringComparison.OrdinalIgnoreCase))
        {
            if (item.Code == "ExistingConflict")
                return L(
                    "A result already exists for this student. Download a fresh workbook so the current result state is respected.",
                    "Wynik dla tego ucznia już istnieje. Pobierz nowy skoroszyt, aby uwzględnić aktualny stan wyników.");
            if (item.Code == "UnknownReference" || item.Code == "CrossSchoolReference")
                return L(
                    "The student linked to this workbook is no longer valid for this assessment. Download a fresh workbook.",
                    "Uczeń powiązany z tym skoroszytem nie jest już prawidłowy dla tego sprawdzianu. Pobierz nowy skoroszyt.");
        }
        if (Model.Batch.Type == ImportType.Classes)
        {
            if (item.Code == "UnknownReference" && item.ColumnName.Equals("AcademicYear", StringComparison.OrdinalIgnoreCase))
                return L(
                    "The Academic Year selected for this Classes import is no longer active. Activate it in Academic Structure or start a new import with an active year.",
                    "Rok szkolny wybrany dla tego importu klas nie jest już aktywny. Aktywuj go w Strukturze akademickiej albo rozpocznij nowy import z aktywnym rokiem.");
            if (item.Code == "UnknownReference" && item.ColumnName.Equals("GradeLevel", StringComparison.OrdinalIgnoreCase))
                return L(
                    $"GradeLevel \"{raw}\" is not configured in Academic Structure. Use the Classes XLSX dropdown or add the curriculum level first.",
                    $"GradeLevel \"{raw}\" nie jest skonfigurowany w Strukturze akademickiej. Użyj listy rozwijanej w szablonie XLSX klas lub najpierw dodaj poziom programu nauczania.");
            if (item.Code == "AmbiguousReference" && item.ColumnName.Equals("GradeLevel", StringComparison.OrdinalIgnoreCase))
                return L(
                    $"GradeLevel \"{raw}\" maps to more than one curriculum pathway. Download the current Classes XLSX template and select the exact level/pathway from the dropdown.",
                    $"GradeLevel \"{raw}\" odpowiada więcej niż jednej ścieżce programu nauczania. Pobierz aktualny szablon XLSX klas i wybierz dokładny poziom/ścieżkę z listy rozwijanej.");
            if (item.Code == "UnknownReference" && item.ColumnName.Equals("CurriculumAdoptionId", StringComparison.OrdinalIgnoreCase))
                return L(
                    "The curriculum level selected in this file is no longer active for this Academic Year. Download the current Classes XLSX template and start a new import.",
                    "Poziom programu nauczania wybrany w tym pliku nie jest już aktywny dla tego roku szkolnego. Pobierz aktualny szablon XLSX klas i rozpocznij nowy import.");
            if (item.ColumnName.Equals("Code", StringComparison.OrdinalIgnoreCase))
            {
                if (item.Code == "ExistingConflict")
                    return L("A class with this generated identifier already exists for this academic year and curriculum.", "Klasa z tym wygenerowanym identyfikatorem już istnieje w tym roku szkolnym i programie nauczania.");
                if (item.Code == "DuplicateRow")
                    return L("This class appears more than once in the file.", "Ta klasa występuje w pliku więcej niż raz.");
            }
        }
        return I[$"Validation{item.Code}"].Value;
    }
    var internalHeaders = Model.Batch.Type switch
    {
        ImportType.Students => new[] { "ClassCode" },
        ImportType.Teachers => new[] { "ClassCode", "SubjectCode" },
        ImportType.Classes => new[] { "AcademicYear", "CurriculumAdoptionId", "Code" },
        ImportType.AssessmentResults => new[] { "ClassCode", "AssessmentId", "StudentNumber" },
        _ => Array.Empty<string>()
    };
    var visibleHeaders = Model.Batch.Headers
        .Where(x => !internalHeaders.Contains(x, StringComparer.OrdinalIgnoreCase))
        .ToArray();
    var invalidRows = Model.Batch.Errors
        .Where(x => x.RowNumber > 1)
        .Select(x => x.RowNumber)
        .ToHashSet();
    var isCompleted = Model.Batch.Status == ImportBatchStatus.Completed;
    var isAccountImport = Model.Batch.Type is ImportType.Students or ImportType.Teachers or ImportType.SubjectSupervisors;
    var isAssessmentResults = Model.Batch.Type == ImportType.AssessmentResults;

    decimal ParseDecimal(IReadOnlyDictionary<string, string> values, string key)
    {
        if (!values.TryGetValue(key, out var raw))
            return 0m;

        return decimal.TryParse(
            raw,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var value)
                ? value
                : 0m;
    }

    int ParseInt(IReadOnlyDictionary<string, string> values, string key)
    {
        if (!values.TryGetValue(key, out var raw))
            return int.MaxValue;

        return int.TryParse(
            raw,
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out var value)
                ? value
                : int.MaxValue;
    }

    var assessmentStudentGroups = Model.Batch.PreviewRows
            .Where(_ => isAssessmentResults)
            .GroupBy(row =>
            {
                if (row.Values.TryGetValue("StudentNumber", out var number) &&
                    !string.IsNullOrWhiteSpace(number))
                {
                    return number;
                }

                return row.Values.TryGetValue("StudentName", out var name)
                    ? name
                    : $"row-{row.RowNumber}";
            }, StringComparer.OrdinalIgnoreCase)
            .Select(group =>
            {
                var rows = group
                    .OrderBy(row => ParseInt(row.Values, "QuestionOrder"))
                    .ThenBy(row => row.RowNumber)
                    .ToArray();
                var first = rows[0];
                var studentName = first.Values.TryGetValue("StudentName", out var name)
                    ? name
                    : group.Key;
                var total = rows.Sum(row => ParseDecimal(row.Values, "Score"));
                var assessmentMax = rows
                    .Select(row => ParseDecimal(row.Values, "AssessmentMaxScore"))
                    .FirstOrDefault(value => value > 0m);
                var percentage = assessmentMax > 0m
                    ? decimal.Round(
                        total / assessmentMax * 100m,
                        2,
                        MidpointRounding.AwayFromZero)
                    : (decimal?)null;
                var hasError = rows.Any(row => invalidRows.Contains(row.RowNumber));
                var questions = rows
                    .Select(row => new
                    {
                        Order = ParseInt(row.Values, "QuestionOrder"),
                        Prompt = row.Values.TryGetValue("QuestionPrompt", out var prompt)
                            ? prompt
                            : string.Empty,
                        MaxScore = row.Values.TryGetValue("QuestionMaxScore", out var max)
                            ? max
                            : string.Empty,
                        Score = row.Values.TryGetValue("Score", out var score)
                            ? score
                            : string.Empty
                    })
                    .ToArray();

                return new
                {
                    StudentName = studentName,
                    Total = total,
                    AssessmentMax = assessmentMax,
                    Percentage = percentage,
                    HasError = hasError,
                    Questions = questions
                };
            })
            .OrderBy(group => group.StudentName)
            .ToArray();

    ViewData["Title"] = I["Batch"].Value;
}

<section class="import-page" data-import-batch>
    <header class="import-page-header">
        <div>
            <div class="user-eyebrow">@TypeLabel(Model.Batch.Type)</div>
            <h1>@I["Batch"]</h1>
            <p class="user-page-subtitle">@Model.Batch.FileName</p>
        </div>
        <a class="school-button" asp-action="Index">@I["ImportTitle"]</a>
    </header>

    @if (TempData["ImportSuccess"] is string success)
    {
        <div class="import-message import-message-success" role="status">@success</div>
    }
    @if (TempData["ImportError"] is string error)
    {
        <div class="import-message import-message-error" role="alert">@error</div>
    }

    @if (isCompleted)
    {
        <div class="import-message import-message-success" role="status">
            <strong>@L("Import completed successfully.", "Import zakończony pomyślnie.")</strong>
            @if (isAccountImport)
            {
                <span>@L(" Accounts were created or linked after confirmation. Password-setup invitations are sent after confirmation; use Resend invitation below if an email needs to be sent again.", " Konta zostały utworzone lub powiązane po potwierdzeniu. Zaproszenia do ustawienia hasła są wysyłane po potwierdzeniu; użyj opcji Wyślij zaproszenie ponownie, jeśli wiadomość trzeba wysłać jeszcze raz.")</span>
            }
        </div>
    }
    else if (Model.Batch.ErrorCount > 0)
    {
        <div class="import-message import-message-error" role="alert">
            @if (Model.Batch.Type == ImportType.AssessmentResults)
            {
                @L("This batch has validation errors. Correct the source workbook and upload a new batch before confirming.", "Ta partia zawiera błędy walidacji. Popraw skoroszyt źródłowy i prześlij nową partię przed potwierdzeniem.")
            }
            else
            {
                @L("This batch has validation errors. Remove the invalid rows or correct the source data before confirming.", "Ta partia zawiera błędy walidacji. Usuń nieprawidłowe wiersze lub popraw dane źródłowe przed potwierdzeniem.")
            }
        </div>
    }
    else
    {
        <div class="import-message import-message-success" role="status">
            @L("Validation successful. Review the data below, then confirm the import.", "Walidacja zakończona pomyślnie. Sprawdź dane poniżej, a następnie potwierdź import.")
        </div>
    }

    <section class="import-metrics">
        <article><span>@I["Status"]</span><strong>@I[Model.StatusResourceKey]</strong></article>
        @if (isAssessmentResults)
        {
            <article><span>@L("Students", "Uczniowie")</span><strong>@assessmentStudentGroups.Length</strong></article>
            <article><span>@L("Question scores", "Wyniki pytań")</span><strong>@Model.Batch.RowCount</strong></article>
        }
        else
        {
            <article><span>@I["Rows"]</span><strong>@Model.Batch.RowCount</strong></article>
            <article><span>@I["ValidRows"]</span><strong>@Model.Batch.ValidRowCount</strong></article>
        }
        <article><span>@I["Errors"]</span><strong>@Model.Batch.ErrorCount</strong></article>
    </section>

    @if (Model.Batch.Type == ImportType.Classes && !string.IsNullOrWhiteSpace(Model.ClassesAcademicYear))
    {
        <div class="import-message import-message-info" role="status">
            <strong>@L("Academic Year:", "Rok szkolny:")</strong> @Model.ClassesAcademicYear
            <span>@L(" — this year applies to every class in this batch.", " — ten rok dotyczy każdej klasy w tym imporcie.")</span>
        </div>
    }
    else if (Model.Batch.Type == ImportType.AssessmentResults)
    {
        <div class="import-message import-message-info" role="status">
            @L("Imported assessment results become read-only after confirmation. If the source data is wrong, correct the spreadsheet and upload a new batch.", "Zaimportowane wyniki sprawdzianów są po potwierdzeniu tylko do odczytu. Jeśli dane źródłowe są błędne, popraw arkusz i prześlij nowy pakiet.")
        </div>
    }
    else if (isAccountImport)
    {
        <div class="import-message import-message-info" role="status">
            @L("Validation does not create accounts or send email. New accounts and password-setup invitations are created only after you confirm a valid batch.", "Walidacja nie tworzy kont ani nie wysyła wiadomości. Nowe konta i zaproszenia do ustawienia hasła są tworzone dopiero po potwierdzeniu poprawnego pakietu.")
        </div>
    }

    @if (Model.Batch.Errors.Count > 0)
    {
        <section class="import-panel">
            <h2>@I["ValidationErrors"]</h2>
            <div class="import-error-list">
                @foreach (var item in Model.Batch.Errors)
                {
                    var column = internalHeaders.Contains(item.ColumnName, StringComparer.OrdinalIgnoreCase)
                        ? item.ColumnName == "ClassCode"
                            ? "ClassName"
                            : item.ColumnName == "StudentNumber" && Model.Batch.Type == ImportType.AssessmentResults
                                ? "StudentName"
                            : item.ColumnName == "Code" && Model.Batch.Type == ImportType.Classes
                                ? "Name"
                                : item.ColumnName == "CurriculumAdoptionId" && Model.Batch.Type == ImportType.Classes
                                    ? "GradeLevel"
                                    : item.ColumnName
                        : item.ColumnName;
                    <article class="import-error-item">
                        <strong>@I["Row"] @item.RowNumber · @column</strong>
                        <span>@ValidationMessage(item)</span>
                        @if (!string.IsNullOrWhiteSpace(item.RawValue) &&
                             !(Model.Batch.Type == ImportType.Classes &&
                               (item.ColumnName.Equals("Code", StringComparison.OrdinalIgnoreCase) ||
                                item.ColumnName.Equals("CurriculumAdoptionId", StringComparison.OrdinalIgnoreCase))) &&
                             !(Model.Batch.Type == ImportType.AssessmentResults &&
                               item.ColumnName.Equals("StudentNumber", StringComparison.OrdinalIgnoreCase)))
                        {
                            <code>@item.RawValue</code>
                        }
                    </article>
                }
            </div>
        </section>
    }

    <section class="import-panel">
        <div class="import-preview-toolbar">
            <div>
                <h2>@I["Preview"]</h2>
                <p>
                    @(isAssessmentResults
                        ? L("One row per student. Use View to review question scores and the final result.", "Jeden wiersz na ucznia. Użyj opcji Pokaż, aby sprawdzić wyniki pytań i wynik końcowy.")
                        : I["PreviewLimit"].Value)
                </p>
            </div>
            <label>
                @L("Filter", "Filtr")
                <select data-import-row-filter>
                    <option value="all">@L("All", "Wszystkie")</option>
                    @if (!isCompleted)
                    {
                        <option value="valid">@L("Valid", "Poprawne")</option>
                        <option value="error">@L("Errors", "Błędy")</option>
                    }
                    else
                    {
                        <option value="imported">@L("Imported", "Zaimportowane")</option>
                        @if (isAccountImport)
                        {
                            <option value="invitation-sent">@L("Invitation sent", "Zaproszenie wysłane")</option>
                            <option value="invitation-failed">@L("Invitation failed", "Błąd zaproszenia")</option>
                        }
                    }
                </select>
            </label>
        </div>

        @if (isAssessmentResults)
        {
            <div class="import-table-wrap">
                <table class="import-table import-assessment-student-table">
                    <thead>
                        <tr>
                            <th>@L("Student", "Uczeń")</th>
                            <th>@L("Final score", "Wynik końcowy")</th>
                            <th>@L("Percentage", "Procent")</th>
                            <th>@I["Status"]</th>
                            <th><span class="visually-hidden">@L("Details", "Szczegóły")</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var student in assessmentStudentGroups)
                    {
                        var validationState = student.HasError ? "error" : "valid";
                        var importState = isCompleted ? "imported" : validationState;
                        var finalScore = student.AssessmentMax > 0m
                            ? $"{student.Total.ToString("0.##", CultureInfo.CurrentCulture)} / {student.AssessmentMax.ToString("0.##", CultureInfo.CurrentCulture)}"
                            : student.Total.ToString("0.##", CultureInfo.CurrentCulture);
                        var percentageText = student.Percentage.HasValue
                            ? $"{student.Percentage.Value.ToString("0.##", CultureInfo.CurrentCulture)}%"
                            : "—";
                        <tr data-import-row
                            data-validation-state="@validationState"
                            data-import-state="@importState">
                            <td data-label="@L("Student", "Uczeń")"><strong>@student.StudentName</strong></td>
                            <td data-label="@L("Final score", "Wynik końcowy")">@finalScore</td>
                            <td data-label="@L("Percentage", "Procent")">@percentageText</td>
                            <td data-label="@I["Status"]">
                                @if (isCompleted)
                                {
                                    <span class="import-student-status is-ready">@L("Imported", "Zaimportowano")</span>
                                }
                                else if (student.HasError)
                                {
                                    <span class="import-student-status is-error">@L("Needs attention", "Wymaga uwagi")</span>
                                }
                                else
                                {
                                    <span class="import-student-status is-ready">@L("Ready", "Gotowe")</span>
                                }
                            </td>
                            <td data-label="@L("Details", "Szczegóły")">
                                <details class="import-student-details">
                                    <summary>@L("View", "Pokaż")</summary>
                                    <div class="import-student-detail-panel">
                                        <table class="import-question-detail-table">
                                            <thead>
                                                <tr>
                                                    <th>@L("Question", "Pytanie")</th>
                                                    <th>@L("Maximum", "Maksimum")</th>
                                                    <th>@L("Score", "Wynik")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var question in student.Questions)
                                            {
                                                var questionLabel = string.IsNullOrWhiteSpace(question.Prompt)
                                                    ? $"Q{question.Order}"
                                                    : $"Q{question.Order}. {question.Prompt}";
                                                <tr>
                                                    <td>@questionLabel</td>
                                                    <td>@(string.IsNullOrWhiteSpace(question.MaxScore) ? "—" : question.MaxScore)</td>
                                                    <td>@question.Score</td>
                                                </tr>
                                            }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <th>@L("Final score", "Wynik końcowy")</th>
                                                    <th>@(student.AssessmentMax > 0m ? student.AssessmentMax.ToString("0.##", CultureInfo.CurrentCulture) : "—")</th>
                                                    <th>@student.Total.ToString("0.##", CultureInfo.CurrentCulture)</th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                        @if (student.Percentage.HasValue)
                                        {
                                            <p class="import-student-percentage">
                                                <strong>@L("Percentage", "Procent"):</strong>
                                                @student.Percentage.Value.ToString("0.##", CultureInfo.CurrentCulture)%
                                            </p>
                                        }
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <form asp-controller="ImportBatchActions" asp-action="RemoveRows" asp-route-batchId="@Model.Batch.Id" method="post" data-import-remove-form>
            <input type="hidden" name="rowVersion" value="@Model.RowVersionBase64" />
            <div class="import-table-wrap">
            <table class="import-table">
            <thead>
            <tr>
            @if (!isCompleted && canManageImports) { <th class="import-select-column"><span class="visually-hidden">@L("Select", "Wybierz")</span></th> }
            <th>@I["Row"]</th>
            @foreach (var header in visibleHeaders) { <th>@header</th> }
            @if (isCompleted) { <th>@I["Status"]</th> }
            @if (isCompleted && isAccountImport) { <th>@L("Invitation", "Zaproszenie")</th> }
            </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Batch.PreviewRows)
            {
            var validationState = invalidRows.Contains(row.RowNumber) ? "error" : "valid";
            var importState = row.Values.TryGetValue("__ImportStatus", out var storedImport) ? storedImport.ToLowerInvariant() : isCompleted ? "imported" : validationState;
            var invitationState = row.Values.TryGetValue("__InvitationStatus", out var storedInvitation) ? storedInvitation.ToLowerInvariant() : string.Empty;
            var filterState = invitationState == "sent" ? "invitation-sent" : invitationState == "failed" ? "invitation-failed" : importState;
            <tr data-import-row data-validation-state="@validationState" data-import-state="@filterState">
            @if (!isCompleted && canManageImports)
            {
            <td class="import-select-column"><input type="checkbox" name="rowNumbers" value="@row.RowNumber" aria-label="@L($"Select row {row.RowNumber}", $"Wybierz wiersz {row.RowNumber}")" /></td>
            }
            <td data-label="@I["Row"]">@row.RowNumber</td>
            @foreach (var header in visibleHeaders)
            {
            var value = row.Values.TryGetValue(header, out var cell) ? cell : string.Empty;
            <td data-label="@header">@value</td>
            }
            @if (isCompleted)
            {
            <td data-label="@I["Status"]">@L("Imported", "Zaimportowano")</td>
            }
            @if (isCompleted && isAccountImport)
            {
            <td data-label="@L("Invitation", "Zaproszenie")">
            @if (invitationState == "failed") { <span>@L("Failed", "Błąd")</span> }
            else if (invitationState == "sent") { <span>@L("Sent", "Wysłano")</span> }
            else if (invitationState == "notrequired") { <span>@L("Not required", "Nie jest wymagane")</span> }
            else { <span>@L("Available", "Dostępne")</span> }
            @if (invitationState != "notrequired")
            {
            <button type="submit" class="school-button school-button-small" formaction="/school/imports/@Model.Batch.Id/resend-invitation" formmethod="post" name="rowNumber" value="@row.RowNumber">@L("Resend invitation", "Wyślij ponownie")</button>
            }
            </td>
            }
            </tr>
            }
            </tbody>
            </table>
            </div>
            @if (!isCompleted && canManageImports)
            {
            <div class="import-preview-actions">
            <button type="submit" class="school-button" data-remove-selected disabled>@L("Delete selected", "Usuń wybrane")</button>
            <span data-import-selection-count>0 @L("selected", "wybranych")</span>
            </div>
            }
            </form>
        }
    </section>

    <section class="import-panel">
        @if (Model.CanConfirm)
        {
            <h2>@I["ConfirmImport"]</h2>
            <p>@I["ConfirmHelp"]</p>
            @if (canManageImports)
            {
                <form asp-action="Confirm" asp-route-batchId="@Model.Batch.Id" method="post">
                    <input type="hidden" name="rowVersion" value="@Model.RowVersionBase64" />
                    <button type="submit" class="school-button school-button-primary">@I["ConfirmImport"]</button>
                </form>
            }
        }
        else if (Model.IsLegacyReadOnly)
        {
            <p>@I["ImportReadOnlyNotice"]</p>
        }
        else if (!isCompleted && Model.Batch.ErrorCount > 0)
        {
            @if (Model.Batch.Type == ImportType.AssessmentResults)
            {
                <p>@L("Correct the workbook and upload a new Assessment Results batch before confirming.", "Popraw skoroszyt i prześlij nową partię wyników sprawdzianu przed potwierdzeniem.")</p>
            }
            else
            {
                <p>@L("Remove the invalid rows or correct the source file before confirming.", "Usuń nieprawidłowe wiersze lub popraw plik źródłowy przed potwierdzeniem.")</p>
            }
        }
    </section>
</section>

<script src="~/js/import-batch-details.js" asp-append-version="true" defer></script>