@using System.Globalization
@using Edulytics.Core.Constants
@using Edulytics.Core.Enums
@model Edulytics.Web.ViewModels.Imports.ImportIndexViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.ImportResource> I

@{
    var canManageImports =
        User.IsInRole(RoleNames.SchoolAdmin) ||
        User.IsInRole(RoleNames.SubjectSupervisor) ||
        User.IsInRole(RoleNames.Teacher);
    var isPolish = string.Equals(
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
        "pl",
        StringComparison.OrdinalIgnoreCase);
    string L(string en, string pl) => isPolish ? pl : en;
    string TypeLabel(ImportType type) => type switch
    {
        ImportType.Teachers => L("Teachers", "Nauczyciele"),
        ImportType.SubjectSupervisors => L("Subject supervisors", "Opiekunowie przedmiotu"),
        ImportType.AssessmentResults => L("Assessment results", "Wyniki sprawdzianów"),
        _ => I[$"Type{type}"].Value
    };
    bool CanDiscard(ImportType type) =>
        (User.IsInRole(RoleNames.SchoolAdmin) && type == ImportType.SubjectSupervisors) ||
        (User.IsInRole(RoleNames.SubjectSupervisor) && type is ImportType.Students or ImportType.Teachers or ImportType.Classes) ||
        (User.IsInRole(RoleNames.Teacher) && type == ImportType.AssessmentResults);
    ViewData["Title"] = L("Bulk data import", "Import danych zbiorczych");
}

<section class="import-page import-index @(canManageImports ? "" : "is-readonly")">
    <header class="import-page-header">
        <div>
            <div class="user-eyebrow">@I["ImportTitle"]</div>
            <h1>@L("Bulk data import", "Import danych zbiorczych")</h1>
            <p class="user-page-subtitle">
                @(canManageImports
                    ? L("Use the Edulytics templates to add school data and accounts in bulk.", "Użyj szablonów Edulytics, aby zbiorczo dodać dane szkoły i konta.")
                    : I["ImportViewSubtitle"].Value)
            </p>
        </div>
        <a class="school-button" asp-controller="SchoolHome" asp-action="Dashboard">@I["BackToDashboard"]</a>
    </header>

    @if (TempData["ImportSuccess"] is string success)
    {
        <div class="import-message import-message-success" role="status">@success</div>
    }
    @if (TempData["ImportError"] is string error)
    {
        <div class="import-message import-message-error" role="alert">@error</div>
    }
    @if (!canManageImports)
    {
        <div class="import-message import-message-info" role="status">@I["ImportReadOnlyNotice"]</div>
    }

    @if (canManageImports)
    {
        <section class="import-panel ed-import-workflow" aria-label="@L("Import workflow", "Przebieg importu")">
            <h2>@L("How bulk import works", "Jak działa import zbiorczy")</h2>
            <div class="ed-import-steps">
                <article><strong>1</strong><span>@L("Choose the data type and download its template.", "Wybierz typ danych i pobierz szablon.")</span></article>
                <article><strong>2</strong><span>@L("Fill it with the names and values shown in Edulytics. You do not need internal database IDs.", "Uzupełnij go nazwami i wartościami widocznymi w Edulytics. Nie potrzebujesz wewnętrznych identyfikatorów bazy.")</span></article>
                <article><strong>3</strong><span>@L("Upload and validate. Validation changes no school data and sends no invitations.", "Prześlij i zweryfikuj. Walidacja nie zmienia danych szkoły ani nie wysyła zaproszeń.")</span></article>
                <article><strong>4</strong><span>@L("Review the preview and correct every validation error in the source file.", "Sprawdź podgląd i popraw wszystkie błędy walidacji w pliku źródłowym.")</span></article>
                <article><strong>5</strong><span>@L("Confirm only when the preview is correct. New student, teacher or supervisor accounts are then created and invitations are sent.", "Potwierdź dopiero po sprawdzeniu podglądu. Wtedy tworzone są nowe konta uczniów, nauczycieli lub opiekunów i wysyłane są zaproszenia.")</span></article>
            </div>
        </section>
    }

    <section class="import-panel import-operational-panel">
        <h2>@I["UploadFile"]</h2>
        <p>@I["FileRules"]</p>
        @if (canManageImports && Model.Workspace.AllowedTypes.Count > 0)
        {
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="import-upload-form">
                <div class="import-field">
                    <label for="importType">@I["ImportType"]</label>
                    <select id="importType" name="importType" required>
                        @foreach (var option in Model.Workspace.AllowedTypes)
                        {
                            <option value="@option.Type">@TypeLabel(option.Type)</option>
                        }
                    </select>
                </div>
                <div class="import-field">
                    <label for="importFile">@I["File"]</label>
                    <input id="importFile" name="file" type="file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                </div>
                <button type="submit" class="school-button school-button-primary">@I["UploadAndValidate"]</button>
            </form>
        }
    </section>

    <section class="import-schema-grid import-operational-schema">
        @foreach (var option in Model.Workspace.AllowedTypes)
        {
            <article class="import-panel import-schema-card">
                <h2>@TypeLabel(option.Type)</h2>
                <strong>@I["RequiredColumns"]</strong>
                <code>@string.Join(",", option.RequiredHeaders)</code>
                @if (canManageImports)
                {
                    <a asp-action="Template" asp-route-importType="@option.Type">@I["DownloadTemplate"]</a>
                }

                @switch (option.Type)
                {
                    case ImportType.Students:
                        <p>@L("Use StudentNumber + Email as the student's academic and login identifiers, plus the exact AcademicYear and ClassName shown in Edulytics. After Confirm, Edulytics creates the Student login, links the student profile to that class and sends the password-setup invitation.", "Użyj StudentNumber + Email jako identyfikatorów ucznia w szkole i do logowania oraz dokładnych nazw AcademicYear i ClassName widocznych w Edulytics. Po potwierdzeniu Edulytics tworzy konto ucznia, łączy profil z klasą i wysyła zaproszenie do ustawienia hasła.")</p>
                        break;
                    case ImportType.Teachers:
                        <p>@L("Use Email + AcademicYear + ClassName. If the email is new, Confirm creates the Teacher account and sends an invitation; if it is already an active Teacher account, Edulytics only adds the class assignment. Mathematics is assigned automatically.", "Użyj Email + AcademicYear + ClassName. Jeśli email jest nowy, po potwierdzeniu tworzone jest konto nauczyciela i wysyłane zaproszenie; jeśli aktywne konto nauczyciela już istnieje, Edulytics dodaje tylko przypisanie do klasy. Matematyka jest przypisywana automatycznie.")</p>
                        break;
                    case ImportType.SubjectSupervisors:
                        <p>@L("School administrators can create Subject Supervisor accounts in bulk. Validation sends nothing; Confirm creates each account and sends its password-setup invitation.", "Administratorzy szkoły mogą zbiorczo tworzyć konta opiekunów przedmiotu. Walidacja niczego nie wysyła; potwierdzenie tworzy konta i wysyła zaproszenia do ustawienia hasła.")</p>
                        break;
                    case ImportType.Classes:
                        <p>@L("Create classes in bulk using AcademicYear + GradeLevel + Name. Edulytics generates the internal class Code automatically, so you do not need to create or manage technical class identifiers.", "Twórz klasy zbiorczo za pomocą AcademicYear + GradeLevel + Name. Edulytics automatycznie generuje wewnętrzny kod klasy, więc nie musisz tworzyć ani zarządzać technicznymi identyfikatorami klas.")</p>
                        break;
                    case ImportType.AssessmentResults:
                        <p>@L("Teachers import offline/manual results using AssessmentTitle + AssessmentDate + ClassName. The signed-in teacher is the owner of the upload, so no Teacher name or internal GUID is required. StudentNumber identifies the student; StudentName is for review. Use one row per question. After Confirm, imported grades are read-only.", "Nauczyciele importują wyniki offline/ręczne za pomocą AssessmentTitle + AssessmentDate + ClassName. Zalogowany nauczyciel jest właścicielem importu, więc nie trzeba podawać nazwy nauczyciela ani wewnętrznego GUID. StudentNumber identyfikuje ucznia, a StudentName służy do sprawdzenia. Jeden wiersz odpowiada jednemu pytaniu. Po potwierdzeniu oceny są tylko do odczytu.")</p>
                        break;
                }
            </article>
        }
    </section>

    <section class="import-panel">
        <h2>@I["History"]</h2>
        <p>@L("Completed imports are kept as history. Unconfirmed or failed batches can be discarded.", "Zakończone importy są zachowywane jako historia. Niepotwierdzone lub nieudane partie można odrzucić.")</p>
        @if (Model.Workspace.Batches.Count == 0)
        {
            <p>@I["NoHistory"]</p>
        }
        else
        {
            <div class="import-table-wrap">
                <table class="import-table">
                    <thead>
                        <tr><th>@I["ImportType"]</th><th>@I["FileName"]</th><th>@I["Status"]</th><th>@I["Rows"]</th><th>@I["Errors"]</th><th>@I["Created"]</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var batch in Model.Workspace.Batches)
                    {
                        var statusKey = batch.Status switch
                        {
                            ImportBatchStatus.Validated => "StatusValidated",
                            ImportBatchStatus.ValidationFailed => "StatusValidationFailed",
                            _ => "StatusCompleted"
                        };
                        var canDiscardBatch = batch.Status != ImportBatchStatus.Completed && CanDiscard(batch.Type);
                        <tr>
                            <td data-label="@I["ImportType"]">@TypeLabel(batch.Type)</td>
                            <td data-label="@I["FileName"]">@batch.FileName</td>
                            <td data-label="@I["Status"]">@I[statusKey]</td>
                            <td data-label="@I["Rows"]">@batch.RowCount</td>
                            <td data-label="@I["Errors"]">@batch.ErrorCount</td>
                            <td data-label="@I["Created"]">@batch.CreatedAtUtc.ToString("u")</td>
                            <td>
                                <div class="import-history-actions">
                                    <a asp-action="Details" asp-route-batchId="@batch.Id">@I["Open"]</a>
                                    @if (canDiscardBatch)
                                    {
                                        <form asp-controller="ImportBatchActions" asp-action="Discard" asp-route-batchId="@batch.Id" method="post">
                                            <button type="submit" class="import-link-button">@L("Discard", "Odrzuć")</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

<style>
.ed-import-workflow{margin-bottom:1rem}.ed-import-steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.7rem}.ed-import-steps article{display:grid;grid-template-columns:auto 1fr;gap:.55rem;align-items:start;padding:.8rem;border:1px solid #dbe4ef;border-radius:.8rem;background:#f8faff}.ed-import-steps article>strong{display:grid;place-items:center;width:1.75rem;height:1.75rem;border-radius:50%;background:#2f66e8;color:#fff;font-size:.8rem}.ed-import-steps article>span{color:#425b76;line-height:1.4;font-size:.88rem}.import-history-actions{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap}.import-history-actions form{margin:0}.import-link-button{border:0;background:transparent;padding:0;color:#b42318;text-decoration:underline;cursor:pointer;font:inherit}@@media(max-width:1100px){.ed-import-steps{grid-template-columns:1fr 1fr}}@@media(max-width:650px){.ed-import-steps{grid-template-columns:1fr}}
</style>