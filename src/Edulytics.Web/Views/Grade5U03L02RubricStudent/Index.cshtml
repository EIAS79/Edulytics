@model Edulytics.Web.Controllers.G5L02RubricStudentPage
@{
    ViewData["Title"] = "Grade 5 — Represent Unit Fraction Multiplication";
}
<h1>Unit 3, Lesson 2 — Represent Unit Fraction Multiplication</h1>
<p>Original Edulytics teacher-reviewed construction task. Practice answers are graded separately; this explanation is scored by an assigned teacher, not automatically.</p>
<p>Draw two unit squares. Show one fourth of one third and one third of one fourth. Explain why both shaded areas are 1/12 of the same original whole. Explain Priya's 2-by-5 grid (1/10) and the distinct 5-by-3 grid (1/15), giving multiplication expressions for both orders.</p>
@if (Model.Existing is null)
{
    <form method="post" action="/student/g5/u03/l02/rubric/submit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="lessonId" value="@Model.LessonId" />
        <input type="hidden" name="curriculumAdoptionId" value="@Model.CurriculumAdoptionId" />
        <label for="explanation">Your construction and reasoning (20–8000 characters)</label>
        <textarea id="explanation" name="explanation" required minlength="20" maxlength="8000" rows="10"></textarea>
        <button type="submit">Submit for teacher review</button>
    </form>
}
else
{
    <h2>Submitted for review</h2>
    <p>Submitted: @Model.Existing.SubmittedAtUtc.ToString("u")</p>
    <pre style="white-space:pre-wrap">@Model.Existing.ResponseText</pre>
    @if (Model.Existing.TeacherScore is int score)
    {
        <p>Teacher score: @score / 6</p>
        <p>Teacher feedback: @Model.Existing.TeacherFeedback</p>
    }
    else
    {
        <p>Teacher review pending. No automatic score has been awarded.</p>
    }
}
