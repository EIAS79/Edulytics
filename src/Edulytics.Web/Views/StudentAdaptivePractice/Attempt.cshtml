@using System.Globalization
@using System.Text.RegularExpressions
@using Edulytics.Core.AdaptivePractice
@using Edulytics.Core.Mathematics.Practice
@using Edulytics.Services.AdaptivePractice
@using Edulytics.Web.Presentation
@model AdaptivePracticeSessionView
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.StudentResource> S
@inject AdaptivePracticeV2Policy AdaptivePolicy
@{
    Layout = "_StudentLayout";
    var locale = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var lessonTitle = ViewData["LessonTitle"]?.ToString() ?? "Mathematics";
    var unitTitle = ViewData["LessonUnitTitle"]?.ToString() ?? string.Empty;
    ViewData["Title"] = lessonTitle;

    var question = Model.CurrentQuestion;
    var answeredCount = Math.Max(0, Model.CurrentSequence - 1);
    var progress = Model.TargetQuestionCount <= 0
        ? 0d
        : Math.Min(100d, answeredCount * 100d / Model.TargetQuestionCount);

    LessonPracticeInteractionContract? interaction = null;
    if (!string.IsNullOrWhiteSpace(question?.GenerationFamily))
    {
        LessonPracticeInteractionRegistry.TryResolve(
            question.GenerationFamily,
            out interaction);
    }

    var visualSvg = question is null
        ? null
        : PracticeMathVisualRenderer.RenderSvg(
            question.GenerationFamily,
            question.GenerationParametersJson);

    var prompt = question?.Prompt ?? string.Empty;
    var optionMatches = Regex.Matches(
        prompt,
        @"(?<![A-Za-z0-9])([A-D])\)\s*",
        RegexOptions.CultureInvariant);
    var isPromptMultipleChoice =
        question is not null &&
        optionMatches.Count >= 2 &&
        optionMatches[0].Index > 0;
    var stem = isPromptMultipleChoice
        ? prompt[..optionMatches[0].Index].Trim()
        : prompt;
    var choices = new List<(string Label, string Value)>();

    if (isPromptMultipleChoice)
    {
        for (var index = 0; index < optionMatches.Count; index++)
        {
            var match = optionMatches[index];
            var start = match.Index + match.Length;
            var end = index + 1 < optionMatches.Count
                ? optionMatches[index + 1].Index
                : prompt.Length;
            var value = prompt[start..end].Trim();
            if (value.Length > 0)
                choices.Add((match.Groups[1].Value, value));
        }

        isPromptMultipleChoice = choices.Count >= 2;
    }

    var feedbackKind = TempData["PracticeFeedback"]?.ToString();
    var feedbackSolution = TempData["PracticeSolution"]?.ToString();

    var backLabel = locale switch
    {
        "pl" => "Powrót do lekcji",
        "ar" => "العودة إلى الدرس",
        _ => "Back to lesson"
    };
    var practiceLabel = locale switch
    {
        "pl" => "Ćwiczenie Edulytics",
        "ar" => "تدريب Edulytics",
        _ => "Edulytics Practice"
    };
    var personalizedLabel = locale switch
    {
        "pl" => "Spersonalizowane",
        "ar" => "مخصص لمستواك",
        _ => "Personalized"
    };
    var missionLabel = locale switch
    {
        "pl" => "Twoje zadanie",
        "ar" => "مهمتك",
        _ => "Your mission"
    };
    var confirmationLabel = locale switch
    {
        "pl" => "Niezależne potwierdzenie",
        "ar" => "تأكيد مستقل",
        _ => "Fresh confirmation"
    };
}

@section Head {
<style>
    .up-page{display:grid;gap:18px}
    .up-hero{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;padding:24px;border-radius:24px;background:linear-gradient(135deg,#103846,#164f5d);color:#fff}
    .up-eyebrow{display:inline-flex;gap:8px;align-items:center;font-size:.8rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:#c9f7e8}
    .up-hero h1{margin:8px 0 6px;font-size:clamp(1.65rem,3vw,2.45rem)}
    .up-hero p{margin:0;color:rgba(255,255,255,.82)}
    .up-progress-wrap{min-width:180px;text-align:right}
    .up-progress-label{font-weight:900}
    .up-progress{height:10px;margin-top:10px;border-radius:999px;background:rgba(255,255,255,.18);overflow:hidden}
    .up-progress span{display:block;height:100%;border-radius:inherit;background:#71e0c4}
    .up-card{padding:24px;border:1px solid rgba(19,64,79,.12);border-radius:24px;background:#fff;box-shadow:0 14px 34px rgba(19,64,79,.08)}
    .up-question-head{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:18px}
    .up-question-number{font-size:.82rem;font-weight:900;color:#52717d;text-transform:uppercase;letter-spacing:.06em}
    .up-badge{display:inline-flex;padding:6px 10px;border-radius:999px;background:#eafaf4;color:#17634f;font-size:.78rem;font-weight:900}
    .up-prompt{font-size:clamp(1.25rem,2.4vw,1.8rem);font-weight:900;line-height:1.35;color:#173c47;text-align:center;margin:10px auto 22px;max-width:820px}
    .up-visual{width:min(700px,100%);margin:0 auto 22px;padding:16px;border-radius:20px;background:#f7fbfc;border:1px solid #d9e8ec}
    .up-visual svg{display:block;width:100%;height:auto;max-height:360px}
    .up-form{display:grid;gap:16px;justify-items:center}
    .up-input{width:min(440px,100%);min-height:58px;border:2px solid #bfd4da;border-radius:14px;padding:10px 16px;text-align:center;font-size:1.45rem;font-weight:900;color:#173c47;background:#fff}
    .up-input:focus{outline:4px solid rgba(113,224,196,.28);border-color:#3d9d86}
    .up-choices{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}
    .up-choice{min-width:120px;border:1px solid #c8dce1;border-radius:14px;padding:13px 18px;background:#f8fbfc;color:#173c47;font-weight:900;cursor:pointer}
    .up-choice:hover,.up-choice:focus{border-color:#3d9d86;background:#eefaf6}
    .up-feedback{padding:14px 16px;border-radius:16px;font-weight:800}
    .up-feedback.ok{background:#eafaf4;color:#145d4b;border:1px solid #b7eadb}
    .up-feedback.bad{background:#fff1ef;color:#85332b;border:1px solid #f0c0ba}
    .up-actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
    .up-primary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 18px;border:0;border-radius:12px;background:#133f4d;color:#fff;text-decoration:none;font-weight:900;cursor:pointer}
    .up-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 18px;border:1px solid #c8dce1;border-radius:12px;background:#fff;color:#173c47;text-decoration:none;font-weight:800}
    .up-coach{display:flex;gap:14px;align-items:center;padding:16px;border-radius:18px;background:#f7fbfc;border:1px solid #d9e8ec}
    .up-coach img{width:64px;height:auto}
    .up-complete{text-align:center;padding:34px}
    .up-complete img{width:86px;height:auto}
    @media(max-width:720px){.up-hero{display:grid}.up-progress-wrap{text-align:left;min-width:0}.up-card{padding:18px}.up-question-head{align-items:flex-start}}
</style>
}

<section class="up-page">
    <header class="up-hero">
        <div>
            <span class="up-eyebrow">@practiceLabel · @personalizedLabel</span>
            <h1>@lessonTitle</h1>
            <p>@unitTitle</p>
        </div>
        <div class="up-progress-wrap">
            <div class="up-progress-label">
                @(Model.IsCompleted ? Model.TargetQuestionCount : Model.CurrentSequence)
                / @Model.TargetQuestionCount
            </div>
            <div class="up-progress"
                 role="progressbar"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="@progress">
                <span style="width:@progress%"></span>
            </div>
        </div>
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="up-feedback bad" role="alert">@error</div>
    }

    @if (feedbackKind is not null)
    {
        <div class="up-feedback @(feedbackKind == "correct" ? "ok" : "bad")" role="status">
            <strong>@(feedbackKind == "correct" ? S["PracticeCorrect"].Value : S["PracticeIncorrect"].Value)</strong>
            @if (!string.IsNullOrWhiteSpace(feedbackSolution))
            {
                <span> @feedbackSolution</span>
            }
        </div>
    }

    @if (Model.IsPaused)
    {
        <section class="up-card up-complete">
            <img src="~/images/public/edulaytiks-character.png?v=43" alt="" />
            <h2>@(locale switch { "pl" => "Ćwiczenie zostało bezpiecznie wstrzymane", "ar" => "تم إيقاف التدريب مؤقتًا بأمان", _ => "Practice safely paused" })</h2>
            <p>@(locale switch { "pl" => "Twoja ostatnia odpowiedź została zapisana. Spróbuj ponownie później.", "ar" => "تم حفظ إجابتك الأخيرة. حاول مرة أخرى لاحقًا.", _ => "Your last answer was saved. Try again later." })</p>
            <div class="up-actions">
                <a class="up-primary" asp-controller="StudentPortal" asp-action="Lesson" asp-route-id="@Model.LessonId">@backLabel</a>
            </div>
        </section>
    }
    else if (Model.IsCompleted)
    {
        <section class="up-card up-complete">
            <img src="~/images/public/edulaytiks-character.png?v=43" alt="" />
            <h2>@S["PracticeFinish"]</h2>
            <p>@(locale switch { "pl" => "Sesja została zakończona. Twoje odpowiedzi zostały zapisane w historii nauki.", "ar" => "اكتملت الجلسة وتم حفظ إجاباتك في سجل التعلم.", _ => "Session complete. Your answers are saved in your learning history." })</p>
            <div class="up-actions">
                <a class="up-primary" asp-controller="StudentPortal" asp-action="Lesson" asp-route-id="@Model.LessonId">@backLabel</a>
                @if (AdaptivePolicy.EnableQuestionLog)
                {
                    <a class="up-secondary" asp-controller="StudentAdaptiveIntelligence" asp-action="QuestionLog">Question log</a>
                }
            </div>
        </section>
    }
    else if (question is not null)
    {
        <section class="up-card">
            <div class="up-question-head">
                <span class="up-question-number">@missionLabel · @question.Sequence / @Model.TargetQuestionCount</span>
                @if (question.IsIndependentConfirmation)
                {
                    <span class="up-badge">@confirmationLabel</span>
                }
            </div>

            <div class="up-prompt">@stem</div>

            @if (!string.IsNullOrWhiteSpace(visualSvg))
            {
                <div class="up-visual">@Html.Raw(visualSvg)</div>
            }

            @if (interaction is null)
            {
                <div class="up-feedback bad">This Practice interaction is not available.</div>
            }
            else
            {
                <form asp-action="AnswerAdaptiveLessonAttempt"
                      asp-route-id="@Model.SessionId"
                      method="post"
                      class="up-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sequence" value="@question.Sequence" />

                    @if (isPromptMultipleChoice)
                    {
                        <div class="up-choices" role="radiogroup" aria-label="@S["YourAnswer"]">
                            @foreach (var choice in choices)
                            {
                                <button class="up-choice" type="submit" name="answer" value="@choice.Value">
                                    @choice.Label) @choice.Value
                                </button>
                            }
                        </div>
                    }
                    else if (interaction.InteractionKind == LessonPracticeInteractionKind.RelationChoice)
                    {
                        <div class="up-choices" aria-label="@S["YourAnswer"]">
                            @foreach (var relation in new[] { "<", "=", ">" })
                            {
                                <button class="up-choice" type="submit" name="answer" value="@relation">@relation</button>
                            }
                        </div>
                    }
                    else
                    {
                        <input class="up-input"
                               name="answer"
                               maxlength="128"
                               required
                               autocomplete="off"
                               autofocus
                               aria-label="@S["YourAnswer"]" />
                        <button class="up-primary" type="submit">@S["PracticeCheckAnswer"]</button>
                    }
                </form>
            }
        </section>

        <aside class="up-coach">
            <img src="~/images/public/edulaytiks-character.png?v=43" alt="" />
            <div>
                <strong>EDDY</strong>
                <p>@(question.IsIndependentConfirmation
                    ? confirmationLabel
                    : locale switch
                    {
                        "pl" => "Rozwiąż zadanie. Następne pytanie zostanie dobrane na podstawie Twojej odpowiedzi.",
                        "ar" => "حل السؤال. سيتم اختيار السؤال التالي بناءً على إجابتك.",
                        _ => "Solve the question. Your next question will be selected from your answer."
                    })</p>
            </div>
        </aside>
    }
</section>
