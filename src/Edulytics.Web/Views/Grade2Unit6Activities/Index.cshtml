@model Edulytics.Web.ViewModels.LessonContent.Grade2Unit6Page
@{Layout="_StudentLayout";ViewData["Title"]=Model.Title;}
<style>
.g2u6{max-width:960px;margin:auto;padding:20px;color:#294556}
.g2u6 section{padding:16px;border:1px solid #c1d7e2;border-radius:11px;background:white;margin:15px 0}
.g2u6 label{font-weight:700;display:block;margin:10px 0 5px}
.g2u6 input,.g2u6 textarea{font:inherit;border:1px solid #859fac;border-radius:8px;padding:9px;max-width:640px;width:100%}
.g2u6 .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.g2u6 button{padding:12px 18px;background:#15798c;border:0;border-radius:8px;font-weight:700;color:#fff}
</style>
<main class="g2u6"><a asp-controller="StudentPortal" asp-action="Lesson" asp-route-id="@Model.LessonId">← Back to lesson</a>
<h1>@Model.Title</h1><p>IM K–5 Grade2 Unit6 Lesson @Model.LessonNumber. This page separates teacher-observed ORIGINAL hands-on work from first-party Edulytics numerical exercises.</p>
<section><h2>Publisher source-specific original task</h2><p>@Model.AuthenticSourceRequirement</p>
<p>Complete the REAL original geometry, shaded equal area, clock-face, coin-collection or game activity with your teacher. Teacher must examine genuine source images; numerical fields below cannot substitute for it.</p></section>
<form asp-controller="Grade2Unit6Activities" asp-action="Submit" asp-route-lessonNumber="@Model.LessonNumber" method="post">
@Html.AntiForgeryToken()
<input type="hidden" name="curriculumAdoptionId" value="@Model.AdoptionId"/>
<input type="hidden" name="lessonId" value="@Model.LessonId"/>
<section><h2>1. Mathematical source companion — numerical facts, human review</h2><p>Enter the numeric source-example values in the same order given in the teacher-facing explanation, not imagined picture-only facts.</p>
<div class="grid">
<div><label asp-for="Answers.SourceA">Source example value 1</label><input asp-for="Answers.SourceA" type="number" min="0" max="1000"/></div>
<div><label asp-for="Answers.SourceB">Source example value 2</label><input asp-for="Answers.SourceB" type="number" min="0" max="1000"/></div>
<div><label asp-for="Answers.SourceC">Source example value 3</label><input asp-for="Answers.SourceC" type="number" min="0" max="1000"/></div>
<div><label asp-for="Answers.SourceD">Source example value 4</label><input asp-for="Answers.SourceD" type="number" min="0" max="1000"/></div></div></section>
<section><h2>2. Your genuine published source work — teacher review</h2>
<label asp-for="Answers.ActualSourceShapeOrImage">What did you really SEE on the original publisher picture, clock, shaded figure or coin card?</label><textarea asp-for="Answers.ActualSourceShapeOrImage" maxlength="2000" rows="3"></textarea>
<label asp-for="Answers.StudentCreatedDrawingOrWords">Describe your OWN actual drawn polygon/shape partition/time representation/explanation</label><textarea asp-for="Answers.StudentCreatedDrawingOrWords" maxlength="2000" rows="3"></textarea>
<label asp-for="Answers.RealPhysicalGameOrCoins">Physical blocks, pattern puzzle, partner work, clock hands or coin collections (when applicable)</label><textarea asp-for="Answers.RealPhysicalGameOrCoins" maxlength="2000" rows="3"></textarea>
<p>Teacher observations and approval must be recorded by an authenticated teacher, not entered by the student.</p></section>
<section><h2>3. Edulytics first-party independent numerical examples</h2>
<p>These invented arithmetic/shape attribute examples are NOT source Cool-down and do not prove real pictures or class games.</p><div class="grid">
<div><label asp-for="Answers.OwnA">Independent answer A</label><input asp-for="Answers.OwnA" type="number" min="0" max="1000"/></div>
<div><label asp-for="Answers.OwnB">Independent answer B</label><input asp-for="Answers.OwnB" type="number" min="0" max="1000"/></div>
<div><label asp-for="Answers.OwnC">Independent answer C</label><input asp-for="Answers.OwnC" type="number" min="0" max="1000"/></div>
<div><label asp-for="Answers.OwnD">Independent answer D</label><input asp-for="Answers.OwnD" type="number" min="0" max="1000"/></div>
</div><button type="submit">Check numeric results</button></section></form>
@if(Model.Submitted){<section aria-live="polite"><h2>Results — numeric checks are not original teacher acceptance</h2>
@foreach(var f in Model.Feedback){<h3>@f.Section</h3><p>@f.Comment</p>}</section>}
<p>Stage D tests, CI, academic acceptance and publication are not asserted.</p></main>
