@model Edulytics.Web.ViewModels.LessonContent.Grade3Lesson8PracticePage
@using Edulytics.Core.Mathematics.Curriculum
@{
    Layout="_StudentLayout";
    ViewData["Title"]="Grade 3 · More Questions About Scaled Bar Graphs";
    var feelings=UsCcssG3Unit1Lesson8TwoStepDataProblems.Feelings;
    var trees=UsCcssG3Unit1Lesson8TwoStepDataProblems.Trees;
    var cooldown=UsCcssG3Unit1Lesson8TwoStepDataProblems.OriginalEdulyticsCoolDown;
    var sourceReading=UsCcssG3Unit1Lesson8TwoStepDataProblems.OriginalSourceReadingTime;
}
<style>
.g3-l08{max-width:980px;padding:20px;margin:auto;color:#193b55}
.g3-l08 .panel{background:#fff;border:1px solid #d8e4ed;border-radius:15px;padding:22px;margin:15px 0}
.g3-l08 label{display:block;font-weight:700;margin:11px 0 5px}
.g3-l08 textarea,.g3-l08 input{max-width:680px;width:100%;padding:10px;border-radius:8px;border:1px solid #8296a7;font:inherit}
.g3-l08 .two{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.g3-l08 .bar-row{display:flex;align-items:center;gap:12px;margin:11px 0}
.g3-l08 .bar-row strong{width:100px;flex:none}
.g3-l08 .bar{height:26px;background:#188399}
.g3-l08 .source-vertical-frame{overflow-x:auto}
.g3-l08 .source-vertical-chart{display:grid;grid-template-columns:36px minmax(340px,1fr);gap:9px;max-width:740px;min-width:410px}
.g3-l08 .source-y-ticks{height:300px;display:flex;flex-direction:column;justify-content:space-between;font-size:.78rem;line-height:1}
.g3-l08 .source-v-bars{height:300px;display:grid;grid-template-columns:repeat(var(--source-columns),minmax(70px,1fr));gap:10px;align-items:end;border-left:2px solid #648399;border-bottom:2px solid #648399;padding:0 8px}
.g3-l08 .source-v-column{height:300px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end}
.g3-l08 .source-v-bar{background:#188399;width:70%;max-width:82px;border-radius:4px 4px 0 0}
.g3-l08 .source-v-labels{grid-column:2;display:grid;grid-template-columns:repeat(var(--source-columns),minmax(70px,1fr));gap:10px;padding:0 8px}
.g3-l08 .source-v-label{text-align:center;font-size:.82rem;overflow-wrap:anywhere}
.g3-l08 .source-x-title{grid-column:2;text-align:center;font-weight:700;margin:5px 0}
.g3-l08 .ok{border-left:4px solid #198455;padding-left:10px}
.g3-l08 .no{border-left:4px solid #b13547;padding-left:10px}
.g3-l08 .review{border-left:4px solid #a87919;padding-left:10px}
.g3-l08 button{padding:12px 18px;border:0;border-radius:8px;background:#097887;color:#fff;font:inherit;cursor:pointer}
</style>
<main class="g3-l08">
    <a asp-controller="StudentPortal" asp-action="Lesson" asp-route-id="@Model.LessonId">← Back to lesson</a>
    <h1>More Questions About Scaled Bar Graphs</h1>
    <p>Read a data situation three times, identify all quantities, solve a comparison of one group to the sum of two others, and justify two methods. These source values match the locally archived 2021 lesson; graphs are independently redrawn.</p>
    <form asp-controller="Grade3Lesson8Activities" asp-action="Submit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="curriculumAdoptionId" value="@Model.AdoptionId" />
        <input type="hidden" name="lessonId" value="@Model.LessonId" />
        <section class="panel">
            <h2>1. Warm-up — repeated addition by 2 and 5</h2>
            <p>Find the value of each of the four public 2021 mental-math expressions, in this sequence. Use the previous result to reason about one more equal group:</p>
            <ol>
                <li>2 + 2 + 2 + 2 + 2</li>
                <li>2 + 2 + 2 + 2 + 2 + 2</li>
                <li>5 + 5 + 5 + 5 + 5 + 5</li>
                <li>5 + 5 + 5 + 5 + 5 + 5 + 5</li>
            </ol>
            <label for="warmup">My strategy</label>
            <textarea id="warmup" name="Warmup" rows="3" maxlength="2000">@Model.Answers.Warmup</textarea>
            <p>Teacher checks how adding one more equal group changes the total and whether the original four-expression sequence was reasoned about, not merely recalled.</p>
        </section>
        <section class="panel">
            <h2>2. Source-aligned New School Year graph — scale 0–60 by 5</h2>
            <p>How are the students feeling about the new school year?</p>
            <div class="source-vertical-frame">
                <div class="source-vertical-chart" style="--source-columns:3" role="img" aria-label="Feelings About the New School Year: vertical axis 0 to 60 in fives; excited 55, nervous 23, curious 25 students.">
                    <div class="source-y-ticks" aria-hidden="true">
                        @for(var tick=60;tick>=0;tick-=5){<span>@tick</span>}
                    </div>
                    <div class="source-v-bars" aria-hidden="true">
                        @foreach(var item in feelings){
                            <div class="source-v-column"><div class="source-v-bar" style="height:@(item.Value*300/60)px"></div></div>
                        }
                    </div>
                    <div class="source-v-labels" aria-hidden="true">
                        @foreach(var item in feelings){<span class="source-v-label">@item.Category</span>}
                    </div>
                    <p class="source-x-title">Feelings</p>
                </div>
            </div>
            <p>Axis tick marks: 0–60 by fives. Read heights from the scaled vertical bars before discussing the comparison.</p>
            <h3>Three Reads</h3>
            <label for="read1">First read — what is this situation about?</label>
            <textarea id="read1" name="FirstRead" rows="2" maxlength="2000">@Model.Answers.FirstRead</textarea>
            <label for="read2">Second read — what quantities are given?</label>
            <textarea id="read2" name="SecondRead" rows="2" maxlength="2000">@Model.Answers.SecondRead</textarea>
            <label for="read3">Third read — what operations and steps would you use?</label>
            <textarea id="read3" name="ThirdRead" rows="2" maxlength="2000">@Model.Answers.ThirdRead</textarea>
            <label for="feelings-answer">How many MORE are Excited than Nervous OR Curious combined?</label>
            <input id="feelings-answer" name="FeelingsTwoStep" value="@Model.Answers.FeelingsTwoStep" inputmode="numeric" required />
            <p>Think about two mathematical approaches: add the two comparison categories first, or subtract them from Excited one at a time.</p>
            <label for="other-way">Explain TWO methods with equations and why they give the same result</label>
            <textarea id="other-way" name="FeelingsOtherMethod" rows="4" maxlength="2000">@Model.Answers.FeelingsOtherMethod</textarea>
        </section>
        <section class="panel">
            <h2>3. Source-aligned trees graph — axis 0–100 by 10</h2>
            <p>Clare counted trees on the way home. Read carefully: “Oak OR Maple” means both categories together in these questions.</p>
            <div class="source-vertical-frame">
                <div class="source-vertical-chart" style="--source-columns:4" role="img" aria-label="Trees I Saw on the Way Home: vertical axis 0 to 100 in tens; oak 29, pine 82, maple 15, fir 58 trees.">
                    <div class="source-y-ticks" aria-hidden="true">
                        @for(var tick=100;tick>=0;tick-=10){<span>@tick</span>}
                    </div>
                    <div class="source-v-bars" aria-hidden="true">
                        @foreach(var item in trees){
                            <div class="source-v-column"><div class="source-v-bar" style="height:@(item.Value*300/100)px"></div></div>
                        }
                    </div>
                    <div class="source-v-labels" aria-hidden="true">
                        @foreach(var item in trees){<span class="source-v-label">@item.Category</span>}
                    </div>
                    <p class="source-x-title">Type of tree</p>
                </div>
            </div>
            <p>Axis tick marks: 0–100 by tens. Use the scaled bars to derive exact addition and subtraction relationships.</p>
            <div class="two">
                <div><label for="pine-fir">How many MORE Pine than Fir?</label><input id="pine-fir" name="PineFir" value="@Model.Answers.PineFir" inputmode="numeric" required /></div>
                <div><label for="pine-two">How many MORE Pine than Oak OR Maple together?</label><input id="pine-two" name="PineOakMaple" value="@Model.Answers.PineOakMaple" inputmode="numeric" required /></div>
                <div><label for="pine-oak">How many FEWER Oak than Pine?</label><input id="pine-oak" name="PineOak" value="@Model.Answers.PineOak" inputmode="numeric" required /></div>
                <div><label for="fir-two">How many FEWER Oak OR Maple combined than Fir?</label><input id="fir-two" name="FirOakMaple" value="@Model.Answers.FirOakMaple" inputmode="numeric" required /></div>
            </div>
            <label for="tree-work">Show two ways to solve a two-step problem using tens and ones</label>
            <textarea id="tree-work" name="TreeWork" rows="4" maxlength="2000">@Model.Answers.TreeWork</textarea>
        </section>
        <section class="panel">
            <h2>4. Lesson synthesis (10 minutes) — before Cool-down</h2>
            <p>Compare two-step strategies with tens/ones and the Three Reads routine. How did counting by tens, adding two groups, or subtracting one group at a time help with the exact school feeling and tree data?</p>
            <label for="summary">What helps you read and solve scaled-bar problems, and how can you use Three Reads by yourself?</label>
            <textarea id="summary" name="LessonSynthesis" rows="3" maxlength="2000">@Model.Answers.LessonSynthesis</textarea>
            <p>Section summary: scaled picture and bar graphs can show categorical data; they support answerable questions about more and fewer, including a comparison with TWO other categories combined. Teacher-led optional centers: Sort and Display Stage 3 and Five in a Row Stage 6.</p>
        </section>
        <section class="panel">
            <h2>5. ORIGINAL 2021 source Cool-down: Reading Time (5 minutes)</h2>
            <p>The original graph shows Favorite Time to Read, with a vertical 0–50 by-five scale and categories Morning, Lunchtime, Afternoon, Evenings. Approximate visual heights: Morning about 11–12, Lunchtime 25, Afternoon 23, Evenings 44. The original public teacher guide's worked examples use slightly different visual readings for Morning. Answer sensibly from the graph, justify both problems, and have a teacher review; NO automatic exact pass.</p>
            <div class="source-vertical-frame">
                <div class="source-vertical-chart" style="--source-columns:4" role="img" aria-label="Favorite Time to Read, 0 to 50 in fives; approximate bars Morning 12, Lunchtime 25, Afternoon 23, Evenings 44. Original image is not copied.">
                    <div class="source-y-ticks" aria-hidden="true">@for(var tick=50;tick>=0;tick-=5){<span>@tick</span>}</div>
                    <div class="source-v-bars" aria-hidden="true">
                        @foreach(var item in sourceReading){<div class="source-v-column"><div class="source-v-bar" style="height:@(item.Value*300/50)px"></div></div>}
                    </div>
                    <div class="source-v-labels" aria-hidden="true">@foreach(var item in sourceReading){<span class="source-v-label">@item.Category</span>}</div>
                    <p class="source-x-title">Time of day</p>
                </div>
            </div>
            <div class="two">
                <div><label for="read-a">1. About how many FEWER chose Morning than Afternoon?</label><input id="read-a" name="CoolMorningAfternoon" value="@Model.Answers.CoolMorningAfternoon" inputmode="numeric" required /></div>
                <div><label for="read-b">2. About how many MORE chose Evening than Morning OR Lunchtime combined?</label><input id="read-b" name="CoolEveningMinusMorningLunch" value="@Model.Answers.CoolEveningMinusMorningLunch" inputmode="numeric" required /></div>
            </div>
            <label for="read-equations">Write an expression or equation for EACH question; explain your visual estimate</label>
            <textarea id="read-equations" name="CoolSourceEquations" rows="3" maxlength="2000" required>@Model.Answers.CoolSourceEquations</textarea>
            <p>Source teacher model responses are approximately 12 fewer Morning and 7 more Evening, but the plot is not numbered to single units. Do not reject another reasonable visual estimate automatically.</p>
        </section>
        <section class="panel">
            <h2>6. Teacher review and next-day correction</h2>
            <p>Teacher checks two mathematically distinct strategies for the original New School Year activity and the four tree questions, followed by source Cool-down answers. In the next lesson, pupils may revisit and correct the written assessment with a small group.</p>
        </section>
        <section class="panel">
            <h2>7. Optional original Edulytics extra arithmetic — NOT source Cool-down</h2>
            <p>A fictional school book-interest survey. These are NOT the publisher's original teacher-only assessment numbers.</p>
            @foreach(var item in cooldown){
                <div class="bar-row"><strong>@item.Category</strong>
                    <span class="bar" style="width:@(item.Value*100/70)%" aria-hidden="true"></span>
                    <span>@item.Value</span>
                </div>
            }
            <p>Vertical scale for a drawing: 0–70 by 10. Draw a separate bar graph with precise heights.</p>
            <div class="two">
                <div><label for="cd-first">How many MORE prefer Adventure than Science?</label><input id="cd-first" name="CoolAdventureScience" value="@Model.Answers.CoolAdventureScience" inputmode="numeric" required /></div>
                <div><label for="cd-two">How many MORE Adventure than Science OR Comics combined?</label><input id="cd-two" name="CoolAdventureVsTwo" value="@Model.Answers.CoolAdventureVsTwo" inputmode="numeric" required /></div>
                <div><label for="cd-total">Total preferences recorded?</label><input id="cd-total" name="CoolTotal" value="@Model.Answers.CoolTotal" inputmode="numeric" required /></div>
            </div>
            <label for="cool-explain">Draw a new scaled graph and explain two different correct methods for the second question</label>
            <textarea id="cool-explain" name="CoolExplanation" rows="4" maxlength="2000">@Model.Answers.CoolExplanation</textarea>
        </section>
        <button type="submit">Check arithmetic only</button>
    </form>
    @if(Model.Submitted){
        <section class="panel" aria-live="polite">
            <h2>Answer feedback</h2>
            @foreach(var f in Model.Feedback){
                <div class="@(f.NumericCorrect==true?"ok":f.NumericCorrect==false?"no":"review")">
                    <h3>@f.Label</h3>
                    <p>@(f.NumericCorrect==true?"Correct number.":f.NumericCorrect==false?"Recheck the arithmetic.":"Teacher review required.") @f.Explanation</p>
                </div>
            }
            <p>This form does not certify oral reasoning, two solution methods, classroom participation or official assessment.</p>
        </section>
    }
    <p>Source alignment: <a href="https://im.kendallhunt.com/k5/teachers/grade-3/unit-1/lesson-8/lesson.html" rel="noopener noreferrer">Illustrative Mathematics Grade 3 Unit 1 Lesson 8 (2021)</a> locally archived; original graphics not reproduced and independent first-party Cool-down.</p>
</main>
