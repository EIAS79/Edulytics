@model Edulytics.Web.ViewModels.LessonContent.Grade3Lesson3PracticePage
@using Edulytics.Core.Mathematics.Curriculum
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Grade 3 · Scaled Picture Graphs";
    var sportsUnscaled = UsCcssG3Unit1Lesson3ScaledPictureGraph.SportsUnscaled;
    var sports = UsCcssG3Unit1Lesson3ScaledPictureGraph.Sports;
    var books = UsCcssG3Unit1Lesson3ScaledPictureGraph.Books;
    var flowers = UsCcssG3Unit1Lesson3ScaledPictureGraph.Flowers;
    var cool = UsCcssG3Unit1Lesson3ScaledPictureGraph.IndependentCoolDown;
}
<style>
.g3-scale{max-width:920px;margin:0 auto;padding:20px;color:#17344e}
.g3-scale .panel{border:1px solid #d7e4ef;border-radius:15px;background:#fff;padding:23px;margin:17px 0}
.g3-scale .rows{display:grid;grid-template-columns:140px 1fr;gap:12px;align-items:center}
.g3-scale .dots{font-size:1.35rem;letter-spacing:.3rem}
.g3-scale label{display:block;margin:14px 0 5px;font-weight:700}
.g3-scale input,.g3-scale textarea{padding:10px;width:100%;max-width:650px;border:1px solid #69829a;border-radius:8px;font:inherit}
.g3-scale input:focus,.g3-scale textarea:focus{outline:3px solid #b3ddec}
.g3-scale .number-questions{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px}
.g3-scale .button{background:#077c8e;color:white;border:0;border-radius:8px;padding:13px 20px;cursor:pointer;font:inherit;font-weight:700}
.g3-scale .ok{border-left:4px solid #197452;padding-left:10px}.g3-scale .no{border-left:4px solid #b32f43;padding-left:10px}
.g3-scale .review{border-left:4px solid #a57517;padding-left:10px}
</style>
<main class="g3-scale">
    <a asp-controller="StudentPortal" asp-action="Lesson" asp-route-id="@Model.LessonId">← Back to lesson</a>
    <header>
        <p>EDULYTICS · NEW ORIGINAL TASKS</p>
        <h1>Read and ask questions about scaled picture graphs</h1>
        <p>One symbol can represent more than one person or object. Always use the displayed key. The classroom charts use the actual quantities from the locally archived 2021 lesson, with original Edulytics glyphs rather than copied artwork. The separate Cool-down below is newly authored by Edulytics.</p>
    </header>
    <form asp-controller="Grade3Lesson3Activities" asp-action="Submit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="curriculumAdoptionId" value="@Model.AdoptionId" />
        <input type="hidden" name="lessonId" value="@Model.LessonId" />
        <section class="panel">
            <h2>1. Mental maths and partner discussion</h2>
            <p>Work mentally: 50 + 10, 50 + 12, 60 + 13, 65 + 13. What strategy helps you combine tens and ones? Why is 65 + 13 = 78?</p>
            <label for="warmup">My strategy</label>
            <textarea name="Warmup" id="warmup" rows="3" maxlength="2000">@Model.Answers.Warmup</textarea>
        </section>
        <section class="panel">
            <h2>2. Two source-aligned sports graphs, identical data</h2>
            <p>Key 1: ● = one student. Count each mark once. This graph intentionally uses 65 symbols; grouping them by 5 or 10 is a strategy to make counting faster.</p>
            <div class="rows">
            @foreach(var item in sportsUnscaled.Rows) {
                <strong>@item.Category</strong>
                <span class="dots" aria-label="@item.Symbols learners choosing @item.Category">@(string.Concat(Enumerable.Repeat("● ", item.Symbols)))</span>
            }
            </div>
            <h3>Same 65 responses, but each symbol now represents five students</h3>
            <p><strong>@sports.Title</strong> — key: ● = @sports.StudentsPerSymbol students.</p>
            <div class="rows">
            @foreach(var item in sports.Rows){
                <strong>@item.Category</strong>
                <span class="dots" aria-label="@item.Symbols symbols for @item.Category; each is worth @sports.StudentsPerSymbol students">@(string.Concat(Enumerable.Repeat("● ", item.Symbols)))</span>
            }
            </div>
            <p>Example: three soccer symbols mean 3 × 5 = 15 students. This second pictograph requires just 13 marks instead of 65, but both represent the SAME number of students. Counting only the symbols would give the wrong answer.</p>
            <div class="number-questions">
                <div><label for="sport-total">How many students in total?</label><input id="sport-total" name="SportsTotal" value="@Model.Answers.SportsTotal" inputmode="numeric" required /></div>
                <div><label for="basketball">How many chose basketball?</label><input id="basketball" name="SportsBasketball" value="@Model.Answers.SportsBasketball" inputmode="numeric" required /></div>
                <div><label for="sport-compare">How many more chose basketball than tennis?</label><input id="sport-compare" name="SportsCompare" value="@Model.Answers.SportsCompare" inputmode="numeric" required /></div>
            </div>
        </section>
        <section class="panel">
            <h2>3. Source-aligned flower graph: scale five</h2>
            <p><strong>@flowers.Title</strong> — key: ● = @flowers.StudentsPerSymbol flowers.</p>
            <div class="rows">
            @foreach(var item in flowers.Rows){
                <strong>@item.Category</strong><span class="dots" aria-label="@item.Symbols symbols for @item.Category; each worth @flowers.StudentsPerSymbol flowers">@(string.Concat(Enumerable.Repeat("● ", item.Symbols)))</span>
            }
            </div>
            <div class="number-questions">
                <div><label for="roses">How many roses?</label><input id="roses" name="FlowersRoses" value="@Model.Answers.FlowersRoses" inputmode="numeric" required /></div>
                <div><label for="tulips">How many tulips?</label><input id="tulips" name="FlowersTulips" value="@Model.Answers.FlowersTulips" inputmode="numeric" required /></div>
                <div><label for="daisies">How many daisies?</label><input id="daisies" name="FlowersDaisies" value="@Model.Answers.FlowersDaisies" inputmode="numeric" required /></div>
                <div><label for="flower-total">How many flowers in all?</label><input id="flower-total" name="FlowersTotal" value="@Model.Answers.FlowersTotal" inputmode="numeric" required /></div>
                <div><label for="flower-compare">How many more daisies than tulips?</label><input id="flower-compare" name="FlowersCompare" value="@Model.Answers.FlowersCompare" inputmode="numeric" required /></div>
            </div>
            <label for="violets">How many violets did Andre see?</label>
            <input id="violets" name="FlowersViolets" value="@Model.Answers.FlowersViolets" inputmode="numeric" required />
            <label for="key-explain">Explain the differences between keys 1 and 5 in the two sports graphs</label>
            <textarea name="DifferenceInKeys" id="key-explain" rows="3" maxlength="2000">@Model.Answers.DifferenceInKeys</textarea>
            <label for="original-question">Write two questions answerable from Andre's flower graph</label>
            <textarea name="OriginalQuestion" id="original-question" rows="3" maxlength="2000">@Model.Answers.OriginalQuestion</textarea>
        </section>
        <section class="panel">
            <h2>4. Source-aligned Favorite Type of Books graph: key two</h2>
            <p><strong>@books.Title</strong> — key: ● = @books.StudentsPerSymbol students.</p>
            <div class="rows">
            @foreach (var item in books.Rows) {
                <strong>@item.Category</strong>
                <span class="dots" aria-label="@item.Symbols symbols; each represents @books.StudentsPerSymbol students">@(string.Concat(Enumerable.Repeat("● ", item.Symbols)))</span>
            }
            </div>
            <div class="number-questions">
                <div><label for="joke-books">How many students chose joke books?</label><input id="joke-books" name="BooksJokes" value="@Model.Answers.BooksJokes" inputmode="numeric" required /></div>
                <div><label for="comics">How many students chose comic books?</label><input id="comics" name="BooksComics" value="@Model.Answers.BooksComics" inputmode="numeric" required /></div>
                <div><label for="science-books">How many chose science books?</label><input id="science-books" name="BooksScience" value="@Model.Answers.BooksScience" inputmode="numeric" required /></div>
                <div><label for="mystery-books">How many chose mystery books?</label><input id="mystery-books" name="BooksMystery" value="@Model.Answers.BooksMystery" inputmode="numeric" required /></div>
                <div><label for="books-total">How many students chose one of these books?</label><input id="books-total" name="BooksTotal" value="@Model.Answers.BooksTotal" inputmode="numeric" required /></div>
            </div>
            <label for="book-reasoning">How do you know the number of students for each type of book? Explain how the two-students-per-symbol key supports your answers.</label>
            <textarea id="book-reasoning" name="BooksHowYouKnow" rows="3" maxlength="2000">@Model.Answers.BooksHowYouKnow</textarea>
            <p>Reasoning about the graph is reviewed by your teacher, not automatically passed when a number is correct.</p>
            <label for="book-questions">Write two questions answerable from the favorite books graph</label>
            <textarea id="book-questions" name="SecondOriginalQuestion" rows="3" maxlength="2000">@Model.Answers.SecondOriginalQuestion</textarea>
        </section>
        <section class="panel">
            <h2>5. Lesson synthesis (10 minutes) — before the Cool-down</h2>
            <p>Compare the two Favorite Sports graphs: each shows 65 student responses, but the unit-key picture graph uses 65 symbols while the five-students-per-symbol graph uses just 13. Explain how the key changes the counting strategy and why a scaled picture graph can save space.</p>
            <p>Teacher questions: What makes a question answerable from the graph? How can you use counting by 2 or by 5 to justify the flower and book totals? Ask a partner to respond to one question you wrote; the teacher checks the explanation.</p>
            <p>Teacher rubric: use keys 1, 2 and 5 correctly; both sports graphs total 65; flowers 10/5/25/15; book genres 8/2/8/6; write two different answerable questions for EACH flower and book graph, and explain how the book-key multiplication gives each value. Oral reasoning is not auto-graded.</p>
        </section>
        <section class="panel">
            <h2>6. Independent Edulytics Cool-down (5 minutes)</h2>
            <p>This independent fictional library survey is NOT the publisher's educator-only Birds in the Park task.</p>
            <p><strong>@cool.Title</strong> — key: ● = @cool.StudentsPerSymbol learners.</p>
            <div class="rows">
            @foreach(var item in cool.Rows){
                <strong>@item.Category</strong><span class="dots" aria-label="@item.Symbols symbols for @item.Category, each represents @cool.StudentsPerSymbol students">@(string.Concat(Enumerable.Repeat("● ", item.Symbols)))</span>
            }
            </div>
            <div class="number-questions">
                <div><label for="cool-nature">How many chose Nature?</label><input name="CoolNature" id="cool-nature" value="@Model.Answers.CoolNature" inputmode="numeric" required /></div>
                <div><label for="cool-difference">How many more chose Nature than Mystery?</label><input name="CoolDifference" id="cool-difference" value="@Model.Answers.CoolDifference" inputmode="numeric" required /></div>
            </div>
            <label for="cool-explain">Invent another valid question from this graph and explain its answer</label>
            <textarea name="CoolExplanation" id="cool-explain" rows="3" maxlength="2000">@Model.Answers.CoolExplanation</textarea>
        </section>
        <section class="panel">
            <h2>7. Math Community — individual reflection after the Cool-down</h2>
            <p>Which “Doing Math” action was most important in your work today, and why? The teacher reviews your response after class. This follows the 2021 teacher source's sequence and does not mean that a live observation has been recorded.</p>
            <label for="community">My most important Doing Math action and reason</label>
            <textarea name="MathCommunity" id="community" rows="3" maxlength="2000">@Model.Answers.MathCommunity</textarea>
            <p>Optional teacher-directed centers remain Sort and Display Stage 2 and Capture Squares Stage 3. Neither center is automatically certified through numeric responses.</p>
        </section>
        <button class="button" type="submit">Check the numerical graph questions</button>
    </form>
    @if(Model.Submitted){
        <section class="panel" aria-live="polite">
            <h2>Learning feedback</h2>
            @foreach(var item in Model.Feedback){
                <div class="@(item.MachineCorrect == true?"ok":item.MachineCorrect == false?"no":"review")">
                    <strong>@item.Name</strong>
                    <p>@(item.MachineCorrect == true?"Mathematically correct.":item.MachineCorrect == false?"Recheck the calculation.":"Teacher review required.") @item.Message</p>
                </div>
            }
            <p>These responses are not an official school grade or proof of classroom participation.</p>
        </section>
    }
    <p>Academic reference: <a href="https://im.kendallhunt.com/k5/teachers/grade-3/unit-1/lesson-3/preparation.html" rel="noopener noreferrer">Illustrative Mathematics Grade 3 Unit 1 Lesson 3, first edition (2021)</a>, <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener noreferrer">CC BY 4.0</a>. No original publisher graphics or protected Cool-down were copied.</p>
</main>
