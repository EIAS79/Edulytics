@model Edulytics.Web.ViewModels.Platform.TemporaryPracticePreviewViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>@Model.Title - Edulytics Practice</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/counting-grove-v1.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/counting-grove-student-ui.css" asp-append-version="true" />
</head>
<body class="cg-preview-page">
    <main class="cg-preview-wrap">
        <header class="cg-preview-head">
            <div>
                <p class="cg-preview-kicker">Edulytics Practice</p>
                <h1>@Model.Title</h1>
                <p>@Model.UnitTitle</p>
            </div>
        </header>

        <section class="cg-preview-card" aria-label="Practice game">
            <div id="count-touch-game"
                 data-count-touch-game
                 data-lesson-code="@Model.LessonCode"
                 data-lesson-language="en"></div>
        </section>
    </main>

    <script src="~/js/count-touch-preview.js" asp-append-version="true"></script>
</body>
</html>
