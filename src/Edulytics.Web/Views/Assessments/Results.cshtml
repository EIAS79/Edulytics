@using System.Globalization
@model Edulytics.Web.ViewModels.Assessments.AssessmentResultsViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.AssessmentResource> A
@{
    ViewData["Title"] = A["Results"];
    var assessment = Model.Workspace.Assessment;
    var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var questionLabel = language switch { "pl" => "Pytanie", "ar" => "السؤال", _ => "Question" };
    var studentAnswerLabel = language switch { "pl" => "Odpowiedź ucznia", "ar" => "إجابة الطالب", _ => "Student answer" };
    var expectedAnswerLabel = language switch { "pl" => "Poprawna / oczekiwana odpowiedź", "ar" => "الإجابة الصحيحة / المتوقwana", _ => "Correct / expected answer" };
    var scoreLabel = language switch { "pl" => "Punkty", "ar" => "الدرجة", _ => "Score" };
    var statusLabel = language switch { "pl" => "Status", "ar" => "الحالة", _ => "Status" };
    var actionLabel = language switch { "pl" => "Akcja", "ar" => "الإجراء", _ => "Action" };
    var resultLabel = language switch { "pl" => "Wynik", "ar" => "النتيجة", _ => "Result" };
    var studentLabel = language switch { "pl" => "Uczeń", "ar" => "الطالب", _ => "Student" };
    var submittedLabel = language switch { "pl" => "Przesłano", "ar" => "تم التسليم", _ => "Submitted" };
    var noSubmissionLabel = language switch { "pl" => "Brak wyniku", "ar" => "لا توجد نتيجة بعد", _ => "No result yet" };
    var viewPaperLabel = language switch { "pl" => "Zobacz arkusz", "ar" => "عرض ورقة الامتحان", _ => "View paper" };
    var backToListLabel = language switch { "pl" => "Powrót do listy uczniów", "ar" => "العودة إلى قائمة الطلاب", _ => "Back to student list" };
    var paperTitleLabel = language switch { "pl" => "Arkusz ucznia", "ar" => "ورقة امتحان الطالب", _ => "Student paper" };
    var noResponseLabel = language switch { "pl" => "Brak zapisanej odpowiedzi", "ar" => "لا توجد إجابة مسجلة", _ => "No submitted answer recorded" };
    var blankResponseLabel = language switch { "pl" => "Brak odpowiedzi", "ar" => "لم تتم الإجابة", _ => "No answer submitted" };
    var noExpectedLabel = language switch { "pl" => "Brak zapisanej odpowiedzi wzorcowej", "ar" => "لا توجد إجابة نموذجية مسجلة", _ => "No expected answer recorded" };

    var selectedStudentId = Guid.TryParse(Context.Request.Query["studentProfileId"], out var parsedStudentId)
        ? parsedStudentId
        : (Guid?)null;
    var selectedStudent = selectedStudentId.HasValue
        ? Model.Workspace.Students.FirstOrDefault(student => student.StudentProfileId == selectedStudentId.Value)
        : null;
}

<section class="assessment-page assessment-results-page">
    <header class="assessment-header">
        <div>
            <h1>@A["Results"] — @assessment.Title</h1>
            <p>@A["Status"]: @A[Model.StatusKey] · @A["MaxScore"]: @assessment.MaxScore.ToString("0.##")</p>
        </div>
        <a class="school-button" asp-action="Details" asp-route-id="@assessment.Id">@A["Details"]</a>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="school-alert school-alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="school-alert school-alert-error" role="alert">@error</div>
    }

    @if (Model.Workspace.Students.Count == 0)
    {
        <div class="assessment-empty">@A["NoStudents"]</div>
    }
    else
    {
        <section class="assessment-results-roster-shell">
            <div class="assessment-results-roster-scroll">
                <table class="assessment-results-roster" data-student-filter-ready="true">
                    <thead>
                        <tr>
                            <th scope="col">@studentLabel</th>
                            <th scope="col">@statusLabel</th>
                            <th scope="col">@scoreLabel</th>
                            <th scope="col">@resultLabel</th>
                            <th scope="col" class="assessment-roster-action-column">@actionLabel</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Workspace.Students)
                        {
                            <tr class="assessment-result-roster-row"
                                data-student-id="@student.StudentProfileId"
                                data-has-result="@(student.ResultId.HasValue ? "true" : "false")">
                                <td>
                                    <a class="assessment-student-link"
                                       asp-action="Results"
                                       asp-route-id="@assessment.Id"
                                       asp-route-studentProfileId="@student.StudentProfileId">
                                        @student.DisplayName
                                    </a>
                                    <span class="assessment-student-number">@A["StudentNumber"]: @student.StudentNumber</span>
                                </td>
                                <td>
                                    <span class="assessment-roster-status @(student.ResultId.HasValue ? "is-submitted" : "is-missing")">
                                        @(student.ResultId.HasValue ? submittedLabel : noSubmissionLabel)
                                    </span>
                                </td>
                                <td>
                                    @if (student.ResultId.HasValue)
                                    {
                                        <strong>@student.Score.ToString("0.##") / @assessment.MaxScore.ToString("0.##")</strong>
                                    }
                                    else
                                    {
                                        <span class="assessment-roster-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (student.ResultId.HasValue)
                                    {
                                        <strong>@student.Percentage.ToString("0.##")%</strong>
                                    }
                                    else
                                    {
                                        <span class="assessment-roster-muted">—</span>
                                    }
                                </td>
                                <td class="assessment-roster-action-column">
                                    @if (student.ResultId.HasValue)
                                    {
                                        <a class="school-button school-button-primary assessment-view-paper-button"
                                           asp-action="Results"
                                           asp-route-id="@assessment.Id"
                                           asp-route-studentProfileId="@student.StudentProfileId">
                                            @viewPaperLabel
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (selectedStudent is not null)
    {
        <section class="assessment-selected-paper" id="student-paper">
            <header class="assessment-result-student-header">
                <div>
                    <span class="assessment-paper-kicker">@paperTitleLabel</span>
                    <h2>@selectedStudent.DisplayName</h2>
                    <p>@A["StudentNumber"]: @selectedStudent.StudentNumber</p>
                </div>
                <div class="assessment-paper-header-actions">
                    @if (selectedStudent.ResultId.HasValue)
                    {
                        <div class="assessment-result-total assessment-result-total-v2">
                            <span class="assessment-result-total-label">@scoreLabel</span>
                            <strong>@selectedStudent.Score.ToString("0.##") / @assessment.MaxScore.ToString("0.##")</strong>
                            <span>@selectedStudent.Percentage.ToString("0.##")%</span>
                        </div>
                    }
                    <a class="school-button" asp-action="Results" asp-route-id="@assessment.Id">@backToListLabel</a>
                </div>
            </header>

            @if (!selectedStudent.ResultId.HasValue)
            {
                <div class="assessment-empty">@noSubmissionLabel</div>
            }
            else
            {
                <div class="assessment-breakdown-scroll">
                    <table class="assessment-breakdown-table">
                        <thead>
                            <tr>
                                <th scope="col">@questionLabel</th>
                                <th scope="col">@studentAnswerLabel</th>
                                <th scope="col">@expectedAnswerLabel</th>
                                <th scope="col" class="assessment-score-column">@scoreLabel</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var question in Model.Workspace.Questions)
                            {
                                var hasScore = selectedStudent.QuestionScores.TryGetValue(question.Id, out var current);
                                var hasResponse = selectedStudent.QuestionResponses.TryGetValue(question.Id, out var response);
                                var hasExpected = !string.IsNullOrWhiteSpace(question.CorrectAnswer);
                                var scoreClass = hasScore && current >= question.MaxScore ? "is-full" : hasScore && current > 0m ? "is-partial" : "is-zero";
                                <tr>
                                    <td class="assessment-question-cell">
                                        <span class="assessment-question-number">@question.Order</span>
                                        <span>@question.Prompt</span>
                                    </td>
                                    <td>
                                        @if (hasResponse)
                                        {
                                            <span class="assessment-answer-value @(string.IsNullOrWhiteSpace(response) ? "is-empty" : null)">@(string.IsNullOrWhiteSpace(response) ? blankResponseLabel : response)</span>
                                        }
                                        else
                                        {
                                            <span class="assessment-answer-muted">@noResponseLabel</span>
                                        }
                                    </td>
                                    <td>
                                        @if (hasExpected)
                                        {
                                            <span class="assessment-answer-value is-expected">@question.CorrectAnswer</span>
                                        }
                                        else
                                        {
                                            <span class="assessment-answer-muted">@noExpectedLabel</span>
                                        }
                                    </td>
                                    <td class="assessment-score-cell">
                                        @if (hasScore)
                                        {
                                            <span class="assessment-score-badge @scoreClass">@current.ToString("0.##") / @question.MaxScore.ToString("0.##")</span>
                                        }
                                        else
                                        {
                                            <span class="assessment-score-badge is-missing">— / @question.MaxScore.ToString("0.##")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</section>

<style>
    .assessment-results-roster-shell,
    .assessment-selected-paper {
        margin-top: 1.25rem;
        overflow: hidden;
        border: 1px solid #dbe4ef;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 12px 32px rgba(31, 55, 92, 0.07);
    }

    .assessment-results-roster-scroll,
    .assessment-breakdown-scroll { width: 100%; overflow-x: auto; }

    .assessment-results-roster {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
    }

    .assessment-results-roster th {
        padding: .82rem 1rem;
        border-bottom: 1px solid #dce4ef;
        background: #f3f6fb;
        color: #52627a;
        font-size: .76rem;
        font-weight: 900;
        letter-spacing: .04em;
        text-align: left;
        text-transform: uppercase;
    }

    .assessment-results-roster td {
        padding: 1rem;
        border-bottom: 1px solid #edf1f6;
        color: #17233d;
        vertical-align: middle;
    }

    .assessment-results-roster tbody tr:last-child td { border-bottom: 0; }
    .assessment-results-roster tbody tr:hover { background: #fbfdff; }
    .assessment-student-link { display: inline-block; color: #153b7c; font-size: 1rem; font-weight: 900; text-decoration: none; }
    .assessment-student-link:hover, .assessment-student-link:focus-visible { color: #2f66e8; text-decoration: underline; }
    .assessment-student-number { display: block; margin-top: .22rem; color: #7b8798; font-size: .82rem; }
    .assessment-roster-status { display: inline-flex; padding: .35rem .62rem; border-radius: 999px; font-size: .82rem; font-weight: 850; }
    .assessment-roster-status.is-submitted { background: #eaf8ef; color: #17643a; }
    .assessment-roster-status.is-missing { background: #eef2f7; color: #617089; }
    .assessment-roster-muted { color: #8a96a7; }
    .assessment-roster-action-column { text-align: right !important; }
    .assessment-view-paper-button { min-width: 7.5rem; padding: .5rem .75rem; }

    .assessment-selected-paper { scroll-margin-top: 1rem; }
    .assessment-result-student-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.15rem 1.25rem; border-bottom: 1px solid #e8edf5; background: linear-gradient(180deg,#fff 0%,#f8faff 100%); }
    .assessment-result-student-header h2 { margin: .15rem 0 0; font-size: 1.35rem; }
    .assessment-result-student-header p { margin: .25rem 0 0; color: #617089; }
    .assessment-paper-kicker { color: #315fcb; font-size: .76rem; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; }
    .assessment-paper-header-actions { display: flex; align-items: center; gap: 1rem; }
    .assessment-result-total-v2 { min-width: 8.5rem; text-align: right; }
    .assessment-result-total-label { display: block; margin-bottom: .15rem; color: #68778c; font-size: .76rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
    .assessment-result-total-v2 strong { display: block; color: #14213d; font-size: 1.15rem; }
    .assessment-result-total-v2 > span:last-child { display: block; margin-top: .12rem; color: #466178; font-weight: 800; }

    .assessment-breakdown-table { width: 100%; min-width: 900px; margin: 0; border-collapse: collapse; table-layout: fixed; }
    .assessment-breakdown-table th { padding: .75rem .9rem; border-bottom: 1px solid #dce4ef; background: #f3f6fb; color: #52627a; font-size: .76rem; font-weight: 900; letter-spacing: .04em; text-align: left; text-transform: uppercase; }
    .assessment-breakdown-table th:first-child { width: 38%; }
    .assessment-breakdown-table th:nth-child(2) { width: 21%; }
    .assessment-breakdown-table th:nth-child(3) { width: 25%; }
    .assessment-breakdown-table th:last-child { width: 16%; }
    .assessment-breakdown-table td { padding: .9rem; border-bottom: 1px solid #edf1f6; color: #17233d; vertical-align: top; overflow-wrap: anywhere; }
    .assessment-breakdown-table tbody tr:last-child td { border-bottom: 0; }
    .assessment-question-cell { display: flex; align-items: flex-start; gap: .65rem; line-height: 1.45; }
    .assessment-question-number { display: inline-grid; place-items: center; flex: 0 0 1.75rem; min-width: 1.75rem; height: 1.75rem; border-radius: .5rem; background: #eef3ff; color: #315fcb; font-size: .85rem; font-weight: 900; }
    .assessment-answer-value { display: inline-block; padding: .38rem .55rem; border-radius: .5rem; background: #f4f7fb; color: #1f2d45; font-weight: 750; white-space: pre-wrap; }
    .assessment-answer-value.is-expected { background: #eef9f2; color: #17643a; }
    .assessment-answer-value.is-empty, .assessment-answer-muted { color: #7a8799; font-style: italic; font-weight: 600; }
    .assessment-score-column, .assessment-score-cell { text-align: right !important; }
    .assessment-score-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 5.5rem; padding: .4rem .6rem; border-radius: .55rem; font-weight: 900; white-space: nowrap; }
    .assessment-score-badge.is-full { background: #eaf8ef; color: #17643a; }
    .assessment-score-badge.is-partial { background: #fff7df; color: #7b5a00; }
    .assessment-score-badge.is-zero { background: #fff0ef; color: #a03b34; }
    .assessment-score-badge.is-missing { background: #f1f3f6; color: #7b8798; }

    @@media (max-width: 720px) {
        .assessment-result-student-header, .assessment-paper-header-actions { align-items: stretch; flex-direction: column; }
        .assessment-result-total-v2 { text-align: left; }
        .assessment-breakdown-table { min-width: 760px; }
    }
</style>