@model Edulytics.Web.Controllers.G5L02RubricTeacherPage
@{ ViewData["Title"] = "Grade 5 U03:L02 — Teacher scoring"; }
<h1>Grade 5 U03:L02 — Teacher scoring</h1>
<p>Student submission: @Model.Submission.SubmittedAtUtc.ToString("u")</p>
<pre style="white-space:pre-wrap">@Model.Submission.ResponseText</pre>
@if (Model.Submission.TeacherScore is int score)
{
    <p>Reviewed by an authorized teacher: @score / 6</p>
    <p>Feedback: @Model.Submission.TeacherFeedback</p>
}
else
{
    <p>Review each criterion against the student's reasoning and construction. Numeric-only answers must not receive drawing/justification points automatically.</p>
    <form method="post" action="/school/g5/u03/l02/rubric/@Model.Submission.Id">
        @Html.AntiForgeryToken()
        @for (var i = 0; i < Model.Criteria.Length; i++)
        {
            <div>
                <label for="criterion-@i">@(i + 1). @Model.Criteria[i]</label>
                <select id="criterion-@i" name="marks" required>
                    <option value="">Choose</option>
                    <option value="0">0 — Not met</option>
                    <option value="1">1 — Met</option>
                </select>
            </div>
        }
        <label for="teacherFeedback">Teacher feedback (10–2000 characters)</label>
        <textarea id="teacherFeedback" name="teacherFeedback" required minlength="10" maxlength="2000" rows="5"></textarea>
        <button type="submit">Save teacher score</button>
    </form>
}
<a href="/school/g5/u03/l02/rubric">Back to review queue</a>
