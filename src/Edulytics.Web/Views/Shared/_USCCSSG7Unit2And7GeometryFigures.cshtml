@model Edulytics.Core.Curriculum.RichLessonContentV2Lesson
@{
    // Grade 7-only opt-in content. This partial is intentionally not called
    // from the shared Rich V2 renderer: Supervisor 1 controls that integration
    // under issue #592 and draft PR #599's single-writer boundary.
    var figure = Model.LessonCode switch
    {
        "PED:US-CCSS-MATH:G7:U02:L01" =>
            "/curriculum/us-ccss-g7/geometry/u02-l01-scaled-crescents.svg",
        "PED:US-CCSS-MATH:G7:U07:L01" =>
            "/curriculum/us-ccss-g7/geometry/u07-l01-hexagon-angles-and-protractor.svg",
        "PED:US-CCSS-MATH:G7:U07:L02" =>
            "/curriculum/us-ccss-g7/geometry/u07-l02-adjacent-right-and-straight-angles.svg",
        "PED:US-CCSS-MATH:G7:U07:L03" =>
            "/curriculum/us-ccss-g7/geometry/u07-l03-nonadjacent-vertical-and-complementary-angles.svg",
        "PED:US-CCSS-MATH:G7:U07:L04" =>
            "/curriculum/us-ccss-g7/geometry/u07-l04-multi-step-angle-equations.svg",
        "PED:US-CCSS-MATH:G7:U07:L05" =>
            "/curriculum/us-ccss-g7/geometry/u07-l05-equation-choice-underdetermined-and-equal-parts.svg",
        _ => null
    };
    var description = Model.LessonCode switch
    {
        "PED:US-CCSS-MATH:G7:U02:L01" =>
            "Three original crescent outlines using the same curve: A has width W and height H, B has width 1.5W and height 1.5H, and C has width 1.5W but height H. B is a true copy of A; C is stretched in only one direction.",
        "PED:US-CCSS-MATH:G7:U07:L01" =>
            "Three regular hexagon corners of 120 degrees each meet at one vertex to make 360 degrees. The right-hand protractor example measures 40 degrees counterclockwise from its zero ray, not 140 degrees.",
        "PED:US-CCSS-MATH:G7:U07:L02" =>
            "Two distinct angle constructions: 35 plus 55 degrees makes a 90-degree right angle; 125 plus 55 degrees makes a 180-degree straight angle. The parts are adjacent and have no overlapping interiors.",
        "PED:US-CCSS-MATH:G7:U07:L03" =>
            "Two intersecting straight lines form equal vertical-angle pairs of 55 and 55 degrees and 125 and 125 degrees, with adjacent angles summing to 180 degrees. At separate vertices, a 28-degree angle and a 62-degree angle sum to 90 degrees without being adjacent.",
        "PED:US-CCSS-MATH:G7:U07:L04" =>
            "Two original diagrams model unknown angles: a straight angle is partitioned into 40 degrees, x degrees and x degrees, giving 40+2x=180 and x=70. Two intersecting lines have opposite angles of 70 degrees and 3y+10 degrees, so 3y+10=70 and y=20.",
        "PED:US-CCSS-MATH:G7:U07:L05" =>
            "In the first original diagram a straight angle has sectors a, 90 degrees and b; a+b=90 does not fix a and b separately. In the second diagram three equal x+10 degree sectors and one 30 degree sector form 180 degrees; 3(x+10)+30=180 gives x=40. The illustrative first diagram must not be measured to invent a unique value.",
        _ => ""
    };
    var learnerTask = Model.LessonCode switch
    {
        "PED:US-CCSS-MATH:G7:U02:L01" =>
            "Draw and label at least two crescent copies. Compare one horizontal and one vertical corresponding dimension; explain why a horizontal stretch is not a scaled copy. Explain how the drawing compares with equivalent mixtures.",
        "PED:US-CCSS-MATH:G7:U07:L01" =>
            "Assemble three hexagon corners, justify a full turn, and independently draw a right-starting 40-degree angle using the correct protractor scale. Explain why the 140-degree reading is a different angle.",
        "PED:US-CCSS-MATH:G7:U07:L02" =>
            "Cut or draw two original rectangular angle constructions, label adjacent parts of 90-degree and 180-degree angles, and explain why their measures add. Check both with a real protractor.",
        "PED:US-CCSS-MATH:G7:U07:L03" =>
            "Using a straightedge and protractor, draw two intersecting lines and measure all four angles. Mark both equal vertical pairs, explain why adjacent angles sum to 180 degrees, compare the measurements with a partner, and independently construct separate 28-degree and 62-degree angles to demonstrate nonadjacent complementary angles.",
        "PED:US-CCSS-MATH:G7:U07:L04" =>
            "Draw and annotate your own straight and intersecting-line figures. Determine unknown angles with 40+x+x=180 and 3y+10=70, explain why straight angles and vertical angles justify each equation, and check x=70 and y=20 by substitution; review incorrect reasoning with your teacher.",
        "PED:US-CCSS-MATH:G7:U07:L05" =>
            "Determine whether a+90+b=180 gives enough information to find a and b individually. Provide two distinct valid pairs. Then draw and label three equal adjacent x+10 sectors and a final 30-degree sector on a straight angle; solve 3(x+10)+30=180, justify the parentheses, check x=40, and correct a wrong solution.",
        _ => ""
    };
}
@if (figure is not null)
{
    <section class="rich-lesson-section rich-lesson-section--g7-source-geometry"
             aria-label="Grade 7 original geometric construction reference">
        <h3>Geometric construction and explanation</h3>
        <figure>
            <img src="@figure"
                 asp-append-version="true"
                 alt="@description"
                 width="1000"
                 loading="lazy"
                 decoding="async"
                 style="display:block;max-width:100%;height:auto" />
            <figcaption>
                Original Edulytiks mathematical example, not a reproduction
                of an Illustrative Mathematics figure. Student constructions
                must be individually drawn or measured.
            </figcaption>
        </figure>
        <p><strong>Student task:</strong> @learnerTask</p>
        <p>
            <strong>Teacher-only assessment:</strong> Review the learner's
            actual construction, labeled corresponding geometry, mathematical
            reasoning and discussion. A numerical Practice answer or this
            reference figure cannot by itself pass the source task.
        </p>
    </section>
}
@if (Model.LessonCode == "PED:US-CCSS-MATH:G7:U02:L01")
{
    @* First-party Grade7 proportional reasoning lesson, no source artwork. *@
    <section class="rich-lesson-section rich-lesson-section--g7-proportional-reasoning"
             data-g7-u02-l01 aria-label="Grade 7 original equivalent-ratio investigation">
      <h3>One of These Things Is Not Like the Others — Edulytiks</h3>
      <h4>1.1 Build a labeled double number line</h4>
      <p>Complete aligned top ticks 0, 2, 4, 6, 8, 10 and
         bottom ticks 0, 1, 2, 3, 4, 5. Invent a context
         with TWO different quantities, label both
         with correct units, and explain the shared
         multiplicative relationship and how 10
         on the top corresponds to 5 on the bottom.
         A teacher should evaluate your invented context.</p>
      <h4>1.2 Compare first-party mystery drink mixtures</h4>
      <p>Consider three hypothetical drink recipes:
         A: 1 cup water and 1.5 teaspoons of powder;
         B: 2 cups water and 0.5 teaspoon of powder;
         C: 1 cup water and 0.25 teaspoon of powder.
         Explain which recipe would have the strongest
         concentration under equal ingredients, and
         why B and C are equivalent at 0.25 teaspoon
         per cup despite differing total amounts.
         Construct a ratio table or a double number line
         for both recipes. Any real tasting,
         classroom supplies, food restrictions and
         discussion remain teacher-managed.</p>
      <p>Extension: A hypothetical salt-and-sugar mixture
         uses water/salt/sugar amounts 2 cups/4 tsp/0.25 cups;
         a second uses 1.5 cups/3 tsp/0.2 cups;
         a third uses 1 cup/2 tsp/0.125 cups.
         Compare BOTH salt and sugar concentration per
         cup water. The first and third match in both
         components; the middle differs in sugar ratio.</p>
      <h4>1.3 Draw and explain scaled crescent-like figures</h4>
      <p>Using the first-party crescent reference above,
         compare A with B and C. B grows by a factor
         1.5 on BOTH width and height; C grows by
         1.5 in width only. Explain why matching
         just one ratio does not establish
         a uniform scaled copy. Draw two figures,
         mark corresponding maximum widths and heights,
         then represent their measurements in a table
         or on a double number line. Have your teacher
         review the original drawings and argument.</p>
      <details><summary>Open mathematical checks after reasoning</summary>
        <p>For the line, 2 top units align with 1 bottom
           unit and 10 align with 5. For the recipes:
           A=1.5 tsp/cup, B=0.25, C=0.25;
           B and C are equivalent. In the salt/sugar
           extension, mixtures A and C have equal
           ratios for BOTH ingredients; B's sugar
           concentration differs. Uniform crescent
           scale A to B is 1.5 in both dimensions;
           A to C is NOT uniform.</p>
      </details>
      <h4>Cool-down — independent Edulytiks assessment</h4>
      <p>A color-mixing recipe uses 3 units of blue for
         every 2 units of yellow. Compare it with
         a second recipe using 9 blue and 6 yellow,
         and a third using 9 blue and 8 yellow.
         Decide which mixture has the same proportions.
         Draw a double number line showing
         the equivalent ratios and give a short
         written explanation of why the third
         recipe differs. Your teacher evaluates
         the representation and reasoning.</p>
      <p><strong>Assessment boundary:</strong> Exact ratio
         answers can be machine checked; original
         drawings, real mixtures, learner-invented
         line contexts and verbal justification
         require human review. No learner
         artefact or teacher score is saved by
         this view, and the publisher's gated
         Cool-down has not been reproduced.</p>
    </section>
}
@if (Model.LessonCode == "PED:US-CCSS-MATH:G7:U02:L02")
{
    <section class="rich-lesson-section rich-lesson-section--g7-proportion-tables"
             data-g7-u02-l02 aria-label="Grade 7 tables and proportional constants">
      <h3>Introducing Proportional Relationships with Tables</h3>
      <h4>2.1 Notice, question and test an inconsistent table</h4>
      <p>In a hypothetical towel shipment, a table records
         1 case → 12 rolls, 2 cases → 36 rolls,
         5 cases → 60 rolls, 10 cases → 120 rolls.
         Notice and discuss what might be inconsistent.
         Compute every rolls-per-case ratio, and
         identify the row that prevents a constant
         of proportionality. If each case contained
         12 rolls, 2 cases would require 24 rolls,
         not 36. Do not ignore the inconsistent entry.</p>
      <h4>2.2 Feeding a crowd — two proportional tables</h4>
      <p>A first-party recipe requires 2 cups of rice
         per 6 people. Complete a ratio table containing
         2 cups/6 people, 3 cups/9 people,
         10 cups/? people, and ? cups/45 people.
         Next a batch of 6 spring rolls serves 3 people.
         Extend its table for 30 and 40 rolls, and
         calculate how many rolls are needed for
         28 people. Explain the constant of
         proportionality for each chosen column order,
         and why reversing columns reciprocates it.</p>
      <h4>2.3 Bread dough — fractional constant</h4>
      <p>An original class example uses 8 tablespoons
         of honey for every 10 cups of flour.
         Complete the table for 20 tablespoons
         of honey, 13 tablespoons and 20 cups of
         flour. Write and interpret the constant
         5/4 cups of flour per tablespoon of honey,
         and the inverse 4/5 tablespoon of
         honey per cup of flour. Use diagrams,
         tables and a written explanation.</p>
      <h4>2.4 Quarters and dimes</h4>
      <p>Four quarters have the same value as ten dimes.
         Create the pairs (1,2.5), (4,10),
         (6,15) and (14,35).
         Explain the meaning of 2.5 dimes per quarter
         as a VALUE equivalent, rather than claiming
         a shop pays with half a coin. A teacher
         reviews your table and reasoning.</p>
      <h4>Additional practice and transfer</h4>
      <p>Draw a table for chocolate milk:
         2 cups milk for 3 tablespoons syrup.
         Determine syrup for 8 and 10 cups and
         state the constant with units.
         Separately compare 3 cups of red paint
         per 7 cups of white paint, and
         the ratio cards 4:7, 8:15, 16:28,
         2:3 and 20:35. Identify all ratios
         equivalent to 4:7 and justify the grouping.
         Apply previous scale-drawing area rules
         where appropriate, without replacing
         this lesson's proportionality work.</p>
      <details><summary>Check numerical answers after your work</summary>
        <p>Rice: 10 cups serve 30 people;
           45 people need 15 cups.
           Spring rolls: 30 rolls serve 15 people,
           40 rolls serve 20, and 28 people need
           56 rolls. Bread dough: 20 tbsp honey
           use 25 cups flour, 13 tbsp use 16.25 cups,
           and 20 cups flour need 16 tbsp honey.
           Quarters-to-dimes factor is 5/2.
           Chocolate syrup-per-milk factor is 3/2,
           red paint-per-white factor is 3/7.
           Matching ratio cards are A, C and E.</p>
      </details>
      <h4>Cool-down — independently authored Edulytiks task</h4>
      <p>One maker uses 6 meters of string to assemble
         4 identical decorations. Another makes
         10 decorations with the same design.
         Complete a table for 1, 4, 7 and
         10 decorations, and state both the
         meters-per-decoration constant and
         its inverse with suitable units.
         Explain why changing the first
         column from 4 to 10 is not the same
         as changing the fixed unit rate.</p>
      <p><strong>Assessment boundary:</strong> Numeric
         results are exact Practice; the source
         table anomaly, written interpretations,
         invented contexts and hand-drawn tables
         need teacher review. No third-party
         figures or gated original Cool-down
         have been reproduced.</p>
    </section>
}
