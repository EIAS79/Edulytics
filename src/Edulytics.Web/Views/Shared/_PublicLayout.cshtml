@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.SharedResource> Brand
@using System.Globalization
@{
    const string publicLanguageCookie = "Edulytics.PublicLanguage";
    var localizedProductName = Brand["ProductName"].Value;
    var publicLanguage = Context.Request.Cookies[publicLanguageCookie];
    var isArabic = string.Equals(publicLanguage, "ar", StringComparison.OrdinalIgnoreCase);
    var pageLanguage = isArabic ? "ar" : CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var pageDirection = isArabic ? "rtl" : "ltr";
    var isMarketingContentPage = ViewData["MarketingPageKey"] is string;
    var pageTitle = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="@pageLanguage" dir="@pageDirection" class="@(isArabic ? "ed-site-ar" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <script>
        (() => {
            try {
                const language = window.localStorage.getItem('edulytics.public.siteLanguage');
                if (language === 'ar') {
                    document.documentElement.lang = 'ar';
                    document.documentElement.dir = 'rtl';
                    document.documentElement.classList.add('ed-site-ar');
                }
            } catch { }
        })();
    </script>
    <title>@localizedProductName@(string.IsNullOrWhiteSpace(pageTitle) ? "" : $" | {pageTitle}")</title>
    <meta name="description" content="Edulytics is a curriculum-aligned mathematics learning, assessment and mastery platform for schools, teachers and students." />
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-site-v32.css" />
    <style>
        .ed-home .student-avatar .head,
        .ed-home .student-avatar .body,
        .ed-home .student-avatar .screen {
            display: none !important;
        }

        .ed-home .student-avatar {
            width: 210px !important;
            height: 245px !important;
            bottom: 34px !important;
            transform: translateX(-55%) !important;
            z-index: 3;
        }

        .ed-home .student-avatar::before {
            content: "";
            position: absolute;
            inset: -8px -20px -6px;
            background: url('/images/public/edulytics-math-mascot-1.png') center bottom / contain no-repeat;
            filter: drop-shadow(0 12px 18px rgba(32, 64, 104, .14));
        }

        @@media (max-width: 720px) {
            .ed-home .student-avatar {
                width: 180px !important;
                height: 215px !important;
                bottom: 38px !important;
            }
        }
    </style>
</head>
<body class="ed-public-body">
    <div class="visually-hidden">Polski English العربية</div>
    <main class="ed-public-main">
        @RenderBody()
    </main>
    <script src="~/js/public-site-v32.js"></script>
    @if (isMarketingContentPage)
    {
        <script src="~/js/public-content-v32.js"></script>
    }
    <script src="~/js/public-site-global-ui-v30.js" asp-append-version="true"></script>
    <script src="~/js/public-language-cookie-v31.js" asp-append-version="true"></script>
    <script src="~/js/public-home-visual-contract-v32.js" asp-append-version="true"></script>
</body>
</html>