@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.SharedResource> Brand
@using System.Globalization
@{
    var localizedProductName = Brand["ProductName"].Value;
    var pageLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@pageLanguage" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>@localizedProductName</title>
    <meta name="description" content="Edulytics is a curriculum-aligned mathematics learning, assessment and mastery platform for schools, teachers and students." />
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/round2-product-fixes.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/round4-ux-display.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v4.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v5.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v6.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v10.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-contact-v4.css"
          asp-append-version="true" />
</head>
<body class="ed-public-body">
    <div class="visually-hidden">Polski English</div>
    <main class="ed-public-main">
        @RenderBody()
    </main>
    <script src="~/js/public-home-commercial-v4.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v5.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v6.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v9.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v10.js" asp-append-version="true"></script>
</body>
</html>
