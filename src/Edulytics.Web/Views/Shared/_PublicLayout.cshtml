@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.SharedResource> Brand
@using System.Globalization
@{
    var localizedProductName = Brand["ProductName"].Value;
    var pageLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isMarketingContentPage = ViewData["MarketingPageKey"] is string;
    var pageTitle = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="@pageLanguage" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? localizedProductName : $"{pageTitle} | {localizedProductName}")</title>
    <meta name="description" content="Edulytics is a curriculum-aligned mathematics learning, assessment and mastery platform for schools, teachers and students." />
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/round2-product-fixes.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/round4-ux-display.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v4.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v5.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v6.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v10.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v11.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v12.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v13.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v14.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v15.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v16.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-commercial-v17.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-philosophy-v23.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-contact-v4.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-contact-system-v28.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-footer-v24.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-home-navbar-v25.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/public-understanding-v1.css"
          asp-append-version="true" />
    @if (isMarketingContentPage)
    {
        <link rel="stylesheet"
              href="~/css/public-content-pages-v27.css"
              asp-append-version="true" />
    }
    <style>
        .ed-home .student-avatar .head,
        .ed-home .student-avatar .body,
        .ed-home .student-avatar .screen {
            display: none !important;
        }

        .ed-home .student-avatar {
            width: 210px !important;
            height: 245px !important;
            bottom: 34px !important;
            transform: translateX(-55%) !important;
            z-index: 3;
        }

        .ed-home .student-avatar::before {
            content: "";
            position: absolute;
            inset: -8px -20px -6px;
            background: url('/images/public/edulytics-math-mascot-1.png') center bottom / contain no-repeat;
            filter: drop-shadow(0 12px 18px rgba(32, 64, 104, .14));
        }

        @@media (max-width: 720px) {
            .ed-home .student-avatar {
                width: 180px !important;
                height: 215px !important;
                bottom: 38px !important;
            }
        }
    </style>
</head>
<body class="ed-public-body">
    <div class="visually-hidden">Polski English العربية</div>
    <main class="ed-public-main">
        @RenderBody()
    </main>
    <script src="~/js/public-home-commercial-v4.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v5.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v6.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v9.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v10.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v11.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v12.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v13.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v14.js" asp-append-version="true"></script>
    <script src="~/js/public-home-commercial-v15.js" asp-append-version="true"></script>
    <script src="~/js/public-home-cartoon-cleanup.js" asp-append-version="true"></script>
    <script src="~/js/public-home-experience-v20.js" asp-append-version="true"></script>
    <script src="~/js/public-home-curricula-v21.js" asp-append-version="true"></script>
    <script src="~/js/public-home-ai-spotlight-v22.js" asp-append-version="true"></script>
    <script src="~/js/public-site-routing-v27.js" asp-append-version="true"></script>
    <script src="~/js/public-site-routing-v28.js" asp-append-version="true"></script>
    <script src="~/js/public-understanding-v1.js" asp-append-version="true"></script>
    <script src="~/js/public-contact-system-v28.js" asp-append-version="true"></script>
    @if (isMarketingContentPage)
    {
        <script src="~/js/public-content-pages-v27-en.js" asp-append-version="true"></script>
        <script src="~/js/public-content-pages-v27-pl.js" asp-append-version="true"></script>
        <script src="~/js/public-content-pages-v27-ar.js" asp-append-version="true"></script>
        <script src="~/js/public-content-pages-v27.js" asp-append-version="true"></script>
    }
</body>
</html>