@model Edulytics.Core.Curriculum.RichLessonVisual
@using Edulytics.Core.Curriculum
@{
    var kindClass = Model.Kind.ToString().ToLowerInvariant();
}

<figure class="rich-lesson-visual rich-lesson-visual--@kindClass">
    <div class="rich-lesson-visual__header">
        <h3>@Model.Title</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
    </div>

    @if (Model.Kind is RichLessonVisualKind.CalculationChain or RichLessonVisualKind.EquationSet)
    {
        <div class="rich-lesson-chain" role="img" aria-label="@Model.Description">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                <div class="rich-lesson-chain__item">@Model.Items[i]</div>
                @if (Model.Kind == RichLessonVisualKind.CalculationChain && i < Model.Items.Count - 1)
                {
                    <span class="rich-lesson-chain__arrow" aria-hidden="true">→</span>
                }
            }
        </div>
    }
    else if (Model.Kind is RichLessonVisualKind.NumberLine or RichLessonVisualKind.Scale)
    {
        <div class="rich-number-line-scroll">
            <div class="rich-number-line" role="img" aria-label="@Model.Description">
                @foreach (var item in Model.Items)
                {
                    <div class="rich-number-line__tick">
                        <span class="rich-number-line__mark" aria-hidden="true"></span>
                        <strong>@item</strong>
                    </div>
                }
            </div>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.DoubleNumberLine)
    {
        <div class="rich-double-line" role="img" aria-label="@Model.Description">
            <div class="rich-double-line__row">
                <strong>@Model.PrimaryLabel</strong>
                <div class="rich-double-line__values">
                    @foreach (var item in Model.Items)
                    {
                        <span>@item</span>
                    }
                </div>
            </div>
            <div class="rich-double-line__row">
                <strong>@Model.SecondaryLabel</strong>
                <div class="rich-double-line__values">
                    @foreach (var item in Model.SecondaryItems)
                    {
                        <span>@item</span>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.FractionBars)
    {
        <div class="rich-fraction-bars" role="img" aria-label="@Model.Description">
            @foreach (var row in Model.Rows.Where(x => x.Denominator > 0))
            {
                var numerator = Math.Clamp(row.Numerator, 0, row.Denominator);
                <div class="rich-fraction-row">
                    <strong>@row.Label</strong>
                    <div class="rich-fraction-bar"
                         style="grid-template-columns:repeat(@row.Denominator,minmax(0,1fr));">
                        @for (var i = 0; i < row.Denominator; i++)
                        {
                            <span class="@(i < numerator ? "is-filled" : null)"></span>
                        }
                    </div>
                    <span>@numerator/@row.Denominator</span>
                </div>
            }
        </div>
    }
    else if (Model.Kind is RichLessonVisualKind.RatioTable or RichLessonVisualKind.PlaceValueChart or RichLessonVisualKind.ComparisonTable)
    {
        <div class="rich-lesson-table-wrap">
            <table class="rich-lesson-table">
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <th scope="row">@row.Label</th>
                            @foreach (var cell in row.Cells)
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.Grade4Unit1AreaFigures)
    {
        // Independently drawn grade-four 2021 source-equivalent mathematical shapes.
        // No publisher pixels, logos, or source asset are embedded.
        <div class="rich-lesson-area-models">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 450"
                 role="img" aria-label="@Model.Description"
                 style="width:100%;max-width:720px;height:auto">
                <g fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="75" y="65" width="140" height="112"/>
                    <rect x="395" y="65" width="112" height="140"/>
                    @for (var i = 1; i < 4; i++)
                    {
                        <line x1="@(395 + i * 28)" x2="@(395 + i * 28)" y1="65" y2="205"/>
                    }
                    @for (var i = 1; i < 5; i++)
                    {
                        <line x1="395" x2="507" y1="@(65 + i * 28)" y2="@(65 + i * 28)"/>
                    }
                    <rect x="100" y="270" width="100" height="150"/>
                    <path d="M395 270 H435 V350 H475 V410 H395 Z"/>
                </g>
                <g fill="currentColor" font-family="sans-serif" font-size="18">
                    <text x="45" y="45">A</text>
                    <text x="390" y="45">B</text>
                    <text x="45" y="250">C</text>
                    <text x="390" y="250">D</text>
                    <text x="140" y="55">5</text>
                    <text x="50" y="125">4</text>
                    <text x="140" y="263">4</text>
                    <text x="77" y="355">6</text>
                    <text x="408" y="263">2</text>
                    <text x="370" y="350">7</text>
                    <text x="447" y="343">2</text>
                    <text x="485" y="389">3</text>
                </g>
            </svg>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.Grade5Unit1CubeComparison)
    {
        // Grade 5 first-edition task, independently authored geometric models.
        // The four 3D cube assemblies are mathematical constructions, not
        // publisher artwork or an endorsement by Illustrative Mathematics.
        var cubeModels = new[]
        {
            new
            {
                Label = "A", Count = 8, Explanation = "2 × 2 × 2 = 8",
                Cubes = Enumerable.Range(0, 2).SelectMany(x =>
                    Enumerable.Range(0, 2).SelectMany(y =>
                        Enumerable.Range(0, 2).Select(z => (X: x, Y: y, Z: z)))).ToArray()
            },
            new
            {
                Label = "B", Count = 8, Explanation = "5 bottom + 3 above = 8",
                Cubes = Enumerable.Range(0, 5).Select(x => (X: x, Y: 0, Z: 0))
                    .Concat(Enumerable.Range(1, 3).Select(x => (X: x, Y: 0, Z: 1))).ToArray()
            },
            new
            {
                Label = "C", Count = 8, Explanation = "2 × 1 × 4 = 8",
                Cubes = Enumerable.Range(0, 2).SelectMany(x =>
                    Enumerable.Range(0, 4).Select(z => (X: x, Y: 0, Z: z))).ToArray()
            },
            new
            {
                Label = "D", Count = 10, Explanation = "5 × 1 × 2 = 10",
                Cubes = Enumerable.Range(0, 5).SelectMany(x =>
                    Enumerable.Range(0, 2).Select(z => (X: x, Y: 0, Z: z))).ToArray()
            }
        };
        <div class="rich-lesson-cube-models">
            <svg viewBox="0 0 960 590" xmlns="http://www.w3.org/2000/svg"
                 role="img" aria-label="@Model.Description"
                 style="width:100%;max-width:900px;height:auto">
                @for (var index = 0; index < cubeModels.Length; index++)
                {
                    var cubeSet = cubeModels[index];
                    var originX = 120 + index % 2 * 450;
                    var originY = 165 + index / 2 * 270;
                    <g>
                        <text x="@(originX - 60)" y="@(originY - 125)"
                              font-size="21" font-weight="bold"
                              fill="currentColor">@cubeSet.Label — @cubeSet.Count cubes</text>
                        @foreach (var cube in cubeSet.Cubes.OrderBy(x => x.X + x.Y + x.Z)
                                             .ThenBy(x => x.Z))
                        {
                            var px = originX + (cube.X - cube.Y) * 23;
                            var py = originY + (cube.X + cube.Y) * 12 - cube.Z * 30;
                            var top = $"{px},{py - 30} {px + 23},{py - 18} {px},{py - 6} {px - 23},{py - 18}";
                            var left = $"{px - 23},{py - 18} {px},{py - 6} {px},{py + 20} {px - 23},{py + 8}";
                            var right = $"{px},{py - 6} {px + 23},{py - 18} {px + 23},{py + 8} {px},{py + 20}";
                            <polygon points="@top" fill="#e9f3fc"
                                     stroke="#31536f" stroke-width="1.5" />
                            <polygon points="@left" fill="#b5d5ee"
                                     stroke="#31536f" stroke-width="1.5" />
                            <polygon points="@right" fill="#80b5db"
                                     stroke="#31536f" stroke-width="1.5" />
                        }
                        <text x="@(originX - 60)" y="@(originY + 90)"
                              font-size="17" fill="currentColor">@cubeSet.Explanation</text>
                    </g>
                }
            </svg>
        </div>
    }
﻿    else if (Model.Kind == RichLessonVisualKind.Grade5Unit1CubeModelWodb)
    {
        // Author-created, mathematically source-aligned Grade 5 U01:L02
        // constructions. Do not use original publisher figure pixels.
        var models = new[]
        {
            Enumerable.Range(0, 2).SelectMany(segment =>
                Enumerable.Range(0, 2).SelectMany(y =>
                    Enumerable.Range(0, 3).Select(z =>
                        (X: segment * 4, Y: y, Z: z)))).ToArray(),
            Enumerable.Range(0, 2).SelectMany(x =>
                Enumerable.Range(0, 2).SelectMany(y =>
                    Enumerable.Range(0, 3).Select(z => (X: x, Y: y, Z: z))))
                    .Where(c => c != (X: 1, Y: 1, Z: 2)).ToArray(),
            new[] { 4, 4, 3, 1 }.SelectMany((n, z) =>
                Enumerable.Range(0, n).Select(x => (X: x, Y: 0, Z: z))).ToArray(),
            Enumerable.Range(0, 3).SelectMany(x =>
                Enumerable.Range(0, 2).SelectMany(y =>
                    Enumerable.Range(0, 2).Select(z => (X: x, Y: y, Z: z)))).ToArray()
        };
        var labels = new[] { "A", "B", "C", "D" };
        var details = new[]
        {
            "2 separate prisms; 6 + 6",
            "1 missing top cube; 11",
            "4 + 4 + 3 + 1 = 12",
            "3 by 2 by 2; 12"
        };
        <div class="rich-lesson-cube-models">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 650"
                 role="img" aria-label="@Model.Description"
                 style="max-width:960px;width:100%;height:auto">
                @for (var modelIndex = 0; modelIndex < models.Length; modelIndex++)
                {
                    var cx = 120 + (modelIndex % 2) * 470;
                    var cy = 190 + (modelIndex / 2) * 310;
                    var cubes = models[modelIndex];
                    <g>
                        <text x="@(cx - 75)" y="@(cy - 150)" font-size="22"
                              fill="currentColor" font-weight="bold">
                            @labels[modelIndex]: @cubes.Length cubes
                        </text>
                        @foreach (var cube in cubes.OrderBy(c => c.X + c.Y + c.Z).ThenBy(c => c.Z))
                        {
                            var x = cx + (cube.X - cube.Y) * 24;
                            var y = cy + (cube.X + cube.Y) * 12 - cube.Z * 30;
                            var faceTop = $"{x},{y - 30} {x + 24},{y - 18} {x},{y - 6} {x - 24},{y - 18}";
                            var faceLeft = $"{x - 24},{y - 18} {x},{y - 6} {x},{y + 20} {x - 24},{y + 8}";
                            var faceRight = $"{x},{y - 6} {x + 24},{y - 18} {x + 24},{y + 8} {x},{y + 20}";
                            <polygon points="@faceTop" fill="#e9f3fc" stroke="#31536f" stroke-width="1.6"/>
                            <polygon points="@faceLeft" fill="#b5d5ee" stroke="#31536f" stroke-width="1.6"/>
                            <polygon points="@faceRight" fill="#80b5db" stroke="#31536f" stroke-width="1.6"/>
                        }
                        <text x="@(cx - 75)" y="@(cy + 104)" fill="currentColor"
                              font-size="17">@details[modelIndex]</text>
                    </g>
                }
            </svg>
        </div>
    }

    else if (Model.Kind == RichLessonVisualKind.CartesianPlot)
    {
        // Reuse the RichV2 visual model; original learner-safe SVG graph, not
        // a publisher asset. Rows encode [x,y] numeric coordinates by series name.
        // Do not render non-finite, negative or oversized coordinates.
        var points = new List<(string Series, double X, double Y)>();
        foreach (var row in Model.Rows)
        {
            if (row.Cells.Count < 2 ||
                !double.TryParse(row.Cells[0], System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var x) ||
                !double.TryParse(row.Cells[1], System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var y) ||
                !double.IsFinite(x) || !double.IsFinite(y) ||
                x < 0 || y < 0 || x > 10000 || y > 10000)
            {
                continue;
            }
            points.Add((row.Label, x, y));
        }
        var maxX = Math.Ceiling(Math.Max(4d,
            points.Count > 0 ? points.Max(p => p.X) : 4d));
        var yMaxValue = Math.Max(10d,
            points.Count > 0 ? points.Max(p => p.Y) : 10d);
        var yTick = Math.Ceiling(yMaxValue / 5d);
        var yTop = yTick * 5d;
        var series = points.Select(p => p.Series)
            .Distinct(StringComparer.Ordinal).ToArray();
        var palette = new[] { "#1d4ed8", "#b91c1c", "#047857", "#7c3aed" };
        <div class="rich-lesson-cartesian" dir="ltr">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 750 440"
                 role="img" aria-label="@Model.Description"
                 style="width:100%;height:auto;max-width:760px">
                <title>@Model.Title</title>
                <desc>@Model.Description</desc>
                @for (var tick = 0; tick <= 5; tick++)
                {
                    var y = 340d - 275d * tick / 5d;
                    var value = tick * yTick;
                    <line x1="80" x2="650" y1="@y" y2="@y"
                          stroke="currentColor" stroke-opacity=".16" />
                    @Html.Raw($"<text x=\"66\" y=\"{(y + 5).ToString(System.Globalization.CultureInfo.InvariantCulture)}\" fill=\"currentColor\" text-anchor=\"end\" font-size=\"15\">")
                    @value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)
                    @Html.Raw("</text>")
                }
                @for (var tick = 0; tick <= (int)maxX; tick++)
                {
                    var x = 80d + 560d * tick / maxX;
                    <line x1="@x" x2="@x" y1="65" y2="340"
                          stroke="currentColor" stroke-opacity=".16" />
                    @Html.Raw($"<text x=\"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" y=\"365\" fill=\"currentColor\" text-anchor=\"middle\" font-size=\"15\">")@tick@Html.Raw("</text>")
                }
                <line x1="80" x2="658" y1="340" y2="340"
                      stroke="currentColor" stroke-width="2" />
                <line x1="80" x2="80" y1="48" y2="340"
                      stroke="currentColor" stroke-width="2" />
                @foreach (var point in points)
                {
                    var px = 80d + 560d * point.X / maxX;
                    var py = 340d - 275d * point.Y / yTop;
                    var si = Array.IndexOf(series, point.Series);
                    var color = palette[(si < 0 ? 0 : si) % palette.Length];
                    <circle cx="@px" cy="@py" r="6" fill="@color"
                            stroke="#fff" stroke-width="1.5" />
                }
                <text x="360" y="405" fill="currentColor"
                      text-anchor="middle" font-size="18">@Model.PrimaryLabel</text>
                <text transform="translate(24 203) rotate(-90)" fill="currentColor"
                      text-anchor="middle" font-size="18">@Model.SecondaryLabel</text>
                @for (var i = 0; i < series.Length && i < 4; i++)
                {
                    <circle cx="@(530 + (i % 2) * 110)" cy="@(20 + (i / 2) * 20)"
                            r="5" fill="@palette[i]" />
                    @Html.Raw($"<text x=\"{541 + (i % 2) * 110}\" y=\"{25 + (i / 2) * 20}\" font-size=\"13\" fill=\"currentColor\">")@series[i]@Html.Raw("</text>")
                }
            </svg>
        </div>
        <div class="rich-lesson-table-wrap">
            <table class="rich-lesson-table">
                <caption>@Model.Title — البيانات الرقمية</caption>
                <thead><tr><th scope="col">المجموعة</th>
                    <th scope="col">@Model.PrimaryLabel</th>
                    <th scope="col">@Model.SecondaryLabel</th></tr></thead>
                <tbody>
                @foreach (var point in points)
                {
                    <tr><th scope="row">@point.Series</th>
                        <td>@point.X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@point.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Kind is RichLessonVisualKind.SignedCartesianPlot or RichLessonVisualKind.ClosedCoordinatePolygon)
    {
        // Signed coordinates with four quadrants. Existing CartesianPlot remains unchanged.
        var points=new List<(string Name,double X,double Y)>();
        foreach (var row in Model.Rows)
        {
            if(row.Cells.Count<2 ||
               !double.TryParse(row.Cells[0],System.Globalization.NumberStyles.Float,
                   System.Globalization.CultureInfo.InvariantCulture,out var x) ||
               !double.TryParse(row.Cells[1],System.Globalization.NumberStyles.Float,
                   System.Globalization.CultureInfo.InvariantCulture,out var y) ||
               !double.IsFinite(x)||!double.IsFinite(y)||
               x< -10||x>10||y< -10||y>10) continue;
            points.Add((row.Label,x,y));
        }
        var extent=Math.Max(5d,Math.Ceiling(points.Count>0?
            points.Max(pt=>Math.Max(Math.Abs(pt.X),Math.Abs(pt.Y))):5d));
        var scale=175d/extent;
        <div class="rich-lesson-cartesian" dir="ltr">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 660 460"
                 role="img" aria-label="@Model.Description"
                 style="width:100%;height:auto;max-width:700px">
                <title>@Model.Title</title><desc>@Model.Description</desc>
                @for(var tick=-(int)extent;tick<=(int)extent;tick++)
                {
                    var px=330d+tick*scale;var py=225d-tick*scale;
                    <line x1="@px" y1="50" x2="@px" y2="400" stroke="currentColor" stroke-opacity=".15"/>
                    <line x1="155" y1="@py" x2="505" y2="@py" stroke="currentColor" stroke-opacity=".15"/>
                    @if(tick!=0)
                    {
                        @Html.Raw(FormattableString.Invariant($"<text x=\"{px}\" y=\"243\" text-anchor=\"middle\" font-size=\"12\" fill=\"currentColor\">{tick}</text>"))
                        @Html.Raw(FormattableString.Invariant($"<text x=\"320\" y=\"{py+4}\" text-anchor=\"end\" font-size=\"12\" fill=\"currentColor\">{tick}</text>"))
                    }
                }
                <line x1="145" y1="225" x2="515" y2="225" stroke="currentColor" stroke-width="2.5"/>
                <line x1="330" y1="40" x2="330" y2="410" stroke="currentColor" stroke-width="2.5"/>
                <text x="337" y="242" font-size="13" fill="currentColor">0</text>
                <text x="520" y="220" font-size="18" fill="currentColor">x</text>
                <text x="337" y="35" font-size="18" fill="currentColor">y</text>
                @if (Model.Kind == RichLessonVisualKind.ClosedCoordinatePolygon && points.Count >= 3)
                {
                    var coordinates = string.Join(" ", points.Select(pt => FormattableString.Invariant($"{330d+pt.X*scale},{225d-pt.Y*scale}")));
                    <polygon points="@coordinates" fill="none" stroke="#1d4ed8" stroke-width="2.5"/>
                }
                @foreach(var point in points)
                {
                    var px=330d+point.X*scale;var py=225d-point.Y*scale;
                    <circle cx="@px" cy="@py" r="5.5" fill="#1d4ed8" stroke="#fff" stroke-width="1.5"/>
                    @Html.Raw(FormattableString.Invariant($"<text x=\"{px+8}\" y=\"{py-8}\" font-size=\"13\" fill=\"currentColor\">{System.Net.WebUtility.HtmlEncode(point.Name)}</text>"))
                }
            </svg>
        </div>
        <div class="rich-lesson-table-wrap">
            <table class="rich-lesson-table">
                <caption>@Model.Title — إحداثيات النقاط</caption>
                <thead><tr><th scope="col">النقطة</th><th scope="col">س (x)</th><th scope="col">ص (y)</th></tr></thead>
                <tbody>
                @foreach(var point in points)
                {
                    <tr><th scope="row">@point.Name</th>
                        <td>@point.X.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@point.Y.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.ExpressionStripBars)
    {
        // Edulytics-authored grouped bar model for Grade6 expression factors.
        <div class="rich-lesson-expression-strips" dir="rtl"
             role="img" aria-label="@Model.Description"
             style="display:grid;gap:12px;max-width:720px">
            @foreach(var row in Model.Rows)
            {
                <div style="display:grid;gap:5px">
                    <strong>@row.Label</strong>
                    <div style="display:flex;gap:4px;flex-wrap:wrap">
                        @foreach(var cell in row.Cells.Take(12))
                        {
                            <span style="flex:1 1 70px;display:block;min-height:40px;
                                  padding:8px;border:2px solid currentColor;
                                  border-radius:4px;text-align:center">@cell</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.InequalityNumberLine)
    {
        // Source-aligned open/closed inequality endpoints, independent of RTL direction.
        <div class="rich-lesson-inequality" dir="ltr" style="display:grid;gap:10px">
            @foreach(var row in Model.Rows)
            {
                var op=row.Cells.Count>0?row.Cells[0]:"";
                var boundText=row.Cells.Count>1?row.Cells[1]:"";
                if(op is not ("<" or "≤" or ">" or "≥") ||
                    !decimal.TryParse(boundText,System.Globalization.NumberStyles.Number,
                        System.Globalization.CultureInfo.InvariantCulture,out decimal bound) ||
                    bound < -1000 || bound > 1000) continue;
                var left=op is "<" or "≤";
                var inclusive=op is "≤" or "≥";
                var start=left?48:320;
                var finish=left?320:592;
                var tip=left?36:604;
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 112"
                     role="img" aria-label="@(row.Label): @(Model.Description)"
                     style="display:block;width:100%;height:auto;max-width:680px">
                    <title>@Model.Title — @row.Label</title>
                    <line x1="30" y1="55" x2="610" y2="55" stroke="currentColor" stroke-width="2"/>
                    @for(int tick=-4;tick<=4;tick++)
                    {
                        var x=320+tick*65;
                        var value=bound+tick;
                        <line x1="@x" y1="48" x2="@x" y2="62" stroke="currentColor" stroke-width="1.3"/>
                        @Html.Raw(FormattableString.Invariant($"<text x=\"{x}\" y=\"80\" text-anchor=\"middle\" font-size=\"12\" fill=\"currentColor\">{value:0.#}</text>"))
                    }
                    <line x1="@start" y1="55" x2="@finish" y2="55" stroke="#2563eb" stroke-width="5" stroke-linecap="round"/>
                    @if(left)
                    {
                        <path d="M 36 55 L 53 45 L 53 65 Z" fill="#2563eb"/>
                    }
                    else
                    {
                        <path d="M 604 55 L 587 45 L 587 65 Z" fill="#2563eb"/>
                    }
                    <circle cx="320" cy="55" r="8" stroke="#2563eb" stroke-width="3"
                            fill="@(inclusive?"#2563eb":"white")"/>
                    <text x="320" y="24" text-anchor="middle" font-size="16"
                          fill="currentColor">@row.Label</text>
                </svg>
            }
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.VennDiagram)
    {
        // First-party two-set Venn figure. The complete original model data
        // remains in the accessible item list; neither region is silently omitted.
        <div class="rich-lesson-venn" dir="rtl" style="max-width:760px">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 380"
                 role="img" aria-label="@Model.Description"
                 style="display:block;width:100%;height:auto">
                <title>@Model.Title</title>
                <desc>@Model.Description</desc>
                <rect x="40" y="20" width="620" height="330" rx="10" fill="none"
                      stroke="currentColor" stroke-opacity=".4" stroke-width="2" />
                <circle cx="282" cy="173" r="132" fill="#60a5fa" fill-opacity=".2"
                        stroke="#2563eb" stroke-width="2.5" />
                <circle cx="418" cy="173" r="132" fill="#fbbf24" fill-opacity=".2"
                        stroke="#b45309" stroke-width="2.5" />
                <text x="205" y="124" fill="currentColor" font-size="19"
                      text-anchor="middle">&#x0623;</text>
                <text x="495" y="124" fill="currentColor" font-size="19"
                      text-anchor="middle">&#x0628;</text>
                <text x="219" y="192" fill="currentColor" font-size="15"
                      text-anchor="middle">@(Model.Items.Count > 0 ? Model.Items[0] : "\u0623 \u0641\u0642\u0637")</text>
                <text x="350" y="192" fill="currentColor" font-size="14"
                      text-anchor="middle">@(Model.Items.Count > 1 ? Model.Items[1] : "\u0623 \u2229 \u0628")</text>
                <text x="481" y="192" fill="currentColor" font-size="15"
                      text-anchor="middle">@(Model.Items.Count > 2 ? Model.Items[2] : "\u0628 \u0641\u0642\u0637")</text>
                <text x="350" y="329" fill="currentColor" font-size="14"
                      text-anchor="middle">@(Model.Items.Count > 3 ? Model.Items[3] : "")</text>
            </svg>
            <ul class="rich-lesson-visual__items" dir="rtl">
                @foreach (var item in Model.Items)
                {
                    <li>@item</li>
                }
            </ul>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.CoordinatePlane)
    {
        var lines = RichLessonCoordinateDiagram.ParseLines(Model.Description);
        var points = RichLessonCoordinateDiagram.ParsePoints(Model.Items);
        var clipId = "rich-coord-" + ((uint)Model.Title.GetHashCode()).ToString("x8");
        var colors = new[] { "#1d4ed8", "#b91c1c", "#047857", "#7c3aed" };
        var lineNumber = 0;
        <div class="rich-lesson-coordinate" dir="ltr" style="max-width:760px">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 660 460"
                 role="img" aria-label="@Model.Description"
                 style="display:block;width:100%;height:auto">
                <title>@Model.Title</title><desc>@Model.Description</desc>
                <defs>
                    <clipPath id="@clipId">
                        <rect x="180" y="80" width="300" height="300" />
                    </clipPath>
                </defs>
                @for (var tick = -10; tick <= 10; tick++)
                {
                    var gx = 330 + tick * 15;
                    var gy = 230 - tick * 15;
                    <line x1="@gx" y1="80" x2="@gx" y2="380"
                          stroke="currentColor" stroke-opacity=".12" />
                    <line x1="180" y1="@gy" x2="480" y2="@gy"
                          stroke="currentColor" stroke-opacity=".12" />
                    @if (tick != 0 && tick % 2 == 0)
                    {
                        @Html.Raw(FormattableString.Invariant($"<text x=\"{gx}\" y=\"244\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"10\">{tick}</text>"))
                        @Html.Raw(FormattableString.Invariant($"<text x=\"322\" y=\"{gy+4}\" text-anchor=\"end\" fill=\"currentColor\" font-size=\"10\">{tick}</text>"))
                    }
                }
                <line x1="175" y1="230" x2="488" y2="230"
                      stroke="currentColor" stroke-width="2.5" />
                <line x1="330" y1="72" x2="330" y2="386"
                      stroke="currentColor" stroke-width="2.5" />
                <text x="493" y="225" font-size="16" fill="currentColor">&#x0633;</text>
                <text x="338" y="66" font-size="16" fill="currentColor">&#x0635;</text>
                <g clip-path="@($"url(#{clipId})")">
                    @foreach (var line in lines)
                    {
                        var y1 = 230d - (line.Slope * -10d + line.Intercept) * 15d;
                        var y2 = 230d - (line.Slope * 10d + line.Intercept) * 15d;
                        var color = colors[lineNumber++ % colors.Length];
                        @if (line.ShadeBelow || line.ShadeAbove)
                        {
                            var borderY = line.ShadeBelow ? 380d : 80d;
                            var area = FormattableString.Invariant($"180,{y1} 480,{y2} 480,{borderY} 180,{borderY}");
                            <polygon points="@area" fill="@color" fill-opacity=".13" />
                        }
                        <line x1="180" y1="@y1" x2="480" y2="@y2"
                              stroke="@color" stroke-width="3"
                              stroke-dasharray="@(line.IsDashed ? "8 5" : "none")" />
                    }
                    @foreach (var point in points)
                    {
                        var px = 330d + point.X * 15d;
                        var py = 230d - point.Y * 15d;
                        <circle cx="@px" cy="@py" r="5" fill="#047857"
                                stroke="#fff" stroke-width="1.5" />
                    }
                </g>
            </svg>
            <p dir="rtl">@Model.Description</p>
            <ul dir="rtl">
                @foreach (var item in Model.Items)
                {
                    <li>@item</li>
                }
            </ul>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.DimensionedGeometry)
    {
        // Original bounded mathematical geometry templates. Labels are
        // encoded by Razor; no raw SVG or publisher artwork is accepted.
        var shape = Model.PrimaryLabel;
        var labels = Model.Items;
        string Label(int i) => i < labels.Count ? labels[i] : "";
        <div class="rich-lesson-cartesian" dir="ltr">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 260"
                 role="img" aria-label="@Model.Description"
                 style="width:100%;height:auto;max-width:500px">
                @if (shape == "cone")
                {
                    <ellipse cx="250" cy="205" rx="125" ry="27" fill="#dbeafe" stroke="#1d4ed8" stroke-width="2"/>
                    <path d="M125 205 L250 32 L375 205" fill="#dbeafe" fill-opacity=".4" stroke="#1d4ed8" stroke-width="2"/>
                    <line x1="250" y1="32" x2="250" y2="205" stroke="#334155" stroke-dasharray="6 5" stroke-width="2"/>
                    <line x1="250" y1="205" x2="375" y2="205" stroke="#0f766e" stroke-width="3"/>
                    <text x="260" y="115" fill="currentColor" font-size="17">@Label(1)</text>
                    <text x="300" y="198" fill="currentColor" font-size="17">@Label(0)</text>
                }
                else if (shape == "triangle")
                {
                    <polygon points="85,210 415,210 210,40" fill="#dbeafe" stroke="#1d4ed8" stroke-width="2"/>
                    <line x1="210" y1="40" x2="210" y2="210" stroke="#334155" stroke-width="2" stroke-dasharray="6 5"/>
                    <path d="M210 197 H223 V210" fill="none" stroke="#334155" stroke-width="2"/>
                    <text x="245" y="236" fill="currentColor" font-size="18">@Label(0)</text>
                    <text x="218" y="128" fill="currentColor" font-size="18">@Label(1)</text>
                }
                else if (shape == "heron")
                {
                    <polygon points="100,210 400,210 250,85" fill="#dbeafe" stroke="#1d4ed8" stroke-width="2"/>
                    <text x="240" y="236" fill="currentColor" font-size="18">@Label(0)</text>
                    <text x="155" y="135" fill="currentColor" font-size="18">@Label(1)</text>
                    <text x="335" y="135" fill="currentColor" font-size="18">@Label(2)</text>
                }
                else if (shape == "cylinders")
                {
                    <rect x="55" y="45" width="112" height="164" fill="#dbeafe" stroke="#1d4ed8" stroke-width="2"/>
                    <ellipse cx="111" cy="45" rx="56" ry="16" fill="#eff6ff" stroke="#1d4ed8" stroke-width="2"/>
                    <ellipse cx="111" cy="209" rx="56" ry="16" fill="#dbeafe" stroke="#1d4ed8" stroke-width="2"/>
                    <line x1="111" y1="45" x2="167" y2="45" stroke="#0f766e" stroke-width="3"/>
                    <rect x="300" y="102" width="168" height="107" fill="#dbeafe" stroke="#1d4ed8" stroke-width="2"/>
                    <ellipse cx="384" cy="102" rx="84" ry="20" fill="#eff6ff" stroke="#1d4ed8" stroke-width="2"/>
                    <ellipse cx="384" cy="209" rx="84" ry="20" fill="#dbeafe" stroke="#1d4ed8" stroke-width="2"/>
                    <line x1="384" y1="102" x2="468" y2="102" stroke="#0f766e" stroke-width="3"/>
                    <text x="90" y="28" fill="currentColor" font-size="16">@Label(0)</text>
                    <text x="173" y="130" fill="currentColor" font-size="16">@Label(1)</text>
                    <text x="362" y="82" fill="currentColor" font-size="16">@Label(2)</text>
                    <text x="250" y="160" fill="currentColor" font-size="16">@Label(3)</text>
                }
                else if (shape == "bisectors")
                {
                    <polygon points="100,215 400,215 250,30" fill="#eff6ff" stroke="#1d4ed8" stroke-width="2"/>
                    <path d="M100 215 L250 150 L400 215" fill="none" stroke="#0f766e" stroke-width="2.5"/>
                    <circle cx="250" cy="150" r="4" fill="#0f766e"/>
                    <text x="245" y="20" fill="currentColor" font-size="17">A</text>
                    <text x="80" y="235" fill="currentColor" font-size="17">B</text>
                    <text x="405" y="235" fill="currentColor" font-size="17">C</text>
                    <text x="258" y="143" fill="currentColor" font-size="17">I</text>
                    <text x="259" y="62" fill="currentColor" font-size="17">@Label(0)</text>
                    <text x="237" y="175" fill="currentColor" font-size="17">?</text>
                }
            </svg>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.ShapeDecomposition)
    {
        <div class="rich-shape-decomposition" role="img" aria-label="@Model.Description">
            @foreach (var row in Model.Rows)
            {
                <article class="rich-shape-card">
                    <strong>@row.Label</strong>
                    @foreach (var cell in row.Cells)
                    {
                        <span>@cell</span>
                    }
                </article>
            }
        </div>
    }
</figure>
