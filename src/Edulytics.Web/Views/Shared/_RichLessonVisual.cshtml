@model Edulytics.Core.Curriculum.RichLessonVisual
@using Edulytics.Core.Curriculum
@{
    var kindClass = Model.Kind.ToString().ToLowerInvariant();
}

<figure class="rich-lesson-visual rich-lesson-visual--@kindClass">
    <div class="rich-lesson-visual__header">
        <h3>@Model.Title</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
    </div>

    @if (Model.Kind is RichLessonVisualKind.CalculationChain or RichLessonVisualKind.EquationSet)
    {
        <div class="rich-lesson-chain" role="img" aria-label="@Model.Description">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                <div class="rich-lesson-chain__item">@Model.Items[i]</div>
                @if (Model.Kind == RichLessonVisualKind.CalculationChain && i < Model.Items.Count - 1)
                {
                    <span class="rich-lesson-chain__arrow" aria-hidden="true">→</span>
                }
            }
        </div>
    }
    else if (Model.Kind is RichLessonVisualKind.NumberLine or RichLessonVisualKind.Scale)
    {
        <div class="rich-number-line-scroll">
            <div class="rich-number-line" role="img" aria-label="@Model.Description">
                @foreach (var item in Model.Items)
                {
                    <div class="rich-number-line__tick">
                        <span class="rich-number-line__mark" aria-hidden="true"></span>
                        <strong>@item</strong>
                    </div>
                }
            </div>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.DoubleNumberLine)
    {
        <div class="rich-double-line" role="img" aria-label="@Model.Description">
            <div class="rich-double-line__row">
                <strong>@Model.PrimaryLabel</strong>
                <div class="rich-double-line__values">
                    @foreach (var item in Model.Items)
                    {
                        <span>@item</span>
                    }
                </div>
            </div>
            <div class="rich-double-line__row">
                <strong>@Model.SecondaryLabel</strong>
                <div class="rich-double-line__values">
                    @foreach (var item in Model.SecondaryItems)
                    {
                        <span>@item</span>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.ClockFace)
    {
        // This is a mathematical clock face, not a symbolic circle icon.
        // Angles are derived from the structured hour/minute parameters;
        // numbers are invariant-culture for SVG numeric attributes.
        var hour = int.TryParse(Model.Items.ElementAtOrDefault(0), out var clockHour)
            ? Math.Clamp(clockHour, 1, 12) : 12;
        var minutes = int.TryParse(Model.Items.ElementAtOrDefault(1), out var clockMinutes)
            ? Math.Clamp(clockMinutes, 0, 59) : 0;
        var minuteRadians = Math.PI * 2 * minutes / 60.0 - Math.PI / 2;
        var hourRadians = Math.PI * 2 * ((hour % 12) + minutes / 60.0) / 12.0
            - Math.PI / 2;
        var minuteX = (100.0 + 73.0 * Math.Cos(minuteRadians))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var minuteY = (100.0 + 73.0 * Math.Sin(minuteRadians))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var hourX = (100.0 + 49.0 * Math.Cos(hourRadians))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var hourY = (100.0 + 49.0 * Math.Sin(hourRadians))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        <div class="rich-clock-figure" role="img" aria-label="@Model.Description">
            <svg viewBox="0 0 200 200" width="230" height="230"
                 style="max-width:100%;height:auto" aria-hidden="true">
                <circle cx="100" cy="100" r="90" fill="none"
                        stroke="currentColor" stroke-width="3"/>
                <circle cx="100" cy="100" r="84" fill="none"
                        stroke="currentColor" stroke-width="1" opacity="0.35"/>
                <text x="100" y="32" text-anchor="middle" fill="currentColor"
                      font-size="16">12</text>
                <text x="168" y="105" text-anchor="middle" fill="currentColor"
                      font-size="16">3</text>
                <text x="100" y="177" text-anchor="middle" fill="currentColor"
                      font-size="16">6</text>
                <text x="32" y="105" text-anchor="middle" fill="currentColor"
                      font-size="16">9</text>
                <line x1="100" y1="100" x2="@hourX" y2="@hourY"
                      stroke="currentColor" stroke-linecap="round" stroke-width="7"/>
                <line x1="100" y1="100" x2="@minuteX" y2="@minuteY"
                      stroke="currentColor" stroke-linecap="round" stroke-width="3"/>
                <circle cx="100" cy="100" r="5" fill="currentColor"/>
            </svg>
            <p>Hour hand: @hour · Minute hand: @minutes minutes after the hour</p>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.FractionBars)
    {
        <div class="rich-fraction-bars" role="img" aria-label="@Model.Description">
            @foreach (var row in Model.Rows.Where(x => x.Denominator > 0))
            {
                var numerator = Math.Clamp(row.Numerator, 0, row.Denominator);
                <div class="rich-fraction-row">
                    <strong>@row.Label</strong>
                    <div class="rich-fraction-bar"
                         style="grid-template-columns:repeat(@row.Denominator,minmax(0,1fr));">
                        @for (var i = 0; i < row.Denominator; i++)
                        {
                            <span class="@(i < numerator ? "is-filled" : null)"></span>
                        }
                    </div>
                    <span>@numerator/@row.Denominator</span>
                </div>
            }
        </div>
    }
    else if (Model.Kind is RichLessonVisualKind.RatioTable or RichLessonVisualKind.PlaceValueChart)
    {
        <div class="rich-lesson-table-wrap">
            <table class="rich-lesson-table">
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <th scope="row">@row.Label</th>
                            @foreach (var cell in row.Cells)
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.BarGraph)
    {
        // Native progress meters keep each verified category count proportional,
        // readable with assistive technology and usable without JavaScript.
        var counts = Model.Rows
            .Select(r => int.TryParse(r.Cells.FirstOrDefault(), out var count)
                ? Math.Max(0, count) : 0)
            .ToArray();
        var graphMax = Math.Max(1, counts.DefaultIfEmpty(0).Max());
        <div class="rich-lesson-bar-graph"
             role="group" aria-label="@Model.Description">
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                var category = Model.Rows[i].Label;
                var count = counts[i];
                <div class="rich-lesson-bar-graph__row">
                    <label for="rich-bar-@i-@Model.GetHashCode()">@category</label>
                    <progress id="rich-bar-@i-@Model.GetHashCode()" value="@count"
                              max="@graphMax" aria-label="@category: @count"></progress>
                    <strong>@count</strong>
                </div>
            }
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.ShapeDecomposition)
    {
        <div class="rich-shape-decomposition" role="img" aria-label="@Model.Description">
            @foreach (var row in Model.Rows)
            {
                <article class="rich-shape-card">
                    <strong>@row.Label</strong>
                    @foreach (var cell in row.Cells)
                    {
                        <span>@cell</span>
                    }
                </article>
            }
        </div>
    }
</figure>
