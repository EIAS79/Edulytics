@model Edulytics.Core.Curriculum.RichLessonVisual
@using Edulytics.Core.Curriculum
@{
    var kindClass = Model.Kind.ToString().ToLowerInvariant();
}

<figure class="rich-lesson-visual rich-lesson-visual--@kindClass">
    <div class="rich-lesson-visual__header">
        <h3>@Model.Title</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
    </div>

    @if (Model.Kind is RichLessonVisualKind.CalculationChain or RichLessonVisualKind.EquationSet)
    {
        <div class="rich-lesson-chain" role="img" aria-label="@Model.Description">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                <div class="rich-lesson-chain__item">@Model.Items[i]</div>
                @if (Model.Kind == RichLessonVisualKind.CalculationChain && i < Model.Items.Count - 1)
                {
                    <span class="rich-lesson-chain__arrow" aria-hidden="true">→</span>
                }
            }
        </div>
    }
    else if (Model.Kind is RichLessonVisualKind.NumberLine or RichLessonVisualKind.Scale)
    {
        // New source-bound B01 number lines encode the target TICK INDEX
        // separately from labels. Existing legacy visual items are unchanged.
        var targetTick = Model.Kind == RichLessonVisualKind.NumberLine &&
            int.TryParse(Model.SecondaryItems.ElementAtOrDefault(0),
                out var parsedTick) &&
            parsedTick >= 0 && parsedTick < Model.Items.Count
                ? parsedTick : -1;
        // A source-correct G2 number-line comparison has TWO tick targets,
        // not just the first one. Other visual contracts stay unchanged.
        var comparisonTicks=new HashSet<int>();
        if(Model.Kind==RichLessonVisualKind.NumberLine &&
            (Model.SecondaryLabel=="Two G2 number-line positions" ||
             Model.SecondaryLabel=="Two G4 decimal positions" ||
             Model.SecondaryLabel=="Two G3 quarter-inch positions") &&
            Model.SecondaryItems.Count==2 &&
            int.TryParse(Model.SecondaryItems[0],out var comparisonFirst) &&
            int.TryParse(Model.SecondaryItems[1],out var comparisonSecond) &&
            comparisonFirst>=0 && comparisonFirst<Model.Items.Count &&
            comparisonSecond>=0 && comparisonSecond<Model.Items.Count)
        {
            comparisonTicks.Add(comparisonFirst);
            comparisonTicks.Add(comparisonSecond);
        }
        // Ruler questions encode two actual centimeter MARK VALUES.
        // Mark their corresponding tick positions, not a guessed index.
        var rulerEndpoints = new HashSet<int>();
        if (Model.Kind == RichLessonVisualKind.Scale &&
            Model.SecondaryItems.Count == 2 &&
            int.TryParse(Model.SecondaryItems[0], out var firstEndpoint) &&
            int.TryParse(Model.SecondaryItems[1], out var lastEndpoint))
        {
            var firstIndex=Model.Items.IndexOf(firstEndpoint.ToString());
            var lastIndex=Model.Items.IndexOf(lastEndpoint.ToString());
            if (firstIndex >= 0 && lastIndex >= 0)
            {
                rulerEndpoints.Add(firstIndex);
                rulerEndpoints.Add(lastIndex);
            }
        }
        <div class="rich-number-line-scroll">
            <div class="rich-number-line" role="img" aria-label="@Model.Description">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    <div class="rich-number-line__tick @(i == targetTick || rulerEndpoints.Contains(i) || comparisonTicks.Contains(i) ? "rich-number-line__tick--target" : "")">
                        @if (i == targetTick || rulerEndpoints.Contains(i) || comparisonTicks.Contains(i))
                        {
                            <span aria-hidden="true" title="Marked target">◆</span>
                        }
                        <span class="rich-number-line__mark" aria-hidden="true"></span>
                        <strong>@Model.Items[i]</strong>
                    </div>
                }
            </div>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.DoubleNumberLine)
    {
        <div class="rich-double-line" role="img" aria-label="@Model.Description">
            <div class="rich-double-line__row">
                <strong>@Model.PrimaryLabel</strong>
                <div class="rich-double-line__values">
                    @foreach (var item in Model.Items)
                    {
                        <span>@item</span>
                    }
                </div>
            </div>
            <div class="rich-double-line__row">
                <strong>@Model.SecondaryLabel</strong>
                <div class="rich-double-line__values">
                    @foreach (var item in Model.SecondaryItems)
                    {
                        <span>@item</span>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.CounterPairs)
    {
        // Actual counter groups rather than a decorative EquationSet:
        // exactly two counters in every complete pair and one leftover if odd.
        var total = int.TryParse(Model.Items.ElementAtOrDefault(0),out var count)
            ? Math.Clamp(count,1,100) : 1;
        var pairCount = total / 2;
        var leftover = total % 2;
        <div class="rich-counter-pairs" role="img" aria-label="@Model.Description">
            <div class="rich-counter-pairs__groups"
                 style="display:flex;flex-wrap:wrap;gap:.65rem">
                @for(var pair=0;pair<pairCount;pair++)
                {
                    <div class="rich-counter-pairs__pair" aria-hidden="true"
                         style="display:flex;gap:.2rem;align-items:center;padding:.3rem;border:1px solid currentColor;border-radius:.5rem">
                        <span>●</span><span>●</span>
                    </div>
                }
                @if(leftover == 1)
                {
                    <div class="rich-counter-pairs__leftover" aria-hidden="true"
                         style="padding:.3rem;border:2px dashed currentColor;border-radius:.5rem">●</div>
                }
            </div>
            <p>@pairCount complete pairs, @leftover left over:
                @total is @(leftover == 0 ? "even" : "odd").</p>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.ClockFace)
    {
        // This is a mathematical clock face, not a symbolic circle icon.
        // Angles are derived from the structured hour/minute parameters;
        // numbers are invariant-culture for SVG numeric attributes.
        var hour = int.TryParse(Model.Items.ElementAtOrDefault(0), out var clockHour)
            ? Math.Clamp(clockHour, 1, 12) : 12;
        var minutes = int.TryParse(Model.Items.ElementAtOrDefault(1), out var clockMinutes)
            ? Math.Clamp(clockMinutes, 0, 59) : 0;
        var minuteRadians = Math.PI * 2 * minutes / 60.0 - Math.PI / 2;
        var hourRadians = Math.PI * 2 * ((hour % 12) + minutes / 60.0) / 12.0
            - Math.PI / 2;
        var minuteX = (100.0 + 73.0 * Math.Cos(minuteRadians))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var minuteY = (100.0 + 73.0 * Math.Sin(minuteRadians))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var hourX = (100.0 + 49.0 * Math.Cos(hourRadians))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var hourY = (100.0 + 49.0 * Math.Sin(hourRadians))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        <div class="rich-clock-figure" role="img" aria-label="@Model.Description">
            <svg viewBox="0 0 200 200" width="230" height="230"
                 style="max-width:100%;height:auto" aria-hidden="true">
                <circle cx="100" cy="100" r="90" fill="none"
                        stroke="currentColor" stroke-width="3"/>
                <circle cx="100" cy="100" r="84" fill="none"
                        stroke="currentColor" stroke-width="1" opacity="0.35"/>
                @* Every one-minute division is necessary for G3 nearest-minute
                   lessons: 60 mathematically equal angular increments, with
                   five-minute positions visibly longer. Not publisher artwork. *@
                @for (var mark = 0; mark < 60; mark++)
                {
                    var angle = 2.0 * Math.PI * mark / 60.0 - Math.PI / 2.0;
                    var startRadius = mark % 5 == 0 ? 77.0 : 82.0;
                    var endRadius = 88.0;
                    var x1 = (100.0 + startRadius * Math.Cos(angle))
                        .ToString(System.Globalization.CultureInfo.InvariantCulture);
                    var y1 = (100.0 + startRadius * Math.Sin(angle))
                        .ToString(System.Globalization.CultureInfo.InvariantCulture);
                    var x2 = (100.0 + endRadius * Math.Cos(angle))
                        .ToString(System.Globalization.CultureInfo.InvariantCulture);
                    var y2 = (100.0 + endRadius * Math.Sin(angle))
                        .ToString(System.Globalization.CultureInfo.InvariantCulture);
                    <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                          stroke="currentColor"
                          stroke-width="@(mark % 5 == 0 ? "2.1" : "1")"/>
                }
                @for (var number = 1; number <= 12; number++)
                {
                    var angle = 2.0 * Math.PI * number / 12.0 - Math.PI / 2.0;
                    var labelX = (100.0 + 64.0 * Math.Cos(angle))
                        .ToString(System.Globalization.CultureInfo.InvariantCulture);
                    var labelY = (100.0 + 64.0 * Math.Sin(angle))
                        .ToString(System.Globalization.CultureInfo.InvariantCulture);
                    @* Numeric values are generated only from the 1..12 loop;
                       emit SVG text via a trusted, invariant numeric fragment
                       because Razor reserves <text> as a control-flow element. *@
                    @Html.Raw("<text x=\"" + labelX + "\" y=\"" + labelY +
                        "\" text-anchor=\"middle\" dominant-baseline=\"middle\"" +
                        " fill=\"currentColor\" font-size=\"11\">" +
                        number.ToString(System.Globalization.CultureInfo.InvariantCulture) +
                        "</text>")
                }
                <line x1="100" y1="100" x2="@hourX" y2="@hourY"
                      stroke="currentColor" stroke-linecap="round" stroke-width="7"/>
                <line x1="100" y1="100" x2="@minuteX" y2="@minuteY"
                      stroke="currentColor" stroke-linecap="round" stroke-width="3"/>
                <circle cx="100" cy="100" r="5" fill="currentColor"/>
            </svg>
            <p>Time shown: @hour:@(minutes.ToString("00", System.Globalization.CultureInfo.InvariantCulture)). Each tick is one minute; the hour hand moves between hours.</p>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.FractionBars)
    {
        <div class="rich-fraction-bars" role="img" aria-label="@Model.Description">
            @foreach (var row in Model.Rows.Where(x => x.Denominator > 0))
            {
                var numerator = Math.Clamp(row.Numerator, 0, row.Denominator);
                <div class="rich-fraction-row">
                    <strong>@row.Label</strong>
                    <div class="rich-fraction-bar"
                         style="grid-template-columns:repeat(@row.Denominator,minmax(0,1fr));">
                        @for (var i = 0; i < row.Denominator; i++)
                        {
                            <span class="@(i < numerator ? "is-filled" : null)"></span>
                        }
                    </div>
                    <span>@numerator/@row.Denominator</span>
                </div>
            }
        </div>
    }
    else if (Model.Kind is RichLessonVisualKind.RatioTable or RichLessonVisualKind.PlaceValueChart)
    {
        <div class="rich-lesson-table-wrap">
            <table class="rich-lesson-table">
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <th scope="row">@row.Label</th>
                            @foreach (var cell in row.Cells)
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.TapeDiagram)
    {
        // Equal unit-width bars are aligned at zero, with the difference
        // displayed as a distinct unmatched segment, not guessed SVG pixels.
        var longer = int.TryParse(Model.Items.ElementAtOrDefault(0),out var l) ? l : 0;
        var shorter = int.TryParse(Model.Items.ElementAtOrDefault(1),out var s) ? s : 0;
        var difference = int.TryParse(Model.Items.ElementAtOrDefault(2),out var diff) ? diff : -1;
        var unknownPosition = int.TryParse(Model.Items.ElementAtOrDefault(3),out var pos)
            ? pos : 0;
        var tapeUnit = Model.SecondaryLabel switch
        {
            "cents" => "cents",
            "apples" => "apples",
            _ => "units"
        };
        if (longer > 0 && shorter > 0 && longer > shorter &&
            difference == longer - shorter)
        {
            var portion=(100.0*shorter/longer)
                .ToString("0.###",System.Globalization.CultureInfo.InvariantCulture);
            var remainder=(100.0*difference/longer)
                .ToString("0.###",System.Globalization.CultureInfo.InvariantCulture);
            <div class="rich-tape-diagram" role="img" aria-label="@Model.Description"
                 style="max-width:540px;">
                <p>First group: @(unknownPosition == 1 ? "?" : longer.ToString()) @tapeUnit</p>
                <div style="border:2px solid currentColor;padding:0.4rem;width:100%;box-sizing:border-box">
                    @longer equal @tapeUnit
                </div>
                <p>Second group: @(unknownPosition == 2 ? "?" : shorter.ToString()) @tapeUnit, plus @(unknownPosition == 0 ? "?" : difference.ToString()) extra @tapeUnit</p>
                <div style="display:flex;width:100%;box-sizing:border-box;">
                    <div style="border:2px solid currentColor;box-sizing:border-box;width:@(portion)%;" >
                        @(unknownPosition == 2 ? "?" : shorter.ToString())
                    </div>
                    <div style="border:2px dashed currentColor;box-sizing:border-box;width:@(remainder)%;">
                        @(unknownPosition == 0 ? "?" : difference.ToString())
                    </div>
                </div>
            </div>
        }
    }
    else if (Model.Kind == RichLessonVisualKind.PictureGraph)
    {
        var iconUnit=int.TryParse(Model.Items.ElementAtOrDefault(0),out var parsedUnit)
            ? parsedUnit : 0;
        if (iconUnit > 0)
        {
            <div class="rich-picture-graph" role="group" aria-label="@Model.Description">
                <p><strong>@Model.PrimaryLabel</strong></p>
                @foreach (var row in Model.Rows)
                {
                    @* Generic elementary picture graphs are mathematical data displays.
                       Unicode fruit symbols are rendered by the learner's font: no
                       publisher artwork, downloaded image or copied source asset. *@
                    var category = row.Label.Trim().ToLowerInvariant();
                    var independentSymbol = category switch
                    {
                        "apple" or "apples" or "jabłko" or "jabłka" or "تفاح" => "🍎",
                        "orange" or "oranges" or "pomarańcza" or "pomarańcze" or "برتقال" => "🍊",
                        "grape" or "grapes" or "winogrona" or "عنب" => "🍇",
                        "banana" or "bananas" or "banany" or "موز" => "🍌",
                        _ => "●"
                    };
                    <div class="rich-picture-graph__row" role="group"
                         aria-label="@($"{row.Label}: {row.Cells.Count} symbols; {row.Cells.Count*iconUnit} responses")">
                        <strong>@row.Label</strong>
                        <div style="display:flex;gap:0.35rem;flex-wrap:wrap" aria-hidden="true">
                            @foreach (var symbol in row.Cells)
                            {
                                <span class="rich-picture-graph__symbol">@independentSymbol</span>
                            }
                        </div>
                        <span>@(row.Cells.Count*iconUnit) responses</span>
                    </div>
                }
            </div>
        }
    }
    else if (Model.Kind == RichLessonVisualKind.LinePlot)
    {
        // A true numerical line plot has equal tick spacing and X stacks.
        <div class="rich-line-plot" role="group" aria-label="@Model.Description"
             style="display:flex;align-items:flex-end;gap:1rem;overflow-x:auto;border-bottom:2px solid currentColor;padding:0.75rem;">
            @foreach (var row in Model.Rows)
            {
                <div class="rich-line-plot__column"
                     role="group" aria-label="@($"{row.Label}: {row.Cells.Count} measured objects")"
                     style="display:flex;flex-direction:column;align-items:center;min-width:2.75rem;">
                    <div class="rich-line-plot__marks" aria-hidden="true"
                         style="display:flex;flex-direction:column-reverse;align-items:center;">
                        @foreach (var mark in row.Cells)
                        {
                            <strong>×</strong>
                        }
                    </div>
                    <span aria-hidden="true">│</span>
                    <strong>@row.Label</strong>
                </div>
            }
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.BarGraph)
    {
        // Native progress meters keep each verified category count proportional,
        // readable with assistive technology and usable without JavaScript.
        var counts = Model.Rows
            .Select(r => int.TryParse(r.Cells.FirstOrDefault(), out var count)
                ? Math.Max(0, count) : 0)
            .ToArray();
        var graphMax = Math.Max(1, counts.DefaultIfEmpty(0).Max());
        <div class="rich-lesson-bar-graph"
             role="group" aria-label="@Model.Description">
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                var category = Model.Rows[i].Label;
                var count = counts[i];
                <div class="rich-lesson-bar-graph__row">
                    <label for="rich-bar-@i-@Model.GetHashCode()">@category</label>
                    <progress id="rich-bar-@i-@Model.GetHashCode()" value="@count"
                              max="@graphMax" aria-label="@category: @count"></progress>
                    <strong>@count</strong>
                </div>
            }
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.RectangleDiagram)
    {
        // True rectangle aspect ratio from the SAME two side lengths used by
        // the independently verified area question. No decorative tile grid.
        var rectangleLength = int.TryParse(Model.Items.ElementAtOrDefault(0),
            out var parsedLength) ? Math.Clamp(parsedLength, 1, 100) : 1;
        var rectangleWidth = int.TryParse(Model.Items.ElementAtOrDefault(1),
            out var parsedWidth) ? Math.Clamp(parsedWidth, 1, 100) : 1;
        var measureUnit=Model.SecondaryLabel is "m" or "ft" or "cm" or "in"
            ? Model.SecondaryLabel : "units";
        // Both comparative rectangles use precisely 12 pixels per unit.
        // Independently fitting each would misrepresent their relative sizes.
        var diagramScale = Model.SecondaryLabel=="fixed-comparison-scale"
            ? 12.0
            : Math.Min(152.0 / rectangleLength,100.0 / rectangleWidth);
        var diagramW = (rectangleLength * diagramScale)
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var diagramH = (rectangleWidth * diagramScale)
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var rectangleX = ((220 - rectangleLength * diagramScale) / 2)
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var rectangleY = ((165 - rectangleWidth * diagramScale) / 2)
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        <div class="rich-rectangle-diagram" role="img" aria-label="@Model.Description">
            <svg viewBox="0 0 220 200" width="280" height="250"
                 style="max-width:100%;height:auto" aria-hidden="true">
                <rect x="@rectangleX" y="@rectangleY" width="@diagramW"
                      height="@diagramH" fill="none"
                      stroke="currentColor" stroke-width="3" />
                <text x="110" y="185" text-anchor="middle"
                      fill="currentColor">@($"{rectangleLength} {measureUnit} long")</text>
                <text x="110" y="22" text-anchor="middle"
                      fill="currentColor">@($"{rectangleWidth} {measureUnit} wide")</text>
            </svg>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.PolygonDiagram)
    {
        // These are first-party, fixed instructional geometries. The label
        // is selected by a verified question family, never raw SVG input.
        var polygonType = Model.Items.FirstOrDefault() ?? "";
        var polygonPoints = polygonType switch
        {
            "triangle" => "36,140 118,25 191,140",
            "narrow triangle" => "75,145 112,18 145,145",
            "tilted triangle" => "35,115 171,35 182,151",
            "equilateral triangle" => "110,24 44,138 176,138",
            "right triangle" => "42,26 42,140 182,140",
            "quadrilateral" => "44,34 173,40 190,138 37,135",
            "rhombus" => "110,20 179,88 110,156 41,88",
            "rectangle" => "38,43 182,43 182,137 38,137",
            "square" => "50,26 169,26 169,145 50,145",
            "pentagon" => "110,18 191,76 159,156 59,156 29,76",
            "hexagon" => "63,22 157,22 195,87 157,152 63,152 25,87",
            _ => ""
        };
        @if (!string.IsNullOrEmpty(polygonPoints))
        {
            <div class="rich-polygon-diagram" role="img" aria-label="@Model.Description">
                <svg viewBox="0 0 220 175" xmlns="http://www.w3.org/2000/svg"
                     style="width:100%;height:auto;max-width:300px"
                     aria-hidden="true" focusable="false">
                    <polygon points="@polygonPoints" fill="none"
                             stroke="currentColor" stroke-width="4"
                             stroke-linejoin="round" />
                </svg>
                <p>@Model.Title</p>
            </div>
        }
    }
    else if (Model.Kind == RichLessonVisualKind.ShapeDecomposition)
    {
        @if (Model.SecondaryLabel == "Independent-G4-18x24-Rectangular-Partition" &&
             Model.Rows.Count == 6 &&
             Model.Rows.All(r=>r.Cells.Count==3 &&
                 r.Cells.All(s=>int.TryParse(s,out var n) && n>0)) &&
             Model.Rows.Sum(r=>int.Parse(r.Cells[0])) == 18 &&
             Model.Rows.All(r=>int.Parse(r.Cells[1])+int.Parse(r.Cells[2])==24))
        {
            @* Each of six horizontal bands spans exactly 24 unit columns;
               their heights sum to 18, producing 12 non-overlapping
               rectangles on a consistent linear scale (1 cell = 16px). *@
            <div role="group" aria-label="@Model.Description" class="rich-g4-rectangle-design">
                <svg viewBox="0 0 424 328" xmlns="http://www.w3.org/2000/svg"
                     style="width:min(100%,424px);height:auto" aria-hidden="true" focusable="false">
                    @for(var i=0;i<Model.Rows.Count;i++)
                    {
                        var cells=Model.Rows[i].Cells;
                        var height=int.Parse(cells[0])*16;
                        var y=20+Model.Rows.Take(i).Sum(r=>int.Parse(r.Cells[0]))*16;
                        var left=int.Parse(cells[1])*16;
                        var right=int.Parse(cells[2])*16;
                        <rect x="20" y="@y" width="@left" height="@height"
                              fill="#dbeafe" stroke="currentColor" stroke-width="1.5"/>
                        <rect x="@(20+left)" y="@y" width="@right" height="@height"
                              fill="#fef3c7" stroke="currentColor" stroke-width="1.5"/>
                        @* Y is derived from previous band heights: no mutable state. *@
                    }
                </svg>
                <p>Six bands × two rectangles = 12 rectangles. Two small
                regions have areas 1 × 2 = 2 and 2 × 1 = 2, both prime.
                Overall area: 18 × 24 = 432 square units.</p>
            </div>
        }
        else if (Model.SecondaryLabel == "Independent-Nested-Midpoint-Squares" &&
             Model.Items.SequenceEqual(new[] {"0","1","2","3"}))
        {
            @* Every nested square is formed by joining the midpoints
               of the previous square's sides. *@
            <div class="rich-midpoint-squares" role="group" aria-label="@Model.Description">
                <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg"
                     aria-hidden="true" focusable="false"
                     style="width:min(100%,320px);height:auto">
                    <polygon points="20,20 220,20 220,220 20,220"
                             fill="none" stroke="currentColor" stroke-width="2.5"/>
                    <polygon points="120,20 220,120 120,220 20,120"
                             fill="none" stroke="#2563eb" stroke-width="3"/>
                    <polygon points="70,70 170,70 170,170 70,170"
                             fill="none" stroke="#059669" stroke-width="3"/>
                    <polygon points="120,70 170,120 120,170 70,120"
                             fill="none" stroke="#b45309" stroke-width="3"/>
                    @foreach(var midpoint in new[]{(120,20),(220,120),(120,220),(20,120)})
                    {
                        <circle cx="@midpoint.Item1" cy="@midpoint.Item2" r="4"
                                fill="currentColor"/>
                    }
                </svg>
                <p>Outer square → join the side midpoints → repeat twice.
                   Every marked point is at ½ of its side.</p>
            </div>
        }
        else if (Model.SecondaryLabel == "Equal-size-square-grid" &&
             int.TryParse(Model.Items.ElementAtOrDefault(0),out var gridRows) &&
             int.TryParse(Model.Items.ElementAtOrDefault(1),out var gridColumns) &&
             gridRows > 0 && gridColumns > 0 &&
             Model.Rows.Count == gridRows &&
             Model.Rows.All(row=>row.Cells.Count==gridColumns))
        {
            var template=$"repeat({gridColumns},2rem)";
            <div role="img" aria-label="@Model.Description"
                 style="display:grid;grid-template-columns:@template;gap:0;width:max-content">
                @foreach (var row in Model.Rows)
                {
                    @foreach (var tile in row.Cells)
                    {
                        <span aria-hidden="true"
                              style="display:block;width:2rem;height:2rem;box-sizing:border-box;border:1px solid currentColor"></span>
                    }
                }
            </div>
        }
        else
        {
            <div class="rich-shape-decomposition" role="img" aria-label="@Model.Description">
            @foreach (var row in Model.Rows)
            {
                <article class="rich-shape-card">
                    <strong>@row.Label</strong>
                    @foreach (var cell in row.Cells)
                    {
                        <span>@cell</span>
                    }
                </article>
            }
            </div>
        }
    }
</figure>
