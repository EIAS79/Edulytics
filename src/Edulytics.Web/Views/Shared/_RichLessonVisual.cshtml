@model Edulytics.Core.Curriculum.RichLessonVisual
@using Edulytics.Core.Curriculum
@{
    var kindClass = Model.Kind.ToString().ToLowerInvariant();
}

<figure class="rich-lesson-visual rich-lesson-visual--@kindClass">
    <div class="rich-lesson-visual__header">
        <h3>@Model.Title</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
    </div>

    @if (Model.Kind is RichLessonVisualKind.CalculationChain or RichLessonVisualKind.EquationSet)
    {
        <div class="rich-lesson-chain" role="img" aria-label="@Model.Description">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                <div class="rich-lesson-chain__item">@Model.Items[i]</div>
                @if (Model.Kind == RichLessonVisualKind.CalculationChain && i < Model.Items.Count - 1)
                {
                    <span class="rich-lesson-chain__arrow" aria-hidden="true">→</span>
                }
            }
        </div>
    }
    else if (Model.Kind is RichLessonVisualKind.NumberLine or RichLessonVisualKind.Scale)
    {
        <div class="rich-number-line-scroll">
            <div class="rich-number-line" role="img" aria-label="@Model.Description">
                @foreach (var item in Model.Items)
                {
                    <div class="rich-number-line__tick">
                        <span class="rich-number-line__mark" aria-hidden="true"></span>
                        <strong>@item</strong>
                    </div>
                }
            </div>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.DoubleNumberLine)
    {
        <div class="rich-double-line" role="img" aria-label="@Model.Description">
            <div class="rich-double-line__row">
                <strong>@Model.PrimaryLabel</strong>
                <div class="rich-double-line__values">
                    @foreach (var item in Model.Items)
                    {
                        <span>@item</span>
                    }
                </div>
            </div>
            <div class="rich-double-line__row">
                <strong>@Model.SecondaryLabel</strong>
                <div class="rich-double-line__values">
                    @foreach (var item in Model.SecondaryItems)
                    {
                        <span>@item</span>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.FractionBars)
    {
        <div class="rich-fraction-bars" role="img" aria-label="@Model.Description">
            @foreach (var row in Model.Rows.Where(x => x.Denominator > 0))
            {
                var numerator = Math.Clamp(row.Numerator, 0, row.Denominator);
                <div class="rich-fraction-row">
                    <strong>@row.Label</strong>
                    <div class="rich-fraction-bar"
                         style="grid-template-columns:repeat(@row.Denominator,minmax(0,1fr));">
                        @for (var i = 0; i < row.Denominator; i++)
                        {
                            <span class="@(i < numerator ? "is-filled" : null)"></span>
                        }
                    </div>
                    <span>@numerator/@row.Denominator</span>
                </div>
            }
        </div>
    }
    else if (Model.Kind is RichLessonVisualKind.RatioTable or RichLessonVisualKind.PlaceValueChart)
    {
        <div class="rich-lesson-table-wrap">
            <table class="rich-lesson-table">
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <th scope="row">@row.Label</th>
                            @foreach (var cell in row.Cells)
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.Grade4Unit1AreaFigures)
    {
        // Independently drawn grade-four 2021 source-equivalent mathematical shapes.
        // No publisher pixels, logos, or source asset are embedded.
        <div class="rich-lesson-area-models">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 450"
                 role="img" aria-label="@Model.Description"
                 style="width:100%;max-width:720px;height:auto">
                <g fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="75" y="65" width="140" height="112"/>
                    <rect x="395" y="65" width="112" height="140"/>
                    @for (var i = 1; i < 4; i++)
                    {
                        <line x1="@(395 + i * 28)" x2="@(395 + i * 28)" y1="65" y2="205"/>
                    }
                    @for (var i = 1; i < 5; i++)
                    {
                        <line x1="395" x2="507" y1="@(65 + i * 28)" y2="@(65 + i * 28)"/>
                    }
                    <rect x="100" y="270" width="100" height="150"/>
                    <path d="M395 270 H435 V350 H475 V410 H395 Z"/>
                </g>
                <g fill="currentColor" font-family="sans-serif" font-size="18">
                    <text x="45" y="45">A</text>
                    <text x="390" y="45">B</text>
                    <text x="45" y="250">C</text>
                    <text x="390" y="250">D</text>
                    <text x="140" y="55">5</text>
                    <text x="50" y="125">4</text>
                    <text x="140" y="263">4</text>
                    <text x="77" y="355">6</text>
                    <text x="408" y="263">2</text>
                    <text x="370" y="350">7</text>
                    <text x="447" y="343">2</text>
                    <text x="485" y="389">3</text>
                </g>
            </svg>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.Grade5Unit1CubeComparison)
    {
        // Grade 5 first-edition task, independently authored geometric models.
        // The four 3D cube assemblies are mathematical constructions, not
        // publisher artwork or an endorsement by Illustrative Mathematics.
        var cubeModels = new[]
        {
            new
            {
                Label = "A", Count = 8, Explanation = "2 × 2 × 2 = 8",
                Cubes = Enumerable.Range(0, 2).SelectMany(x =>
                    Enumerable.Range(0, 2).SelectMany(y =>
                        Enumerable.Range(0, 2).Select(z => (X: x, Y: y, Z: z)))).ToArray()
            },
            new
            {
                Label = "B", Count = 8, Explanation = "5 bottom + 3 above = 8",
                Cubes = Enumerable.Range(0, 5).Select(x => (X: x, Y: 0, Z: 0))
                    .Concat(Enumerable.Range(1, 3).Select(x => (X: x, Y: 0, Z: 1))).ToArray()
            },
            new
            {
                Label = "C", Count = 8, Explanation = "2 × 1 × 4 = 8",
                Cubes = Enumerable.Range(0, 2).SelectMany(x =>
                    Enumerable.Range(0, 4).Select(z => (X: x, Y: 0, Z: z))).ToArray()
            },
            new
            {
                Label = "D", Count = 10, Explanation = "5 × 1 × 2 = 10",
                Cubes = Enumerable.Range(0, 5).SelectMany(x =>
                    Enumerable.Range(0, 2).Select(z => (X: x, Y: 0, Z: z))).ToArray()
            }
        };
        <div class="rich-lesson-cube-models">
            <svg viewBox="0 0 960 590" xmlns="http://www.w3.org/2000/svg"
                 role="img" aria-label="@Model.Description"
                 style="width:100%;max-width:900px;height:auto">
                @for (var index = 0; index < cubeModels.Length; index++)
                {
                    var cubeSet = cubeModels[index];
                    var originX = 120 + index % 2 * 450;
                    var originY = 165 + index / 2 * 270;
                    <g>
                        <text x="@(originX - 60)" y="@(originY - 125)"
                              font-size="21" font-weight="bold"
                              fill="currentColor">@cubeSet.Label — @cubeSet.Count cubes</text>
                        @foreach (var cube in cubeSet.Cubes.OrderBy(x => x.X + x.Y + x.Z)
                                             .ThenBy(x => x.Z))
                        {
                            var px = originX + (cube.X - cube.Y) * 23;
                            var py = originY + (cube.X + cube.Y) * 12 - cube.Z * 30;
                            var top = $"{px},{py - 30} {px + 23},{py - 18} {px},{py - 6} {px - 23},{py - 18}";
                            var left = $"{px - 23},{py - 18} {px},{py - 6} {px},{py + 20} {px - 23},{py + 8}";
                            var right = $"{px},{py - 6} {px + 23},{py - 18} {px + 23},{py + 8} {px},{py + 20}";
                            <polygon points="@top" fill="#e9f3fc"
                                     stroke="#31536f" stroke-width="1.5" />
                            <polygon points="@left" fill="#b5d5ee"
                                     stroke="#31536f" stroke-width="1.5" />
                            <polygon points="@right" fill="#80b5db"
                                     stroke="#31536f" stroke-width="1.5" />
                        }
                        <text x="@(originX - 60)" y="@(originY + 90)"
                              font-size="17" fill="currentColor">@cubeSet.Explanation</text>
                    </g>
                }
            </svg>
        </div>
    }
﻿    else if (Model.Kind == RichLessonVisualKind.Grade5Unit1CubeModelWodb)
    {
        // Author-created, mathematically source-aligned Grade 5 U01:L02
        // constructions. Do not use original publisher figure pixels.
        var models = new[]
        {
            Enumerable.Range(0, 2).SelectMany(segment =>
                Enumerable.Range(0, 2).SelectMany(y =>
                    Enumerable.Range(0, 3).Select(z =>
                        (X: segment * 4, Y: y, Z: z)))).ToArray(),
            Enumerable.Range(0, 2).SelectMany(x =>
                Enumerable.Range(0, 2).SelectMany(y =>
                    Enumerable.Range(0, 3).Select(z => (X: x, Y: y, Z: z))))
                    .Where(c => c != (X: 1, Y: 1, Z: 2)).ToArray(),
            new[] { 4, 4, 3, 1 }.SelectMany((n, z) =>
                Enumerable.Range(0, n).Select(x => (X: x, Y: 0, Z: z))).ToArray(),
            Enumerable.Range(0, 3).SelectMany(x =>
                Enumerable.Range(0, 2).SelectMany(y =>
                    Enumerable.Range(0, 2).Select(z => (X: x, Y: y, Z: z)))).ToArray()
        };
        var labels = new[] { "A", "B", "C", "D" };
        var details = new[]
        {
            "2 separate prisms; 6 + 6",
            "1 missing top cube; 11",
            "4 + 4 + 3 + 1 = 12",
            "3 by 2 by 2; 12"
        };
        <div class="rich-lesson-cube-models">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 650"
                 role="img" aria-label="@Model.Description"
                 style="max-width:960px;width:100%;height:auto">
                @for (var modelIndex = 0; modelIndex < models.Length; modelIndex++)
                {
                    var cx = 120 + (modelIndex % 2) * 470;
                    var cy = 190 + (modelIndex / 2) * 310;
                    var cubes = models[modelIndex];
                    <g>
                        <text x="@(cx - 75)" y="@(cy - 150)" font-size="22"
                              fill="currentColor" font-weight="bold">
                            @labels[modelIndex]: @cubes.Length cubes
                        </text>
                        @foreach (var cube in cubes.OrderBy(c => c.X + c.Y + c.Z).ThenBy(c => c.Z))
                        {
                            var x = cx + (cube.X - cube.Y) * 24;
                            var y = cy + (cube.X + cube.Y) * 12 - cube.Z * 30;
                            var faceTop = $"{x},{y - 30} {x + 24},{y - 18} {x},{y - 6} {x - 24},{y - 18}";
                            var faceLeft = $"{x - 24},{y - 18} {x},{y - 6} {x},{y + 20} {x - 24},{y + 8}";
                            var faceRight = $"{x},{y - 6} {x + 24},{y - 18} {x + 24},{y + 8} {x},{y + 20}";
                            <polygon points="@faceTop" fill="#e9f3fc" stroke="#31536f" stroke-width="1.6"/>
                            <polygon points="@faceLeft" fill="#b5d5ee" stroke="#31536f" stroke-width="1.6"/>
                            <polygon points="@faceRight" fill="#80b5db" stroke="#31536f" stroke-width="1.6"/>
                        }
                        <text x="@(cx - 75)" y="@(cy + 104)" fill="currentColor"
                              font-size="17">@details[modelIndex]</text>
                    </g>
                }
            </svg>
        </div>
    }

    else if (Model.Kind == RichLessonVisualKind.CartesianPlot)
    {
        // Reuse the RichV2 visual model; original learner-safe SVG graph, not
        // a publisher asset. Rows encode [x,y] numeric coordinates by series name.
        // Do not render non-finite, negative or oversized coordinates.
        var points = new List<(string Series, double X, double Y)>();
        foreach (var row in Model.Rows)
        {
            if (row.Cells.Count < 2 ||
                !double.TryParse(row.Cells[0], System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var x) ||
                !double.TryParse(row.Cells[1], System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var y) ||
                !double.IsFinite(x) || !double.IsFinite(y) ||
                x < 0 || y < 0 || x > 10000 || y > 10000)
            {
                continue;
            }
            points.Add((row.Label, x, y));
        }
        var maxX = Math.Ceiling(Math.Max(4d,
            points.Count > 0 ? points.Max(p => p.X) : 4d));
        var yMaxValue = Math.Max(10d,
            points.Count > 0 ? points.Max(p => p.Y) : 10d);
        var yTick = Math.Ceiling(yMaxValue / 5d);
        var yTop = yTick * 5d;
        var series = points.Select(p => p.Series)
            .Distinct(StringComparer.Ordinal).ToArray();
        var palette = new[] { "#1d4ed8", "#b91c1c", "#047857", "#7c3aed" };
        <div class="rich-lesson-cartesian" dir="ltr">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 750 440"
                 role="img" aria-label="@Model.Description"
                 style="width:100%;height:auto;max-width:760px">
                <title>@Model.Title</title>
                <desc>@Model.Description</desc>
                @for (var tick = 0; tick <= 5; tick++)
                {
                    var y = 340d - 275d * tick / 5d;
                    var value = tick * yTick;
                    <line x1="80" x2="650" y1="@y" y2="@y"
                          stroke="currentColor" stroke-opacity=".16" />
                    <text x="66" y="@(y + 5)" fill="currentColor"
                          text-anchor="end" font-size="15">
                        @value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)
                    </text>
                }
                @for (var tick = 0; tick <= (int)maxX; tick++)
                {
                    var x = 80d + 560d * tick / maxX;
                    <line x1="@x" x2="@x" y1="65" y2="340"
                          stroke="currentColor" stroke-opacity=".16" />
                    <text x="@x" y="365" fill="currentColor"
                          text-anchor="middle" font-size="15">@tick</text>
                }
                <line x1="80" x2="658" y1="340" y2="340"
                      stroke="currentColor" stroke-width="2" />
                <line x1="80" x2="80" y1="48" y2="340"
                      stroke="currentColor" stroke-width="2" />
                @foreach (var point in points)
                {
                    var px = 80d + 560d * point.X / maxX;
                    var py = 340d - 275d * point.Y / yTop;
                    var si = Array.IndexOf(series, point.Series);
                    var color = palette[(si < 0 ? 0 : si) % palette.Length];
                    <circle cx="@px" cy="@py" r="6" fill="@color"
                            stroke="#fff" stroke-width="1.5" />
                }
                <text x="360" y="405" fill="currentColor"
                      text-anchor="middle" font-size="18">@Model.PrimaryLabel</text>
                <text transform="translate(24 203) rotate(-90)" fill="currentColor"
                      text-anchor="middle" font-size="18">@Model.SecondaryLabel</text>
                @for (var i = 0; i < series.Length && i < 4; i++)
                {
                    <circle cx="@(530 + (i % 2) * 110)" cy="@(20 + (i / 2) * 20)"
                            r="5" fill="@palette[i]" />
                    <text x="@(541 + (i % 2) * 110)"
                          y="@(25 + (i / 2) * 20)"
                          font-size="13" fill="currentColor">@series[i]</text>
                }
            </svg>
        </div>
        <div class="rich-lesson-table-wrap">
            <table class="rich-lesson-table">
                <caption>@Model.Title — البيانات الرقمية</caption>
                <thead><tr><th scope="col">المجموعة</th>
                    <th scope="col">@Model.PrimaryLabel</th>
                    <th scope="col">@Model.SecondaryLabel</th></tr></thead>
                <tbody>
                @foreach (var point in points)
                {
                    <tr><th scope="row">@point.Series</th>
                        <td>@point.X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@point.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Kind == RichLessonVisualKind.ShapeDecomposition)
    {
        <div class="rich-shape-decomposition" role="img" aria-label="@Model.Description">
            @foreach (var row in Model.Rows)
            {
                <article class="rich-shape-card">
                    <strong>@row.Label</strong>
                    @foreach (var cell in row.Cells)
                    {
                        <span>@cell</span>
                    }
                </article>
            }
        </div>
    }
</figure>
