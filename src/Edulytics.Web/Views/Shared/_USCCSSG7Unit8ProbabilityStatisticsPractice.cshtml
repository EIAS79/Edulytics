@model Edulytics.Core.Curriculum.LessonContent.RichLessonV2

@if (Model.LessonCode == "PED:US-CCSS-MATH:G7:U08:L01")
{
  <section class="rich-lesson-section" data-g7-u08-l01 aria-label="Grade 7 Mystery Bags">
    <h3>Mystery Bags — Edulytiks</h3>
    <h4>Source-aligned focus</h4><p>Use repeated random draws to make a reasonable prediction about an unknown population. Keep experimental results and assumptions explicit.</p>
    <h4>Activity connection</h4><p>Mystery-bag sampling and comparing observed frequencies. Machine Practice checks only closed probability/statistic subresults; simulation design, displays, and inference remain teacher reviewed.</p>
    <h4>Cool-down — first-party Edulytiks assessment</h4><p>In 40 draws with replacement, a red block appears 14 times. Estimate the probability of red and predict how many red results you would expect in 100 similar draws. Explain why the estimate need not equal the exact bag composition.</p>
    <p><strong>Teacher review:</strong> Check sampling or simulation design, representation, assumptions, statistical interpretation, and written reasoning. This Cool-down is independently authored.</p>
  </section>
}

@if (Model.LessonCode == "PED:US-CCSS-MATH:G7:U08:L02")
{
  <section class="rich-lesson-section" data-g7-u08-l02 aria-label="Grade 7 Chance Experiments">
    <h3>Chance Experiments — Edulytiks</h3>
    <h4>Source-aligned focus</h4><p>Interpret probability values as fractions, decimals, and percentages between 0 and 1. Keep experimental results and assumptions explicit.</p>
    <h4>Activity connection</h4><p>Likelihood language, number-cube experiments, and probability card sort. Machine Practice checks only closed probability/statistic subresults; simulation design, displays, and inference remain teacher reviewed.</p>
    <h4>Cool-down — first-party Edulytiks assessment</h4><p>A game has probability 3/8 of winning. Write the probability as a decimal and percentage, place it between impossible and certain, and compare it with a 45% event.</p>
    <p><strong>Teacher review:</strong> Check sampling or simulation design, representation, assumptions, statistical interpretation, and written reasoning. This Cool-down is independently authored.</p>
  </section>
}
