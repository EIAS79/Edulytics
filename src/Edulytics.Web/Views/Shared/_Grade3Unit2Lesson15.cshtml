            <rect x="132" y="48" width="50" height="32" fill="#e5d4ae" stroke="#8a7346" stroke-dasharray="4 3" />
            <text x="157" y="68" text-anchor="middle" font-size="12">closet</text>
            <line x1="70" y1="83" x2="70" y2="128" stroke="#fff" stroke-width="5" />
