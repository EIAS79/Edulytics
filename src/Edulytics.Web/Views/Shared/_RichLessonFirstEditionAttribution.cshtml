@model Edulytics.Core.Curriculum.RichLessonContentV2Lesson
@using System.Text.RegularExpressions
@using System.Globalization
@{
    // B01 500-source contract. Refer to the original 2019–2021 edition,
    // never the differently licensed IM v.360 edition.
    var sourceCode = Regex.Match(
        Model.LessonCode,
        @"^PED:US-CCSS-MATH:G(?<grade>[1-4]):U(?<unit>\d{2}):L(?<lesson>\d{2})$",
        RegexOptions.CultureInvariant);
    var originalTeacherSource = sourceCode.Success
        ? $"https://im.kendallhunt.com/k5/teachers/grade-{sourceCode.Groups["grade"].Value}/unit-{int.Parse(sourceCode.Groups["unit"].Value, CultureInfo.InvariantCulture)}/lesson-{int.Parse(sourceCode.Groups["lesson"].Value, CultureInfo.InvariantCulture)}/preparation.html"
        : null;
    var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var title = language switch
    {
        "pl" => "Źródło i licencja",
        "ar" => "المصدر والترخيص",
        _ => "Source and license"
    };
    var basedOn = language switch
    {
        "pl" => "Materiał opracowany na podstawie",
        "ar" => "محتوى تعليمي مُعدّ بالاعتماد على",
        _ => "Educational material adapted from"
    };
    var byAuthor = language switch
    {
        "pl" => "autorstwa",
        "ar" => "من تأليف",
        _ => "authored by"
    };
    var licensedAs = language switch
    {
        "pl" => "Na licencji",
        "ar" => "بموجب الترخيص",
        _ => "Licensed under"
    };
    var adapted = language switch
    {
        "pl" => "Wyjaśnienia i wizualizacje dostosowano dla Edulytics; zmiany nie są zatwierdzone ani autoryzowane przez Illustrative Mathematics.",
        "ar" => "تم تكييف الشروحات والتمثيلات التعليمية لـ Edulytics. لا يعني ذلك اعتمادًا أو شراكةً مع Illustrative Mathematics.",
        _ => "Explanations and instructional visuals are adapted for Edulytics. This does not imply endorsement or affiliation with Illustrative Mathematics."
    };
    var thirdParty = language switch
    {
        "pl" => "Grafiki przypisane innym autorom mogą podlegać odrębnym licencjom; ich licencja nie wynika automatycznie z CC BY 4.0 programu.",
        "ar" => "قد تخضع صور الأطراف الثالثة لتراخيص مستقلة، ولا تنتقل إليها تلقائيًا رخصة CC BY 4.0 الخاصة بالمنهج.",
        _ => "Separately attributed third-party images may have their own licenses and are not automatically covered by the curriculum's CC BY 4.0 license."
    };
}
@if (originalTeacherSource is not null)
{
    <footer class="rich-lesson-source-attribution"
            aria-label="@title"
            data-edulytics-curriculum-source="im-k5-first-edition-2021">
        <p dir="auto" class="rich-lesson-source-attribution__credit">
            <strong>@title:</strong>
            @basedOn
            <a href="@originalTeacherSource" target="_blank"
               rel="noopener noreferrer external">IM® K–12 Math (2019–2021)</a>
            @byAuthor
            <a href="https://illustrativemathematics.org/"
               target="_blank" rel="noopener noreferrer external">Illustrative Mathematics®</a>.
            @licensedAs
            <a href="https://creativecommons.org/licenses/by/4.0/"
               target="_blank" rel="noopener noreferrer external">CC BY 4.0</a>.
            @adapted
        </p>
        <p dir="auto" class="rich-lesson-source-attribution__notice">
            @thirdParty
        </p>
    </footer>
}
