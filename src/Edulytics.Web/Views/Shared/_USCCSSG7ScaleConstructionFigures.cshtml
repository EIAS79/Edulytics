@model Edulytics.Core.Curriculum.RichLessonContentV2Lesson
@{
    // Grade 7-specific opt-in visual. This partial deliberately has no
    // global renderer registration or scoring side effects. Supervisor 1
    // owns the shared Rich V2 invocation and authenticated proof.
    var assetPath = Model.LessonCode switch
    {
        "PED:US-CCSS-MATH:G7:U01:L01" =>
            "/curriculum/us-ccss-g7/geometry/u01-l01-scaled-vs-stretched.svg",
        "PED:US-CCSS-MATH:G7:U01:L02" =>
            "/curriculum/us-ccss-g7/geometry/u01-l02-corresponding-triangles.svg",
        "PED:US-CCSS-MATH:G7:U01:L03" =>
            "/curriculum/us-ccss-g7/geometry/u01-l03-scaled-l-construction.svg",
        "PED:US-CCSS-MATH:G7:U01:L04" =>
            "/curriculum/us-ccss-g7/geometry/u01-l04-hidden-distances-and-angles.svg",
        "PED:US-CCSS-MATH:G7:U01:L05" =>
            "/curriculum/us-ccss-g7/geometry/u01-l05-size-and-inverse-scale.svg",
        "PED:US-CCSS-MATH:G7:U01:L06" =>
            "/curriculum/us-ccss-g7/geometry/u01-l06-tiling-and-area-factors.svg",
        "PED:US-CCSS-MATH:G7:U01:L07" =>
            "/curriculum/us-ccss-g7/geometry/u01-l07-court-scale-and-bench.svg",
        "PED:US-CCSS-MATH:G7:U01:L08" =>
            "/curriculum/us-ccss-g7/geometry/u01-l08-scale-map-road-vs-direct.svg",
        "PED:US-CCSS-MATH:G7:U01:L09" =>
            "/curriculum/us-ccss-g7/geometry/u01-l09-studio-floor-plan-with-door.svg",
        "PED:US-CCSS-MATH:G7:U01:L10" =>
            "/curriculum/us-ccss-g7/geometry/u01-l10-changing-plan-scales.svg",
        "PED:US-CCSS-MATH:G7:U01:L11" =>
            "/curriculum/us-ccss-g7/geometry/u01-l11-unitless-scale-conversion.svg",
        "PED:US-CCSS-MATH:G7:U01:L12" =>
            "/curriculum/us-ccss-g7/geometry/u01-l12-unit-conversion-area-flag.svg",
        "PED:US-CCSS-MATH:G7:U01:L13" =>
            "/curriculum/us-ccss-g7/geometry/u01-l13-classroom-floor-plan-peer-review.svg",
        _ => null
    };

    var altText = Model.LessonCode switch
    {
        "PED:US-CCSS-MATH:G7:U01:L01" =>
            "Original block letter F with width 4 and height 5, a correct copy twice as wide and twice as tall, and a counterexample twice as wide but unchanged in height. All use the same drawing unit.",
        "PED:US-CCSS-MATH:G7:U01:L02" =>
            "Two right triangles at equal page units: ABC has legs 4 and 3, and corresponding DEF has legs 6 and 4.5. Vertex pairs A to D, B to E and C to F show scale factor 1.5; the right angles remain 90 degrees.",
        "PED:US-CCSS-MATH:G7:U01:L03" =>
            "Three six-vertex L polygons at one common drawing unit: original width 6 height 5; smaller width 3 height 2.5 under scale factor one-half; larger width 18 height 15 under factor 3.",
        "PED:US-CCSS-MATH:G7:U01:L04" =>
            "Two rectangles at the same drawing units. The original measures 4 by 3 with an unmarked diagonal of 5; the factor-two copy measures 8 by 6 with a corresponding diagonal of 10. All corresponding right angles stay 90 degrees.",
        "PED:US-CCSS-MATH:G7:U01:L05" =>
            "At the same 14-pixel-per-unit drawing scale: reduced rectangle 4 by 2 with factor one-half, original rectangle 8 by 4 with factor one, and enlarged rectangle 12 by 6 with factor three-halves. Reciprocal factors reconstruct the original.",
        "PED:US-CCSS-MATH:G7:U01:L06" =>
            "Equal unit-square tiles cover an original 3 by 1 rectangle, a factor-two 6 by 2 rectangle and a factor-three 9 by 3 rectangle. Tiled areas count 3, 12 and 27 square units, so areas scale by the square of the length scale factor.",
        "PED:US-CCSS-MATH:G7:U01:L07" =>
            "A court at scale 1 drawing centimeter to 2 real meters: 14 by 7 drawing centimeters represents 28 by 14 meters. A 9-meter bench is a separately labeled 4.5-centimeter drawing segment. All drawing lengths use one consistent unit.",
        "PED:US-CCSS-MATH:G7:U01:L08" =>
            "Map at scale 1 centimeter to 4 kilometers. A three-segment road route measuring 2 centimeters per segment is 6 centimeters and 24 kilometers; a 5-centimeter straight line between its endpoints is 20 kilometers. The route is longer by 4 kilometers.",
        "PED:US-CCSS-MATH:G7:U01:L09" =>
            "A 7 by 5 meter studio floor plan drawn 7 by 5 centimeters at scale 1 centimeter to 1 meter. A measured 1.5-centimeter gap in the lower wall represents a 1.5-meter doorway, with an explicit scale key.",
        "PED:US-CCSS-MATH:G7:U01:L10" =>
            "Two scale drawings of one 300-by-180-meter garden using equal pixels per drawing centimeter: original 10-by-6-centimeter plan at one centimeter to 30 meters, and 15-by-9-centimeter plan at one centimeter to 20 meters. The drawing area ratio is 2.25.",
        "PED:US-CCSS-MATH:G7:U01:L11" =>
            "A unitless scale 1 to 180 matches one drawing inch to 15 actual feet. A 6-foot wall equals 72 inches and is drawn as a 0.4-inch segment. Both line segments use the same image pixel scale; the actual wall itself is not drawn at paper size.",
        "PED:US-CCSS-MATH:G7:U01:L12" =>
            "Original flag-like 20-meter by 12-meter rectangle with unitless 1 to 100 scale. The drawing is 20 by 12 centimeters and has area 240 square centimeters, while actual area is 240 square meters. Convert to common square-centimeter units before comparing the area factor 10000.",
        "PED:US-CCSS-MATH:G7:U01:L13" =>
            "An 8-by-6-meter classroom at one drawing centimeter to one meter, with an actual 1-meter doorway shown by a 1-centimeter wall opening and a 3-meter board shown by a 3-centimeter upper-wall segment. This is an example, not a completed learner floor plan.",
        _ => ""
    };

    var constructionPrompt = Model.LessonCode switch
    {
        "PED:US-CCSS-MATH:G7:U01:L01" =>
            "Construct your own original and correctly scaled F. Explain why the horizontally stretched F is not a scaled copy using one horizontal and one vertical corresponding length.",
        "PED:US-CCSS-MATH:G7:U01:L02" =>
            "Draw and label both triangles. Identify matching vertices, sides and angles, and justify the factor 3/2 using two corresponding lengths. Check the unchanged right angles.",
        "PED:US-CCSS-MATH:G7:U01:L03" =>
            "Create both L copies on graph paper. Check the vertex order and every length multiplier; explain why adding the same number to each side is not scaling.",
        "PED:US-CCSS-MATH:G7:U01:L04" =>
            "Draw each rectangle on a common grid, measure diagonal lengths between previously unconnected vertices and compare the corresponding right angles. Explain scale factor two using measured distances.",
        "PED:US-CCSS-MATH:G7:U01:L05" =>
            "Construct reduction, original and enlargement at the same grid units. Explain why factors below one reduce, above one enlarge, and reciprocals restore the original figure.",
        "PED:US-CCSS-MATH:G7:U01:L06" =>
            "Draw original and factor-two and factor-three copies using identical one-unit tiles. Count all tiles to justify why the area ratios are 1:4:9 rather than 1:2:3.",
        "PED:US-CCSS-MATH:G7:U01:L07" =>
            "Using a ruler and the court scale key, recreate the court and 9-meter bench as an original labeled drawing. Explain which real measurements correspond to each drawn segment.",
        "PED:US-CCSS-MATH:G7:U01:L08" =>
            "Draw an original map, trace all consecutive road segments, measure direct endpoint separation and convert both using the same map scale. Explain the difference between route and direct distance.",
        "PED:US-CCSS-MATH:G7:U01:L09" =>
            "Draw a fresh studio floor plan including a real 1.5-meter door opening, scale key and fully labeled walls. Exchange the plan with a peer and revise any measurement or placement errors.",
        "PED:US-CCSS-MATH:G7:U01:L10" =>
            "Create two original measured garden plans using the two stated scales. Explain why the two drawn areas differ by factor 2.25 while the real land remains the same.",
        "PED:US-CCSS-MATH:G7:U01:L11" =>
            "Convert 15 feet into 180 inches and explain the unitless ratio 1:180. Draw a 0.4-inch representation of a six-foot wall and show a ruler check.",
        "PED:US-CCSS-MATH:G7:U01:L12" =>
            "Draw an original 1:100 rectangular flag or pool plan. Label drawing and actual areas in consistent units and justify why the area factor is 10000.",
        "PED:US-CCSS-MATH:G7:U01:L13" =>
            "Independently measure or model your classroom, construct a complete scale drawing with doorway, board, scale key and units, then record peer corrections and revise.",
        _ => ""
    };
}
@if (assetPath is not null)
{
    <section class="rich-lesson-section rich-lesson-section--g7-original-geometry"
             aria-label="Grade 7 scaled-figure construction reference">
        <h3>Construct and justify: original geometry model</h3>
        <figure>
            <img src="@assetPath"
                 asp-append-version="true"
                 alt="@altText"
                 loading="lazy"
                 decoding="async"
                 width="925"
                 style="display:block;max-width:100%;height:auto" />
            <figcaption>
                Original Edulytiks mathematical figure, not publisher artwork.
                Reference geometry only: the student must still produce and
                explain an independent scaled construction.
            </figcaption>
        </figure>
        <p><strong>Your task:</strong> @constructionPrompt</p>
        <p>
            <strong>Assessment boundary:</strong> An answer such as a scale
            factor alone cannot complete this task. A teacher must inspect
            the drawing, corresponding geometry and the student's reasoning.
            This reference figure does not submit, score or save student work.
        </p>
    </section>
}

@if (Model.LessonCode == "PED:US-CCSS-MATH:G7:U01:L01")
{
    @* Grade-owned first-party activity; only appears when the shared owner invokes
       this opt-in partial. Student work has no persistence or automatic grade. *@
    <section class="rich-lesson-section rich-lesson-section--g7-scaled-copy-activities"
             data-g7-u01-l01 aria-label="Grade 7 lesson 1 scaled copies">
        <h3>Explore scaled copies — Edulytiks original activity</h3>
        <p>Inspect an original frame. Move the slider to change the two copies.
           In a scaled copy, every corresponding horizontal and vertical length
           changes by the same positive factor. A horizontal-only stretch
           generally is not a scaled copy.</p>
        <div style="display:flex;flex-wrap:wrap;gap:1.5rem;align-items:center;min-height:9rem">
            <figure style="min-width:9rem">
                <svg viewBox="0 0 110 90" width="150" role="img"
                     aria-label="Original 4-unit-wide by 3-unit-high frame with diagonal">
                    <rect x="10" y="12" width="80" height="60" fill="#dcecf3" stroke="#152d40" stroke-width="2" />
                    <path d="M10 72L90 12" stroke="#152d40" stroke-width="2" />
                </svg>
                <figcaption>Original: 4 by 3 units</figcaption>
            </figure>
            <figure style="min-width:9rem">
                <svg data-g7-uniform viewBox="0 0 110 90" width="150" role="img"
                     aria-label="Uniformly scaled frame">
                    <rect x="10" y="12" width="80" height="60" fill="#dcecf3" stroke="#152d40" stroke-width="2" />
                    <path d="M10 72L90 12" stroke="#152d40" stroke-width="2" />
                </svg>
                <figcaption>Uniform width and height</figcaption>
            </figure>
            <figure style="min-width:9rem">
                <svg data-g7-distorted viewBox="0 0 110 90" width="150" role="img"
                     aria-label="Nonuniform horizontally stretched frame">
                    <rect x="10" y="12" width="80" height="60" fill="#e5e5e5" stroke="#661a1a" stroke-width="2" />
                    <path d="M10 72L90 12" stroke="#661a1a" stroke-width="2" />
                </svg>
                <figcaption>Horizontal width only</figcaption>
            </figure>
        </div>
        <label for="g7-u01-l01-scale">Explore the scale factor</label>
        <input id="g7-u01-l01-scale" data-g7-portrait-scale
               type="range" min="50" max="150" step="25" value="125" />
        <p data-g7-portrait-result role="status">Use the slider to compare ratios.</p>
        <h3>Match ten first-party polygon cards</h3>
        <p>Each pair has the same shape with all corresponding lengths multiplied by
           one constant. Choose two cards, write the corresponding side-length
           evidence, and check your choice. Draw one matched pair on graph paper;
           show matching vertices and lengths. Explain the drawing to a partner or teacher.</p>
        <div data-g7-cards style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.7rem"
             role="group" aria-label="Select two of ten original polygons"></div>
        <label for="g7-u01-l01-reason">Explain your polygon match</label>
        <textarea id="g7-u01-l01-reason" data-g7-explanation rows="3"
                  style="width:100%;max-width:45rem"
                  placeholder="Compare matching lengths, factors and angles"></textarea>
        <p><button type="button" class="school-button" data-g7-check>Check pair</button>
           <button type="button" class="school-button" data-g7-reset>Clear selections</button></p>
        <p data-g7-feedback aria-live="polite">Your explanation and choices are not submitted or saved.</p>
        <h3>Cool-down — original Edulytiks assessment, not publisher Cool-down</h3>
        <p>Draw a right triangle with perpendicular legs of 3 and 4 units and
           hypotenuse 5 units. Candidate A has corresponding lengths 6, 8, 10.
           Candidate B has lengths 6, 8, 9. Which is a scaled copy? Explain
           using all three ratios, then construct a half-size copy with the same angles.</p>
        <fieldset>
            <legend>Classify the scaled copy</legend>
            <label><input type="radio" name="g7-l01-cooldown" value="A" /> Candidate A</label>
            <label><input type="radio" name="g7-l01-cooldown" value="B" /> Candidate B</label>
        </fieldset>
        <p><button type="button" class="school-button" data-g7-cooldown-check>
            Check classification only
        </button></p>
        <p data-g7-cooldown-feedback aria-live="polite">
            Teacher review is required for the actual drawing, three ratios and explanation.
        </p>
        <p><strong>Assessment boundary:</strong> This activity offers local formative
           feedback only. No student response or drawing is saved, submitted, or
           automatically scored. The teacher must assess the drawing and reasoning.</p>
    </section>
    <script src="~/curriculum/us-ccss-g7/geometry/u01-l01-activities.js"
            asp-append-version="true" defer></script>
}

@if (Model.LessonCode == "PED:US-CCSS-MATH:G7:U01:L02")
{
    @* First-party student-facing tasks. Static delivery depends on the
       designated shared Rich V2 view invoking this Grade 7 partial. *@
    <section class="rich-lesson-section rich-lesson-section--g7-corresponding-parts"
             data-g7-u01-l02 aria-label="Grade 7 corresponding parts and scale factor activity">
        <h3>Corresponding Parts — Edulytiks original student activity</h3>
        <p><strong>Number talk:</strong> Work out one-fourth of 32, one-ninth of 7.2,
           and one-fourth of 5.6. Explain why multiplication by a unit fraction
           divides by its denominator.</p>
        <h4>Find matching points, lengths and angles</h4>
        <p>On the same unit grid, draw original triangle ABC with A=(0,0),
           B=(4,0), C=(0,3), and copy DEF with D=(0,0), E=(6,0), F=(0,4.5).
           Then draw an altered copy D'=(0,0), E'=(6,0), F'=(0,3).</p>
        <p>Label A↔D, B↔E, C↔F. Match segments AB↔DE, AC↔DF,
           BC↔EF and angles BAC↔EDF. Use your own ruler or tracing paper
           to compare the right angles and acute angles.</p>
        <ul>
            <li>Which copy is a scaled copy of ABC? Justify with all three side ratios.</li>
            <li>Identify the correspondence of point B, segment BC and angle BAC.</li>
            <li>What is the factor from ABC to DEF? What factor returns DEF to ABC?</li>
            <li>What happens to the acute angles if the x-coordinate alone is multiplied by 1.5?</li>
        </ul>
        <p><strong>Additional triangle comparison:</strong> Start with side lengths
           (3,4,5). Compare candidate sides (1.5,2,2.5), (6,8,10),
           and (6,8,9). Identify the uniformly scaled figures and explain
           why the remaining candidate is not a scaled copy. On graph paper,
           draw one valid copy and label corresponding vertices and sides.</p>
        <details>
            <summary>Open the reasoning guide after you have attempted the activity</summary>
            <p>The original ABC has right angle at A and sides 3,4,5.
               DEF has sides 4.5,6,7.5; all three factors are 1.5
               and corresponding angles remain equal. The altered copy
               changes the two perpendicular sides by different factors,
               so its acute angles change. The reverse factor is 2/3.
               For the additional triangle comparison, factors 1/2
               and 2 are uniform, while 6/3=8/4=2 but 9/5=1.8.</p>
        </details>
        <h4>Cool-down — Edulytiks original, not the publisher's gated question</h4>
        <p>Draw ABC from the three original coordinates. Label its side lengths and
           its right angle. Construct a factor-3/2 triangle DEF using the matching
           vertices, identify the image of segment BC and angle BAC, and explain
           why all corresponding angles stay equal. Then explain whether a
           triangle with legs 6 and 3 is a scaled copy of ABC.</p>
        <p><strong>Teacher-scoring boundary:</strong> A teacher must inspect
           point correspondence, correct scale factors on all three sides,
           preserved angle measures, a real labeled drawing, and a complete
           explanation. Reading the reasoning guide or typing one number
           does not submit or pass an assessment. This partial does not
           capture or persist student work.</p>
    </section>
}

@if (Model.LessonCode == "PED:US-CCSS-MATH:G7:U01:L03")
{
    @* Equivalent first-party lesson activity, not a claim to reproduce the
       publisher's diagrams. Shared Rich V2 opt-in invocation is pending. *@
    <section class="rich-lesson-section rich-lesson-section--g7-making-scaled-copies"
             data-g7-u01-l03 aria-label="Grade 7 original scaled construction activities">
        <h3>Making Scaled Copies — Edulytiks student construction</h3>
        <h4>Warm-up: more or less?</h4>
        <p>Without rounding away an important difference, decide whether
           25 × 8.5 is greater or less than 205, 9.93 × 0.984 is
           greater or less than 10, and 0.24 × 0.67 is greater
           or less than 0.2. Explain each claim.</p>
        <h4>Draw, measure, and compare</h4>
        <p>On graph paper, create an original L-shaped polygon by connecting
           the vertices (0,0), (6,0), (6,2), (4,2), (4,5), (0,5)
           in order and closing the outline. Use the same unit scale to
           construct two separate copies with factors 3 and 1/2.
           Preserve all angles and corresponding proportions. A fractional
           coordinate is allowed between grid intersections.</p>
        <p><strong>Factor 3:</strong> each original point (x,y) becomes
           (3x,3y). <strong>Factor 1/2:</strong> each becomes
           (x/2,y/2). Draw the actual shapes rather than just listing
           numeric multipliers. Show a teacher your scale grid and
           annotate at least two corresponding sides.</p>
        <h4>Critique two strategies</h4>
        <p>A student wants a 15-unit side to become 5 units.
           One method multiplies every side by 1/3. Another subtracts 10
           from every side. Which method produces a scaled copy?
           Can subtraction produce a negative length for a short side?
           Explain the effect on the geometry and on every angle.</p>
        <p>A different student wants to make a 4-unit segment into 8 units
           and suggests adding 4 to all side lengths. Explain why
           multiplying every length by 2 is the intended construction
           and why adding 4 generally is not uniform scaling.</p>
        <details>
            <summary>Check the mathematics after constructing your copy</summary>
            <p>25 × 8.5 = 212.5 (greater than 205); 9.93 × 0.984
               = 9.77112 (less than 10); and 0.24 × 0.67
               = 0.1608 (less than 0.2). The multiplier from 15
               to 5 is 1/3, not subtraction of 10. The correct
               two L copies use all six original vertices multiplied
               uniformly by factors 3 and 1/2; corresponding angles
               remain unchanged. A translated or rotated construction
               is valid if it preserves all distances and angles
               with the same factor.</p>
        </details>
        <h4>Cool-down — independently authored by Edulytiks</h4>
        <p>A triangle has vertices (0,0), (6,0), (0,4).
           Draw a half-size copy (factor 1/2) on a coordinate grid;
           label the image vertices, each corresponding length,
           and its right angle. A classmate claims that adding 2
           to both original legs produces the same copy. Identify the
           two resulting ratios and show why the claim fails.</p>
        <p><strong>Expected teacher reasoning:</strong> A correct half-size
           copy can use (0,0), (3,0), (0,2), with new legs 3 and 2,
           and unchanged right angle. Adding 2 produces legs 8 and 6,
           with ratios 8/6 and 6/4, which are unequal.
           The teacher checks an actual labeled drawing,
           corresponding dimensions, angle preservation and
           a written or oral counterexample. No response is
           submitted or graded automatically in this partial.</p>
    </section>
}
