@model Edulytics.Services.Analytics.AnalyticsDashboard
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.AnalyticsResource> A
@using System.Globalization
@using Edulytics.Web.ViewModels.Analytics

@{
    var d = Model;
    var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var lessonWeaknessTitle = language switch
    {
        "pl" => "Analiza słabych lekcji",
        "ar" => "تحليل نقاط الضعف حسب الدرس",
        _ => "Lesson weakness analysis"
    };
    var lessonEvidenceHelp = language switch
    {
        "pl" => "Wyłącznie na podstawie ocenionych pytań z jednoznacznie zapisanym identyfikatorem lekcji.",
        "ar" => "يعتمد فقط على الأسئلة المصححة التي تحمل معرّف درس محفوظًا بشكل صريح.",
        _ => "Based only on scored questions with an explicitly persisted lesson identity."
    };
    var classMasteryLabel = language switch
    {
        "pl" => "Opanowanie klasy",
        "ar" => "إتقان الصف",
        _ => "Class mastery"
    };
    var assessmentsLabel = language switch
    {
        "pl" => "Testy",
        "ar" => "الاختبارات",
        _ => "Assessments"
    };

    var evidenceStudentTotal = Math.Max(1, d.StudentsWithEvidence);
    decimal StudentShare(int count) => count * 100m / evidenceStudentTotal;
    decimal OutcomeShare(int count) => d.Outcomes.Count == 0
        ? 0m
        : count * 100m / d.Outcomes.Count;
    decimal TopicShare(int count) => d.Topics.Count == 0
        ? 0m
        : count * 100m / d.Topics.Count;
}

        <section class="evaluation-visual-grid analytics-overview-visuals"
                 aria-label="@A["VisualAnalytics"]">
            <article class="evaluation-chart-panel">
                <header>
                    <div>
                        <h2>@A["OverallMastery"]</h2>
                        <p>Overall mastery remains visible as a number and as a progress shape.</p>
                    </div>
                </header>
                <div class="evaluation-donut"
                     data-evaluation-chart="donut"
                     data-value="@d.OverallMasteryPercentage.ToString(CultureInfo.InvariantCulture)"
                     data-suffix="%"
                     data-decimals="1"
                     aria-label="@A["OverallMastery"]: @d.OverallMasteryPercentage.ToString("0.#")%">
                    <div class="evaluation-donut-content">
                        <strong data-chart-number>@d.OverallMasteryPercentage.ToString("0.#")%</strong>
                        <small>@A["OverallMastery"]</small>
                    </div>
                </div>
            </article>

            <article class="evaluation-chart-panel">
                <header>
                    <div>
                        <h2>@A["MasteryDistribution"]</h2>
                        <p>Counts are normalized to the visible analytics scope so risk and weakness are easier to compare.</p>
                    </div>
                </header>
                <div class="evaluation-bars" data-evaluation-chart="bars">
                    <div class="evaluation-bar-row is-danger">
                        <span>@A["AtRiskStudents"]</span>
                        <span class="evaluation-bar-track">
                            <i class="evaluation-bar-fill"
                               data-chart-value="@StudentShare(d.AtRiskStudents).ToString(CultureInfo.InvariantCulture)"></i>
                        </span>
                        <strong>@d.AtRiskStudents</strong>
                    </div>
                    <div class="evaluation-bar-row is-warning">
                        <span>@A["CriticalOutcomes"]</span>
                        <span class="evaluation-bar-track">
                            <i class="evaluation-bar-fill"
                               data-chart-value="@OutcomeShare(d.CriticalOutcomeCount).ToString(CultureInfo.InvariantCulture)"></i>
                        </span>
                        <strong>@d.CriticalOutcomeCount</strong>
                    </div>
                    <div class="evaluation-bar-row is-warning">
                        <span>@A["WeakTopics"]</span>
                        <span class="evaluation-bar-track">
                            <i class="evaluation-bar-fill"
                               data-chart-value="@TopicShare(d.WeakTopicCount).ToString(CultureInfo.InvariantCulture)"></i>
                        </span>
                        <strong>@d.WeakTopicCount</strong>
                    </div>
                </div>
            </article>
        </section>

        <section class="analytics-metrics"
                 aria-label="@A["AnalyticsTitle"]">

            <article class="analytics-metric">
                <span>@A["OverallMastery"]</span>
                <strong>
                    @d.OverallMasteryPercentage.ToString("0.##")%
                </strong>
            </article>

            <article class="analytics-metric">
                <span>@A["StudentsWithEvidence"]</span>
                <strong>@d.StudentsWithEvidence</strong>
            </article>

            <article class="analytics-metric analytics-metric-warning">
                <span>@A["AtRiskStudents"]</span>
                <strong>@d.AtRiskStudents</strong>
            </article>

            <article class="analytics-metric analytics-metric-danger">
                <span>@A["CriticalOutcomes"]</span>
                <strong>@d.CriticalOutcomeCount</strong>
            </article>

            <article class="analytics-metric analytics-metric-warning">
                <span>@lessonWeaknessTitle</span>
                <strong>@d.WeakLessonCount</strong>
            </article>

            <article class="analytics-metric analytics-metric-warning">
                <span>@A["WeakTopics"]</span>
                <strong>@d.WeakTopicCount</strong>
            </article>
        </section>

        <section class="analytics-panel">
            <header>
                <h2>@A["ClassHeatmap"]</h2>
                <p>@A["ClassHeatmapHelp"]</p>
            </header>

            @if (d.Outcomes.Count == 0)
            {
                <p class="analytics-empty-inline">
                    @A["NoOutcomes"]
                </p>
            }
            else
            {
                <div class="analytics-table-wrap">
                    <table class="analytics-table analytics-heatmap">
                        <thead>
                            <tr>
                                <th>@A["AcademicYear"]</th>
                                <th>@A["Class"]</th>
                                <th>@A["Subject"]</th>
                                <th>@A["Outcome"]</th>
                                <th>@A["Mastery"]</th>
                                <th>@A["Students"]</th>
                                <th>@A["AtRisk"]</th>
                                <th>@A["Evidence"]</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in d.Outcomes)
                            {
                                <tr>
                                    <td data-label="@A["AcademicYear"]">
                                        @item.AcademicYearName
                                    </td>

                                    <td data-label="@A["Class"]">
                                        @item.ClassName
                                    </td>

                                    <td data-label="@A["Subject"]">
                                        @item.SubjectName
                                    </td>

                                    <td data-label="@A["Outcome"]">
                                        <strong>@item.OutcomeCode</strong>
                                        <span>@item.OutcomeDescription</span>
                                    </td>

                                    <td data-label="@A["Mastery"]">
                                        <span class="analytics-band @AnalyticsIndexViewModel.BandClass(item.Band)">
                                            @item.MasteryPercentage.ToString("0.##")%
                                            ·
                                            @A[AnalyticsIndexViewModel.BandKey(item.Band)]
                                        </span>
                                    </td>

                                    <td data-label="@A["Students"]">
                                        @item.StudentCount
                                    </td>

                                    <td data-label="@A["AtRisk"]">
                                        @item.AtRiskStudentCount
                                    </td>

                                    <td data-label="@A["Evidence"]">
                                        @item.EvidenceCount
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="analytics-panel">
            <header>
                <h2>@lessonWeaknessTitle</h2>
                <p>@lessonEvidenceHelp</p>
            </header>

            @if (d.Lessons.Count == 0)
            {
                <p class="analytics-empty-inline">
                    @(language switch
                    {
                        "pl" => "Dane o opanowaniu lekcji są niedostępne, ponieważ ocenione pytania nie są powiązane z konkretnymi lekcjami.",
                        "ar" => "إتقان الدروس غير متاح لأن أسئلة التقييم المصححة غير مرتبطة بدروس محددة.",
                        _ => "Lesson mastery is unavailable because scored assessment questions are not linked to specific lessons."
                    })
                </p>
            }
            else
            {
                <div class="analytics-topic-grid">
                    @foreach (var item in d.Lessons)
                    {
                        <article class="analytics-topic-card">
                            <div class="analytics-topic-heading">
                                <div>
                                    <strong>@item.LessonTitle</strong>
                                    <small>
                                        @item.UnitTitle · @item.ClassName · @item.SubjectName
                                    </small>
                                </div>

                                <span class="analytics-band @AnalyticsIndexViewModel.BandClass(item.Band)">
                                    @classMasteryLabel: @item.MasteryPercentage.ToString("0.##")%
                                </span>
                            </div>

                            <progress max="100"
                                      value="@item.MasteryPercentage.ToString(CultureInfo.InvariantCulture)"
                                      aria-label="@classMasteryLabel">
                            </progress>

                            <dl>
                                <div>
                                    <dt>@A["Students"]</dt>
                                    <dd>@item.StudentCount</dd>
                                </div>
                                <div>
                                    <dt>@A["AtRisk"]</dt>
                                    <dd>@item.AtRiskStudentCount</dd>
                                </div>
                                <div>
                                    <dt>@A["Evidence"]</dt>
                                    <dd>@item.EvidenceCount</dd>
                                </div>
                                <div>
                                    <dt>@assessmentsLabel</dt>
                                    <dd>@item.AssessmentCount</dd>
                                </div>
                            </dl>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="analytics-panel">
            <header>
                <h2>@A["TopicAnalysis"]</h2>
            </header>

            @if (d.Topics.Count == 0)
            {
                <p class="analytics-empty-inline">
                    @A["NoTopics"]
                </p>
            }
            else
            {
                <div class="analytics-topic-grid">
                    @foreach (var item in d.Topics)
                    {
                        <article class="analytics-topic-card">
                            <div class="analytics-topic-heading">
                                <div>
                                    <strong>@item.TopicName</strong>
                                    <small>
                                        @item.ClassName · @item.SubjectName
                                    </small>
                                </div>

                                <span class="analytics-band @AnalyticsIndexViewModel.BandClass(item.Band)">
                                    @item.MasteryPercentage.ToString("0.##")%
                                </span>
                            </div>

                            <progress max="100"
                                      value="@item.MasteryPercentage.ToString(CultureInfo.InvariantCulture)"
                                      aria-label="@A["Mastery"]">
                            </progress>

                            <dl>
                                <div>
                                    <dt>@A["Outcomes"]</dt>
                                    <dd>@item.OutcomeCount</dd>
                                </div>

                                <div>
                                    <dt>@A["WeakOutcomes"]</dt>
                                    <dd>@item.WeakOutcomeCount</dd>
                                </div>

                                <div>
                                    <dt>@A["Students"]</dt>
                                    <dd>@item.StudentCount</dd>
                                </div>
                            </dl>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="analytics-panel">
            <header>
                <h2>@A["ProgressOverTime"]</h2>
            </header>

            @if (d.Trends.Count == 0)
            {
                <p class="analytics-empty-inline">
                    @A["NoTrend"]
                </p>
            }
            else
            {
                <div class="analytics-trend-list">
                    @foreach (var item in d.Trends)
                    {
                        <article class="analytics-trend-row">
                            <div class="analytics-trend-info">
                                <strong>@item.AssessmentTitle</strong>
                                <span>
                                    @item.AssessmentDate.ToString("yyyy-MM-dd")
                                    ·
                                    @item.ClassName
                                    ·
                                    @item.SubjectName
                                </span>
                            </div>

                            <div class="analytics-trend-score">
                                <span class="analytics-band @AnalyticsIndexViewModel.BandClass(item.Band)">
                                    @item.AveragePercentage.ToString("0.##")%
                                </span>

                                <small>
                                    @A["Students"]: @item.StudentCount
                                    ·
                                    @A["AtRisk"]: @item.AtRiskStudentCount
                                </small>
                            </div>

                            <progress max="100"
                                      value="@item.AveragePercentage.ToString(CultureInfo.InvariantCulture)"
                                      aria-label="@A["Average"]">
                            </progress>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="analytics-panel">
            <header>
                <h2>@A["RiskStudents"]</h2>
            </header>

            @if (d.RiskStudents.Count == 0)
            {
                <p class="analytics-empty-inline">
                    @A["NoRisks"]
                </p>
            }
            else
            {
                <div class="analytics-risk-grid">
                    @foreach (var item in d.RiskStudents)
                    {
                        <article class="analytics-risk-card">
                            <div>
                                <strong>@item.DisplayName</strong>
                                <span>
                                    @A["StudentNumber"]:
                                    @item.StudentNumber
                                </span>
                                <span>
                                    @item.AcademicYearName
                                    ·
                                    @item.ClassName
                                </span>
                            </div>

                            <span class="analytics-band @AnalyticsIndexViewModel.BandClass(item.Band)">
                                @item.MasteryPercentage.ToString("0.##")%
                            </span>

                            <span>
                                @A["CriticalGaps"]:
                                <strong>@item.CriticalOutcomeCount</strong>
                            </span>

                            @if (d.SelectedSubjectId.HasValue)
                            {
                                <a class="school-button"
                                   asp-controller="Analytics"
                                   asp-action="StudentReportPdf"
                                   asp-route-studentProfileId="@item.StudentProfileId"
                                   asp-route-academicYearId="@item.AcademicYearId"
                                   asp-route-classGroupId="@item.ClassGroupId"
                                   asp-route-subjectId="@d.SelectedSubjectId.Value">
                                    @(language switch
                                    {
                                        "pl" => "PDF ucznia",
                                        "ar" => "PDF الطالب",
                                        _ => "Student PDF"
                                    })
                                </a>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="analytics-panel analytics-legend">
            <h2>@A["MasteryLegend"]</h2>

            <div>
                <span class="analytics-band analytics-band-critical">
                    @A["MasteryCritical"] · 0–39
                </span>

                <span class="analytics-band analytics-band-weak">
                    @A["MasteryWeak"] · 40–59
                </span>

                <span class="analytics-band analytics-band-developing">
                    @A["MasteryDeveloping"] · 60–74
                </span>

                <span class="analytics-band analytics-band-secure">
                    @A["MasterySecure"] · 75–89
                </span>

                <span class="analytics-band analytics-band-strong">
                    @A["MasteryStrong"] · 90–100
                </span>
            </div>
        </section>