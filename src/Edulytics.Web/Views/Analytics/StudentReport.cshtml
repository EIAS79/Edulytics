@model Edulytics.Services.Analytics.AnalyticsStudentEvaluationReportPage
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.AnalyticsResource> A
@using Edulytics.Core.Analytics
@using System.Globalization
@{
    ViewData["Title"] = A["FullStudentReport"].Value;

    var source = Model.Source;
    var e = source.Evaluation;

    string Value(decimal? value) =>
        value.HasValue ? $"{value.Value:0.#}%" : "—";

    string TrendLabel(EvaluationTrendBand value) => value switch
    {
        EvaluationTrendBand.RapidlyImproving => "↑↑ Rapidly improving",
        EvaluationTrendBand.Improving => "↑ Improving",
        EvaluationTrendBand.Stable => "→ Stable",
        EvaluationTrendBand.Declining => "↓ Declining",
        EvaluationTrendBand.RapidlyDeclining => "↓↓ Rapidly declining",
        _ => A["InsufficientEvidence"].Value
    };

    string StatusLabel(EvaluationSkillStatus value) => value switch
    {
        EvaluationSkillStatus.Strong => A["MasteryStrong"].Value,
        EvaluationSkillStatus.Secure => A["MasterySecure"].Value,
        EvaluationSkillStatus.Developing => A["MasteryDeveloping"].Value,
        EvaluationSkillStatus.NeedsFocus => A["NeedsFocus"].Value,
        EvaluationSkillStatus.Critical => A["MasteryCritical"].Value,
        EvaluationSkillStatus.NotYetAssessed => A["NotYetAssessed"].Value,
        _ => A["InsufficientEvidence"].Value
    };

    var assessmentSeries = string.Join(
        ",",
        Model.Assessments.Select(x =>
            x.Percentage.ToString(CultureInfo.InvariantCulture)));

    var assessmentLabels = string.Join(
        "|",
        Model.Assessments.Select(x =>
            x.AssessmentDate.ToString("MM-dd", CultureInfo.InvariantCulture)));

    var strengths = e.Skills
        .Where(x =>
            x.Status is EvaluationSkillStatus.Strong or
                EvaluationSkillStatus.Secure)
        .OrderByDescending(x => x.CurrentMasteryPercentage ?? 0m)
        .Take(8)
        .ToArray();

    var focus = e.Skills
        .Where(x =>
            x.Status is EvaluationSkillStatus.Critical or
                EvaluationSkillStatus.NeedsFocus)
        .OrderByDescending(x => x.InterventionPriority)
        .ThenBy(x => x.CurrentMasteryPercentage ?? 101m)
        .Take(10)
        .ToArray();
}

<section class="evaluation-report-page">
    <header class="evaluation-report-toolbar no-print">
        <div>
            <a class="school-button school-button-secondary"
               asp-action="Student"
               asp-route-studentProfileId="@e.StudentProfileId"
               asp-route-academicYearId="@e.AcademicYearId"
               asp-route-classGroupId="@e.ClassGroupId"
               asp-route-subjectId="@e.SubjectId">
                @A["ViewEvaluation"]
            </a>
        </div>

        <form method="get"
              asp-action="StudentReport"
              asp-route-studentProfileId="@e.StudentProfileId"
              class="evaluation-report-filter">
            <input type="hidden" name="academicYearId" value="@e.AcademicYearId" />
            <input type="hidden" name="classGroupId" value="@e.ClassGroupId" />
            <input type="hidden" name="subjectId" value="@e.SubjectId" />

            <label for="termId">@A["SelectTerm"]</label>
            <select id="termId" name="termId" data-report-autosubmit="true">
                <option value="">@A["AllTerms"]</option>
                @foreach (var term in source.Terms)
                {
                    <option value="@term.TermId"
                            selected="@(Model.SelectedTermId == term.TermId ? "selected" : null)">
                        @term.TermName
                    </option>
                }
            </select>
        </form>

        <div class="evaluation-report-toolbar-actions">
            <button type="button"
                    class="school-button school-button-secondary"
                    data-report-print="true">
                @A["PrintReport"]
            </button>

            <a class="school-button"
               asp-action="StudentReportPdf"
               asp-route-studentProfileId="@e.StudentProfileId"
               asp-route-academicYearId="@e.AcademicYearId"
               asp-route-classGroupId="@e.ClassGroupId"
               asp-route-subjectId="@e.SubjectId"
               asp-route-termId="@Model.SelectedTermId">
                @A["DownloadPdf"]
            </a>
        </div>
    </header>

    <article class="evaluation-report-sheet">
        <header class="evaluation-report-brand">
            <div class="evaluation-report-logo">
                <partial name="_LocalizedBrand" />
            </div>
            <div>
                <span class="user-eyebrow">@A["FullStudentReport"]</span>
                <h1>@e.DisplayName</h1>
                <p>@e.StudentNumber · @e.SubjectName</p>
            </div>
            <div class="evaluation-report-meta">
                <span>@A["ReportGenerated"]</span>
                <strong>@Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</strong>
            </div>
        </header>

        <section class="evaluation-report-context-grid">
            <div>
                <span>@A["AcademicYear"]</span>
                <strong>@e.AcademicYearName</strong>
            </div>
            <div>
                <span>@A["Class"]</span>
                <strong>@e.ClassName</strong>
            </div>
            <div>
                <span>@A["Subject"]</span>
                <strong>@e.SubjectName</strong>
            </div>
            <div>
                <span>@A["ReportScope"]</span>
                <strong>@(Model.SelectedTermName ?? A["AllTerms"].Value)</strong>
            </div>
        </section>

        @if (Model.SelectedTerm is not null)
        {
            <section class="evaluation-report-term-focus">
                <div>
                    <span>@A["SelectTerm"]</span>
                    <strong>@Model.SelectedTerm.TermName</strong>
                    <small>
                        @Model.SelectedTerm.StartsOn.ToString("yyyy-MM-dd")
                        —
                        @Model.SelectedTerm.EndsOn.ToString("yyyy-MM-dd")
                    </small>
                </div>
                <div>
                    <span>@A["AssessmentMastery"]</span>
                    <strong>@Value(Model.SelectedTerm.AssessmentMasteryPercentage)</strong>
                </div>
                <div>
                    <span>@A["PracticeMastery"]</span>
                    <strong>@Value(Model.SelectedTerm.PracticeMasteryPercentage)</strong>
                </div>
                <div>
                    <span>@A["ComparableSkillGrowth"]</span>
                    <strong>
                        @(Model.SelectedTerm.ComparableSkillGrowthPercentagePoints.HasValue
                            ? $"{Model.SelectedTerm.ComparableSkillGrowthPercentagePoints.Value:+0.#;-0.#;0} pts"
                            : "—")
                    </strong>
                </div>
                <p>
                    Current mastery below remains the latest year-level evaluation.
                    The selected term filters assessment/evidence history and highlights term-specific metrics.
                </p>
            </section>
        }

        <section class="evaluation-report-executive">
            <article class="evaluation-chart-panel evaluation-report-master-card">
                <header>
                    <div>
                        <h2>@A["CurrentMastery"]</h2>
                        <p>@e.EvaluatedSkillCount / @e.ExpectedSkillCount skills evaluated</p>
                    </div>
                </header>
                <div class="evaluation-donut"
                     data-evaluation-chart="donut"
                     data-value="@(e.CurrentMasteryPercentage?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
                     data-suffix="%"
                     data-decimals="1">
                    <div class="evaluation-donut-content">
                        <strong data-chart-number>@Value(e.CurrentMasteryPercentage)</strong>
                        <small>@A["CurrentMastery"]</small>
                    </div>
                </div>
            </article>

            <div class="evaluation-report-kpis">
                <article>
                    <span>@A["AssessmentMastery"]</span>
                    <strong>@Value(e.AssessmentMasteryPercentage)</strong>
                </article>
                <article>
                    <span>@A["PracticeMastery"]</span>
                    <strong>@Value(e.PracticeMasteryPercentage)</strong>
                </article>
                <article>
                    <span>@A["Coverage"]</span>
                    <strong>@e.CurriculumCoveragePercentage.ToString("0.#")%</strong>
                </article>
                <article>
                    <span>@A["Confidence"]</span>
                    <strong>@e.ConfidencePercentage.ToString("0.#")%</strong>
                    <small>@e.ConfidenceBand</small>
                </article>
                <article>
                    <span>@A["ShortTrend"]</span>
                    <strong>@TrendLabel(e.ShortTermTrend)</strong>
                </article>
                <article>
                    <span>@A["CriticalGaps"]</span>
                    <strong>@e.CriticalSkillCount</strong>
                    <small>@e.NeedsFocusSkillCount @A["NeedsFocus"].Value.ToLowerInvariant()</small>
                </article>
            </div>
        </section>

        <section class="evaluation-report-section">
            <header>
                <span class="user-eyebrow">@A["Charts"]</span>
                <h2>@A["PerformanceComparison"]</h2>
            </header>
            <div class="evaluation-visual-grid">
                <article class="evaluation-chart-panel">
                    <div class="evaluation-bars" data-evaluation-chart="bars">
                        <div class="evaluation-bar-row">
                            <span>@A["AssessmentMastery"]</span>
                            <span class="evaluation-bar-track">
                                <i class="evaluation-bar-fill"
                                   data-chart-value="@(e.AssessmentMasteryPercentage?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"></i>
                            </span>
                            <strong>@Value(e.AssessmentMasteryPercentage)</strong>
                        </div>
                        <div class="evaluation-bar-row is-practice">
                            <span>@A["PracticeMastery"]</span>
                            <span class="evaluation-bar-track">
                                <i class="evaluation-bar-fill"
                                   data-chart-value="@(e.PracticeMasteryPercentage?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"></i>
                            </span>
                            <strong>@Value(e.PracticeMasteryPercentage)</strong>
                        </div>
                        <div class="evaluation-bar-row is-warning">
                            <span>@A["Coverage"]</span>
                            <span class="evaluation-bar-track">
                                <i class="evaluation-bar-fill"
                                   data-chart-value="@e.CurriculumCoveragePercentage.ToString(CultureInfo.InvariantCulture)"></i>
                            </span>
                            <strong>@e.CurriculumCoveragePercentage.ToString("0.#")%</strong>
                        </div>
                    </div>
                </article>

                <article class="evaluation-chart-panel">
                    <div class="evaluation-line-chart-scroll">
                        <div class="evaluation-line-chart"
                             data-evaluation-chart="line"
                             data-values="@assessmentSeries"
                             data-labels="@assessmentLabels"
                             data-aria-label="@A["AssessmentProgressChart"]"
                             data-empty-label="@A["InsufficientEvidence"]">
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <section class="evaluation-report-section">
            <header>
                <span class="user-eyebrow">@A["TopicAnalysis"]</span>
                <h2>@A["TopicMasteryChart"]</h2>
            </header>
            @if (source.Topics.Count == 0)
            {
                <div class="evaluation-chart-empty">@A["InsufficientEvidence"]</div>
            }
            else
            {
                <div class="evaluation-lollipop-list evaluation-report-topic-bars"
                     data-evaluation-chart="lollipop">
                    @foreach (var topic in source.Topics
                        .OrderBy(x => x.CurrentMasteryPercentage ?? 101m)
                        .Take(12))
                    {
                        var value = topic.CurrentMasteryPercentage;
                        var css = !value.HasValue
                            ? string.Empty
                            : value.Value < 40m
                                ? "is-danger"
                                : value.Value < 60m
                                    ? "is-warning"
                                    : string.Empty;
                        <div class="evaluation-lollipop-row @css">
                            <span class="evaluation-lollipop-label">@topic.TopicName</span>
                            <span class="evaluation-lollipop-track">
                                <i class="evaluation-lollipop-stick"
                                   data-chart-value="@(value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"></i>
                            </span>
                            <strong>@Value(topic.CurrentMasteryPercentage)</strong>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="evaluation-report-two-column">
            <article class="evaluation-report-section evaluation-report-strengths">
                <header>
                    <span class="user-eyebrow">@A["MasterySecure"]</span>
                    <h2>Strengths</h2>
                </header>
                @if (strengths.Length == 0)
                {
                    <p class="evaluation-report-empty">@A["InsufficientEvidence"]</p>
                }
                else
                {
                    <div class="evaluation-report-chip-list">
                        @foreach (var skill in strengths)
                        {
                            <span>
                                <strong>@skill.SkillName</strong>
                                <small>@Value(skill.CurrentMasteryPercentage)</small>
                            </span>
                        }
                    </div>
                }
            </article>

            <article class="evaluation-report-section evaluation-report-focus">
                <header>
                    <span class="user-eyebrow">@A["NeedsFocus"]</span>
                    <h2>Needs attention</h2>
                </header>
                @if (focus.Length == 0)
                {
                    <p class="evaluation-report-empty">No current priority gap is supported by the available evidence.</p>
                }
                else
                {
                    <div class="evaluation-report-chip-list">
                        @foreach (var skill in focus)
                        {
                            <span>
                                <strong>@skill.SkillName</strong>
                                <small>@StatusLabel(skill.Status) · @Value(skill.CurrentMasteryPercentage)</small>
                            </span>
                        }
                    </div>
                }
            </article>
        </section>

        <section class="evaluation-report-section">
            <header>
                <span class="user-eyebrow">@A["TopicsSkills"]</span>
                <h2>Exact skill record</h2>
            </header>
            <div class="analytics-table-wrap">
                <table class="analytics-table evaluation-report-skill-table">
                    <thead>
                        <tr>
                            <th>@A["Skill"]</th>
                            <th>@A["CurrentMastery"]</th>
                            <th>@A["AssessmentMastery"]</th>
                            <th>@A["PracticeMastery"]</th>
                            <th>@A["Status"]</th>
                            <th>@A["Trend"]</th>
                            <th>@A["Evidence"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var skill in e.Skills)
                        {
                            <tr>
                                <td>
                                    <strong>@skill.SkillName</strong>
                                    <small>@skill.SkillKey</small>
                                </td>
                                <td>@Value(skill.CurrentMasteryPercentage)</td>
                                <td>@Value(skill.AssessmentMasteryPercentage)</td>
                                <td>@Value(skill.PracticeMasteryPercentage)</td>
                                <td>@StatusLabel(skill.Status)</td>
                                <td>@TrendLabel(skill.ShortTermTrend)</td>
                                <td>@skill.Evidence.TotalEvidence</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="evaluation-report-two-column">
            <article class="evaluation-report-section">
                <header>
                    <span class="user-eyebrow">@A["AssessmentHistory"]</span>
                    <h2>@A["AssessmentHistory"]</h2>
                </header>
                @if (Model.Assessments.Count == 0)
                {
                    <p class="evaluation-report-empty">@A["InsufficientEvidence"]</p>
                }
                else
                {
                    <div class="evaluation-assessment-timeline">
                        @foreach (var item in Model.Assessments)
                        {
                            <article>
                                <span class="evaluation-timeline-dot" aria-hidden="true"></span>
                                <div>
                                    <strong>@item.Title</strong>
                                    <small>@item.AssessmentDate.ToString("yyyy-MM-dd") · @(item.TermName ?? "—")</small>
                                </div>
                                <div class="evaluation-assessment-score">
                                    <strong>@item.Percentage.ToString("0.#")%</strong>
                                    @if (item.ComparableSkillChangePercentagePoints.HasValue)
                                    {
                                        <small>
                                            @A["ComparableSkillGrowth"]:
                                            @item.ComparableSkillChangePercentagePoints.Value.ToString("+0.#;-0.#;0") pts
                                        </small>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>

            <article class="evaluation-report-section">
                <header>
                    <span class="user-eyebrow">@A["RecommendedNextSteps"]</span>
                    <h2>@A["RecommendedNextSteps"]</h2>
                </header>
                @if (source.Recommendations.Count == 0)
                {
                    <p class="evaluation-report-empty">No intervention priority is currently supported by the available evidence.</p>
                }
                else
                {
                    <div class="evaluation-report-recommendations">
                        @foreach (var item in source.Recommendations.Take(8))
                        {
                            <article>
                                <span class="evaluation-priority priority-@item.Priority.ToString().ToLowerInvariant()">
                                    @item.Priority
                                </span>
                                <div>
                                    <strong>@item.SkillName</strong>
                                    <p>@item.Reason</p>
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </section>

        <section class="evaluation-report-evidence-summary">
            <div>
                <span>@A["Evidence"]</span>
                <strong>@Model.Evidence.Count</strong>
                <small>@(Model.SelectedTermName ?? A["AllTerms"].Value)</small>
            </div>
            <div>
                <span>@A["Confidence"]</span>
                <strong>@e.ConfidencePercentage.ToString("0.#")%</strong>
                <small>@e.ConfidenceBand</small>
            </div>
            <div>
                <span>@A["RetentionConcerns"]</span>
                <strong>@e.RetentionConcernCount</strong>
            </div>
            <div>
                <span>@A["CriticalGaps"]</span>
                <strong>@e.CriticalSkillCount</strong>
            </div>
        </section>

        <section class="evaluation-report-placeholder-grid">
            <article>
                <h2>@A["TeacherComments"]</h2>
                <div class="evaluation-report-writing-space"></div>
            </article>
            <article>
                <h2>@A["ParentStudentReview"]</h2>
                <div class="evaluation-report-writing-space"></div>
            </article>
        </section>

        <footer class="evaluation-report-footer">
            <span>Edulytics · @A["FullStudentReport"]</span>
            <span>@Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
        </footer>
    </article>
</section>

@section Scripts {
    <script src="~/js/evaluation-charts.js" asp-append-version="true"></script>
}
