@using System.Globalization
@model string
@{
    Layout = "_PublicLayout";
    var isDemo = string.Equals(Model, "demo", StringComparison.OrdinalIgnoreCase);
    var isPolish = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "pl", StringComparison.OrdinalIgnoreCase);
    string L(string en, string pl) => isPolish ? pl : en;
    ViewData["Title"] = isDemo ? L("Request a demo", "Poproś o demo") : L("Sales enquiry", "Zapytanie sprzedażowe");
}

<div class="ed-home ed-contact-v28" data-contact-page="@(isDemo ? "demo" : "sales")">
    <partial name="_PublicSiteHeader" />

    <main class="ed-inquiry-v28">
        <div class="ed-contact-container ed-inquiry-grid">
            <section class="ed-inquiry-copy">
                <a class="ed-inquiry-back" href="/contact" data-contact-key="backContact">@L("Back to contact", "Wróć do kontaktu")</a>
                <span class="ed-contact-eyebrow" data-contact-key="@(isDemo ? "demoEyebrow" : "salesEyebrow")">
                    @(isDemo ? L("EDULYTICS DEMO", "DEMO EDULYTICS") : L("SALES ENQUIRY", "ZAPYTANIE SPRZEDAŻOWE"))
                </span>
                <h1 data-contact-key="@(isDemo ? "demoPageTitle" : "salesPageTitle")">
                    @(isDemo
                        ? L("See Edulytics in your school's context.", "Zobacz Edulytics w kontekście swojej szkoły.")
                        : L("Talk to us about Edulytics.", "Porozmawiaj z nami o Edulytics."))
                </h1>
                <p data-contact-key="@(isDemo ? "demoPageLead" : "salesPageLead")">
                    @(isDemo
                        ? L("Share a little about your role and school so the walkthrough can focus on what you want to evaluate.", "Opowiedz krótko o swojej roli i szkole, aby prezentacja mogła skupić się na tym, co chcesz ocenić.")
                        : L("Tell us about your school or requirement and we will help you determine whether Edulytics fits and how to get started.", "Opowiedz nam o swojej szkole lub potrzebie, a pomożemy ocenić dopasowanie Edulytics i sposób rozpoczęcia pracy."))
                </p>

                <div class="ed-inquiry-trust">
                    <div class="ed-inquiry-trust-item"><span>◎</span><div data-contact-key="trustCurriculum">@L("Built around curriculum and learning outcomes", "Oparte na programie i efektach uczenia się")</div></div>
                    <div class="ed-inquiry-trust-item"><span>✓</span><div data-contact-key="trustTeacher">@L("Teachers remain in control of formal assessment", "Nauczyciel zachowuje kontrolę nad formalnym ocenianiem")</div></div>
                    <div class="ed-inquiry-trust-item"><span>↻</span><div data-contact-key="trustPractice">@L("Practice stays separate from official school grades", "Ćwiczenia pozostają oddzielone od oficjalnych ocen szkolnych")</div></div>
                    <div class="ed-inquiry-trust-item"><span>→</span><div data-contact-key="trustNext">@L("Results lead to a clear next learning step", "Wyniki prowadzą do jasnego kolejnego kroku w nauce")</div></div>
                </div>
            </section>

            <section class="ed-inquiry-form-card">
                <h2 data-contact-key="@(isDemo ? "formDemoTitle" : "formSalesTitle")">
                    @(isDemo ? L("Request your demo", "Poproś o demo") : L("Tell us what you need", "Powiedz nam, czego potrzebujesz"))
                </h2>
                <p data-contact-key="@(isDemo ? "formDemoLead" : "formSalesLead")">
                    @(isDemo
                        ? L("Complete the details below and send your request directly to the Edulytics team.", "Uzupełnij dane poniżej i wyślij prośbę bezpośrednio do zespołu Edulytics.")
                        : L("Complete the details below and send your enquiry directly from this website.", "Uzupełnij dane poniżej i wyślij zapytanie bezpośrednio z tej strony."))
                </p>

                <form class="ed-inquiry-form"
                      method="post"
                      action="/contact/submit"
                      data-contact-server-form
                      novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="formType" value="@(isDemo ? "demo" : "sales")" />

                    <div aria-hidden="true"
                         style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
                        <label for="contact-website">Website</label>
                        <input id="contact-website"
                               name="website"
                               type="text"
                               tabindex="-1"
                               autocomplete="off" />
                    </div>

                    <div class="ed-inquiry-row">
                        <div class="ed-inquiry-field">
                            <label for="first-name" data-contact-key="firstName">@L("First name", "Imię")</label>
                            <input id="first-name"
                                   name="firstName"
                                   maxlength="80"
                                   autocomplete="given-name"
                                   required />
                        </div>
                        <div class="ed-inquiry-field">
                            <label for="last-name" data-contact-key="lastName">@L("Last name", "Nazwisko")</label>
                            <input id="last-name"
                                   name="lastName"
                                   maxlength="80"
                                   autocomplete="family-name"
                                   required />
                        </div>
                    </div>

                    <div class="ed-inquiry-field">
                        <label for="work-email" data-contact-key="email">@L("Work email", "E-mail służbowy")</label>
                        <input id="work-email"
                               name="email"
                               type="email"
                               maxlength="254"
                               autocomplete="email"
                               required />
                    </div>

                    <div class="ed-inquiry-field">
                        <label for="organisation" data-contact-key="organisation">@L("School or organisation", "Szkoła lub organizacja")</label>
                        <input id="organisation"
                               name="organisation"
                               maxlength="160"
                               autocomplete="organization"
                               required />
                    </div>

                    <div class="ed-inquiry-row">
                        <div class="ed-inquiry-field">
                            <label for="role" data-contact-key="role">@L("Role", "Rola")</label>
                            <select id="role" name="role" required>
                                <option value="" data-contact-key="rolePlaceholder">@L("Choose your role", "Wybierz rolę")</option>
                                <option value="Teacher" data-contact-key="roleTeacher">@L("Teacher", "Nauczyciel")</option>
                                <option value="Education leader / school administration" data-contact-key="roleLeader">@L("Education leader / school administration", "Lider edukacji / administracja szkoły")</option>
                                <option value="Subject supervisor" data-contact-key="roleSupervisor">@L("Subject supervisor", "Opiekun przedmiotu")</option>
                                <option value="Parent" data-contact-key="roleParent">@L("Parent", "Rodzic")</option>
                                <option value="Other" data-contact-key="roleOther">@L("Other", "Inna")</option>
                            </select>
                        </div>
                        <div class="ed-inquiry-field">
                            <label for="country" data-contact-key="country">@L("Country", "Kraj")</label>
                            <input id="country"
                                   name="country"
                                   maxlength="100"
                                   autocomplete="country-name" />
                        </div>
                    </div>

                    @if (isDemo)
                    {
                        <div class="ed-inquiry-field">
                            <label for="students" data-contact-key="students">@L("Approximate number of students", "Przybliżona liczba uczniów")</label>
                            <input id="students"
                                   name="students"
                                   inputmode="numeric"
                                   maxlength="12"
                                   pattern="[0-9]*" />
                        </div>
                    }

                    <div class="ed-inquiry-field">
                        <label for="message" data-contact-key="@(isDemo ? "messageDemo" : "message")">
                            @(isDemo ? L("What would you like to see in the demo?", "Co chcesz zobaczyć podczas demo?") : L("What would you like to discuss?", "Co chcesz omówić?"))
                        </label>
                        <textarea id="message"
                                  name="message"
                                  minlength="5"
                                  maxlength="3000"
                                  required></textarea>
                    </div>

                    <button class="ed-inquiry-submit"
                            type="submit"
                            data-contact-key="@(isDemo ? "submitDemo" : "submitSales")">
                        @(isDemo ? L("Send demo request", "Wyślij prośbę o demo") : L("Send sales enquiry", "Wyślij zapytanie sprzedażowe"))
                    </button>

                    <p class="ed-inquiry-note"
                       data-contact-key="mailNote">
                        @L(
                            "Your message is sent securely from this website. No email application will open.",
                            "Wiadomość jest wysyłana bezpiecznie z tej strony. Aplikacja pocztowa nie zostanie otwarta.")
                    </p>

                    <p class="ed-inquiry-note"
                       data-contact-form-status
                       aria-live="polite"
                       role="status"
                       style="min-height:1.5em;margin-top:.55rem;"></p>
                </form>
            </section>
        </div>
    </main>

    <partial name="_PublicSiteFooter" />
</div>
