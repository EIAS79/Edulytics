@using System.Globalization
@model string
@{
    Layout = "_PublicLayout";
    var formType = (Model ?? "sales").Trim().ToLowerInvariant();
    var isDemo = string.Equals(formType, "demo", StringComparison.OrdinalIgnoreCase);
    var isSupport = string.Equals(formType, "support", StringComparison.OrdinalIgnoreCase);
    var isGeneral = string.Equals(formType, "general", StringComparison.OrdinalIgnoreCase);
    var isPolish = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "pl", StringComparison.OrdinalIgnoreCase);
    var turnstileSiteKey = ViewData["TurnstileSiteKey"] as string ?? string.Empty;
    string L(string en, string pl) => isPolish ? pl : en;

    string PageTitle() => formType switch
    {
        "demo" => L("Request a demo", "Poproś o demo"),
        "support" => L("Contact support", "Skontaktuj się z pomocą"),
        "general" => L("Contact Edulytics", "Kontakt z Edulytics"),
        _ => L("Sales enquiry", "Zapytanie sprzedażowe")
    };

    string EyebrowKey() => formType switch
    {
        "demo" => "demoEyebrow",
        "support" => "supportEyebrow",
        "general" => "generalEyebrow",
        _ => "salesEyebrow"
    };

    string PageTitleKey() => formType switch
    {
        "demo" => "demoPageTitle",
        "support" => "supportPageTitle",
        "general" => "generalPageTitle",
        _ => "salesPageTitle"
    };

    string PageLeadKey() => formType switch
    {
        "demo" => "demoPageLead",
        "support" => "supportPageLead",
        "general" => "generalPageLead",
        _ => "salesPageLead"
    };

    string FormTitleKey() => formType switch
    {
        "demo" => "formDemoTitle",
        "support" => "formSupportTitle",
        "general" => "formGeneralTitle",
        _ => "formSalesTitle"
    };

    string FormLeadKey() => formType switch
    {
        "demo" => "formDemoLead",
        "support" => "formSupportLead",
        "general" => "formGeneralLead",
        _ => "formSalesLead"
    };

    string MessageKey() => formType switch
    {
        "demo" => "messageDemo",
        "support" => "messageSupport",
        "general" => "messageGeneral",
        _ => "message"
    };

    string SubmitKey() => formType switch
    {
        "demo" => "submitDemo",
        "support" => "submitSupport",
        "general" => "submitGeneral",
        _ => "submitSales"
    };

    ViewData["Title"] = PageTitle();
}

<div class="ed-home ed-contact-v28" data-contact-page="@formType">
    <partial name="_PublicSiteHeader" />

    <main class="ed-inquiry-v28">
        <div class="ed-contact-container ed-inquiry-grid">
            <section class="ed-inquiry-copy">
                <a class="ed-inquiry-back" href="/contact" data-contact-key="backContact">@L("Back to contact", "Wróć do kontaktu")</a>
                <span class="ed-contact-eyebrow" data-contact-key="@EyebrowKey()">
                    @switch (formType)
                    {
                        case "demo":
                            @L("EDULYTICS DEMO", "DEMO EDULYTICS")
                            break;
                        case "support":
                            @L("SUPPORT REQUEST", "PROŚBA O WSPARCIE")
                            break;
                        case "general":
                            @L("CONTACT EDULYTICS", "KONTAKT Z EDULYTICS")
                            break;
                        default:
                            @L("SALES ENQUIRY", "ZAPYTANIE SPRZEDAŻOWE")
                            break;
                    }
                </span>
                <h1 data-contact-key="@PageTitleKey()">
                    @switch (formType)
                    {
                        case "demo":
                            @L("See Edulytics in your school's context.", "Zobacz Edulytics w kontekście swojej szkoły.")
                            break;
                        case "support":
                            @L("How can we help you?", "Jak możemy Ci pomóc?")
                            break;
                        case "general":
                            @L("Send us a message.", "Napisz do nas.")
                            break;
                        default:
                            @L("Talk to us about Edulytics.", "Porozmawiaj z nami o Edulytics.")
                            break;
                    }
                </h1>
                <p data-contact-key="@PageLeadKey()">
                    @switch (formType)
                    {
                        case "demo":
                            @L("Share a little about your role and school so the walkthrough can focus on what you want to evaluate.", "Opowiedz krótko o swojej roli i szkole, aby prezentacja mogła skupić się na tym, co chcesz ocenić.")
                            break;
                        case "support":
                            @L("Describe the access, account or technical issue and send it directly to the Edulytics team.", "Opisz problem z dostępem, kontem lub kwestią techniczną i wyślij go bezpośrednio do zespołu Edulytics.")
                            break;
                        case "general":
                            @L("Use this form for a general question that does not fit sales, demo or technical support.", "Użyj tego formularza w przypadku ogólnego pytania, które nie dotyczy sprzedaży, demo ani wsparcia technicznego.")
                            break;
                        default:
                            @L("Tell us about your school or requirement and we will help you determine whether Edulytics fits and how to get started.", "Opowiedz nam o swojej szkole lub potrzebie, a pomożemy ocenić dopasowanie Edulytics i sposób rozpoczęcia pracy.")
                            break;
                    }
                </p>

                <div class="ed-inquiry-trust">
                    <div class="ed-inquiry-trust-item"><span>◎</span><div data-contact-key="trustCurriculum">@L("Built around curriculum and learning outcomes", "Oparte na programie i efektach uczenia się")</div></div>
                    <div class="ed-inquiry-trust-item"><span>✓</span><div data-contact-key="trustTeacher">@L("Teachers remain in control of formal assessment", "Nauczyciel zachowuje kontrolę nad formalnym ocenianiem")</div></div>
                    <div class="ed-inquiry-trust-item"><span>↻</span><div data-contact-key="trustPractice">@L("Practice stays separate from official school grades", "Ćwiczenia pozostają oddzielone od oficjalnych ocen szkolnych")</div></div>
                    <div class="ed-inquiry-trust-item"><span>→</span><div data-contact-key="trustNext">@L("Results lead to a clear next learning step", "Wyniki prowadzą do jasnego kolejnego kroku w nauce")</div></div>
                </div>
            </section>

            <section class="ed-inquiry-form-card">
                <h2 data-contact-key="@FormTitleKey()">
                    @switch (formType)
                    {
                        case "demo":
                            @L("Request your demo", "Poproś o demo")
                            break;
                        case "support":
                            @L("Tell us what you need help with", "Opisz, w czym potrzebujesz pomocy")
                            break;
                        case "general":
                            @L("Send your message", "Wyślij wiadomość")
                            break;
                        default:
                            @L("Tell us what you need", "Powiedz nam, czego potrzebujesz")
                            break;
                    }
                </h2>
                <p data-contact-key="@FormLeadKey()">
                    @switch (formType)
                    {
                        case "demo":
                            @L("Complete the details below and send your request directly to the Edulytics team.", "Uzupełnij dane poniżej i wyślij prośbę bezpośrednio do zespołu Edulytics.")
                            break;
                        case "support":
                            @L("Complete the form and your support request will be sent securely from this website.", "Wypełnij formularz, a zgłoszenie do pomocy zostanie bezpiecznie wysłane z tej strony.")
                            break;
                        case "general":
                            @L("Complete the form and send your message directly from this website.", "Wypełnij formularz i wyślij wiadomość bezpośrednio z tej strony.")
                            break;
                        default:
                            @L("Complete the details below and send your enquiry directly from this website.", "Uzupełnij dane poniżej i wyślij zapytanie bezpośrednio z tej strony.")
                            break;
                    }
                </p>

                <form class="ed-inquiry-form"
                      method="post"
                      action="/contact/submit"
                      data-contact-server-form
                      novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="formType" value="@formType" />

                    <div aria-hidden="true"
                         style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
                        <label for="contact-website">Website</label>
                        <input id="contact-website"
                               name="website"
                               type="text"
                               tabindex="-1"
                               autocomplete="off" />
                    </div>

                    <div class="ed-inquiry-row">
                        <div class="ed-inquiry-field">
                            <label for="first-name" data-contact-key="firstName">@L("First name", "Imię")</label>
                            <input id="first-name"
                                   name="firstName"
                                   maxlength="80"
                                   autocomplete="given-name"
                                   required />
                        </div>
                        <div class="ed-inquiry-field">
                            <label for="last-name" data-contact-key="lastName">@L("Last name", "Nazwisko")</label>
                            <input id="last-name"
                                   name="lastName"
                                   maxlength="80"
                                   autocomplete="family-name"
                                   required />
                        </div>
                    </div>

                    <div class="ed-inquiry-field">
                        <label for="work-email" data-contact-key="email">@L("Work email", "E-mail służbowy")</label>
                        <input id="work-email"
                               name="email"
                               type="email"
                               maxlength="254"
                               autocomplete="email"
                               required />
                    </div>

                    <div class="ed-inquiry-field">
                        <label for="organisation" data-contact-key="organisation">@L("School or organisation", "Szkoła lub organizacja")</label>
                        <input id="organisation"
                               name="organisation"
                               maxlength="160"
                               autocomplete="organization"
                               required />
                    </div>

                    <div class="ed-inquiry-row">
                        <div class="ed-inquiry-field">
                            <label for="role" data-contact-key="role">@L("Role", "Rola")</label>
                            <select id="role" name="role" required>
                                <option value="" data-contact-key="rolePlaceholder">@L("Choose your role", "Wybierz rolę")</option>
                                <option value="Teacher" data-contact-key="roleTeacher">@L("Teacher", "Nauczyciel")</option>
                                <option value="Education leader / school administration" data-contact-key="roleLeader">@L("Education leader / school administration", "Lider edukacji / administracja szkoły")</option>
                                <option value="Subject supervisor" data-contact-key="roleSupervisor">@L("Subject supervisor", "Opiekun przedmiotu")</option>
                                <option value="Parent" data-contact-key="roleParent">@L("Parent", "Rodzic")</option>
                                <option value="Other" data-contact-key="roleOther">@L("Other", "Inna")</option>
                            </select>
                        </div>
                        <div class="ed-inquiry-field">
                            <label for="country" data-contact-key="country">@L("Country", "Kraj")</label>
                            <input id="country"
                                   name="country"
                                   maxlength="100"
                                   autocomplete="country-name" />
                        </div>
                    </div>

                    @if (isDemo)
                    {
                        <div class="ed-inquiry-field">
                            <label for="students" data-contact-key="students">@L("Approximate number of students", "Przybliżona liczba uczniów")</label>
                            <input id="students"
                                   name="students"
                                   inputmode="numeric"
                                   maxlength="12"
                                   pattern="[0-9]*" />
                        </div>
                    }

                    <div class="ed-inquiry-field">
                        <label for="message" data-contact-key="@MessageKey()">
                            @switch (formType)
                            {
                                case "demo":
                                    @L("What would you like to see in the demo?", "Co chcesz zobaczyć podczas demo?")
                                    break;
                                case "support":
                                    @L("What do you need help with?", "W czym potrzebujesz pomocy?")
                                    break;
                                case "general":
                                    @L("How can we help?", "Jak możemy pomóc?")
                                    break;
                                default:
                                    @L("What would you like to discuss?", "Co chcesz omówić?")
                                    break;
                            }
                        </label>
                        <textarea id="message"
                                  name="message"
                                  minlength="5"
                                  maxlength="3000"
                                  required></textarea>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(turnstileSiteKey))
                    {
                        <div class="ed-turnstile-wrap" aria-label="@L("Security verification", "Weryfikacja bezpieczeństwa")">
                            <div class="cf-turnstile"
                                 data-sitekey="@turnstileSiteKey"
                                 data-action="public_contact"
                                 data-theme="light"
                                 data-size="flexible"
                                 data-language="auto"></div>
                        </div>
                    }
                    else
                    {
                        <p class="ed-inquiry-note" role="alert">
                            @L(
                                "Security verification is temporarily unavailable. Please try again later.",
                                "Weryfikacja bezpieczeństwa jest tymczasowo niedostępna. Spróbuj ponownie później.")
                        </p>
                    }

                    <button class="ed-inquiry-submit"
                            type="submit"
                            @(string.IsNullOrWhiteSpace(turnstileSiteKey) ? "disabled" : null)
                            data-contact-key="@SubmitKey()">
                        @switch (formType)
                        {
                            case "demo":
                                @L("Send demo request", "Wyślij prośbę o demo")
                                break;
                            case "support":
                                @L("Send support request", "Wyślij zgłoszenie do pomocy")
                                break;
                            case "general":
                                @L("Send message", "Wyślij wiadomość")
                                break;
                            default:
                                @L("Send sales enquiry", "Wyślij zapytanie sprzedażowe")
                                break;
                        }
                    </button>

                    <p class="ed-inquiry-note"
                       data-contact-form-status
                       aria-live="polite"
                       role="status"
                       style="min-height:1.5em;margin-top:.55rem;"></p>
                </form>
            </section>
        </div>
    </main>

    <partial name="_PublicSiteFooter" />
</div>

@if (!string.IsNullOrWhiteSpace(turnstileSiteKey))
{
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
}
