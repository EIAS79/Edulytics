@using System.Text.RegularExpressions
@using Edulytics.Core.Enums
@using Edulytics.Services.Practice
@model PracticeAttemptDetails
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.StudentResource> S
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = S["PrivatePracticeAttemptTitle"].Value;
    var lessonGameMode = ViewData["LessonGameMode"] is true;
    var orderedQuestions = Model.Questions.OrderBy(x => x.Order).ToArray();
    var answeredCount = orderedQuestions.Count(x => x.Answered);
    var totalQuestions = orderedQuestions.Length;
    var progressPercent = totalQuestions == 0
        ? 0
        : Math.Round(answeredCount * 100d / totalQuestions, 1);
}
<style>
    .practice-question-content { min-width: 0; }
    .practice-choice-list { display: grid; gap: 10px; margin: 12px 0 14px; }
    .practice-choice {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid #d8e1ee;
        border-radius: 12px;
        background: #fff;
        cursor: pointer;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
    }
    .practice-choice:hover { border-color: #8eaef6; background: #f8faff; }
    .practice-choice:has(input:checked) { border-color: #3568dc; box-shadow: 0 0 0 2px rgba(53,104,220,.12); background: #f5f8ff; }
    .practice-choice input { width: 18px; height: 18px; margin: 0; flex: 0 0 18px; }
    .practice-choice-letter {
        display: inline-grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: #eef3ff;
        color: #244da8;
        font-weight: 700;
        flex: 0 0 30px;
    }
    .practice-choice-text { font-weight: 600; line-height: 1.35; }
    .practice-answer-actions { display: grid; gap: 10px; }

    .lesson-game-shell {
        position: relative;
        overflow: hidden;
        min-height: 610px;
        border: 1px solid #9bdde5;
        border-radius: 28px;
        background:
            radial-gradient(circle at 11% 18%, rgba(255,255,255,.58) 0 6%, transparent 7%),
            radial-gradient(circle at 82% 82%, rgba(255,255,255,.28) 0 9%, transparent 10%),
            linear-gradient(145deg, #c9f6f6 0%, #8be4ed 48%, #63d2df 100%);
        box-shadow: 0 22px 60px rgba(18,96,112,.17);
        color: #123a48;
    }
    .lesson-game-shell::before,
    .lesson-game-shell::after {
        content: "";
        position: absolute;
        border-radius: 999px;
        background: rgba(255,255,255,.18);
        pointer-events: none;
    }
    .lesson-game-shell::before { width: 330px; height: 330px; left: -120px; bottom: -170px; }
    .lesson-game-shell::after { width: 250px; height: 250px; right: -80px; top: 110px; }
    .lesson-game-topbar {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 22px 26px 14px;
    }
    .lesson-game-kicker { margin: 0; font-size: .84rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; color: #0c6677; }
    .lesson-game-counter { font-weight: 900; color: #174a59; white-space: nowrap; }
    .lesson-game-progress {
        position: relative;
        z-index: 1;
        height: 13px;
        margin: 0 26px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(255,255,255,.58);
        box-shadow: inset 0 1px 3px rgba(15,82,96,.12);
    }
    .lesson-game-progress > span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #0b7285, #20a87f);
        transition: width .25s ease;
    }
    .lesson-game-feedback { position: relative; z-index: 2; margin: 18px 26px 0; }
    .lesson-game-stage {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0,1fr) 280px;
        gap: 28px;
        align-items: stretch;
        padding: 30px 32px 34px;
    }
    .lesson-game-question {
        min-height: 430px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 34px;
        border: 1px solid rgba(255,255,255,.55);
        border-radius: 24px;
        background: rgba(255,255,255,.42);
        backdrop-filter: blur(3px);
    }
    .lesson-game-question-number { font-weight: 900; color: #0c6677; margin-bottom: 18px; }
    .lesson-game-question h1 {
        max-width: 760px;
        margin: 0 0 28px;
        font-size: clamp(2rem,5vw,4.2rem);
        line-height: 1.12;
        letter-spacing: -.035em;
        color: #103b49;
    }
    .lesson-game-answer {
        width: min(260px,100%);
        min-height: 72px;
        padding: 12px 20px;
        border: 3px solid #0b7285;
        border-radius: 16px;
        background: #fffbd0;
        color: #173f4d;
        text-align: center;
        font-size: 2rem;
        font-weight: 900;
        outline: none;
        box-shadow: 0 8px 20px rgba(14,89,104,.12);
    }
    .lesson-game-answer:focus { box-shadow: 0 0 0 5px rgba(11,114,133,.16), 0 8px 20px rgba(14,89,104,.12); }
    .lesson-game-side {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 18px;
        border: 1px solid rgba(11,114,133,.24);
        border-radius: 24px;
        background: rgba(23,159,178,.20);
    }
    .lesson-game-keypad { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; }
    .lesson-game-key {
        aspect-ratio: 1;
        min-height: 58px;
        border: 0;
        border-radius: 50%;
        background: #075d6c;
        color: #fff;
        font-size: 1.45rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 7px 16px rgba(3,64,75,.18);
        transition: transform .1s ease, filter .1s ease;
    }
    .lesson-game-key:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .lesson-game-key:active { transform: translateY(1px) scale(.98); }
    .lesson-game-tools { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
    .lesson-game-tool {
        min-height: 44px;
        border: 1px solid rgba(7,93,108,.28);
        border-radius: 12px;
        background: rgba(255,255,255,.62);
        color: #075d6c;
        font-weight: 900;
        cursor: pointer;
    }
    .lesson-game-submit {
        width: 100%;
        min-height: 54px;
        margin-top: 16px;
        border: 0;
        border-radius: 15px;
        background: #0b7285;
        color: #fff;
        font-weight: 900;
        font-size: 1rem;
        cursor: pointer;
        box-shadow: 0 9px 18px rgba(5,92,108,.2);
    }
    .lesson-game-choices { width: min(640px,100%); text-align: start; }
    .lesson-game-finish {
        position: relative;
        z-index: 1;
        max-width: 680px;
        margin: 70px auto;
        padding: 40px;
        text-align: center;
        border-radius: 24px;
        background: rgba(255,255,255,.68);
        box-shadow: 0 18px 42px rgba(18,96,112,.14);
    }
    .lesson-game-finish h1 { margin-top: 0; color: #103b49; }
    .lesson-game-score { font-size: 2.2rem; font-weight: 950; color: #0b7285; }
    .lesson-game-footer-actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 24px; }
    @@media (max-width: 820px) {
        .lesson-game-shell { min-height: 0; border-radius: 20px; }
        .lesson-game-stage { grid-template-columns: 1fr; padding: 22px; }
        .lesson-game-question { min-height: 330px; padding: 24px 18px; }
        .lesson-game-side { max-width: 380px; width: 100%; margin: 0 auto; }
    }
    @@media (max-width: 480px) {
        .lesson-game-topbar { padding: 18px 18px 12px; }
        .lesson-game-progress { margin-inline: 18px; }
        .lesson-game-feedback { margin-inline: 18px; }
        .lesson-game-stage { padding: 18px; gap: 16px; }
        .lesson-game-question h1 { font-size: 2rem; }
        .lesson-game-answer { min-height: 62px; font-size: 1.65rem; }
        .lesson-game-key { min-height: 52px; }
    }
</style>

@if (lessonGameMode)
{
    var currentQuestion = orderedQuestions.FirstOrDefault(x => !x.Answered);
    var prompt = currentQuestion?.Prompt ?? string.Empty;
    var optionMatches = currentQuestion is null
        ? MatchCollection.Empty
        : Regex.Matches(prompt, @"(?<![A-Za-z0-9])([A-D])\)\s*", RegexOptions.CultureInvariant);
    var isMultipleChoice = currentQuestion is not null && optionMatches.Count >= 2 && optionMatches[0].Index > 0;
    var stem = isMultipleChoice ? prompt[..optionMatches[0].Index].Trim() : prompt;
    var choices = new List<(string Label, string Value)>();
    if (isMultipleChoice)
    {
        for (var choiceIndex = 0; choiceIndex < optionMatches.Count; choiceIndex++)
        {
            var match = optionMatches[choiceIndex];
            var start = match.Index + match.Length;
            var end = choiceIndex + 1 < optionMatches.Count ? optionMatches[choiceIndex + 1].Index : prompt.Length;
            var value = prompt[start..end].Trim();
            if (value.Length > 0) choices.Add((match.Groups[1].Value, value));
        }
        isMultipleChoice = choices.Count >= 2;
    }

    <section class="lesson-game-shell" aria-label="@S["PrivatePracticeAttemptTitle"]">
        <div class="lesson-game-topbar">
            <div>
                <p class="lesson-game-kicker">@S["PracticeTab"]</p>
                <strong>@S["PrivatePracticeAttemptTitle"]</strong>
            </div>
            <div class="lesson-game-counter">@S["Question"] @Math.Min(answeredCount + 1, totalQuestions) / @totalQuestions</div>
        </div>
        <div class="lesson-game-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progressPercent">
            <span style="width:@progressPercent%"></span>
        </div>

        @if (TempData["Error"] is string gameError)
        {
            <div class="lesson-game-feedback school-alert school-alert-error" role="alert">@gameError</div>
        }
        @if (TempData["PracticeFeedback"] is string gameFeedback)
        {
            <div class="lesson-game-feedback school-alert @(gameFeedback == "correct" ? "school-alert-success" : "school-alert-error")" role="status">
                @(gameFeedback == "correct" ? S["PracticeCorrect"].Value : S["PracticeIncorrect"].Value)
                @if (TempData["PracticeSolution"] is string gameSolution)
                {
                    <div><strong>@S["PracticeSolution"]:</strong> @gameSolution</div>
                }
            </div>
        }

        @if (Model.Status == PracticeAttemptStatus.Submitted)
        {
            <div class="lesson-game-finish">
                <h1>@S["PracticeFinish"]</h1>
                <p class="lesson-game-score">@Model.Percentage.ToString("0.##")%</p>
                <p><strong>@S["Score"]:</strong> @Model.Score.ToString("0.##") / @Model.MaxScore.ToString("0.##")</p>
                <div class="lesson-game-footer-actions">
                    <a class="school-button school-button-primary" asp-controller="StudentPortal" asp-action="Learning">@S["MyLearning"]</a>
                    <a class="school-button" asp-action="Index">@S["BackToPrivatePractice"]</a>
                </div>
            </div>
        }
        else if (currentQuestion is not null)
        {
            <form asp-action="Answer" asp-route-id="@Model.AttemptId" method="post" class="lesson-game-stage">
                @Html.AntiForgeryToken()
                <input type="hidden" name="attemptItemId" value="@currentQuestion.AttemptItemId" />
                <input type="hidden" name="mode" value="lesson-game" />
                <div class="lesson-game-question">
                    <div class="lesson-game-question-number">@S["Question"] @currentQuestion.Order</div>
                    <h1>@stem</h1>
                    @if (isMultipleChoice)
                    {
                        <div class="practice-choice-list lesson-game-choices" role="radiogroup" aria-label="@S["YourAnswer"]">
                            @foreach (var choice in choices)
                            {
                                <label class="practice-choice">
                                    <input type="radio" name="answer" value="@choice.Value" required />
                                    <span class="practice-choice-letter">@choice.Label</span>
                                    <span class="practice-choice-text">@choice.Value</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <input id="lesson-practice-answer" class="lesson-game-answer" name="answer" inputmode="numeric" maxlength="32" required autocomplete="off" aria-label="@S["YourAnswer"]" autofocus />
                    }
                </div>
                <aside class="lesson-game-side">
                    @if (!isMultipleChoice)
                    {
                        <div class="lesson-game-tools">
                            <button class="lesson-game-tool" type="button" data-practice-key="clear" aria-label="@S["PracticeClear"]">C</button>
                            <button class="lesson-game-tool" type="button" data-practice-key="backspace" aria-label="@S["PracticeBackspace"]">⌫</button>
                        </div>
                        <div class="lesson-game-keypad" aria-label="@S["YourAnswer"]">
                            @for (var digit = 1; digit <= 9; digit++)
                            {
                                <button class="lesson-game-key" type="button" data-practice-key="@digit">@digit</button>
                            }
                            <span aria-hidden="true"></span>
                            <button class="lesson-game-key" type="button" data-practice-key="0">0</button>
                            <span aria-hidden="true"></span>
                        </div>
                    }
                    <button class="lesson-game-submit" type="submit">@S["PracticeCheckAnswer"]</button>
                </aside>
            </form>
        }
        else
        {
            <div class="lesson-game-finish">
                <h1>@S["PracticeAnswerAll"]</h1>
                <form asp-action="Submit" asp-route-id="@Model.AttemptId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mode" value="lesson-game" />
                    <button class="school-button school-button-primary" type="submit">@S["PracticeFinish"]</button>
                </form>
            </div>
        }
    </section>
    <script src="~/js/student-lesson-practice.js" asp-append-version="true"></script>
}
else
{
    <header class="student-page-header">
        <span class="student-eyebrow">@S["PrivatePractice"]</span>
        <h1>@S["PrivatePracticeAttemptTitle"]</h1>
        <p>@S["PrivatePracticeAttemptSubtitle"]</p>
    </header>
    @if (TempData["Error"] is string error)
    {
        <div class="school-alert school-alert-error" role="alert">@error</div>
    }
    @if (TempData["PracticeFeedback"] is string feedback)
    {
        <div class="school-alert @(feedback == "correct" ? "school-alert-success" : "school-alert-error")" role="status">
            @(feedback == "correct" ? S["PracticeCorrect"].Value : S["PracticeIncorrect"].Value)
            @if (TempData["PracticeSolution"] is string solution)
            {
                <div><strong>@S["PracticeSolution"]:</strong> @solution</div>
            }
        </div>
    }
    <section class="student-card">
        <p><strong>@S["Status"]:</strong> @Model.Status</p>
        @if (Model.Status == PracticeAttemptStatus.Submitted)
        {
            <p><strong>@S["Score"]:</strong> @Model.Score.ToString("0.##") / @Model.MaxScore.ToString("0.##") · <strong>@S["Percentage"]:</strong> @Model.Percentage.ToString("0.##")%</p>
        }
    </section>
    <div class="student-card-list">
    @foreach (var question in orderedQuestions)
    {
        var prompt = question.Prompt ?? string.Empty;
        var optionMatches = Regex.Matches(
            prompt,
            @"(?<![A-Za-z0-9])([A-D])\)\s*",
            RegexOptions.CultureInvariant);
        var isMultipleChoice = optionMatches.Count >= 2 && optionMatches[0].Index > 0;
        var stem = isMultipleChoice
            ? prompt[..optionMatches[0].Index].Trim()
            : prompt;
        var choices = new List<(string Label, string Value)>();
        if (isMultipleChoice)
        {
            for (var choiceIndex = 0; choiceIndex < optionMatches.Count; choiceIndex++)
            {
                var match = optionMatches[choiceIndex];
                var start = match.Index + match.Length;
                var end = choiceIndex + 1 < optionMatches.Count
                    ? optionMatches[choiceIndex + 1].Index
                    : prompt.Length;
                var value = prompt[start..end].Trim();
                if (value.Length > 0)
                    choices.Add((match.Groups[1].Value, value));
            }
            isMultipleChoice = choices.Count >= 2;
        }

        <article class="student-assessment-card">
            <div class="practice-question-content">
                <span class="student-subject-code">@S["Question"] @question.Order</span>
                <h2>@stem</h2>
                <p>@S["AssessmentDifficulty"]: @question.Difficulty</p>
            </div>
            @if (question.Answered)
            {
                <div class="school-alert @(question.IsCorrect == true ? "school-alert-success" : "school-alert-error")">
                    @(question.IsCorrect == true ? S["PracticeCorrect"].Value : S["PracticeIncorrect"].Value)
                    @if (!string.IsNullOrWhiteSpace(question.Feedback))
                    {
                        <div><strong>@S["PracticeSolution"]:</strong> @question.Feedback</div>
                    }
                </div>
            }
            else if (Model.Status == PracticeAttemptStatus.InProgress)
            {
                <form asp-action="Answer" asp-route-id="@Model.AttemptId" method="post" class="assessment-form practice-answer-actions">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="attemptItemId" value="@question.AttemptItemId" />
                    @if (isMultipleChoice)
                    {
                        <div class="practice-choice-list" role="radiogroup" aria-label="@S["YourAnswer"]">
                            @foreach (var choice in choices)
                            {
                                <label class="practice-choice">
                                    <input type="radio" name="answer" value="@choice.Value" required />
                                    <span class="practice-choice-letter">@choice.Label</span>
                                    <span class="practice-choice-text">@choice.Value</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <label>@S["YourAnswer"]</label>
                        <input name="answer" maxlength="2000" required autocomplete="off" />
                    }
                    <button class="school-button school-button-primary" type="submit">@S["PracticeCheckAnswer"]</button>
                </form>
            }
        </article>
    }
    </div>
    @if (Model.Status == PracticeAttemptStatus.InProgress)
    {
        var complete = orderedQuestions.Length > 0 && orderedQuestions.All(x => x.Answered);
        <section class="student-card">
            @if (complete)
            {
                <form asp-action="Submit" asp-route-id="@Model.AttemptId" method="post">
                    @Html.AntiForgeryToken()
                    <button class="school-button school-button-primary" type="submit">@S["PracticeFinish"]</button>
                </form>
            }
            else
            {
                <button class="school-button" type="button" disabled>@S["PracticeAnswerAll"]</button>
            }
        </section>
    }
    <a class="school-button" asp-action="Index">@S["BackToPrivatePractice"]</a>
}
