@model Edulytics.Web.GameRouting.StudentGameLaunchViewModel
@{
    Layout = null;
    var renderer = Model.Route.RendererKey;
    var isCountTouch = string.Equals(renderer, "count-touch", StringComparison.Ordinal);
    var isUniversalWorkspace = string.Equals(renderer, Edulytics.Web.GameRouting.GameLessonRouter.UniversalRendererKey, StringComparison.Ordinal);
    var isLessonGrounded =
        string.Equals(renderer, Edulytics.Web.GameRouting.GameLessonRouteResolver.LessonGroundedRendererKey, StringComparison.Ordinal) ||
        string.Equals(renderer, Edulytics.Web.GameRouting.MathematicsV2ProductMigrationPolicy.RendererKey, StringComparison.Ordinal);
    var isExactLessonGrounded = isLessonGrounded &&
        (string.Equals(Model.Route.Mechanic, "TWO_UNKNOWNS", StringComparison.Ordinal) ||
         string.Equals(Model.Route.Mechanic, "SCALE_READING", StringComparison.Ordinal) ||
         string.Equals(Model.Route.Mechanic, "FRACTION_COMPARE_UNLIKE", StringComparison.Ordinal) ||
         string.Equals(Model.Route.Mechanic, "FRACTION_EQUIVALENT", StringComparison.Ordinal) ||
         string.Equals(Model.Route.Mechanic, "UNIT_RATE", StringComparison.Ordinal));
    var isStage22ServerAuthoritative =
        isExactLessonGrounded &&
        string.Equals(
            renderer,
            Edulytics.Web.GameRouting.MathematicsV2ProductMigrationPolicy.RendererKey,
            StringComparison.Ordinal);
    var usesWorkspaceStyles = isUniversalWorkspace || isLessonGrounded;
    var isSolidGeometry = isUniversalWorkspace &&
        (string.Equals(Model.Route.Mechanic, "VOLUME_BUILD", StringComparison.Ordinal) ||
         string.Equals(Model.Route.Mechanic, "SURFACE_AREA_BUILD", StringComparison.Ordinal));
    var isSpecializedUniversalPractice = isUniversalWorkspace &&
        (string.Equals(Model.Route.Mechanic, "PERIMETER_TRACE", StringComparison.Ordinal) ||
         string.Equals(Model.Route.Mechanic, "AREA_TILE", StringComparison.Ordinal) ||
         string.Equals(Model.Route.Mechanic, "MONEY_VALUE", StringComparison.Ordinal) ||
         string.Equals(Model.Route.Mechanic, "MAKE_AMOUNT", StringComparison.Ordinal) ||
         string.Equals(Model.Route.Mechanic, "CHANGE_TRANSACTION", StringComparison.Ordinal));
    var backLabel = Model.Route.Locale switch
    {
        "pl" => "← Powrót do lekcji",
        "ar" => "العودة إلى الدرس →",
        _ => "← Back to lesson"
    };
    var practiceLabel = Model.Route.Locale switch
    {
        "pl" => "Ćwiczenie Edulytics",
        "ar" => "تدريب Edulytics",
        _ => "Edulytics Practice"
    };
}
<!DOCTYPE html>
<html lang="@Model.Route.Locale" dir="@(Model.Route.Locale == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>@Model.Title - Edulytics Practice</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isCountTouch)
    {
        <link rel="stylesheet" href="~/css/counting-grove-v1.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/counting-grove-student-ui.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/game-workspace-v1.css" asp-append-version="true" />
        @if (usesWorkspaceStyles)
        {
            <link rel="stylesheet" href="~/css/curriculum-workspace-runtime.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/eddy-overlap-v1.css" asp-append-version="true" />
        }
    }
    <link rel="stylesheet" href="~/css/practice-unified-ui-v2.css" asp-append-version="true" />
</head>
<body class="@(isCountTouch ? "cg-preview-page" : "gw-page")">
    <main class="@(isCountTouch ? "cg-preview-wrap" : "gw-wrap")">
        <a class="gw-back" asp-controller="StudentPortal" asp-action="Lesson" asp-route-id="@Model.LessonId">@backLabel</a>
        <header class="@(isCountTouch ? "cg-preview-head" : "gw-head")">
            <div><p>@practiceLabel</p><h1>@Model.Title</h1><p>@Model.UnitTitle</p></div>
        </header>
        <section aria-label="Practice game">
            <script src="~/js/practice-voice-runtime.js" asp-append-version="true"></script>

    @if (renderer == "count-touch")
            {
                <div data-count-touch-game data-lesson-code="@Model.LessonCode" data-lesson-language="@Model.Route.Locale"></div>
            }
            else if (renderer == "angle-explorer")
            {
                <div data-angle-explorer-game data-lesson-code="@Model.LessonCode" data-lesson-language="@Model.Route.Locale"></div>
            }
            else if (renderer == "fraction-forge")
            {
                <div data-fraction-forge-game data-lesson-code="@Model.LessonCode" data-lesson-language="@Model.Route.Locale"></div>
            }
            else if (isLessonGrounded)
            {
                <div data-lesson-grounded-game
                     data-lesson-code="@Model.LessonCode"
                     data-lesson-language="@Model.Route.Locale"
                     data-lesson-title="@Model.Title"
                     data-unit-title="@Model.UnitTitle"
                     data-workspace="@Model.Route.Workspace"
                     data-mechanic="@Model.Route.Mechanic"
                     data-curriculum-adoption-id="@Model.CurriculumAdoptionId"
                     data-lesson-id="@Model.LessonId"
                     data-stage22-server-authoritative="@(isStage22ServerAuthoritative ? "true" : "false")"></div>
                @if (isStage22ServerAuthoritative)
                {
                    <form data-stage22-antiforgery hidden>
                        @Html.AntiForgeryToken()
                    </form>
                }
            }
            else if (isUniversalWorkspace)
            {
                <div data-curriculum-workspace-game
                     data-lesson-code="@Model.LessonCode"
                     data-lesson-language="@Model.Route.Locale"
                     data-lesson-title="@Model.Title"
                     data-unit-title="@Model.UnitTitle"
                     data-workspace="@Model.Route.Workspace"
                     data-mechanic="@Model.Route.Mechanic"></div>
            }
            else
            {
                <div class="gw-error">This game mechanic is not available yet.</div>
            }
        </section>
    </main>

    @if (renderer == "count-touch")
    {
        <script src="~/js/count-touch-preview.js" asp-append-version="true"></script>
    }
    else if (renderer == "angle-explorer")
    {
        <script src="~/js/angle-explorer-preview.js" asp-append-version="true"></script>
    }
    else if (renderer == "fraction-forge")
    {
        <script src="~/js/fraction-forge-preview.js" asp-append-version="true"></script>
    }
    else if (isStage22ServerAuthoritative)
    {
        <script src="~/js/lesson-grounded-practice-stage22.js" asp-append-version="true"></script>
    }
    else if (isExactLessonGrounded)
    {
        <script src="~/js/lesson-grounded-practice-v2.js" asp-append-version="true"></script>
    }
    else if (isLessonGrounded)
    {
        <script src="~/js/lesson-grounded-practice-v1.js" asp-append-version="true"></script>
    }
    else if (isSolidGeometry)
    {
        <script src="~/js/solid-geometry-runtime.js" asp-append-version="true"></script>
    }
    else if (isSpecializedUniversalPractice)
    {
        <script src="~/js/curriculum-specialized-practice-v3.js" asp-append-version="true"></script>
    }
    else if (isUniversalWorkspace)
    {
        <script src="~/js/curriculum-workspace-runtime-v2.js" asp-append-version="true"></script>
        <script src="~/js/curriculum-workspace-runtime-v3-fixes.js" asp-append-version="true"></script>
    }
</body>
</html>