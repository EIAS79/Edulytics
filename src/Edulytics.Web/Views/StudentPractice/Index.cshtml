@using System.Globalization
@using Edulytics.Services.Practice
@model StudentPrivatePracticeWorkspace
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.StudentResource> S
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = S["PrivatePracticeTitle"].Value;
    var selected = Model.SelectedCurriculumAdoptionId;
    var selectedCurriculum = selected.HasValue
        ? Model.Curricula.FirstOrDefault(x => x.CurriculumAdoptionId == selected.Value)
        : null;
    var unitOptions = Model.Units ?? Array.Empty<StudentPrivatePracticeUnitOption>();
    var orderedAttempts = Model.Attempts
        .OrderByDescending(x => x.StartedAtUtc)
        .ThenByDescending(x => x.AttemptId)
        .ToArray();
    var statusOptions = orderedAttempts
        .Select(x => x.Status.ToString())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToArray();
    var isPolish = string.Equals(
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
        "pl",
        StringComparison.OrdinalIgnoreCase);
    string L(string en, string pl) => isPolish ? pl : en;
}
<link rel="stylesheet" href="~/css/round7-list-scroll.css" asp-append-version="true" />
<header class="student-page-header">
    <span class="student-eyebrow">@S["PrivatePractice"]</span>
    <h1>@S["PrivatePracticeTitle"]</h1>
    <p>@S["PrivatePracticeSubtitle"]</p>
</header>
<div class="student-card"><strong>@S["PrivatePracticeNotice"]</strong></div>
@if (TempData["Error"] is string error)
{
    <div class="school-alert school-alert-error" role="alert">@error</div>
}
@if (Model.Curricula.Count == 0)
{
    <div class="student-empty-state">@S["PrivatePracticeNoCurriculum"]</div>
}
else
{
    <section class="student-card">
        <form method="get" asp-action="Index" class="assessment-form">
            <label>@S["Curriculum"]</label>
            <select name="curriculumAdoptionId">
                @foreach (var curriculum in Model.Curricula)
                {
                    <option value="@curriculum.CurriculumAdoptionId" selected="@(curriculum.CurriculumAdoptionId == selected)">@curriculum.CurriculumLevelLabel · @curriculum.ClassName</option>
                }
            </select>
            <button class="school-button" type="submit">@S["ShowPracticeOptions"]</button>
        </form>

        @if (selectedCurriculum is not null)
        {
            <div class="student-practice-context-actions">
                <a id="open-learning-context"
                   class="school-button"
                   asp-controller="StudentPortal"
                   asp-action="Learning"
                   asp-route-curriculumAdoptionId="@selectedCurriculum.CurriculumAdoptionId"
                   asp-route-classGroupId="@selectedCurriculum.ClassGroupId"
                   asp-fragment="selected-curriculum-context">@S["OpenLearning"]</a>
            </div>
        }
    </section>
    @if (selected.HasValue)
    {
        <section class="student-card">
            <h2>@S["GeneratePrivatePractice"]</h2>
            <form asp-action="Generate" method="post" class="assessment-form" id="student-private-practice-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="curriculumAdoptionId" value="@selected.Value" />
                <label>@S["PracticeScope"]</label>
                <select id="practice-scope" name="scope">
                    <option value="@StudentPrivatePracticeScope.WeakAreas" data-question-limit="15">@S["PracticeWeakAreas"]</option>
                    <option value="@StudentPrivatePracticeScope.Lesson" data-question-limit="10">@S["PracticeLesson"]</option>
                    <option value="@StudentPrivatePracticeScope.Unit" data-question-limit="15">@S["PracticeUnit"]</option>
                    <option value="@StudentPrivatePracticeScope.WholeCurriculum" data-question-limit="30">@S["PracticeWholeCurriculum"]</option>
                </select>
                <label for="practice-lesson">@S["Lesson"]</label>
                <select id="practice-lesson" name="lessonId">
                    <option value="">@S["PracticeNotRequired"]</option>
                    @foreach (var lesson in Model.Lessons)
                    {
                        <option value="@lesson.LessonId"
                                data-learning-focus-node-ids="@string.Join(",", lesson.OfficialOutcomeNodeIds)">@lesson.UnitTitle · @lesson.LessonTitle</option>
                    }
                </select>
                <label for="practice-unit">@S["Unit"]</label>
                <select id="practice-unit" name="unitKey">
                    <option value="">@S["PracticeNotRequired"]</option>
                    @foreach (var unit in unitOptions)
                    {
                        <option value="@unit.UnitKey"
                                data-learning-focus-node-ids="@string.Join(",", unit.OfficialOutcomeNodeIds)">@unit.UnitTitle</option>
                    }
                </select>
                <label>@S["AssessmentDifficulty"]</label>
                <select name="difficulty">
                    <option value="@StudentPrivatePracticeDifficulty.MyLevel">@S["PracticeMyLevel"]</option>
                    <option value="@StudentPrivatePracticeDifficulty.AtClassLevel">@S["AssessmentDifficultyAtClassLevel"]</option>
                    <option value="@StudentPrivatePracticeDifficulty.Stretch">@S["AssessmentDifficultyStretch"]</option>
                    <option value="@StudentPrivatePracticeDifficulty.Challenge">@S["AssessmentDifficultyChallenge"]</option>
                </select>
                <label for="practice-question-count">@S["PracticeQuestionCount"]</label>
                <input id="practice-question-count" type="number" name="questionCount" min="1" max="15" value="10" required inputmode="numeric" />
                <small id="practice-question-limit" class="assessment-info" aria-live="polite"></small>
                <button class="school-button school-button-primary" type="submit">@S["GeneratePrivatePractice"]</button>
            </form>
        </section>
    }
}
<section class="student-card" id="practice-history-browser">
    <h2>@S["PrivatePracticeHistory"]</h2>
    @if (orderedAttempts.Length == 0)
    {
        <div class="student-empty-state">@S["PrivatePracticeNoHistory"]</div>
    }
    else
    {
        <div class="practice-history-controls" aria-label="@L("Practice history filters", "Filtry historii ćwiczeń")">
            <label class="practice-history-search">
                <span>@L("Search", "Szukaj")</span>
                <input id="practice-history-search" type="search" placeholder="@L("Search by date or status", "Szukaj po dacie lub statusie")" autocomplete="off" />
            </label>
            <label>
                <span>@L("Status", "Status")</span>
                <select id="practice-history-status">
                    <option value="">@L("All statuses", "Wszystkie statusy")</option>
                    @foreach (var status in statusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>
            <label>
                <span>@L("From", "Od")</span>
                <input id="practice-history-from" type="date" />
            </label>
            <label>
                <span>@L("To", "Do")</span>
                <input id="practice-history-to" type="date" />
            </label>
            <label>
                <span>@L("Per page", "Na stronę")</span>
                <select id="practice-history-page-size">
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </label>
        </div>

        <div class="student-card-list ed-scroll-list" id="practice-history-list">
            @foreach (var attempt in orderedAttempts)
            {
                var status = attempt.Status.ToString();
                var startedDate = attempt.StartedAtUtc.ToString("yyyy-MM-dd");
                var searchable = $"{startedDate} {attempt.StartedAtUtc:yyyy-MM-dd HH:mm} {status} {attempt.Score:0.##} {attempt.Percentage:0.##}";
                <article class="student-assessment-card"
                         data-practice-history-card
                         data-search="@searchable"
                         data-status="@status"
                         data-date="@startedDate">
                    <div>
                        <h3>@S["PrivatePractice"]</h3>
                        <p>@attempt.StartedAtUtc.ToString("yyyy-MM-dd HH:mm") · @attempt.Status</p>
                    </div>
                    <dl><div><dt>@S["Score"]</dt><dd>@attempt.Score.ToString("0.##") / @attempt.MaxScore.ToString("0.##")</dd></div><div><dt>@S["Percentage"]</dt><dd>@attempt.Percentage.ToString("0.##")%</dd></div></dl>
                    <a class="school-button" asp-action="Attempt" asp-route-id="@attempt.AttemptId">@S["OpenPracticeAttempt"]</a>
                </article>
            }
        </div>

        <div id="practice-history-empty" class="student-empty-state" hidden>
            @L("No practice attempts match these filters.", "Brak prób ćwiczeń pasujących do filtrów.")
        </div>

        <div class="practice-history-pagination">
            <span id="practice-history-range" aria-live="polite"></span>
            <div>
                <button id="practice-history-prev" type="button" class="school-button">@L("Previous", "Poprzednia")</button>
                <button id="practice-history-next" type="button" class="school-button">@L("Next", "Następna")</button>
            </div>
        </div>
    }
</section>

<style>
.practice-history-controls{display:grid;grid-template-columns:minmax(240px,2fr) repeat(4,minmax(130px,1fr));gap:.8rem;align-items:end;margin:1rem 0;padding:1rem;border:1px solid #dbe4ef;border-radius:1rem;background:#fff}.practice-history-controls label{display:grid;gap:.35rem;min-width:0}.practice-history-controls label>span{font-size:.78rem;font-weight:800;color:#5a6b82}.practice-history-controls input,.practice-history-controls select{width:100%;min-height:2.75rem;padding:.55rem .7rem;border:1px solid #cfd9e7;border-radius:.65rem;background:#fff;color:#102540}.practice-history-pagination{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:1rem}.practice-history-pagination>span{font-weight:750;color:#5a6b82}.practice-history-pagination>div{display:flex;gap:.65rem}@@media(max-width:1000px){.practice-history-controls{grid-template-columns:repeat(2,minmax(0,1fr))}.practice-history-search{grid-column:span 2}}@@media(max-width:620px){.practice-history-controls{grid-template-columns:1fr}.practice-history-search{grid-column:auto}.practice-history-pagination{align-items:flex-start;flex-direction:column}}
</style>

@section Scripts {
    <script src="~/js/student-practice-learning-link.js" asp-append-version="true"></script>
    <script>
        (() => {
            const scope = document.getElementById('practice-scope');
            const lesson = document.getElementById('practice-lesson');
            const unit = document.getElementById('practice-unit');
            const count = document.getElementById('practice-question-count');
            const help = document.getElementById('practice-question-limit');
            if (!scope || !count) return;

            const applyScope = () => {
                const isLesson = scope.value === '@StudentPrivatePracticeScope.Lesson';
                const isUnit = scope.value === '@StudentPrivatePracticeScope.Unit';

                if (lesson) {
                    lesson.disabled = !isLesson;
                    lesson.required = isLesson;
                    if (!isLesson) lesson.value = '';
                }

                if (unit) {
                    unit.disabled = !isUnit;
                    unit.required = isUnit;
                    if (!isUnit) unit.value = '';
                }
            };

            const applyLimit = () => {
                const option = scope.options[scope.selectedIndex];
                const limit = Number(option?.dataset.questionLimit || 10);
                count.max = String(limit);
                const current = Number(count.value || 1);
                if (current > limit) count.value = String(limit);
                if (help) help.textContent = `Maximum ${limit} questions for this scope.`;
            };

            const apply = () => {
                applyScope();
                applyLimit();
            };

            scope.addEventListener('change', apply);
            count.addEventListener('input', () => {
                const limit = Number(count.max || 1);
                if (Number(count.value) > limit) count.value = String(limit);
            });
            apply();
        })();

        (() => {
            const root = document.getElementById('practice-history-browser');
            if (!root) return;
            const cards = Array.from(root.querySelectorAll('[data-practice-history-card]'));
            if (!cards.length) return;

            const search = document.getElementById('practice-history-search');
            const status = document.getElementById('practice-history-status');
            const dateFrom = document.getElementById('practice-history-from');
            const dateTo = document.getElementById('practice-history-to');
            const pageSize = document.getElementById('practice-history-page-size');
            const prev = document.getElementById('practice-history-prev');
            const next = document.getElementById('practice-history-next');
            const range = document.getElementById('practice-history-range');
            const empty = document.getElementById('practice-history-empty');
            let page = 1;

            const normalized = value => String(value || '').trim().toLocaleLowerCase();
            const filtered = () => cards.filter(card => {
                const q = normalized(search?.value);
                if (q && !normalized(card.dataset.search).includes(q)) return false;
                if (status?.value && card.dataset.status !== status.value) return false;
                if (dateFrom?.value && (card.dataset.date || '') < dateFrom.value) return false;
                if (dateTo?.value && (card.dataset.date || '') > dateTo.value) return false;
                return true;
            });

            const render = () => {
                const matches = filtered();
                const size = Number(pageSize?.value || 10);
                const pages = Math.max(1, Math.ceil(matches.length / size));
                page = Math.min(Math.max(page, 1), pages);
                const start = (page - 1) * size;
                const visible = new Set(matches.slice(start, start + size));
                cards.forEach(card => card.hidden = !visible.has(card));
                if (empty) empty.hidden = matches.length !== 0;
                if (range) {
                    range.textContent = matches.length === 0
                        ? '@L("0 attempts", "0 prób")'
                        : `@L("Showing", "Wyświetlanie") ${start + 1}–${Math.min(start + size, matches.length)} @L("of", "z") ${matches.length}`;
                }
                if (prev) prev.disabled = page <= 1 || matches.length === 0;
                if (next) next.disabled = page >= pages || matches.length === 0;
            };

            [search, status, dateFrom, dateTo, pageSize].forEach(control => {
                control?.addEventListener(control === search ? 'input' : 'change', () => {
                    page = 1;
                    render();
                });
            });
            prev?.addEventListener('click', () => { page -= 1; render(); });
            next?.addEventListener('click', () => { page += 1; render(); });
            render();
        })();
    </script>
}
