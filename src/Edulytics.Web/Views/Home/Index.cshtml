        </div>
        <div class="ed-home-container ed-home-footer-bottom"><span>© @DateTime.UtcNow.Year Edulytics</span><span>@(isPolish ? "Prywatność · Regulamin · Licencje treści" : "Privacy · Terms · Content licences")</span></div>
    </footer>
</div>