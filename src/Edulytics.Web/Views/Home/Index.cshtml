@using Edulytics.Web.Support
@using System.Globalization
@{
    Layout = "_PublicLayout";
    var isPolish = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "pl", StringComparison.OrdinalIgnoreCase);
    var contactLabel = isPolish ? "Kontakt" : "Contact";
    var loginLabel = isPolish ? "Zaloguj się" : "Log in";
    var demoLabel = isPolish ? "Poproś o demo" : "Request a demo";
}

<div class="ed-home">
    <header class="ed-home-header">
        <div class="ed-home-nav-shell">
            <div class="ed-home-brand-row">
                <a class="ed-home-brand" href="/" aria-label="Edulytics"><partial name="_LocalizedBrand" /></a>
                <span class="ed-home-flag" aria-label="Polska"><span class="flag-top"></span><span class="flag-bottom"></span></span>
                <span class="ed-home-lang-label">@(isPolish ? "PL" : "EN")</span>
            </div>

            <nav class="ed-home-links" aria-label="@(isPolish ? "Nawigacja główna" : "Main navigation")">
                <a href="#platform">@(isPolish ? "Platforma" : "Platform")</a>
                <a href="#schools">@(isPolish ? "Dla szkół" : "For schools")</a>
                <a href="#teachers">@(isPolish ? "Dla nauczycieli" : "For teachers")</a>
                <a href="#students">@(isPolish ? "Dla uczniów" : "For students")</a>
                <a href="#curricula">@(isPolish ? "Programy" : "Curricula")</a>
                <a href="#contact">@contactLabel</a>
            </nav>

            <div class="ed-home-actions">
                <div class="ed-home-lang">
                    <form asp-controller="Home" asp-action="SetCulture" method="post">@Html.AntiForgeryToken()<input type="hidden" name="culture" value="pl" /><input type="hidden" name="returnUrl" value="/" /><button type="submit" class="@(isPolish ? "is-active" : "")">PL</button></form>
                    <form asp-controller="Home" asp-action="SetCulture" method="post">@Html.AntiForgeryToken()<input type="hidden" name="culture" value="en" /><input type="hidden" name="returnUrl" value="/" /><button type="submit" class="@(!isPolish ? "is-active" : "")">EN</button></form>
                </div>
                <a class="ed-home-login" asp-controller="Account" asp-action="Login">@loginLabel</a>
                <a class="ed-home-cta" href="mailto:@SupportContactOptions.Email?subject=Edulytics%20demo">@demoLabel</a>
                <details class="ed-home-mobile-menu">
                    <summary aria-label="Menu">☰</summary>
                    <div class="ed-home-mobile-panel">
                        <a href="#platform">@(isPolish ? "Platforma" : "Platform")</a>
                        <a href="#schools">@(isPolish ? "Dla szkół" : "For schools")</a>
                        <a href="#teachers">@(isPolish ? "Dla nauczycieli" : "For teachers")</a>
                        <a href="#students">@(isPolish ? "Dla uczniów" : "For students")</a>
                        <a href="#curricula">@(isPolish ? "Programy" : "Curricula")</a>
                        <a href="#contact">@contactLabel</a>
                    </div>
                </details>
            </div>
        </div>
    </header>

    <main>
        <section class="ed-home-hero ed-geo-scene">
            <span class="geo geo-a"></span><span class="geo geo-b"></span><span class="geo geo-c"></span><span class="geo geo-d"></span>
            <div class="ed-home-container ed-home-hero-grid">
                <div class="ed-home-hero-copy">
                    <div class="ed-home-kicker">@(isPolish ? "MATEMATYKA • AI • MASTERY" : "MATHEMATICS • AI • MASTERY")</div>
                    <h1>@(isPolish ? "Od programu nauczania do prawdziwych efektów w matematyce." : "From curriculum to real mathematics outcomes.")</h1>
                    <p>@(isPolish ? "Edulytics łączy program nauczania, gotowe lekcje, ocenianie, generowanie pytań przez AI i indywidualną praktykę ucznia w jednym spójnym środowisku." : "Edulytics connects curriculum, ready lessons, assessment, AI-assisted question generation and individual student practice in one coherent platform.")</p>
                    <div class="ed-home-hero-actions">
                        <a class="ed-home-cta ed-home-cta-large" href="mailto:@SupportContactOptions.Email?subject=Edulytics%20demo">@demoLabel →</a>
                        <a class="ed-home-secondary ed-home-cta-large" href="#platform">@(isPolish ? "Zobacz platformę" : "Explore the platform")</a>
                    </div>
                    <div class="ed-home-hero-checks"><span>@(isPolish ? "Zgodność z programem nauczania" : "Curriculum-aligned")</span><span>@(isPolish ? "AI pod kontrolą nauczyciela" : "Teacher-controlled AI")</span><span>@(isPolish ? "Dla szkoły, nauczyciela i ucznia" : "For schools, teachers and students")</span></div>
                </div>
            </div>
        </section>

        <section id="schools" class="ed-home-audience-band">
            <div class="ed-home-container">
                <div class="ed-home-center-head"><h2>@(isPolish ? "Dla kogo jest Edulytics?" : "Who is Edulytics for?")</h2></div>
                <div class="ed-home-audience-grid">
                    <article class="audience-card"><h3>@(isPolish ? "Dla szkół" : "For schools")</h3><p>@(isPolish ? "Programy, klasy, wyniki i nadzór akademicki w jednym miejscu." : "Curricula, classes, results and academic oversight in one place.")</p><a href="#platform">@(isPolish ? "Dowiedz się więcej" : "Learn more") →</a></article>
                    <article id="teachers" class="audience-card"><h3>@(isPolish ? "Dla nauczycieli" : "For teachers")</h3><p>@(isPolish ? "Twórz oceny, korzystaj z AI i śledź postępy uczniów." : "Create assessments, use AI and track student progress.")</p><a href="#ai">Generate with Edulytics AI →</a></article>
                    <article id="students" class="audience-card"><h3>@(isPolish ? "Dla uczniów" : "For students")</h3><p>@(isPolish ? "Ucz się z lekcji, rozwiązuj testy i ćwicz prywatnie z AI." : "Learn from lessons, take assessments and practise privately with AI.")</p><a href="#experience">@(isPolish ? "Zobacz doświadczenie" : "Explore the experience") →</a></article>
                    <article class="audience-card"><h3>@(isPolish ? "Dla liderów akademickich" : "For academic leaders")</h3><p>@(isPolish ? "Monitoruj realizację programu, wyniki i jakość pracy nauczycieli." : "Monitor curriculum delivery, outcomes and teaching quality.")</p><a href="#platform">@(isPolish ? "Dowiedz się więcej" : "Learn more") →</a></article>
                </div>
            </div>
        </section>

        <section class="ed-home-value-band ed-geo-scene">
            <span class="geo geo-e"></span><span class="geo geo-f"></span>
            <div class="ed-home-container"><div class="ed-home-center-head"><h2>@(isPolish ? "Kompletne rozwiązanie dla nauczania matematyki" : "A complete mathematics teaching environment")</h2></div><div class="ed-home-value-icons"><div><b>▣</b><span>@(isPolish ? "Program nauczania" : "Curriculum")</span></div><div><b>▤</b><span>@(isPolish ? "Gotowe lekcje" : "Ready lessons")</span></div><div><b>✦</b><span>@(isPolish ? "Generowanie pytań z AI" : "AI question generation")</span></div><div><b>▥</b><span>@(isPolish ? "Oceny i wyniki" : "Assessments & results")</span></div><div><b>◎</b><span>@(isPolish ? "Indywidualna praktyka" : "Individual practice")</span></div><div><b>♟</b><span>@(isPolish ? "Nadzór szkoły" : "School oversight")</span></div></div></div>
        </section>

        <section id="curricula" class="ed-home-section ed-home-curricula">
            <div class="ed-home-container">
                <div class="ed-home-center-head"><h2>@(isPolish ? "Obsługiwane programy nauczania" : "Supported curriculum pathways")</h2><p>@(isPolish ? "Wybierz program i poziom, a Edulytics zachowa ten kontekst w lekcjach, ocenach i analizie postępów." : "Choose a curriculum and level, and Edulytics carries that context through lessons, assessments and progress analysis.")</p></div>
                <div class="ed-home-tabs"><span class="is-active">Cambridge</span><span>Common Core</span><span>@(isPolish ? "Polski program" : "Polish curriculum")</span><span>UAE</span></div>
                <div class="ed-home-curriculum-showcase">
                    <div class="curriculum-intro"><h3>Cambridge Mathematics</h3><p>@(isPolish ? "Poziom, lekcje i kontekst programu w jednym spójnym widoku." : "Level, lessons and curriculum context in one coherent view.")</p><span class="stage-pill">Stage 7</span></div>
                    <div class="curriculum-lessons"><article><span class="stage-pill">Stage 7</span><h4>@(isPolish ? "Liczby całkowite i liczby ze znakiem" : "Integers and directed number")</h4><div class="lesson-tags"><span>@(isPolish ? "Lekcja" : "Lesson")</span><span>@(isPolish ? "Przykłady" : "Examples")</span><span>@(isPolish ? "Ćwiczenia" : "Practice")</span></div></article><article><span class="stage-pill">Stage 7</span><h4>@(isPolish ? "Wyrażenia algebraiczne" : "Algebraic expressions")</h4><div class="lesson-tags"><span>@(isPolish ? "Lekcja" : "Lesson")</span><span>@(isPolish ? "Ćwiczenia" : "Practice")</span><span>@(isPolish ? "Test" : "Test")</span></div></article><article><span class="stage-pill">Stage 7</span><h4>@(isPolish ? "Równania i nierówności" : "Equations and inequalities")</h4><div class="lesson-tags"><span>@(isPolish ? "Lekcja" : "Lesson")</span><span>@(isPolish ? "Ćwiczenia" : "Practice")</span><span>@(isPolish ? "Test" : "Test")</span></div></article></div>
                </div>
            </div>
        </section>

        <section id="experience" class="ed-home-section ed-home-experience ed-geo-scene">
            <span class="geo geo-g"></span><span class="geo geo-h"></span>
            <div class="ed-home-container">
                <div class="ed-home-center-head"><h2>@(isPolish ? "Doświadczenie w praktyce" : "The experience in practice")</h2></div>
                <div class="ed-home-experience-tabs"><span class="is-active">@(isPolish ? "Uczeń" : "Student")</span><span>@(isPolish ? "Nauczyciel" : "Teacher")</span><span>@(isPolish ? "Lider akademicki" : "Academic leader")</span><span>@(isPolish ? "Administrator" : "Administrator")</span></div>
                <div class="ed-home-experience-grid">
                    <div class="ed-home-experience-copy"><span class="ed-home-kicker">@(isPolish ? "DOŚWIADCZENIE UCZNIA" : "STUDENT EXPERIENCE")</span><h2>@(isPolish ? "Nauka, która prowadzi do kolejnego kroku." : "Learning that leads to the next step.")</h2><div class="ed-home-checks"><span>@(isPolish ? "Lekcje z wyjaśnieniami i przykładami" : "Lessons with explanations and examples")</span><span>@(isPolish ? "Indywidualna praktyka z AI" : "Individual AI practice")</span><span>@(isPolish ? "Wyniki i obszary do poprawy" : "Results and areas to improve")</span><span>@(isPolish ? "Ćwiczenia dopasowane do wybranego zakresu" : "Practice matched to the selected scope")</span></div><a class="ed-home-secondary ed-home-cta-large" asp-controller="Account" asp-action="Login">@(isPolish ? "Zobacz portal ucznia" : "Explore the student portal") →</a></div>
                </div>
            </div>
        </section>

        <section id="ai" class="ed-home-section ed-home-ai-section">
            <div class="ed-home-container ed-home-ai-grid">
                <div class="ed-home-ai-copy"><span class="ed-home-kicker">EDULYTICS AI</span><h2>@(isPolish ? "Generuj oceny z Edulytics AI" : "Generate assessments with Edulytics AI")</h2><p>@(isPolish ? "Twórz pytania dla lekcji, działów i całego programu. Nauczyciel sprawdza, edytuje, zatwierdza i publikuje." : "Create questions for lessons, units and the full curriculum. Teachers review, edit, approve and publish.")</p><div class="ed-home-checks"><span>@(isPolish ? "Generowanie pytań w kontekście programu" : "Curriculum-aware question generation")</span><span>@(isPolish ? "Automatyczne powiązanie z zakresem" : "Automatic scope context")</span><span>@(isPolish ? "Edytuj, regeneruj i zatwierdzaj" : "Edit, regenerate and approve")</span><span>@(isPolish ? "Do 50 pytań w jednym generowaniu" : "Up to 50 questions per generation")</span></div></div>
                <div class="ed-home-ai-workbench"><div class="ai-top"><strong>Generate with Edulytics AI</strong><span>AI supported</span></div><div class="ai-fields"><div><small>@(isPolish ? "Zakres" : "Scope")</small><b>@(isPolish ? "Lekcja · Algebra" : "Lesson · Algebra")</b></div><div><small>@(isPolish ? "Liczba pytań" : "Questions")</small><b>20</b></div><div><small>@(isPolish ? "Poziom" : "Level")</small><b>Stage 7</b></div></div><div class="ai-question"><span>1</span><div><small>@(isPolish ? "Pytanie wygenerowane" : "Generated question")</small><strong>2(x + 3) = 14</strong></div></div><div class="ai-actions"><span>@(isPolish ? "Edytuj" : "Edit")</span><span>@(isPolish ? "Regeneruj" : "Regenerate")</span><b>@(isPolish ? "Zatwierdź" : "Approve")</b></div></div>
            </div>
        </section>

        <section id="platform" class="ed-home-section ed-home-philosophy">
            <div class="ed-home-container">
                <div class="ed-philosophy-head">
                    <h2>@(isPolish ? "Zasady Edulytics" : "The Edulytics Principles")</h2>
                    <p>@(isPolish ? "Pięć zasad, które określają, w jaki sposób Edulytics łączy program nauczania, pracę nauczyciela, proces uczenia się i mierzalne postępy." : "Five principles that guide how Edulytics connects curriculum, teaching, learning and measurable progress.")</p>
                </div>

                <div class="ed-philosophy-map">
                    <div class="ed-philosophy-orbit" aria-hidden="true"></div>
                    <div class="ed-philosophy-hub">
                        <span>EDULYTICS</span>
                        <strong>@(isPolish ? "Filozofia nauczania" : "Learning Philosophy")</strong>
                    </div>

                    <article class="ed-philosophy-card ed-philosophy-card--curriculum">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">▤</span><span class="ed-philosophy-number">01</span></div>
                        <h3>@(isPolish ? "Program nauczania w centrum" : "Curriculum at the Core")</h3>
                        <p>@(isPolish ? "Każda lekcja, ocena i informacja o postępach w nauce wynika z programu nauczania i powiązanych z nim efektów uczenia się." : "Every lesson, assessment and learning insight starts from the curriculum and its learning outcomes.")</p>
                    </article>

                    <article class="ed-philosophy-card ed-philosophy-card--understanding">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">◎</span><span class="ed-philosophy-number">02</span></div>
                        <h3>@(isPolish ? "Zrozumienie przed oceną" : "Understanding Before Scores")</h3>
                        <p>@(isPolish ? "Uczenie się to coś więcej niż udzielenie poprawnej odpowiedzi. Edulytics stawia zrozumienie w centrum sposobu mierzenia postępów." : "Learning is not just about getting the right answer. Edulytics puts understanding at the center of how progress is measured.")</p>
                    </article>

                    <article class="ed-philosophy-card ed-philosophy-card--teacher">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">✓</span><span class="ed-philosophy-number">03</span></div>
                        <h3>@(isPolish ? "Nauczyciel zachowuje kontrolę" : "Teachers Stay in Control")</h3>
                        <p>@(isPolish ? "Technologia wspiera decyzje nauczyciela. Formalne sprawdziany są przez niego przeglądane, zatwierdzane i publikowane." : "Technology supports the teacher’s judgment. Formal assessments are reviewed, approved and published by the teacher.")</p>
                    </article>

                    <article class="ed-philosophy-card ed-philosophy-card--practice">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">↻</span><span class="ed-philosophy-number">04</span></div>
                        <h3>@(isPolish ? "Ćwiczenie służy nauce" : "Practice Is for Learning")</h3>
                        <p>@(isPolish ? "Uczniowie mogą ćwiczyć, popełniać błędy i wzmacniać słabsze obszary bez mylenia ćwiczeń z oficjalnymi ocenami szkolnymi." : "Students can practise, make mistakes and strengthen weak areas without confusing practice with official school grades.")</p>
                    </article>

                    <article class="ed-philosophy-card ed-philosophy-card--next">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">→</span><span class="ed-philosophy-number">05</span></div>
                        <h3>@(isPolish ? "Każdy wynik prowadzi do kolejnego kroku" : "Every Result Leads to a Next Step")</h3>
                        <p>@(isPolish ? "Dane z oceniania pokazują poziom opanowania materiału, słabsze obszary i postępy, a następnie kierują ucznia do najbardziej odpowiedniego kolejnego działania." : "Assessment evidence identifies mastery, weakness and progress, then guides the student toward the most relevant next action.")</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="ed-home-start ed-geo-scene">
            <span class="geo geo-i"></span><span class="geo geo-j"></span>
            <div class="ed-home-container"><div class="ed-home-center-head"><h2>@(isPolish ? "Zacznij korzystać z Edulytics" : "Get started with Edulytics")</h2><p>@(isPolish ? "Wybierz swoją rolę i przejdź do logowania." : "Choose your role and continue to sign in.")</p></div><div class="role-grid"><a asp-controller="Account" asp-action="Login"><div class="role-icon">✎</div><strong>@(isPolish ? "Nauczyciel" : "Teacher")</strong></a><a asp-controller="Account" asp-action="Login"><div class="role-icon">🏫</div><strong>@(isPolish ? "Dyrektor szkoły" : "School leader")</strong></a><a asp-controller="Account" asp-action="Login"><div class="role-icon">🎒</div><strong>@(isPolish ? "Uczeń" : "Student")</strong></a><a asp-controller="Account" asp-action="Login"><div class="role-icon">◎</div><strong>@(isPolish ? "Personel / administrator" : "Staff / administrator")</strong></a></div></div>
        </section>

        <section id="contact" class="ed-home-final-cta">
            <div class="ed-home-container"><div><span class="ed-home-kicker">EDULYTICS</span><h2>@(isPolish ? "Połącz program, lekcje, ocenianie i praktykę ucznia w jednej platformie." : "Connect curriculum, lessons, assessment and student practice in one platform.")</h2></div><div class="ed-home-final-actions"><a class="ed-home-cta ed-home-cta-large" href="mailto:@SupportContactOptions.Email?subject=Edulytics%20demo">@demoLabel →</a><a class="ed-home-secondary ed-home-cta-large" href="mailto:@SupportContactOptions.Email">@(isPolish ? "Skontaktuj się z nami" : "Contact us")</a></div></div>
        </section>
    </main>

    <footer class="ed-home-footer">
        <div class="ed-home-container ed-home-footer-grid">
            <div class="ed-home-footer-brand"><partial name="_LocalizedBrand" /><p>@(isPolish ? "Matematyka. Nauka. Postęp." : "Mathematics. Learning. Progress.")</p><div class="footer-contact"><a href="mailto:@SupportContactOptions.Email">@SupportContactOptions.Email</a><span>@SupportContactOptions.PhoneDisplay</span></div></div>
            <div><h3>@(isPolish ? "Platforma" : "Platform")</h3><a href="#platform">@(isPolish ? "Zasady" : "Principles")</a><a href="#curricula">@(isPolish ? "Programy nauczania" : "Curricula")</a><a href="#ai">Edulytics AI</a></div>
            <div><h3>@(isPolish ? "Dla szkół" : "For schools")</h3><a href="#schools">@(isPolish ? "Przegląd" : "Overview")</a><a href="#experience">@(isPolish ? "Doświadczenie" : "Experience")</a><a href="mailto:@SupportContactOptions.Email?subject=Edulytics%20demo">@demoLabel</a></div>
            <div><h3>@(isPolish ? "Dla użytkowników" : "For users")</h3><a href="#teachers">@(isPolish ? "Nauczyciele" : "Teachers")</a><a href="#students">@(isPolish ? "Uczniowie" : "Students")</a><a asp-controller="Account" asp-action="Login">@loginLabel</a></div>
            <div><h3>@(isPolish ? "Firma" : "Company")</h3><a href="@SupportContactOptions.CompanyWebsiteUrl" target="_blank" rel="noopener noreferrer">@(isPolish ? "O nas" : "About")</a><a href="mailto:@SupportContactOptions.Email">@contactLabel</a><a asp-controller="Home" asp-action="ContentSources">@(isPolish ? "Źródła i licencje" : "Content sources & licences")</a></div>
        </div>
        <div class="ed-home-container ed-home-footer-bottom"><span>© @DateTime.UtcNow.Year Edulytics</span><span>@(isPolish ? "Prywatność · Regulamin · Licencje treści" : "Privacy · Terms · Content licences")</span></div>
    </footer>
</div>