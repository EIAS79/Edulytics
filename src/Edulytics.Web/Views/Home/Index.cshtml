@using Edulytics.Web.Support
@using System.Globalization
@{
    Layout = "_PublicLayout";
    var isPolish = string.Equals(
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
        "pl",
        StringComparison.OrdinalIgnoreCase);
    var contactLabel = isPolish ? "Kontakt" : "Contact us";
}

<section class="language-shell" aria-labelledby="language-selection-title">
    <details class="public-contact-menu">
        <summary class="public-contact-trigger">@contactLabel</summary>
        <div class="public-contact-popover" aria-label="@contactLabel">
            <a href="mailto:@SupportContactOptions.Email">@SupportContactOptions.Email</a>
            <a href="@SupportContactOptions.PhoneUri">@SupportContactOptions.PhoneDisplay</a>
            <a href="@SupportContactOptions.CompanyWebsiteUrl" target="_blank" rel="noopener noreferrer">@SupportContactOptions.CompanyWebsiteDisplay</a>
            <a href="@SupportContactOptions.ProductWebsiteUrl" target="_blank" rel="noopener noreferrer">@SupportContactOptions.ProductWebsiteDisplay</a>
        </div>
    </details>

    <div class="language-brand" aria-label="Edulytics">
        <partial name="_LocalizedBrand" />
    </div>

    <h1 id="language-selection-title" class="visually-hidden">Choose language / Wybierz język</h1>

    <div class="language-grid" role="group" aria-label="Choose language / Wybierz język">
        <form asp-controller="Home"
              asp-action="SetCulture"
              method="post"
              class="language-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="culture" value="pl" />
            <button type="submit" class="language-card" aria-label="Polski">
                <span class="language-code" aria-hidden="true">PL</span>
                <span>Polski</span>
            </button>
        </form>

        <form asp-controller="Home"
              asp-action="SetCulture"
              method="post"
              class="language-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="culture" value="en" />
            <button type="submit" class="language-card" aria-label="English">
                <span class="language-code" aria-hidden="true">EN</span>
                <span>English</span>
            </button>
        </form>
    </div>
</section>
