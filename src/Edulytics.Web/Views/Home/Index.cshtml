@using Edulytics.Web.Support
@using System.Globalization
@{
    Layout = "_PublicLayout";
    var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isPolish = string.Equals(language, "pl", StringComparison.OrdinalIgnoreCase);
    var isArabic = string.Equals(language, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string pl, string ar) => isArabic ? ar : isPolish ? pl : en;
    var contactLabel = L("Contact", "Kontakt", "تواصل معنا");
    var loginLabel = L("Log in", "Zaloguj się", "تسجيل الدخول");
    var demoLabel = L("Request a demo", "Poproś o demo", "اطلب عرضًا تجريبيًا");
    ViewData["Title"] = L("Mathematics learning, assessment and mastery", "Nauka matematyki, ocenianie i opanowanie", "تعلّم الرياضيات والتقييم والإتقان");
}

<div class="ed-home">
    <partial name="_PublicSiteHeader" />

    <main>
        <section class="ed-home-hero ed-geo-scene">
            <span class="geo geo-a"></span><span class="geo geo-b"></span><span class="geo geo-c"></span><span class="geo geo-d"></span>
            <div class="ed-home-container ed-home-hero-grid">
                <div class="ed-home-hero-copy">
                    <div class="ed-home-kicker">@L("MATHEMATICS • AI • MASTERY", "MATEMATYKA • AI • MASTERY", "الرياضيات • الذكاء الاصطناعي • الإتقان")</div>
                    <h1>@L("From curriculum to real mathematics outcomes.", "Od programu nauczania do prawdziwych efektów w matematyce.", "من المنهج إلى نتائج حقيقية في الرياضيات.")</h1>
                    <p>@L(
                        "Edulytics connects curriculum, ready lessons, assessment, AI-assisted question generation and individual student practice in one coherent platform.",
                        "Edulytics łączy program nauczania, gotowe lekcje, ocenianie, generowanie pytań przez AI i indywidualną praktykę ucznia w jednym spójnym środowisku.",
                        "يربط Edulytics بين المنهج والدروس الجاهزة والتقييم وتوليد الأسئلة بمساعدة الذكاء الاصطناعي والتدريب الفردي للطالب في منصة واحدة متكاملة.")</p>
                    <div class="ed-home-hero-actions">
                        <a class="ed-home-cta ed-home-cta-large" href="/contact/request-demo">@demoLabel →</a>
                        <a class="ed-home-secondary ed-home-cta-large" href="#platform">@L("Explore the platform", "Zobacz platformę", "استكشف المنصة")</a>
                    </div>
                    <div class="ed-home-hero-checks">
                        <span>@L("Curriculum-aligned", "Zgodność z programem nauczania", "متوافق مع المنهج")</span>
                        <span>@L("Teacher-controlled AI", "AI pod kontrolą nauczyciela", "ذكاء اصطناعي تحت إشراف المعلم")</span>
                        <span>@L("For schools, teachers and students", "Dla szkoły, nauczyciela i ucznia", "للمدارس والمعلمين والطلاب")</span>
                    </div>
                </div>
            </div>
        </section>

        <section id="schools" class="ed-home-audience-band">
            <div class="ed-home-container">
                <div class="ed-home-center-head"><h2>@L("Who is Edulytics for?", "Dla kogo jest Edulytics?", "لمن صُمم Edulytics؟")</h2></div>
                <div class="ed-home-audience-grid">
                    <article class="audience-card">
                        <h3>@L("For schools", "Dla szkół", "للمدارس")</h3>
                        <p>@L("Curricula, classes, results and academic oversight in one place.", "Programy, klasy, wyniki i nadzór akademicki w jednym miejscu.", "المناهج والفصول والنتائج والإشراف الأكاديمي في مكان واحد.")</p>
                        <a href="#platform">@L("Learn more", "Dowiedz się więcej", "اعرف المزيد") →</a>
                    </article>
                    <article id="teachers" class="audience-card">
                        <h3>@L("For teachers", "Dla nauczycieli", "للمعلمين")</h3>
                        <p>@L("Create assessments, use AI and track student progress.", "Twórz oceny, korzystaj z AI i śledź postępy uczniów.", "أنشئ التقييمات، واستخدم الذكاء الاصطناعي، وتابع تقدم الطلاب.")</p>
                        <a href="#ai">@L("Generate with Edulytics AI", "Generuj z Edulytics AI", "أنشئ باستخدام Edulytics AI") →</a>
                    </article>
                    <article id="students" class="audience-card">
                        <h3>@L("For students", "Dla uczniów", "للطلاب")</h3>
                        <p>@L("Learn from lessons, take assessments and practise privately with AI.", "Ucz się z lekcji, rozwiązuj testy i ćwicz prywatnie z AI.", "تعلّم من الدروس، وأكمل التقييمات، وتدرّب بشكل فردي بمساعدة الذكاء الاصطناعي.")</p>
                        <a href="#experience">@L("Explore the experience", "Zobacz doświadczenie", "استكشف التجربة") →</a>
                    </article>
                    <article class="audience-card">
                        <h3>@L("For academic leaders", "Dla liderów akademickich", "للقيادات الأكاديمية")</h3>
                        <p>@L("Monitor curriculum delivery, outcomes and teaching quality.", "Monitoruj realizację programu, wyniki i jakość pracy nauczycieli.", "تابع تنفيذ المنهج والنتائج وجودة العملية التعليمية.")</p>
                        <a href="#platform">@L("Learn more", "Dowiedz się więcej", "اعرف المزيد") →</a>
                    </article>
                </div>
            </div>
        </section>

        <section class="ed-home-value-band ed-geo-scene">
            <span class="geo geo-e"></span><span class="geo geo-f"></span>
            <div class="ed-home-container">
                <div class="ed-home-center-head">
                    <h2>@L("A complete mathematics teaching environment", "Kompletne rozwiązanie dla nauczania matematyki", "حل متكامل لتعليم الرياضيات")</h2>
                </div>
                <div class="ed-home-value-icons">
                    <div><b>▣</b><span>@L("Curriculum", "Program nauczania", "المنهج الدراسي")</span></div>
                    <div><b>▤</b><span>@L("Ready lessons", "Gotowe lekcje", "دروس جاهزة")</span></div>
                    <div><b>✦</b><span>@L("AI question generation", "Generowanie pytań z AI", "توليد أسئلة بالذكاء الاصطناعي")</span></div>
                    <div><b>▥</b><span>@L("Assessments & results", "Oceny i wyniki", "التقييمات والنتائج")</span></div>
                    <div><b>◎</b><span>@L("Individual practice", "Indywidualna praktyka", "تدريب فردي")</span></div>
                    <div><b>♟</b><span>@L("School oversight", "Nadzór szkoły", "إشراف المدرسة")</span></div>
                </div>
            </div>
        </section>

        <section id="curricula" class="ed-home-section ed-home-curricula">
            <div class="ed-home-container">
                <div class="ed-home-center-head">
                    <h2>@L("Supported curriculum pathways", "Obsługiwane programy nauczania", "مسارات المناهج التعليمية المدعومة")</h2>
                    <p>@L(
                        "Choose a curriculum and level, and Edulytics carries that context through lessons, assessments and progress analysis.",
                        "Wybierz program i poziom, a Edulytics zachowa ten kontekst w lekcjach, ocenach i analizie postępów.",
                        "اختر المنهج والمستوى، وسيحافظ Edulytics على هذا السياق عبر الدروس والتقييمات وتحليل التقدم.")</p>
                </div>
                <div class="ed-home-tabs"><span class="is-active">Cambridge</span><span>Common Core</span><span>@L("Polish curriculum", "Polski program", "المنهج البولندي")</span><span>UAE</span></div>
                <div class="ed-home-curriculum-showcase">
                    <div class="curriculum-intro"><h3>Cambridge Mathematics</h3><p>@L("Level, lessons and curriculum context in one coherent view.", "Poziom, lekcje i kontekst programu w jednym spójnym widoku.", "المستوى والدروس وسياق المنهج في عرض واحد متكامل.")</p><span class="stage-pill">Stage 7</span></div>
                    <div class="curriculum-lessons">
                        <article><span class="stage-pill">Stage 7</span><h4>@L("Integers and directed number", "Liczby całkowite i liczby ze znakiem", "الأعداد الصحيحة والأعداد الموجّهة")</h4><div class="lesson-tags"><span>@L("Lesson", "Lekcja", "درس")</span><span>@L("Examples", "Przykłady", "أمثلة")</span><span>@L("Practice", "Ćwiczenia", "تدريب")</span></div></article>
                        <article><span class="stage-pill">Stage 7</span><h4>@L("Algebraic expressions", "Wyrażenia algebraiczne", "التعبيرات الجبرية")</h4><div class="lesson-tags"><span>@L("Lesson", "Lekcja", "درس")</span><span>@L("Practice", "Ćwiczenia", "تدريب")</span><span>@L("Test", "Test", "اختبار")</span></div></article>
                        <article><span class="stage-pill">Stage 7</span><h4>@L("Equations and inequalities", "Równania i nierówności", "المعادلات والمتباينات")</h4><div class="lesson-tags"><span>@L("Lesson", "Lekcja", "درس")</span><span>@L("Practice", "Ćwiczenia", "تدريب")</span><span>@L("Test", "Test", "اختبار")</span></div></article>
                    </div>
                </div>
            </div>
        </section>

        <section id="experience" class="ed-home-section ed-home-experience ed-geo-scene">
            <span class="geo geo-g"></span><span class="geo geo-h"></span>
            <div class="ed-home-container">
                <div class="ed-home-center-head"><h2>@L("The experience in practice", "Doświadczenie w praktyce", "التجربة في الممارسة")</h2></div>
                <div class="ed-home-experience-tabs">
                    <span class="is-active">@L("Student", "Uczeń", "الطالب")</span>
                    <span>@L("Teacher", "Nauczyciel", "المعلم")</span>
                    <span>@L("Academic leader", "Lider akademicki", "القائد الأكاديمي")</span>
                    <span>@L("Administrator", "Administrator", "الإدارة")</span>
                </div>
                <div class="ed-home-experience-grid">
                    <div class="ed-home-experience-copy">
                        <span class="ed-home-kicker">@L("STUDENT EXPERIENCE", "DOŚWIADCZENIE UCZNIA", "تجربة الطالب")</span>
                        <h2>@L("Learning that leads to the next step.", "Nauka, która prowadzi do kolejnego kroku.", "تعلّم يقود إلى الخطوة التالية.")</h2>
                        <div class="ed-home-checks">
                            <span>@L("Lessons with explanations and examples", "Lekcje z wyjaśnieniami i przykładami", "دروس تتضمن شروحات وأمثلة")</span>
                            <span>@L("Individual AI practice", "Indywidualna praktyka z AI", "تدريب فردي بالذكاء الاصطناعي")</span>
                            <span>@L("Results and areas to improve", "Wyniki i obszary do poprawy", "النتائج والمجالات التي تحتاج إلى تحسين")</span>
                            <span>@L("Practice matched to the selected scope", "Ćwiczenia dopasowane do wybranego zakresu", "تدريب متوافق مع النطاق المحدد")</span>
                        </div>
                        <a class="ed-home-secondary ed-home-cta-large" asp-controller="Account" asp-action="Login">@L("Explore the student portal", "Zobacz portal ucznia", "استكشف بوابة الطالب") →</a>
                    </div>
                </div>
            </div>
        </section>

        <section id="ai" class="ed-home-section ed-home-ai-section">
            <div class="ed-home-container ed-home-ai-grid">
                <div class="ed-home-ai-copy">
                    <span class="ed-home-kicker">EDULYTICS AI</span>
                    <h2>@L("Generate assessments with Edulytics AI", "Generuj oceny z Edulytics AI", "أنشئ التقييمات باستخدام Edulytics AI")</h2>
                    <p>@L(
                        "Create questions for lessons, units and the full curriculum. Teachers review, edit, approve and publish.",
                        "Twórz pytania dla lekcji, działów i całego programu. Nauczyciel sprawdza, edytuje, zatwierdza i publikuje.",
                        "أنشئ أسئلة للدروس والوحدات والمنهج بالكامل. يراجع المعلم الأسئلة ويعدّلها ويعتمدها وينشرها.")</p>
                    <div class="ed-home-checks">
                        <span>@L("Curriculum-aware question generation", "Generowanie pytań w kontekście programu", "توليد أسئلة في سياق المنهج")</span>
                        <span>@L("Automatic scope context", "Automatyczne powiązanie z zakresem", "ربط تلقائي بالنطاق")</span>
                        <span>@L("Edit, regenerate and approve", "Edytuj, regeneruj i zatwierdzaj", "تعديل وإعادة توليد واعتماد")</span>
                        <span>@L("Up to 50 questions per generation", "Do 50 pytań w jednym generowaniu", "حتى 50 سؤالًا في عملية توليد واحدة")</span>
                    </div>
                </div>
                <div class="ed-home-ai-workbench">
                    <div class="ai-top"><strong>@L("Generate with Edulytics AI", "Generuj z Edulytics AI", "أنشئ باستخدام Edulytics AI")</strong><span>@L("AI supported", "Wspierane przez AI", "مدعوم بالذكاء الاصطناعي")</span></div>
                    <div class="ai-fields"><div><small>@L("Scope", "Zakres", "النطاق")</small><b>@L("Lesson · Algebra", "Lekcja · Algebra", "درس · الجبر")</b></div><div><small>@L("Questions", "Liczba pytań", "الأسئلة")</small><b>20</b></div><div><small>@L("Level", "Poziom", "المستوى")</small><b>Stage 7</b></div></div>
                    <div class="ai-question"><span>1</span><div><small>@L("Generated question", "Pytanie wygenerowane", "سؤال تم توليده")</small><strong>2(x + 3) = 14</strong></div></div>
                    <div class="ai-actions"><span>@L("Edit", "Edytuj", "تعديل")</span><span>@L("Regenerate", "Regeneruj", "إعادة توليد")</span><b>@L("Approve", "Zatwierdź", "اعتماد")</b></div>
                </div>
            </div>
        </section>

        <section id="platform" class="ed-home-section ed-home-philosophy">
            <div class="ed-home-container">
                <div class="ed-philosophy-head">
                    <h2>@L("The Edulytics Principles", "Zasady Edulytics", "مبادئ Edulytics")</h2>
                    <p>@L(
                        "Five principles that guide how Edulytics connects curriculum, teaching, learning and measurable progress.",
                        "Pięć zasad, które określają, w jaki sposób Edulytics łączy program nauczania, pracę nauczyciela, proces uczenia się i mierzalne postępy.",
                        "خمسة مبادئ تحدد كيف يربط Edulytics بين المنهج والتدريس والتعلّم والتقدم القابل للقياس.")</p>
                </div>

                <div class="ed-philosophy-map">
                    <div class="ed-philosophy-orbit" aria-hidden="true"></div>
                    <div class="ed-philosophy-hub">
                        <span>EDULYTICS</span>
                        <strong>@L("Learning Philosophy", "Filozofia nauczania", "فلسفة التعلّم")</strong>
                    </div>

                    <article class="ed-philosophy-card ed-philosophy-card--curriculum">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">▤</span><span class="ed-philosophy-number">01</span></div>
                        <h3>@L("Curriculum at the Core", "Program nauczania w centrum", "المنهج في صميم التعلّم")</h3>
                        <p>@L("Every lesson, assessment and learning insight starts from the curriculum and its learning outcomes.", "Każda lekcja, ocena i informacja o postępach w nauce wynika z programu nauczania i powiązanych z nim efektów uczenia się.", "كل درس وتقييم ومؤشر للتقدم يبدأ من المنهج ونواتج التعلّم المرتبطة به.")</p>
                    </article>

                    <article class="ed-philosophy-card ed-philosophy-card--understanding">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">◎</span><span class="ed-philosophy-number">02</span></div>
                        <h3>@L("Understanding Before Scores", "Zrozumienie przed oceną", "الفهم قبل الدرجات")</h3>
                        <p>@L("Learning is not just about getting the right answer. Edulytics puts understanding at the center of how progress is measured.", "Uczenie się to coś więcej niż udzielenie poprawnej odpowiedzi. Edulytics stawia zrozumienie w centrum sposobu mierzenia postępów.", "التعلّم لا يقتصر على الوصول إلى إجابة صحيحة. يضع Edulytics الفهم في صميم قياس التقدم.")</p>
                    </article>

                    <article class="ed-philosophy-card ed-philosophy-card--teacher">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">✓</span><span class="ed-philosophy-number">03</span></div>
                        <h3>@L("Teachers Stay in Control", "Nauczyciel zachowuje kontrolę", "المعلم يبقى صاحب القرار")</h3>
                        <p>@L("Technology supports the teacher’s judgment. Formal assessments are reviewed, approved and published by the teacher.", "Technologia wspiera decyzje nauczyciela. Formalne sprawdziany są przez niego przeglądane, zatwierdzane i publikowane.", "تدعم التقنية قرارات المعلم. يراجع المعلم التقييمات الرسمية ويعتمدها وينشرها.")</p>
                    </article>

                    <article class="ed-philosophy-card ed-philosophy-card--practice">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">↻</span><span class="ed-philosophy-number">04</span></div>
                        <h3>@L("Practice Is for Learning", "Ćwiczenie służy nauce", "التدريب من أجل التعلّم")</h3>
                        <p>@L("Students can practise, make mistakes and strengthen weak areas without confusing practice with official school grades.", "Uczniowie mogą ćwiczyć, popełniać błędy i wzmacniać słabsze obszary bez mylenia ćwiczeń z oficjalnymi ocenami szkolnymi.", "يمكن للطلاب التدريب وارتكاب الأخطاء وتقوية جوانب الضعف دون الخلط بين التدريب والدرجات المدرسية الرسمية.")</p>
                    </article>

                    <article class="ed-philosophy-card ed-philosophy-card--next">
                        <div class="ed-philosophy-card__top"><span class="ed-philosophy-icon" aria-hidden="true">→</span><span class="ed-philosophy-number">05</span></div>
                        <h3>@L("Every Result Leads to a Next Step", "Każdy wynik prowadzi do kolejnego kroku", "كل نتيجة تقود إلى الخطوة التالية")</h3>
                        <p>@L("Assessment evidence identifies mastery, weakness and progress, then guides the student toward the most relevant next action.", "Dane z oceniania pokazują poziom opanowania materiału, słabsze obszary i postępy, a następnie kierują ucznia do najbardziej odpowiedniego kolejnego działania.", "تُظهر بيانات التقييم مستوى الإتقان ونقاط الضعف والتقدم، ثم توجه الطالب إلى الإجراء التالي الأكثر ملاءمة.")</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="ed-home-start ed-geo-scene">
            <span class="geo geo-i"></span><span class="geo geo-j"></span>
            <div class="ed-home-container">
                <div class="ed-home-center-head">
                    <h2>@L("Get started with Edulytics", "Zacznij korzystać z Edulytics", "ابدأ باستخدام Edulytics")</h2>
                    <p>@L("Choose your role and continue to sign in.", "Wybierz swoją rolę i przejdź do logowania.", "اختر دورك وانتقل إلى تسجيل الدخول.")</p>
                </div>
                <div class="role-grid">
                    <a asp-controller="Account" asp-action="Login"><div class="role-icon">✎</div><strong>@L("Teacher", "Nauczyciel", "المعلم")</strong></a>
                    <a asp-controller="Account" asp-action="Login"><div class="role-icon">🏫</div><strong>@L("School leader", "Dyrektor szkoły", "مدير المدرسة")</strong></a>
                    <a asp-controller="Account" asp-action="Login"><div class="role-icon">🎒</div><strong>@L("Student", "Uczeń", "الطالب")</strong></a>
                    <a asp-controller="Account" asp-action="Login"><div class="role-icon">◎</div><strong>@L("Staff / administrator", "Personel / administrator", "الموظفون / الإدارة")</strong></a>
                </div>
            </div>
        </section>

        <section id="contact" class="ed-home-final-cta">
            <div class="ed-home-container">
                <div>
                    <span class="ed-home-kicker">EDULYTICS</span>
                    <h2>@L(
                        "Connect curriculum, lessons, assessment and student practice in one platform.",
                        "Połącz program, lekcje, ocenianie i praktykę ucznia w jednej platformie.",
                        "اجمع المنهج والدروس والتقييم وتدريب الطالب في منصة واحدة.")</h2>
                </div>
                <div class="ed-home-final-actions">
                    <a class="ed-home-cta ed-home-cta-large" href="/contact/request-demo">@demoLabel →</a>
                    <a class="ed-home-secondary ed-home-cta-large" href="/contact">@contactLabel</a>
                </div>
            </div>
        </section>
    </main>

    <partial name="_PublicSiteFooter" />
</div>
