@using Edulytics.Web.Support
@using System.Globalization
@{
    Layout = "_PublicLayout";
    var isPolish = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "pl", StringComparison.OrdinalIgnoreCase);
    var contactLabel = isPolish ? "Kontakt" : "Contact";
    var loginLabel = isPolish ? "Zaloguj się" : "Log in";
    var demoLabel = isPolish ? "Poproś o demo" : "Request a demo";
}

<div class="ed-home">
    <header class="ed-home-header">
        <div class="ed-home-nav-shell">
            <div class="ed-home-brand-row">
                <a class="ed-home-brand" href="/" aria-label="Edulytics"><partial name="_LocalizedBrand" /></a>
                <span class="ed-home-flag" aria-label="Polska"><span class="flag-top"></span><span class="flag-bottom"></span></span>
                <span class="ed-home-lang-label">@(isPolish ? "PL" : "EN")</span>
            </div>

            <nav class="ed-home-links" aria-label="@(isPolish ? "Nawigacja główna" : "Main navigation")">
                <a href="#platform">@(isPolish ? "Platforma" : "Platform")</a>
                <a href="#schools">@(isPolish ? "Dla szkół" : "For schools")</a>
                <a href="#teachers">@(isPolish ? "Dla nauczycieli" : "For teachers")</a>
                <a href="#students">@(isPolish ? "Dla uczniów" : "For students")</a>
                <a href="#curricula">@(isPolish ? "Programy" : "Curricula")</a>
                <a href="#contact">@contactLabel</a>
            </nav>

            <div class="ed-home-actions">
                <div class="ed-home-lang">
                    <form asp-controller="Home" asp-action="SetCulture" method="post">@Html.AntiForgeryToken()<input type="hidden" name="culture" value="pl" /><input type="hidden" name="returnUrl" value="/" /><button type="submit" class="@(isPolish ? "is-active" : "")">PL</button></form>
                    <form asp-controller="Home" asp-action="SetCulture" method="post">@Html.AntiForgeryToken()<input type="hidden" name="culture" value="en" /><input type="hidden" name="returnUrl" value="/" /><button type="submit" class="@(!isPolish ? "is-active" : "")">EN</button></form>
                </div>
                <a class="ed-home-login" asp-controller="Account" asp-action="Login">@loginLabel</a>
                <a class="ed-home-cta" href="mailto:@SupportContactOptions.Email?subject=Edulytics%20demo">@demoLabel</a>
                <details class="ed-home-mobile-menu">
                    <summary aria-label="Menu">☰</summary>
                    <div class="ed-home-mobile-panel">
                        <a href="#platform">@(isPolish ? "Platforma" : "Platform")</a>
                        <a href="#schools">@(isPolish ? "Dla szkół" : "For schools")</a>
                        <a href="#teachers">@(isPolish ? "Dla nauczycieli" : "For teachers")</a>
                        <a href="#students">@(isPolish ? "Dla uczniów" : "For students")</a>
                        <a href="#curricula">@(isPolish ? "Programy" : "Curricula")</a>
                        <a href="#contact">@contactLabel</a>
                    </div>
                </details>
            </div>
        </div>
    </header>

    <main>
        <section class="ed-home-hero ed-geo-scene">
            <span class="geo geo-a"></span><span class="geo geo-b"></span><span class="geo geo-c"></span><span class="geo geo-d"></span>
            <div class="ed-home-container ed-home-hero-grid">
                <div class="ed-home-hero-copy">
                    <div class="ed-home-kicker">@(isPolish ? "MATEMATYKA • AI • MASTERY" : "MATHEMATICS • AI • MASTERY")</div>
                    <h1>@(isPolish ? "Od programu nauczania do prawdziwych efektów w matematyce." : "From curriculum to real mathematics outcomes.")</h1>
                    <p>@(isPolish ? "Edulytics łączy program nauczania, gotowe lekcje, ocenianie, generowanie pytań przez AI i indywidualną praktykę ucznia w jednym spójnym środowisku." : "Edulytics connects curriculum, ready lessons, assessment, AI-assisted question generation and individual student practice in one coherent platform.")</p>
                    <div class="ed-home-hero-actions">
                        <a class="ed-home-cta ed-home-cta-large" href="mailto:@SupportContactOptions.Email?subject=Edulytics%20demo">@demoLabel →</a>
                        <a class="ed-home-secondary ed-home-cta-large" href="#platform">@(isPolish ? "Zobacz platformę" : "Explore the platform")</a>
                    </div>
                    <div class="ed-home-hero-checks"><span>@(isPolish ? "Zgodność z programem nauczania" : "Curriculum-aligned")</span><span>@(isPolish ? "AI pod kontrolą nauczyciela" : "Teacher-controlled AI")</span><span>@(isPolish ? "Dla szkoły, nauczyciela i ucznia" : "For schools, teachers and students")</span></div>
                </div>

                <div class="ed-home-hero-visual" aria-label="Edulytics platform illustration">
                    <svg class="hero-illustration" viewBox="0 0 780 570" role="img" aria-label="Student using Edulytics with lesson, practice and progress cards">
                        <defs><linearGradient id="screenGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#eaf5ff"/><stop offset="1" stop-color="#fff"/></linearGradient><linearGradient id="hoodie" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1768f2"/><stop offset="1" stop-color="#6e47ed"/></linearGradient></defs>
                        <rect x="160" y="55" width="520" height="355" rx="30" fill="url(#screenGrad)" stroke="#dce8f7" stroke-width="4"/>
                        <rect x="180" y="78" width="105" height="310" rx="20" fill="#123b73"/>
                        <circle cx="208" cy="112" r="13" fill="#fff" opacity=".95"/><rect x="230" y="104" width="36" height="13" rx="6" fill="#fff" opacity=".9"/>
                        <rect x="201" y="152" width="62" height="10" rx="5" fill="#8eb8f2"/><rect x="201" y="182" width="55" height="10" rx="5" fill="#8eb8f2"/><rect x="201" y="212" width="48" height="10" rx="5" fill="#8eb8f2"/><rect x="201" y="242" width="58" height="10" rx="5" fill="#8eb8f2"/>
                        <rect x="310" y="92" width="320" height="54" rx="16" fill="#fff"/><text x="332" y="125" font-size="21" font-weight="800" fill="#11243d">Lekcja 4 · Ułamki zwykłe</text>
                        <rect x="310" y="166" width="182" height="138" rx="20" fill="#fff"/><circle cx="365" cy="224" r="35" fill="#ffcf4b"/><path d="M365 189 A35 35 0 0 1 400 224 L365 224Z" fill="#4aa9ff"/><text x="421" y="233" font-size="27" font-weight="900" fill="#11243d">3/4</text>
                        <rect x="512" y="166" width="118" height="138" rx="20" fill="#fff"/><text x="536" y="198" font-size="13" font-weight="800" fill="#66758d">TWÓJ POSTĘP</text><text x="536" y="246" font-size="36" font-weight="900" fill="#11a36a">75%</text><rect x="536" y="266" width="72" height="10" rx="5" fill="#e2ecf8"/><rect x="536" y="266" width="54" height="10" rx="5" fill="#11a36a"/>
                        <rect x="465" y="325" width="170" height="75" rx="18" fill="#fff"/><text x="486" y="350" font-size="12" font-weight="900" fill="#1768f2">EDULYTICS AI</text><text x="486" y="375" font-size="16" font-weight="800" fill="#11243d">Ćwicz z AI</text>
                        <ellipse cx="326" cy="486" rx="130" ry="29" fill="#dce9f8"/>
                        <circle cx="315" cy="360" r="58" fill="#f2b47f"/><path d="M260 352c8-58 105-72 120 4-28-15-80-16-120-4Z" fill="#4b2d27"/><circle cx="295" cy="360" r="5" fill="#222"/><circle cx="338" cy="360" r="5" fill="#222"/><path d="M300 385c17 14 35 8 46-3" stroke="#9b4c45" stroke-width="5" fill="none" stroke-linecap="round"/>
                        <path d="M244 435c8-61 131-70 153 2l11 80H226Z" fill="url(#hoodie)"/>
                        <rect x="248" y="446" width="160" height="93" rx="10" fill="#f5f7fb" stroke="#b8c9dc" stroke-width="4"/><circle cx="327" cy="490" r="15" fill="#6e47ed"/>
                        <g transform="translate(603 324)"><circle cx="38" cy="38" r="34" fill="#f4fbff" stroke="#a9d1f4" stroke-width="4"/><rect x="15" y="18" width="46" height="36" rx="14" fill="#1c4e89"/><circle cx="29" cy="36" r="5" fill="#69e7ff"/><circle cx="47" cy="36" r="5" fill="#69e7ff"/><path d="M27 48c8 5 15 5 23 0" stroke="#69e7ff" stroke-width="3" fill="none"/><path d="M5 38H-12M71 38h17M38 5v-15" stroke="#78a9d1" stroke-width="5" stroke-linecap="round"/></g>
                    </svg>
                </div>
            </div>
        </section>

        <section id="schools" class="ed-home-audience-band">
            <div class="ed-home-container">
                <div class="ed-home-center-head"><h2>@(isPolish ? "Dla kogo jest Edulytics?" : "Who is Edulytics for?")</h2></div>
                <div class="ed-home-audience-grid">
                    <article class="audience-card"><div class="audience-picture school-picture"><svg viewBox="0 0 260 145"><rect x="20" y="70" width="220" height="60" rx="10" fill="#e8f2ff"/><rect x="72" y="36" width="116" height="94" rx="8" fill="#fff" stroke="#c9dcf5" stroke-width="3"/><path d="M62 45 130 12l68 33" fill="#ff9a3e"/><rect x="112" y="85" width="36" height="45" fill="#1768f2"/><rect x="90" y="62" width="22" height="20" fill="#9dd7ff"/><rect x="150" y="62" width="22" height="20" fill="#9dd7ff"/><circle cx="130" cy="42" r="13" fill="#fff"/><path d="M130 33v18M121 42h18" stroke="#1768f2" stroke-width="3"/></svg></div><h3>@(isPolish ? "Dla szkół" : "For schools")</h3><p>@(isPolish ? "Programy, klasy, wyniki i nadzór akademicki w jednym miejscu." : "Curricula, classes, results and academic oversight in one place.")</p><a href="#platform">@(isPolish ? "Dowiedz się więcej" : "Learn more") →</a></article>
                    <article id="teachers" class="audience-card"><div class="audience-picture teacher-picture"><svg viewBox="0 0 260 145"><rect x="0" y="0" width="260" height="145" rx="20" fill="#fff4ea"/><rect x="118" y="25" width="112" height="72" rx="8" fill="#fff" stroke="#f4c79f" stroke-width="3"/><path d="M136 78l21-24 18 18 19-27" fill="none" stroke="#1768f2" stroke-width="6" stroke-linecap="round"/><circle cx="74" cy="53" r="24" fill="#efb58c"/><path d="M51 50c4-30 44-33 49 2-10-8-34-10-49-2Z" fill="#5b382c"/><rect x="45" y="78" width="60" height="54" rx="25" fill="#e76f51"/><rect x="24" y="86" width="55" height="41" rx="6" fill="#fff" stroke="#d8c0a9"/></svg></div><h3>@(isPolish ? "Dla nauczycieli" : "For teachers")</h3><p>@(isPolish ? "Twórz oceny, korzystaj z AI i śledź postępy uczniów." : "Create assessments, use AI and track student progress.")</p><a href="#ai">Generate with Edulytics AI →</a></article>
                    <article id="students" class="audience-card"><div class="audience-picture student-picture"><svg viewBox="0 0 260 145"><rect width="260" height="145" rx="20" fill="#eefaf4"/><circle cx="126" cy="45" r="27" fill="#f1b583"/><path d="M99 43c6-35 56-34 58 3-15-8-39-8-58-3Z" fill="#3f2a25"/><rect x="92" y="78" width="72" height="55" rx="25" fill="#1768f2"/><rect x="166" y="79" width="60" height="47" rx="6" fill="#fff" stroke="#b7d5f6" stroke-width="3"/><path d="M177 97h38M177 108h29" stroke="#6b92bd" stroke-width="4" stroke-linecap="round"/></svg></div><h3>@(isPolish ? "Dla uczniów" : "For students")</h3><p>@(isPolish ? "Ucz się z lekcji, rozwiązuj testy i ćwicz prywatnie z AI." : "Learn from lessons, take assessments and practise privately with AI.")</p><a href="#experience">@(isPolish ? "Zobacz doświadczenie" : "Explore the experience") →</a></article>
                    <article class="audience-card"><div class="audience-picture leader-picture"><svg viewBox="0 0 260 145"><rect width="260" height="145" rx="20" fill="#f5f0ff"/><rect x="24" y="22" width="118" height="91" rx="10" fill="#fff" stroke="#d9c9ff" stroke-width="3"/><rect x="43" y="77" width="15" height="22" rx="3" fill="#1768f2"/><rect x="68" y="61" width="15" height="38" rx="3" fill="#6e47ed"/><rect x="93" y="45" width="15" height="54" rx="3" fill="#ff8b38"/><circle cx="188" cy="49" r="23" fill="#efb58c"/><path d="M166 46c4-28 41-30 46 2-12-8-31-9-46-2Z" fill="#4b3228"/><rect x="160" y="76" width="58" height="53" rx="22" fill="#2b4365"/></svg></div><h3>@(isPolish ? "Dla liderów akademickich" : "For academic leaders")</h3><p>@(isPolish ? "Monitoruj realizację programu, wyniki i jakość pracy nauczycieli." : "Monitor curriculum delivery, outcomes and teaching quality.")</p><a href="#platform">@(isPolish ? "Dowiedz się więcej" : "Learn more") →</a></article>
                </div>
            </div>
        </section>

        <section class="ed-home-value-band ed-geo-scene">
            <span class="geo geo-e"></span><span class="geo geo-f"></span>
            <div class="ed-home-container"><div class="ed-home-center-head"><h2>@(isPolish ? "Kompletne rozwiązanie dla nauczania matematyki" : "A complete mathematics teaching environment")</h2></div><div class="ed-home-value-icons"><div><b>▣</b><span>@(isPolish ? "Program nauczania" : "Curriculum")</span></div><div><b>▤</b><span>@(isPolish ? "Gotowe lekcje" : "Ready lessons")</span></div><div><b>✦</b><span>@(isPolish ? "Generowanie pytań z AI" : "AI question generation")</span></div><div><b>▥</b><span>@(isPolish ? "Oceny i wyniki" : "Assessments & results")</span></div><div><b>◎</b><span>@(isPolish ? "Indywidualna praktyka" : "Individual practice")</span></div><div><b>♟</b><span>@(isPolish ? "Nadzór szkoły" : "School oversight")</span></div></div></div>
        </section>

        <section id="curricula" class="ed-home-section ed-home-curricula">
            <div class="ed-home-container">
                <div class="ed-home-center-head"><h2>@(isPolish ? "Obsługiwane programy nauczania" : "Supported curriculum pathways")</h2><p>@(isPolish ? "Wybierz program i poziom, a Edulytics zachowa ten kontekst w lekcjach, ocenach i analizie postępów." : "Choose a curriculum and level, and Edulytics carries that context through lessons, assessments and progress analysis.")</p></div>
                <div class="ed-home-tabs"><span class="is-active">Cambridge</span><span>Common Core</span><span>@(isPolish ? "Polski program" : "Polish curriculum")</span><span>UAE</span></div>
                <div class="ed-home-curriculum-showcase">
                    <div class="curriculum-intro"><h3>Cambridge Mathematics</h3><p>@(isPolish ? "Poziom, lekcje i kontekst programu w jednym spójnym widoku." : "Level, lessons and curriculum context in one coherent view.")</p><span class="stage-pill">Stage 7</span></div>
                    <div class="curriculum-lessons"><article><div class="lesson-picture landscape"><svg viewBox="0 0 210 105"><rect width="210" height="105" rx="14" fill="#dff3ff"/><path d="M0 90 55 35l38 42 39-60 78 73Z" fill="#9dcdf0"/><path d="M26 90 85 54l42 36Z" fill="#6aa5d7"/><circle cx="172" cy="25" r="12" fill="#ffd34d"/></svg></div><span class="stage-pill">Stage 7</span><h4>@(isPolish ? "Liczby całkowite i liczby ze znakiem" : "Integers and directed number")</h4><div class="lesson-tags"><span>@(isPolish ? "Lekcja" : "Lesson")</span><span>@(isPolish ? "Przykłady" : "Examples")</span><span>@(isPolish ? "Ćwiczenia" : "Practice")</span></div></article><article><div class="lesson-picture balance"><svg viewBox="0 0 210 105"><rect width="210" height="105" rx="14" fill="#fff2e9"/><path d="M105 22v62M48 45h114" stroke="#835b3d" stroke-width="6" stroke-linecap="round"/><path d="M60 46 40 78h40ZM150 46l-20 32h40Z" fill="#ff9a3e"/><circle cx="105" cy="22" r="9" fill="#1768f2"/></svg></div><span class="stage-pill">Stage 7</span><h4>@(isPolish ? "Wyrażenia algebraiczne" : "Algebraic expressions")</h4><div class="lesson-tags"><span>@(isPolish ? "Lekcja" : "Lesson")</span><span>@(isPolish ? "Ćwiczenia" : "Practice")</span><span>@(isPolish ? "Test" : "Test")</span></div></article><article><div class="lesson-picture class"><svg viewBox="0 0 210 105"><rect width="210" height="105" rx="14" fill="#eef9ef"/><rect x="15" y="18" width="180" height="62" rx="10" fill="#fff" stroke="#bfe1c5" stroke-width="3"/><circle cx="52" cy="48" r="16" fill="#f1b583"/><circle cx="104" cy="48" r="16" fill="#efb58c"/><circle cx="156" cy="48" r="16" fill="#d9a47e"/><path d="M38 80c4-20 24-20 28 0M90 80c4-20 24-20 28 0M142 80c4-20 24-20 28 0" stroke="#1768f2" stroke-width="10" stroke-linecap="round"/></svg></div><span class="stage-pill">Stage 7</span><h4>@(isPolish ? "Równania i nierówności" : "Equations and inequalities")</h4><div class="lesson-tags"><span>@(isPolish ? "Lekcja" : "Lesson")</span><span>@(isPolish ? "Ćwiczenia" : "Practice")</span><span>@(isPolish ? "Test" : "Test")</span></div></article></div>
                </div>
            </div>
        </section>

        <section id="experience" class="ed-home-section ed-home-experience ed-geo-scene">
            <span class="geo geo-g"></span><span class="geo geo-h"></span>
            <div class="ed-home-container">
                <div class="ed-home-center-head"><h2>@(isPolish ? "Doświadczenie w praktyce" : "The experience in practice")</h2></div>
                <div class="ed-home-experience-tabs"><span class="is-active">@(isPolish ? "Uczeń" : "Student")</span><span>@(isPolish ? "Nauczyciel" : "Teacher")</span><span>@(isPolish ? "Lider akademicki" : "Academic leader")</span><span>@(isPolish ? "Administrator" : "Administrator")</span></div>
                <div class="ed-home-experience-grid">
                    <div class="experience-picture"><svg viewBox="0 0 620 420"><rect width="620" height="420" rx="34" fill="#eaf6ff"/><rect x="40" y="36" width="250" height="158" rx="22" fill="#fff"/><text x="64" y="70" font-size="16" font-weight="800" fill="#1768f2">MOJE LEKCJE</text><text x="64" y="108" font-size="28" font-weight="900" fill="#11243d">Stage 7 · Matematyka</text><rect x="64" y="130" width="160" height="14" rx="7" fill="#dce9f8"/><rect x="64" y="130" width="112" height="14" rx="7" fill="#11a36a"/><circle cx="352" cy="152" r="56" fill="#efb58c"/><path d="M298 145c8-60 105-64 111 3-30-18-81-17-111-3Z" fill="#4b3028"/><rect x="294" y="210" width="118" height="108" rx="44" fill="#1768f2"/><rect x="258" y="280" width="206" height="114" rx="12" fill="#fff" stroke="#b9cee5" stroke-width="4"/><circle cx="362" cy="336" r="18" fill="#6e47ed"/><rect x="415" y="66" width="166" height="96" rx="20" fill="#fff"/><text x="438" y="96" font-size="14" font-weight="800" fill="#66758d">WYNIK</text><text x="438" y="140" font-size="40" font-weight="900" fill="#11a36a">85%</text><rect x="418" y="185" width="165" height="82" rx="20" fill="#fff4e8"/><text x="440" y="214" font-size="13" font-weight="900" fill="#1768f2">AI PRACTICE</text><text x="440" y="246" font-size="22" font-weight="900" fill="#11243d">Ćwicz z AI</text></svg></div>
                    <div class="ed-home-experience-copy"><span class="ed-home-kicker">@(isPolish ? "DOŚWIADCZENIE UCZNIA" : "STUDENT EXPERIENCE")</span><h2>@(isPolish ? "Nauka, która prowadzi do kolejnego kroku." : "Learning that leads to the next step.")</h2><div class="ed-home-checks"><span>@(isPolish ? "Lekcje z wyjaśnieniami i przykładami" : "Lessons with explanations and examples")</span><span>@(isPolish ? "Indywidualna praktyka z AI" : "Individual AI practice")</span><span>@(isPolish ? "Wyniki i obszary do poprawy" : "Results and areas to improve")</span><span>@(isPolish ? "Ćwiczenia dopasowane do wybranego zakresu" : "Practice matched to the selected scope")</span></div><a class="ed-home-secondary ed-home-cta-large" asp-controller="Account" asp-action="Login">@(isPolish ? "Zobacz portal ucznia" : "Explore the student portal") →</a></div>
                </div>
            </div>
        </section>

        <section id="ai" class="ed-home-section ed-home-ai-section">
            <div class="ed-home-container ed-home-ai-grid">
                <div class="ed-home-ai-copy"><span class="ed-home-kicker">EDULYTICS AI</span><h2>@(isPolish ? "Generuj oceny z Edulytics AI" : "Generate assessments with Edulytics AI")</h2><p>@(isPolish ? "Twórz pytania dla lekcji, działów i całego programu. Nauczyciel sprawdza, edytuje, zatwierdza i publikuje." : "Create questions for lessons, units and the full curriculum. Teachers review, edit, approve and publish.")</p><div class="ed-home-checks"><span>@(isPolish ? "Generowanie pytań w kontekście programu" : "Curriculum-aware question generation")</span><span>@(isPolish ? "Automatyczne powiązanie z zakresem" : "Automatic scope context")</span><span>@(isPolish ? "Edytuj, regeneruj i zatwierdzaj" : "Edit, regenerate and approve")</span><span>@(isPolish ? "Do 50 pytań w jednym generowaniu" : "Up to 50 questions per generation")</span></div></div>
                <div class="ed-home-ai-workbench"><div class="ai-top"><strong>Generate with Edulytics AI</strong><span>AI supported</span></div><div class="ai-fields"><div><small>@(isPolish ? "Zakres" : "Scope")</small><b>@(isPolish ? "Lekcja · Algebra" : "Lesson · Algebra")</b></div><div><small>@(isPolish ? "Liczba pytań" : "Questions")</small><b>20</b></div><div><small>@(isPolish ? "Poziom" : "Level")</small><b>Stage 7</b></div></div><div class="ai-question"><span>1</span><div><small>@(isPolish ? "Pytanie wygenerowane" : "Generated question")</small><strong>2(x + 3) = 14</strong></div></div><div class="ai-actions"><span>@(isPolish ? "Edytuj" : "Edit")</span><span>@(isPolish ? "Regeneruj" : "Regenerate")</span><b>@(isPolish ? "Zatwierdź" : "Approve")</b></div></div>
            </div>
        </section>

        <section id="platform" class="ed-home-section ed-home-why">
            <div class="ed-home-container"><div class="ed-home-center-head"><h2>@(isPolish ? "Dlaczego Edulytics?" : "Why Edulytics?")</h2><p>@(isPolish ? "Nie potrzebujesz sztucznych statystyk. Wartość produktu wynika z tego, jak łączy nauczanie, ocenianie i analizę postępów." : "The value comes from how the platform connects teaching, assessment and progress analysis.")</p></div><div class="ed-home-why-grid"><article><div>01</div><h3>@(isPolish ? "Program jako punkt wyjścia" : "Curriculum first")</h3><p>@(isPolish ? "Lekcje, oceny i analiza pozostają osadzone w wybranym programie i poziomie." : "Lessons, assessments and analytics remain grounded in the selected curriculum and level.")</p></article><article><div>02</div><h3>@(isPolish ? "AI pod kontrolą nauczyciela" : "Teacher-controlled AI")</h3><p>@(isPolish ? "AI generuje, ale nauczyciel przegląda i zatwierdza przed publikacją." : "AI generates, but the teacher reviews and approves before publishing.")</p></article><article><div>03</div><h3>@(isPolish ? "Prywatna praktyka ucznia" : "Private student practice")</h3><p>@(isPolish ? "Praktyka ucznia pozostaje oddzielona od oficjalnej oceny szkolnej." : "Student practice stays separate from official school grading.")</p></article><article><div>04</div><h3>Mastery &amp; next step</h3><p>@(isPolish ? "Wyniki pomagają wskazać obszary wymagające dalszej pracy." : "Results help identify areas that need further work.")</p></article></div></div>
        </section>

        <section class="ed-home-start ed-geo-scene">
            <span class="geo geo-i"></span><span class="geo geo-j"></span>
            <div class="ed-home-container"><div class="ed-home-center-head"><h2>@(isPolish ? "Zacznij korzystać z Edulytics" : "Get started with Edulytics")</h2><p>@(isPolish ? "Wybierz swoją rolę i przejdź do logowania." : "Choose your role and continue to sign in.")</p></div><div class="role-grid"><a asp-controller="Account" asp-action="Login"><div class="role-icon">✎</div><strong>@(isPolish ? "Nauczyciel" : "Teacher")</strong></a><a asp-controller="Account" asp-action="Login"><div class="role-icon">🏫</div><strong>@(isPolish ? "Dyrektor szkoły" : "School leader")</strong></a><a asp-controller="Account" asp-action="Login"><div class="role-icon">🎒</div><strong>@(isPolish ? "Uczeń" : "Student")</strong></a><a asp-controller="Account" asp-action="Login"><div class="role-icon">◎</div><strong>@(isPolish ? "Personel / administrator" : "Staff / administrator")</strong></a></div></div>
        </section>

        <section id="contact" class="ed-home-final-cta">
            <div class="ed-home-container"><div><span class="ed-home-kicker">EDULYTICS</span><h2>@(isPolish ? "Połącz program, lekcje, ocenianie i praktykę ucznia w jednej platformie." : "Connect curriculum, lessons, assessment and student practice in one platform.")</h2></div><div class="ed-home-final-actions"><a class="ed-home-cta ed-home-cta-large" href="mailto:@SupportContactOptions.Email?subject=Edulytics%20demo">@demoLabel →</a><a class="ed-home-secondary ed-home-cta-large" href="mailto:@SupportContactOptions.Email">@(isPolish ? "Skontaktuj się z nami" : "Contact us")</a></div></div>
        </section>
    </main>

    <footer class="ed-home-footer">
        <div class="ed-home-container ed-home-footer-grid">
            <div class="ed-home-footer-brand"><partial name="_LocalizedBrand" /><p>@(isPolish ? "Matematyka. Nauka. Postęp." : "Mathematics. Learning. Progress.")</p><div class="footer-contact"><a href="mailto:@SupportContactOptions.Email">@SupportContactOptions.Email</a><span>@SupportContactOptions.PhoneDisplay</span></div></div>
            <div><h3>@(isPolish ? "Platforma" : "Platform")</h3><a href="#platform">@(isPolish ? "Funkcje" : "Features")</a><a href="#curricula">@(isPolish ? "Programy nauczania" : "Curricula")</a><a href="#ai">Edulytics AI</a></div>
            <div><h3>@(isPolish ? "Dla szkół" : "For schools")</h3><a href="#schools">@(isPolish ? "Przegląd" : "Overview")</a><a href="#experience">@(isPolish ? "Doświadczenie" : "Experience")</a><a href="mailto:@SupportContactOptions.Email?subject=Edulytics%20demo">@demoLabel</a></div>
            <div><h3>@(isPolish ? "Dla użytkowników" : "For users")</h3><a href="#teachers">@(isPolish ? "Nauczyciele" : "Teachers")</a><a href="#students">@(isPolish ? "Uczniowie" : "Students")</a><a asp-controller="Account" asp-action="Login">@loginLabel</a></div>
