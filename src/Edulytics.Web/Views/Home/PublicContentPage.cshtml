@using Edulytics.Web.Support
@using System.Globalization
@{
    Layout = "_PublicLayout";
    var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isPolish = string.Equals(language, "pl", StringComparison.OrdinalIgnoreCase);
    var isArabic = string.Equals(language, "ar", StringComparison.OrdinalIgnoreCase);
    string L(string en, string pl) => isArabic ? en : isPolish ? pl : en;
    string L(string en, string pl, string ar) => isArabic ? ar : isPolish ? pl : en;
    var pageKey = (ViewData["MarketingPageKey"] as string) ?? string.Empty;
    var pageUrl = (ViewData["MarketingPageUrl"] as string) ?? "/";
    var pageTitleEn = (ViewData["MarketingPageTitle"] as string) ?? "Edulytics";
    var pageTitlePl = (ViewData["MarketingPageTitlePl"] as string) ?? "Edulytics";
    var pageTitleAr = (ViewData["MarketingPageTitleAr"] as string) ?? pageTitleEn;
    var pageTitle = isArabic ? pageTitleAr : isPolish ? pageTitlePl : pageTitleEn;
    var contactLabel = L("Contact", "Kontakt", "تواصل معنا");
    var loginLabel = L("Log in", "Zaloguj się", "تسجيل الدخول");
    var demoLabel = L("Request a demo", "Poproś o demo", "اطلب عرضًا تجريبيًا");
    ViewData["Title"] = pageTitle;
}

<div class="ed-home ed-content-page" data-marketing-page="@pageKey">
    <partial name="_PublicSiteHeader" />


    <main class="ed-content-main">
        <section class="ed-content-hero">
            <div class="ed-content-container">
                <div class="ed-content-breadcrumb">
                    <a href="/" data-page-key="breadcrumbHome">@L("Home", "Strona główna")</a>
                    <span>›</span>
                    <span data-page-key="breadcrumbSection">@L("Explore", "Poznaj")</span>
                    <span>›</span>
                    <strong data-page-key="breadcrumbCurrent">@pageTitle</strong>
                </div>

                <div class="ed-content-hero-grid">
                    <div class="ed-content-hero-copy">
                        <span class="ed-content-kicker" data-page-key="heroKicker">EDULYTICS</span>
                        <h1 data-page-key="heroTitle">@pageTitle</h1>
                        <p data-page-key="heroBody">@L("Explore how this part of Edulytics connects learning, assessment and progress.", "Zobacz, jak ten obszar Edulytics łączy naukę, ocenianie i postępy.")</p>
                        <div class="ed-content-hero-actions">
                            <a class="ed-content-primary" href="#page-story" data-page-key="heroPrimary">@L("Explore the page", "Poznaj stronę")</a>
                            <a class="ed-content-secondary" href="/contact" data-page-key="heroSecondary">@contactLabel</a>
                        </div>
                    </div>

                    <div class="ed-content-hero-visual" aria-hidden="true">
                        <div class="ed-content-visual-orbit"></div>
                        <div class="ed-content-visual-hub"><small>EDULYTICS</small><strong data-page-key="visualHub">CONNECTED</strong></div>
                        <span class="ed-content-visual-node node-a" data-page-key="visualA">Curriculum</span>
                        <span class="ed-content-visual-node node-b" data-page-key="visualB">Learning</span>
                        <span class="ed-content-visual-node node-c" data-page-key="visualC">Evidence</span>
                        <span class="ed-content-visual-node node-d" data-page-key="visualD">Progress</span>
                        <div class="ed-content-mascot" aria-hidden="true"></div>
                    </div>
                </div>
            </div>
        </section>

        <section id="page-story" class="ed-content-story">
            <div class="ed-content-container">
                <div class="ed-content-section-head">
                    <span class="ed-content-kicker" data-page-key="storyKicker">HOW IT WORKS</span>
                    <h2 data-page-key="storyTitle">A connected part of the learning journey.</h2>
                    <p data-page-key="storyBody">Edulytics keeps the learning context visible from curriculum to the next action.</p>
                </div>
                <div class="ed-content-card-grid" data-page-render="cards"></div>
            </div>
        </section>

        <section class="ed-content-band is-soft">
            <div class="ed-content-container ed-content-split">
                <div class="ed-content-copy">
                    <span class="ed-content-kicker" data-page-key="focusKicker">THE CORE IDEA</span>
                    <h2 data-page-key="focusTitle">Built around the work that matters.</h2>
                    <p data-page-key="focusBody">The platform keeps information useful, explainable and tied to the selected learning scope.</p>
                    <div class="ed-content-points" data-page-render="focusPoints"></div>
                </div>
                <div class="ed-content-evidence-panel" data-page-render="evidence"></div>
            </div>
        </section>

        <section class="ed-content-flow-section">
            <div class="ed-content-container">
                <div class="ed-content-section-head is-left">
                    <span class="ed-content-kicker" data-page-key="flowKicker">CONNECTED FLOW</span>
                    <h2 data-page-key="flowTitle">Each signal should lead somewhere useful.</h2>
                    <p data-page-key="flowBody">The platform turns learning evidence into a clear next action rather than leaving it as an isolated result.</p>
                </div>
                <div class="ed-content-flow" data-page-render="flow"></div>
            </div>
        </section>

        <section class="ed-content-band is-deep">
            <div class="ed-content-container ed-content-split is-reverse">
                <div class="ed-content-copy">
                    <span class="ed-content-kicker" data-page-key="deepKicker">WHY IT MATTERS</span>
                    <h2 data-page-key="deepTitle">Designed to stay useful beyond one screen.</h2>
                    <p data-page-key="deepBody">This capability connects to the wider Edulytics learning and oversight model.</p>
                    <div class="ed-content-points" data-page-render="deepPoints"></div>
                </div>
                <div class="ed-content-context-board" data-page-render="context"></div>
            </div>
        </section>

        <section class="ed-content-role-section">
            <div class="ed-content-container">
                <div class="ed-content-section-head">
                    <span class="ed-content-kicker" data-page-key="roleKicker">WHO IT HELPS</span>
                    <h2 data-page-key="roleTitle">One system, clear responsibilities.</h2>
                    <p data-page-key="roleBody">Different users see the information and actions that belong to their role.</p>
                </div>
                <div class="ed-content-role-grid" data-page-render="roles"></div>
            </div>
        </section>

        <section class="ed-content-final">
            <div class="ed-content-container ed-content-final-grid">
                <div>
                    <span class="ed-content-kicker">EDULYTICS</span>
                    <h2 data-page-key="finalTitle">See how the platform connects the pieces.</h2>
                    <p data-page-key="finalBody">Explore Edulytics in the context of your school, classroom or learning journey.</p>
                </div>
                <div class="ed-content-final-actions">
                    <a class="ed-content-primary" href="mailto:@SupportContactOptions.Email?subject=Edulytics%20demo" data-page-key="finalPrimary">@demoLabel</a>
                    <a class="ed-content-secondary" href="/" data-page-key="finalSecondary">@L("Back to home", "Wróć na stronę główną")</a>
                </div>
            </div>
        </section>
    </main>

    <partial name="_PublicSiteFooter" />

</div>
