@using Edulytics.Core.Constants
@model Edulytics.Web.ViewModels.SchoolUsers.SchoolUserListViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.PlatformResource> T
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.UserHierarchyResource> H

@{
    var canManageSchoolUsers =
        User.IsInRole(RoleNames.SchoolAdmin) ||
        User.IsInRole(RoleNames.SubjectSupervisor) ||
        User.IsInRole(RoleNames.SuperAdmin);

    var schoolUsersSubtitle =
        Model.Context.IsPlatformActor
            ? T["SchoolUsersPlatformSubtitle"].Value
            : User.IsInRole(RoleNames.SubjectSupervisor)
                ? T["SchoolUsersSupervisorSubtitle"].Value
                : H["AdminUsersSubtitle"].Value;

    ViewData["Title"] = T["SchoolUsersTitle"].Value;

    var roleTabs = new[]
    {
        (Value: string.Empty, Label: T["AllUsers"].Value),
        (Value: RoleNames.Student, Label: T["RoleStudent"].Value),
        (Value: RoleNames.Teacher, Label: T["RoleTeacher"].Value),
        (Value: RoleNames.SubjectSupervisor, Label: T["RoleSubjectSupervisor"].Value),
        (Value: RoleNames.SchoolAdmin, Label: T["RoleSchoolAdmin"].Value)
    };

    var firstVisible = Model.TotalCount == 0
        ? 0
        : ((Model.Page - 1) * Model.PageSize) + 1;
    var lastVisible = Model.TotalCount == 0
        ? 0
        : Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}

<section class="user-page">
    <header class="user-page-header">
        <div>
            @if (Model.Context.IsPlatformActor)
            {
                <a class="school-back-link"
                   asp-controller="Schools"
                   asp-action="Details"
                   asp-route-id="@Model.Context.SchoolId">
                    ← @T["BackToSchool"]
                </a>
            }
            else
            {
                <a class="school-back-link"
                   asp-controller="SchoolHome"
                   asp-action="Dashboard">
                    ← @T["BackToDashboard"]
                </a>
            }

            <div class="user-eyebrow">
                @Model.Context.SchoolName
            </div>

            <h1>@T["SchoolUsersTitle"]</h1>

            <p class="user-page-subtitle">
                @schoolUsersSubtitle
            </p>
        </div>

        @if (Model.Context.CanMutate && canManageSchoolUsers)
        {
            <a class="school-button school-button-primary"
               asp-controller="SchoolUsers"
               asp-action="Create"
               asp-route-schoolId="@Model.Context.SchoolId">
                @T["CreateSchoolUser"]
            </a>
        }
    </header>

    @if (TempData["SchoolUserSuccess"] is string success)
    {
        <div class="school-alert school-alert-success"
             role="status">
            @success
        </div>
    }

    @if (TempData["SchoolUserError"] is string error)
    {
        <div class="school-alert school-alert-error"
             role="alert">
            @error
        </div>
    }

    @if (Model.Context.SchoolStatus ==
         Edulytics.Core.Enums.SchoolStatus.Archived)
    {
        <div class="school-alert school-alert-warning"
             role="status">
            @T["ArchivedUsersReadOnly"]
        </div>
    }

    <section class="user-directory-controls" aria-label="@T["UserDirectoryFilters"]">
        <nav class="user-role-tabs" aria-label="@T["UserRole"]">
            @foreach (var tab in roleTabs)
            {
                var selected = string.Equals(
                    Model.Role ?? string.Empty,
                    tab.Value,
                    StringComparison.Ordinal);

                <form method="get" asp-action="Index" class="user-role-tab-form">
                    <input type="hidden" name="schoolId" value="@Model.Context.SchoolId" />
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="academicYearId" value="@Model.AcademicYearId" />
                    <input type="hidden" name="academicProgramId" value="@Model.AcademicProgramId" />
                    <input type="hidden" name="classGroupId" value="@Model.ClassGroupId" />
                    <input type="hidden" name="isActive" value="@Model.IsActive" />
                    <input type="hidden" name="isLocked" value="@Model.IsLocked" />
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <button type="submit"
                            name="role"
                            value="@tab.Value"
                            class="user-role-tab @(selected ? "is-active" : string.Empty)">
                        @tab.Label
                    </button>
                </form>
            }
        </nav>

        <form method="get"
              asp-action="Index"
              class="user-directory-filter-card"
              data-user-directory-filters>
            <input type="hidden" name="schoolId" value="@Model.Context.SchoolId" />
            <input type="hidden" name="role" value="@Model.Role" />

            <div class="user-directory-search-strip">
                <label class="user-directory-search-field">
                    <span class="user-directory-filter-label">@T["SearchUsers"]</span>
                    <span class="user-directory-search-box">
                        <span class="user-directory-search-icon" aria-hidden="true">⌕</span>
                        <input type="search"
                               name="search"
                               value="@Model.Search"
                               maxlength="256"
                               autocomplete="off"
                               placeholder="@T["SearchUsersPlaceholder"]" />
                    </span>
                </label>

                <button type="submit"
                        class="school-button school-button-primary user-directory-search-action">
                    @T["SearchUsers"]
                </button>
            </div>

            <div class="user-directory-filter-grid">
                <label class="user-directory-filter-field">
                    <span class="user-directory-filter-label">@T["AcademicYearFilter"]</span>
                    <select name="academicYearId"
                            data-user-filter-year>
                        <option value="">@T["AllAcademicYears"]</option>
                        @foreach (var option in Model.FilterOptions.AcademicYears)
                        {
                            <option value="@option.Id"
                                    selected="@(Model.AcademicYearId == option.Id ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </label>

                <label class="user-directory-filter-field">
                    <span class="user-directory-filter-label">@T["CurriculumFilter"]</span>
                    <select name="academicProgramId"
                            data-user-filter-program>
                        <option value="">@T["AllCurricula"]</option>
                        @foreach (var option in Model.FilterOptions.AcademicPrograms)
                        {
                            var offeredYearIds = Model.FilterOptions.Classes
                                .Where(x => x.AcademicProgramId == option.Id)
                                .Select(x => x.AcademicYearId.ToString("D"))
                                .Distinct();

                            <option value="@option.Id"
                                    data-year-ids="@string.Join("|", offeredYearIds)"
                                    selected="@(Model.AcademicProgramId == option.Id ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </label>

                <label class="user-directory-filter-field">
                    <span class="user-directory-filter-label">@T["ClassFilter"]</span>
                    <select name="classGroupId"
                            data-user-filter-class>
                        <option value="">@T["AllClasses"]</option>
                        @foreach (var option in Model.FilterOptions.Classes)
                        {
                            <option value="@option.Id"
                                    data-year-id="@option.AcademicYearId"
                                    data-program-id="@option.AcademicProgramId"
                                    selected="@(Model.ClassGroupId == option.Id ? "selected" : null)">
                                @option.Label
                            </option>
                        }
                    </select>
                </label>

                <label class="user-directory-filter-field">
                    <span class="user-directory-filter-label">@T["AccountStatus"]</span>
                    <select name="isActive">
                        <option value="" selected="@(!Model.IsActive.HasValue ? "selected" : null)">@T["AllStatuses"]</option>
                        <option value="true" selected="@(Model.IsActive == true ? "selected" : null)">@T["UserActive"]</option>
                        <option value="false" selected="@(Model.IsActive == false ? "selected" : null)">@T["UserInactive"]</option>
                    </select>
                </label>

                <label class="user-directory-filter-field">
                    <span class="user-directory-filter-label">@T["LockState"]</span>
                    <select name="isLocked">
                        <option value="" selected="@(!Model.IsLocked.HasValue ? "selected" : null)">@T["AllStatuses"]</option>
                        <option value="false" selected="@(Model.IsLocked == false ? "selected" : null)">@T["UserUnlocked"]</option>
                        <option value="true" selected="@(Model.IsLocked == true ? "selected" : null)">@T["UserLocked"]</option>
                    </select>
                </label>

                <label class="user-directory-filter-field user-directory-page-size">
                    <span class="user-directory-filter-label">@T["RowsPerPage"]</span>
                    <select name="pageSize">
                        @foreach (var size in new[] { 25, 50, 100 })
                        {
                            <option value="@size" selected="@(Model.PageSize == size ? "selected" : null)">@size</option>
                        }
                    </select>
                </label>
            </div>

            <div class="user-directory-filter-footer">
                <div class="user-directory-summary" aria-live="polite">
                    @T["ShowingUsers", firstVisible, lastVisible, Model.TotalCount]
                </div>

                <div class="user-filter-actions">
                    <a class="school-button school-button-secondary"
                       asp-action="Index"
                       asp-route-schoolId="@Model.Context.SchoolId">
                        @T["ClearFilters"]
                    </a>
                    <button type="submit" class="school-button school-button-primary">
                        @T["ApplyFilters"]
                    </button>
                </div>
            </div>
        </form>

        <script>
            (() => {
                const form = document.querySelector("[data-user-directory-filters]");
                if (!form) return;

                const year = form.querySelector("[data-user-filter-year]");
                const program = form.querySelector("[data-user-filter-program]");
                const classGroup = form.querySelector("[data-user-filter-class]");
                if (!year || !program || !classGroup) return;

                const programOptions = [...program.options].filter(option => option.value);
                const classOptions = [...classGroup.options].filter(option => option.value);

                const syncAcademicFilters = () => {
                    const yearId = year.value;
                    for (const option of programOptions) {
                        const years = (option.dataset.yearIds || "")
                            .split("|")
                            .filter(Boolean);
                        const visible = !yearId || years.includes(yearId);
                        option.hidden = !visible;
                        option.disabled = !visible;
                    }

                    if (program.selectedOptions[0]?.disabled) {
                        program.value = "";
                    }

                    const activeProgramId = program.value;

                    for (const option of classOptions) {
                        const yearMatches =
                            !yearId ||
                            option.dataset.yearId === yearId;
                        const programMatches =
                            !activeProgramId ||
                            option.dataset.programId === activeProgramId;
                        const visible = yearMatches && programMatches;

                        option.hidden = !visible;
                        option.disabled = !visible;
                    }

                    if (classGroup.selectedOptions[0]?.disabled) {
                        classGroup.value = "";
                    }
                };

                year.addEventListener("change", syncAcademicFilters);
                program.addEventListener("change", syncAcademicFilters);
                syncAcademicFilters();
            })();
        </script>
    </section>

    @if (Model.Users.Count == 0)
    {
        <section class="user-empty">
            <h2>@T["NoSchoolUsers"]</h2>
            <p>@T["NoSchoolUsersDescription"]</p>

            @if (Model.Context.CanMutate && canManageSchoolUsers)
            {
                <a class="school-button school-button-primary"
                   asp-controller="SchoolUsers"
                   asp-action="Create"
                   asp-route-schoolId="@Model.Context.SchoolId">
                    @T["CreateSchoolUser"]
                </a>
            }
        </section>
    }
    else
    {
        <div class="user-table-wrap">
            <table class="user-table">
                <thead>
                <tr>
                    <th>@T["UserNameAndId"]</th>
                    <th>@T["UserEmail"]</th>
                    <th>@T["UserRole"]</th>
                    <th>@T["AcademicContext"]</th>
                    <th>@T["AccountStatus"]</th>
                    <th>@T["LockState"]</th>
                    <th>@T["CreatedAt"]</th>
                    <th>@T["Actions"]</th>
                </tr>
                </thead>

                <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td data-label="@T["UserNameAndId"]">
                            <div class="user-directory-identity">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(user.DisplayName)
                                        ? T["NameUnavailable"].Value
                                        : user.DisplayName)
                                </strong>
                                @if (!string.IsNullOrWhiteSpace(user.StudentNumber))
                                {
                                    <small>@T["StudentNumberLabel"]: @user.StudentNumber</small>
                                }
                                <code title="@user.Id">@user.Id</code>
                            </div>
                        </td>

                        <td data-label="@T["UserEmail"]">
                            <a class="user-directory-email"
                               href="mailto:@user.Email"
                               title="@user.Email">
                                @user.Email
                            </a>

                            @if (user.IsSelf)
                            {
                                <span class="user-self">
                                    @T["You"]
                                </span>
                            }
                        </td>

                        <td data-label="@T["UserRole"]">
                            @if (string.IsNullOrWhiteSpace(user.Role))
                            {
                                <span class="user-state user-state-error">
                                    @T["InvalidRoleState"]
                                </span>
                            }
                            else
                            {
                                @T[$"Role{user.Role}"]
                            }
                        </td>

                        <td data-label="@T["AcademicContext"]">
                            @{
                                var contexts = user.AcademicContexts ?? [];
                                var visibleContexts = contexts.Take(2).ToArray();
                            }

                            @if (contexts.Count == 0)
                            {
                                <span class="user-directory-context-empty">
                                    @T["NoAcademicContext"]
                                </span>
                            }
                            else
                            {
                                <div class="user-directory-context-list">
                                    @foreach (var context in visibleContexts)
                                    {
                                        <span class="user-directory-context-chip"
                                              title="@($"{context.AcademicYearName} · {context.AcademicProgramName} · {context.ClassGroupName}")">
                                            <strong>@context.ClassGroupName</strong>
                                            <small>@context.AcademicYearName · @context.AcademicProgramName</small>
                                        </span>
                                    }

                                    @if (contexts.Count > visibleContexts.Length)
                                    {
                                        <span class="user-directory-context-more">
                                            +@(contexts.Count - visibleContexts.Length) @T["More"]
                                        </span>
                                    }
                                </div>
                            }
                        </td>

                        <td data-label="@T["AccountStatus"]">
                            <span class="user-state"
                                  data-state="@(user.IsActive ? "active" : "inactive")">
                                @(user.IsActive
                                    ? T["UserActive"]
                                    : T["UserInactive"])
                            </span>
                        </td>

                        <td data-label="@T["LockState"]">
                            <span class="user-state"
                                  data-state="@(user.IsLocked ? "locked" : "unlocked")">
                                @(user.IsLocked
                                    ? T["UserLocked"]
                                    : T["UserUnlocked"])
                            </span>
                        </td>

                        <td data-label="@T["CreatedAt"]">
                            @user.CreatedAtUtc.ToString("g")
                            @T["UtcSuffix"]
                        </td>

                        <td data-label="@T["Actions"]">
                            <a class="school-button school-button-secondary school-button-small"
                               asp-controller="SchoolUsers"
                               asp-action="Details"
                               asp-route-id="@user.Id"
                               asp-route-schoolId="@Model.Context.SchoolId">
                                @T["View"]
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="user-pagination" aria-label="@T["Pagination"]">
                <form method="get" asp-action="Index" class="user-pagination-form">
                    <input type="hidden" name="schoolId" value="@Model.Context.SchoolId" />
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="role" value="@Model.Role" />
                    <input type="hidden" name="academicYearId" value="@Model.AcademicYearId" />
                    <input type="hidden" name="academicProgramId" value="@Model.AcademicProgramId" />
                    <input type="hidden" name="classGroupId" value="@Model.ClassGroupId" />
                    <input type="hidden" name="isActive" value="@Model.IsActive" />
                    <input type="hidden" name="isLocked" value="@Model.IsLocked" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <button type="submit"
                            name="page"
                            value="@(Math.Max(1, Model.Page - 1))"
                            class="school-button school-button-secondary school-button-small"
                            disabled="@(Model.Page <= 1 ? "disabled" : null)">
                        @T["PreviousPage"]
                    </button>
                </form>

                <span>@T["PageOf", Model.Page, Model.TotalPages]</span>

                <form method="get" asp-action="Index" class="user-pagination-form">
                    <input type="hidden" name="schoolId" value="@Model.Context.SchoolId" />
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="role" value="@Model.Role" />
                    <input type="hidden" name="academicYearId" value="@Model.AcademicYearId" />
                    <input type="hidden" name="academicProgramId" value="@Model.AcademicProgramId" />
                    <input type="hidden" name="classGroupId" value="@Model.ClassGroupId" />
                    <input type="hidden" name="isActive" value="@Model.IsActive" />
                    <input type="hidden" name="isLocked" value="@Model.IsLocked" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <button type="submit"
                            name="page"
                            value="@(Math.Min(Model.TotalPages, Model.Page + 1))"
                            class="school-button school-button-secondary school-button-small"
                            disabled="@(Model.Page >= Model.TotalPages ? "disabled" : null)">
                        @T["NextPage"]
                    </button>
                </form>
            </nav>
        }
    }
</section>
