@model Edulytics.Services.LessonContent.StudentLessonDetail
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.LessonContentResource> L
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.StudentResource> S
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.LessonPracticeResource> P
@using Edulytics.Web.Presentation
@using Edulytics.Web.ViewModels.LessonContent
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = Model.Title;
    var gameAdoptionId = ViewData["GameAdoptionId"] is Guid gameId
        ? gameId
        : (Guid?)null;
    var exactPracticeAdoptionId = ViewData["ExactPracticeAdoptionId"] is Guid exactPracticeId
        ? exactPracticeId
        : (Guid?)null;
    var practiceAdoptionId = ViewData["LessonPracticePilotAdoptionId"] is Guid adoptionId
        ? adoptionId
        : (Guid?)null;
    var unifiedPracticeAdoptionId =
        exactPracticeAdoptionId ??
        gameAdoptionId ??
        practiceAdoptionId;
    ViewData["UseYouTubeStudioV2"] = true;

    var sections = new[]
    {
        new LessonReaderSection("01", L["Explanation"], "explanation", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.Explanation), sectionKind: "explanation")),
        new LessonReaderSection("02", L["KeyConceptsAndRules"], "concepts", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.KeyConceptsAndRules), sectionKind: "concepts")),
        new LessonReaderSection("03", L["WorkedExamples"], "examples", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.WorkedExamples), sectionKind: "examples")),
        new LessonReaderSection("04", L["StepByStepSolutions"], "steps", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.StepByStepSolutions), orderedSteps: true, sectionKind: "steps")),
        new LessonReaderSection("05", L["CommonMistakes"], "mistakes", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.CommonMistakes), sectionKind: "mistakes")),
        new LessonReaderSection("06", L["QuickSummary"], "summary", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.QuickSummary), sectionKind: "summary"))
    };
}
<style>
    .lesson-mode-tabs {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 14px 0 20px;
        padding: 5px;
        border: 1px solid #dbe5ef;
        border-radius: 999px;
        background: #f5f8fb;
    }
    .lesson-mode-tab {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 20px;
        border: 0;
        border-radius: 999px;
        font: inherit;
        font-weight: 800;
        color: #335168;
        background: transparent;
        text-decoration: none;
    }
    .lesson-mode-tab--active {
        color: #fff;
        background: #0b7285;
        box-shadow: 0 5px 14px rgba(11,114,133,.2);
    }
    .lesson-mode-tab--practice {
        cursor: pointer;
        color: #075d6c;
        transition: transform .15s ease, background .15s ease;
    }
    .lesson-mode-tab--practice:hover {
        background: #dff6f8;
        transform: translateY(-1px);
    }
    .lesson-mode-tabs form { margin: 0; }
    @@media (max-width: 520px) {
        .lesson-mode-tabs { display: flex; width: 100%; }
        .lesson-mode-tab, .lesson-mode-tabs form { flex: 1 1 0; }
        .lesson-mode-tab { width: 100%; padding-inline: 12px; }
    }
</style>
<div class="lesson-reader lesson-reader--student">
    <a class="lesson-reader-back" asp-action="Learning"><span aria-hidden="true">←</span> @L["BackToLessons"]</a>

    @if (unifiedPracticeAdoptionId.HasValue)
    {
        <nav class="lesson-mode-tabs" aria-label="@S["Lesson"] / @P["Practice"]">
            <span class="lesson-mode-tab lesson-mode-tab--active" aria-current="page">@S["Lesson"]</span>
            <form asp-controller="StudentPractice" asp-action="StartLessonPractice" method="post">
                @Html.AntiForgeryToken()
                @* A fresh lesson page render is a new user action; do not reuse the CSRF token as the idempotency identity. *@
                <input type="hidden" name="_idempotencyKey" value="@(Guid.NewGuid().ToString("N"))" />
                <input type="hidden" name="curriculumAdoptionId" value="@unifiedPracticeAdoptionId.Value" />
                <input type="hidden" name="lessonId" value="@Model.Id" />
                <button class="lesson-mode-tab lesson-mode-tab--practice" type="submit">@P["Practice"]</button>
            </form>
        </nav>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L01" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original Grade 2 lesson activities">
            <h2>Edulytics · original lesson activities and Cool-down</h2>
            <p>Explore addition and subtraction within 10, create your own
                number-card expressions, and complete an independently authored
                four-task exit ticket. Teacher-reviewed explanations remain
                separate from automatically checked mathematics.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson1Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 2 lesson activities &amp; Cool-down
            </a>
        </section>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="school-alert school-alert-error" role="alert">@error</div>
    }

    <header class="lesson-reader-hero"><div class="lesson-reader-hero__main"><div class="lesson-reader-hero__topline"><span class="student-subject-code">@Model.SubjectCode</span></div><p class="lesson-library-eyebrow">@L["LearningContent"]</p><h1>@Model.Title</h1><p class="lesson-reader-hero__unit">@Model.TopicName</p><div class="lesson-reader-meta"><span><small>@L["Grade"]</small><strong>@Model.GradeName</strong></span><span><small>@L["Framework"]</small><strong>@Model.FrameworkName</strong></span></div></div></header>
    <div class="lesson-reader-layout @(Model.Outcomes.Count == 0 ? "lesson-reader-layout--full" : null)"><main class="lesson-reader-main">
        @if (Model.RichContent is not null)
        {
            <partial name="_RichLessonContentV2" model="Model.RichContent" />
            @* A-C source-corrected original U03 L20-L27 teaching lives in the
               canonical translation. The V2 runtime composer compresses the
               worked examples/steps and can otherwise hide essential original
               first-party activity directions from the authenticated learner.
               Keep V2 visuals, but show the source-scoped canonical lessons'
               concepts, worked examples and teacher-facilitated directions.
               This DOES NOT claim pupils performed classroom activities. *@
            @* Grade 2 first-lesson Rich V2 may condense original source-specific
               within-ten strategy teaching. Keep V2 and expose the reviewed
               learner concepts/examples/steps in full before authored activities. *@
            @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L01")
            {
                <section class="lesson-source-aligned-activities"
                         aria-label="Grade 2 source-aligned mathematical teaching">
                    <h2>Adding and subtracting within ten</h2>
                    <p class="lesson-reader-text">
                        Examine the sum and difference, use ten-frame counters
                        or another valid strategy, and explain an expression
                        that has the required value.
                    </p>
                    <partial name="_LessonReaderSection" model="sections[1]" />
                    <partial name="_LessonReaderSection" model="sections[2]" />
                    <partial name="_LessonReaderSection" model="sections[3]" />
                </section>
            }
            @if (Model.LessonCode.StartsWith("PED:US-CCSS-MATH:G1:U03:L", StringComparison.Ordinal) &&
                 int.TryParse(Model.LessonCode["PED:US-CCSS-MATH:G1:U03:L".Length..], out var sourceLessonNumber) &&
                 sourceLessonNumber is >= 20 and <= 27)
            {
                <div class="lesson-source-aligned-activities" aria-label="Source-aligned original lesson teaching">
                    <h2>Source-aligned activities and teaching</h2>
                    <p class="lesson-reader-text">
                        Edulytics-authored instructions for this lesson's original mathematical goals.
                        Physical game rounds, drawings and partner explanations still require teacher review.
                    </p>
                    <partial name="_LessonReaderSection" model="sections[1]" />
                    <partial name="_LessonReaderSection" model="sections[2]" />
                    <partial name="_LessonReaderSection" model="sections[3]" />
                </div>
            }
        }
        else
        {
            @foreach (var section in sections)
            {
                <partial name="_LessonReaderSection" model="section" />
            }
        }

        <partial name="_LessonYouTubeStudio"
                 model="@(new LessonYouTubeStudioViewModel(
                     Model.Id,
                     Model.LessonCode,
                     Model.Title,
                     Model.GradeName,
                     Model.FrameworkName,
                     Model.RichContent,
                     Url.Action("LessonYouTube", "StudentPortal", new { id = Model.Id }) ?? string.Empty))" />
        <partial name="_LessonReviewedResources" model="Model" />
        @if (Model.LessonCode == "PED:US-CCSS-MATH:G1:U01:L01")
        {
            <p class="lesson-source-attribution">
                Source inspiration: <a href="https://im.kendallhunt.com/k5/teachers/grade-1/unit-1/lesson-1/lesson.html"
                                       target="_blank" rel="noopener noreferrer">Illustrative Mathematics, Grade 1, Unit 1, Lesson 1</a>
                (© 2021 Illustrative Mathematics, CC BY 4.0).
                Instructional examples and dot-counter visuals have been adapted or newly created for Edulytics;
                the publisher's name and logo are not used as an endorsement.
                <a href="https://creativecommons.org/licenses/by/4.0/"
                   target="_blank" rel="noopener noreferrer">License terms</a>.
            </p>
        }
        else if (Model.LessonCode is { } t001Code
            && t001Code.StartsWith("PED:US-CCSS-MATH:G1:U01:L", StringComparison.Ordinal)
            && int.TryParse(t001Code["PED:US-CCSS-MATH:G1:U01:L".Length..],
                out var t001LessonNumber)
            && t001LessonNumber is >= 2 and <= 10)
        {
            <p class="lesson-source-attribution">
                Source inspiration:
                <a href="@($"https://im.kendallhunt.com/k5/teachers/grade-1/unit-1/lesson-{t001LessonNumber}/lesson.html")"
                   target="_blank" rel="noopener noreferrer">
                    Illustrative Mathematics, Grade 1, Unit 1, Lesson @t001LessonNumber
                </a>
                (© 2021 Illustrative Mathematics, CC BY 4.0).
                The lesson teaching and first-party practice are adapted for Edulytics; this
                does not imply endorsement by the publisher.
                <a href="https://creativecommons.org/licenses/by/4.0/"
                   target="_blank" rel="noopener noreferrer">License terms</a>.
            </p>
        }
    </main>@if (Model.Outcomes.Count > 0) { <aside class="lesson-reader-sidebar" aria-label="@L["LessonReference"]"><section class="lesson-reader-sidecard"><h2>@L["StandardsReference"]</h2><div class="lesson-reader-outcomes">@foreach (var outcome in Model.Outcomes) { <article class="lesson-reader-outcome"><strong>@outcome.Code</strong></article> }</div></section></aside> }</div>
</div>


@section Head {
    <link rel="stylesheet" href="~/css/lesson-youtube-studio.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/lesson-youtube-studio.js" asp-append-version="true"></script>
}
