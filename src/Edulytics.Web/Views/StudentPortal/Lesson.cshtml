@model Edulytics.Services.LessonContent.StudentLessonDetail
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.LessonContentResource> L
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.StudentResource> S
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.LessonPracticeResource> P
@using Edulytics.Web.Presentation
@using Edulytics.Web.ViewModels.LessonContent
@{
    Layout = "_StudentLayout";
    // The owner-consented Grade 5 canonical JSON remains SHA pinned.
    // Remove the editorial "PLC Activity" suffix only at presentation time:
    // IM K-5 First Edition 2021's original lesson titles exclude this badge.
    var grade5OriginalDisplayTitle =
        Model.LessonCode.StartsWith("PED:US-CCSS-MATH:G5:", StringComparison.Ordinal) &&
        Model.Title.EndsWith(" PLC Activity", StringComparison.Ordinal)
            ? Model.Title[..^" PLC Activity".Length]
            : Model.Title;
    ViewData["Title"] = grade5OriginalDisplayTitle;
    var gameAdoptionId = ViewData["GameAdoptionId"] is Guid gameId
        ? gameId
        : (Guid?)null;
    var exactPracticeAdoptionId = ViewData["ExactPracticeAdoptionId"] is Guid exactPracticeId
        ? exactPracticeId
        : (Guid?)null;
    var practiceAdoptionId = ViewData["LessonPracticePilotAdoptionId"] is Guid adoptionId
        ? adoptionId
        : (Guid?)null;
    var unifiedPracticeAdoptionId =
        exactPracticeAdoptionId ??
        gameAdoptionId ??
        practiceAdoptionId;
    var grade3AuthoredActivityAdoptionId =
        ViewData["Grade3AuthoredActivityAdoptionId"] is Guid g3AdoptionId
            ? g3AdoptionId
            : (Guid?)null;
    var isUaeGrade1Arabic = Model.LessonCode.StartsWith("PED:UAE-MOE-MATH:L1:COMMON:", StringComparison.Ordinal);
    var lessonNavTitle = isUaeGrade1Arabic ? "الدرس" : S["Lesson"].Value;
    var practiceNavTitle = isUaeGrade1Arabic ? "التدريب" : P["Practice"].Value;
    var backToLessonsTitle = isUaeGrade1Arabic ? "العودة إلى الدروس" : L["BackToLessons"].Value;
    ViewData["UseYouTubeStudioV2"] = !isUaeGrade1Arabic;

    var sections = new[]
    {
        new LessonReaderSection("01", isUaeGrade1Arabic ? "الشرح" : L["Explanation"].Value, "explanation", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.Explanation), sectionKind: "explanation", includeFallbackVisual: !isUaeGrade1Arabic)),
        new LessonReaderSection("02", isUaeGrade1Arabic ? "المفاهيم والقواعد" : L["KeyConceptsAndRules"].Value, "concepts", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.KeyConceptsAndRules), sectionKind: "concepts")),
        new LessonReaderSection("03", isUaeGrade1Arabic ? "أمثلة محلولة" : L["WorkedExamples"].Value, "examples", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.WorkedExamples), sectionKind: "examples", includeFallbackVisual: !isUaeGrade1Arabic)),
        new LessonReaderSection("04", isUaeGrade1Arabic ? "الحل خطوة بخطوة" : L["StepByStepSolutions"].Value, "steps", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.StepByStepSolutions), orderedSteps: true, sectionKind: "steps")),
        new LessonReaderSection("05", isUaeGrade1Arabic ? "الأخطاء الشائعة" : L["CommonMistakes"].Value, "mistakes", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.CommonMistakes), sectionKind: "mistakes")),
        new LessonReaderSection("06", isUaeGrade1Arabic ? "ملخص الدرس" : L["QuickSummary"].Value, "summary", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.QuickSummary), sectionKind: "summary"))
    };
}
<style>
    .lesson-mode-tabs {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 14px 0 20px;
        padding: 5px;
        border: 1px solid #dbe5ef;
        border-radius: 999px;
        background: #f5f8fb;
    }
    .lesson-mode-tab {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 20px;
        border: 0;
        border-radius: 999px;
        font: inherit;
        font-weight: 800;
        color: #335168;
        background: transparent;
        text-decoration: none;
    }
    .lesson-mode-tab--active {
        color: #fff;
        background: #0b7285;
        box-shadow: 0 5px 14px rgba(11,114,133,.2);
    }
    .lesson-mode-tab--practice {
        cursor: pointer;
        color: #075d6c;
        transition: transform .15s ease, background .15s ease;
    }
    .lesson-mode-tab--practice:hover {
        background: #dff6f8;
        transform: translateY(-1px);
    }
    .lesson-mode-tabs form { margin: 0; }
    @@media (max-width: 520px) {
        .lesson-mode-tabs { display: flex; width: 100%; }
        .lesson-mode-tab, .lesson-mode-tabs form { flex: 1 1 0; }
        .lesson-mode-tab { width: 100%; padding-inline: 12px; }
    }
</style>
<div class="lesson-reader lesson-reader--student">
    <a class="lesson-reader-back" asp-action="Learning"><span aria-hidden="true">←</span> @backToLessonsTitle</a>

    @if (unifiedPracticeAdoptionId.HasValue)
    {
        <nav class="lesson-mode-tabs" aria-label="@lessonNavTitle / @practiceNavTitle">
            <span class="lesson-mode-tab lesson-mode-tab--active" aria-current="page">@lessonNavTitle</span>
            <form asp-controller="StudentPractice" asp-action="StartLessonPractice" method="post">
                @Html.AntiForgeryToken()
                @* A fresh lesson page render is a new user action; do not reuse the CSRF token as the idempotency identity. *@
                <input type="hidden" name="_idempotencyKey" value="@(Guid.NewGuid().ToString("N"))" />
                <input type="hidden" name="curriculumAdoptionId" value="@unifiedPracticeAdoptionId.Value" />
                <input type="hidden" name="lessonId" value="@Model.Id" />
                <button class="lesson-mode-tab lesson-mode-tab--practice" type="submit">@practiceNavTitle</button>
            </form>
        </nav>
    }

    @* G11 Algebra 2: authentic first-party written response with manual teacher review, not a machine-graded claim. *@
    @if (Model.LessonCode.StartsWith("PED:US-CCSS-MATH:HS:TRAD:ALG2:IM-1E:", StringComparison.Ordinal))
    {
        <section class="student-card" aria-label="Algebra 2 lesson written submission and teacher review">
            <h2>Submit your Algebra 2 reasoning for teacher review</h2>
            <p>Write a mathematical model, calculation, interpretation and explanation.
                Your assigned teacher reviews the response, including any written or drawn evidence,
                and records a manual score. This is not automatic Practice grading.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade11Algebra2RubricStudent" asp-action="Index"
               asp-route-lessonId="@Model.Id">
                Open teacher-reviewed Algebra 2 response
            </a>
        </section>
    }

    @* G10 Geometry: per-lesson first-party written evidence, separately and manually scored. *@
    @if (Model.LessonCode.StartsWith("PED:US-CCSS-MATH:HS:TRAD:GEO:IM-1E:", StringComparison.Ordinal))
    {
        <section class="student-card" aria-label="Geometry lesson written submission and teacher review">
            <h2>Submit your Geometry reasoning for teacher review</h2>
            <p>Show your original construction, proof, model or reasoning. Your teacher
                reviews the lesson-specific evidence and records a manual score;
                this is not an automatically marked Practice question.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade10GeometryRubricStudent" asp-action="Index"
               asp-route-lessonId="@Model.Id">
                Open teacher-reviewed Geometry response
            </a>
        </section>
    }

    @* G5 U03:L02: independently authored free-response construction,
       explicitly teacher scored and never auto-mastery. *@
    @if (Model.LessonCode == "PED:US-CCSS-MATH:G5:U03:L02" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 5 teacher-reviewed equal-area construction">
            <h2>Equal-area construction — teacher review</h2>
            <p>Explain both unit-fraction multiplication orders and compare 2-by-5
                and 5-by-3 unit-square models. A qualified teacher scores all six criteria.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade5U03L02RubricStudent" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open teacher-reviewed construction and explanation
            </a>
        </section>
    }
    @if (Model.LessonCode == "PED:US-CCSS-MATH:G3:U01:L01" &&
         grade3AuthoredActivityAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 3 source-aligned data activities">
            <h2>Edulytics · picture and bar graphs</h2>
            <p>Investigate categorical data, compare two graph representations,
                create your own questions, and complete a first-party Cool-down.
                Oral and written reasoning is teacher reviewed.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade3Lesson1Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@grade3AuthoredActivityAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 3 graph activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G3:U01:L02" &&
         grade3AuthoredActivityAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 3 real-class-data graph companion">
            <h2>Edulytics · real class survey and data problems</h2>
            <p>Represent teacher-confirmed class survey counts in two graphs,
                solve variable-data questions, and complete a separate original Cool-down.
                Graphs, explanations and classroom activity evidence require teacher review.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade3Lesson2Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@grade3AuthoredActivityAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 3 class-data activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G3:U01:L03" &&
         grade3AuthoredActivityAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 3 scaled graph lesson companion">
            <h2>Edulytics · scaled picture graph activities</h2>
            <p>Read new scale-two and scale-five pictographs, work out totals and comparisons,
                invent questions, and complete an independent original Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade3Lesson3Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@grade3AuthoredActivityAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open scaled picture graph activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G3:U01:L04" &&
         grade3AuthoredActivityAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 3 original scaled survey companion">
            <h2>Edulytics · create a scaled picture graph</h2>
            <p>Collect genuine class travel preferences, plot each two classmates as a full mark
                and each odd leftover as a half mark, and try an independently authored Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade3Lesson4Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@grade3AuthoredActivityAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 3 scaled graph activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G3:U01:L05" &&
         grade3AuthoredActivityAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 3 original scaled bar graph student lesson">
            <h2>Edulytics · scaled bar graphs</h2>
            <p>Compare two source-aligned original graphs and make new bar graphs
                using the previous real class survey at scale 2 or 5.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade3Lesson5Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@grade3AuthoredActivityAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 3 bar graph activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G3:U01:L06" &&
         grade3AuthoredActivityAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 3 scale choice and bar graph companion">
            <h2>Edulytics · choose a bar graph scale</h2>
            <p>Compare pet graphs with three scales, choose an accurate scale for pattern blocks
                and source seasonal data, and complete a new Edulytics Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade3Lesson6Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@grade3AuthoredActivityAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 3 Choose a Scale activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G3:U01:L07" &&
         grade3AuthoredActivityAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 3 scaled bar graph comparison problems">
            <h2>Edulytics · data comparison problems</h2>
            <p>Use the previously created seasonal graph, interpret scaled bug bars with
                reasonable estimates, and complete an original Edulytics Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade3Lesson7Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@grade3AuthoredActivityAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 3 scaled graph questions and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G3:U01:L08" &&
         grade3AuthoredActivityAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 3 source-aligned two-step bar-graph problems">
            <h2>Edulytics · two-step graph problems</h2>
            <p>Interpret source-matched data in scaled graphs, solve two-step more/fewer
                questions using Three Reads, and complete an original Edulytics Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade3Lesson8Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@grade3AuthoredActivityAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 3 two-step graph activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode.StartsWith("PED:US-CCSS-MATH:G3:", StringComparison.Ordinal) &&
         Model.LessonCode != "PED:US-CCSS-MATH:G3:U01:L01" &&
         Model.LessonCode != "PED:US-CCSS-MATH:G3:U01:L02" &&
         Model.LessonCode != "PED:US-CCSS-MATH:G3:U01:L03" &&
         Model.LessonCode != "PED:US-CCSS-MATH:G3:U01:L04" &&
         Model.LessonCode != "PED:US-CCSS-MATH:G3:U01:L05" &&
         Model.LessonCode != "PED:US-CCSS-MATH:G3:U01:L06" &&
         Model.LessonCode != "PED:US-CCSS-MATH:G3:U01:L07" &&
         Model.LessonCode != "PED:US-CCSS-MATH:G3:U01:L08" &&
         grade3AuthoredActivityAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade 3 Edulytics original candidate companion">
            <h2>Edulytics · original skill companion and Cool-down</h2>
            <p>Independently authored first-pass activity and Cool-down, with
               source activity reminders, numeric checking where valid,
               and teacher-reviewed drawing and reasoning.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade3SourceCompanion" asp-action="Index"
               asp-route-curriculumAdoptionId="@grade3AuthoredActivityAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 3 skill companion and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L01" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original Grade 2 lesson activities">
            <h2>Edulytics · original lesson activities and Cool-down</h2>
            <p>Explore addition and subtraction within 10, create your own
                number-card expressions, and complete an independently authored
                four-task exit ticket. Teacher-reviewed explanations remain
                separate from automatically checked mathematics.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson1Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 2 lesson activities &amp; Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L02" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Original Edulytics ten-cube activities">
            <h2>Edulytics · ten-cube activities and Cool-down</h2>
            <p>Build two-color towers of ten, find hidden cube parts, connect
                addition and subtraction, and answer the independently
                authored end-of-lesson questions.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson2Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open ten-cube activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L03" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics twenty-cube activities">
            <h2>Edulytics · twenty-cube activities and Cool-down</h2>
            <p>Work with two groups of ten, find missing parts of twenty,
            test addition/subtraction equations, and explain your strategy
            using original Edulytics diagrams.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson3Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open twenty-cube activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L04" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics How Close and Cool-down">
            <h2>Edulytics · How Close and Cool-down</h2>
            <p>Use three of five digit cards to get close to twenty,
            solve addition and subtraction problems, and explain a make-ten
            or other valid strategy. Exercises use original Edulytics cards.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson4Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open How Close and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L05" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics How Close with seven cards and sums to 50">
            <h2>Edulytics · How Close to 50 and Cool-down</h2>
            <p>Choose four of seven digit cards, build two two-digit
            numbers, and practice composing tens while adding within 50.
            Use our original Edulytics assessment and teacher rubric.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson5Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open seven-card game and Cool-down</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L06" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics optional Number Puzzles">
            <h2>Edulytics · Number Puzzles center</h2>
            <p>Place digit cards exactly once across a four-equation board,
                practise two-digit sums, and reflect on your choice of center.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson6Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open Number Puzzles and reflection</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L07" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original real classroom survey">
            <h2>Edulytics · collect and organize real classroom data</h2>
            <p>Record anonymous, authentic travel-to-school observations,
                compare the unordered classroom display with a grouped
                pictorial representation, and complete an independently
                authored Cool-down using those same observations.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson7Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open real-class-data activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L08" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Original Edulytics picture graphs and Cool-down">
            <h2>Edulytics · interpreting picture graphs and Cool-down</h2>
            <p>Read first-party child, adult and art-supply pictographs,
                use the one-symbol key to compare categories, and explain
                which questions the graph can and cannot answer.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson8Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open picture graphs and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L09" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original numbered-scale bar graph activities">
            <h2>Edulytics · bar graphs and Cool-down</h2>
            <p>Compare a picture graph to numbered-scale bar graphs,
                write original true class-choice statements, read season
                totals and complete a first-party bar-graph exit ticket.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson9Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open bar-graph activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L10" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original picture and bar graph authoring">
            <h2>Edulytics · make your own picture graph and bar graph</h2>
            <p>Create a picture graph with an original symbol and a key,
                exchange your data table with a partner, draw a correctly
                scaled bar graph, and complete an independently authored
                same-data exit ticket.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson10Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open graph-making activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L11" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics learner-written questions about previous graphs">
            <h2>Edulytics · create and exchange graph questions</h2>
            <p>Revisit the two graphs made in Lesson 10, write four
                original questions (two for each graph), include a
                category-combine or comparison question, and exchange
                answers with a partner. Finish our independent Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson11Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Write my graph questions and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L12" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics Sort and Display optional center">
            <h2>Edulytics · sort real objects and create a graph</h2>
            <p>Sort 20–30 real objects into three categories, represent the
                actual counts with an original picture OR bar graph,
                ask a partner two questions, and choose a previously
                learned arithmetic center.</p>
            <a class="school-button school-button-primary"
