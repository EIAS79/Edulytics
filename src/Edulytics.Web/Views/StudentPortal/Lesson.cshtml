                   target="_blank" rel="noopener noreferrer">License terms</a>.
            </p>
        }
        else if (Model.LessonCode is { } t001Code
            && t001Code.StartsWith("PED:US-CCSS-MATH:G1:U01:L", StringComparison.Ordinal)
            && int.TryParse(t001Code["PED:US-CCSS-MATH:G1:U01:L".Length..],
                out var t001LessonNumber)
