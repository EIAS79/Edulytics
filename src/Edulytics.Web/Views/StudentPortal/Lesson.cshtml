@model Edulytics.Services.LessonContent.StudentLessonDetail
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.LessonContentResource> L
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.StudentResource> S
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.LessonPracticeResource> P
@using Edulytics.Web.Presentation
@using Edulytics.Web.ViewModels.LessonContent
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = Model.Title;
    var gameAdoptionId = ViewData["GameAdoptionId"] is Guid gameId
        ? gameId
        : (Guid?)null;
    var exactPracticeAdoptionId = ViewData["ExactPracticeAdoptionId"] is Guid exactPracticeId
        ? exactPracticeId
        : (Guid?)null;
    var practiceAdoptionId = ViewData["LessonPracticePilotAdoptionId"] is Guid adoptionId
        ? adoptionId
        : (Guid?)null;
    var unifiedPracticeAdoptionId =
        exactPracticeAdoptionId ??
        gameAdoptionId ??
        practiceAdoptionId;
    ViewData["UseYouTubeStudioV2"] = true;

    var sections = new[]
    {
        new LessonReaderSection("01", L["Explanation"], "explanation", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.Explanation), sectionKind: "explanation")),
        new LessonReaderSection("02", L["KeyConceptsAndRules"], "concepts", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.KeyConceptsAndRules), sectionKind: "concepts")),
        new LessonReaderSection("03", L["WorkedExamples"], "examples", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.WorkedExamples), sectionKind: "examples")),
        new LessonReaderSection("04", L["StepByStepSolutions"], "steps", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.StepByStepSolutions), orderedSteps: true, sectionKind: "steps")),
        new LessonReaderSection("05", L["CommonMistakes"], "mistakes", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.CommonMistakes), sectionKind: "mistakes")),
        new LessonReaderSection("06", L["QuickSummary"], "summary", LessonPresentationParser.Parse(StudentLessonPresentationFilter.Clean(Model.QuickSummary), sectionKind: "summary"))
    };
}
<style>
    .lesson-mode-tabs {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 14px 0 20px;
        padding: 5px;
        border: 1px solid #dbe5ef;
        border-radius: 999px;
        background: #f5f8fb;
    }
    .lesson-mode-tab {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 20px;
        border: 0;
        border-radius: 999px;
        font: inherit;
        font-weight: 800;
        color: #335168;
        background: transparent;
        text-decoration: none;
    }
    .lesson-mode-tab--active {
        color: #fff;
        background: #0b7285;
        box-shadow: 0 5px 14px rgba(11,114,133,.2);
    }
    .lesson-mode-tab--practice {
        cursor: pointer;
        color: #075d6c;
        transition: transform .15s ease, background .15s ease;
    }
    .lesson-mode-tab--practice:hover {
        background: #dff6f8;
        transform: translateY(-1px);
    }
    .lesson-mode-tabs form { margin: 0; }
    @@media (max-width: 520px) {
        .lesson-mode-tabs { display: flex; width: 100%; }
        .lesson-mode-tab, .lesson-mode-tabs form { flex: 1 1 0; }
        .lesson-mode-tab { width: 100%; padding-inline: 12px; }
    }
</style>
<div class="lesson-reader lesson-reader--student">
    <a class="lesson-reader-back" asp-action="Learning"><span aria-hidden="true">←</span> @L["BackToLessons"]</a>

    @if (unifiedPracticeAdoptionId.HasValue)
    {
        <nav class="lesson-mode-tabs" aria-label="@S["Lesson"] / @P["Practice"]">
            <span class="lesson-mode-tab lesson-mode-tab--active" aria-current="page">@S["Lesson"]</span>
            <form asp-controller="StudentPractice" asp-action="StartLessonPractice" method="post">
                @Html.AntiForgeryToken()
                @* A fresh lesson page render is a new user action; do not reuse the CSRF token as the idempotency identity. *@
                <input type="hidden" name="_idempotencyKey" value="@(Guid.NewGuid().ToString("N"))" />
                <input type="hidden" name="curriculumAdoptionId" value="@unifiedPracticeAdoptionId.Value" />
                <input type="hidden" name="lessonId" value="@Model.Id" />
                <button class="lesson-mode-tab lesson-mode-tab--practice" type="submit">@P["Practice"]</button>
            </form>
        </nav>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L01" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original Grade 2 lesson activities">
            <h2>Edulytics · original lesson activities and Cool-down</h2>
            <p>Explore addition and subtraction within 10, create your own
                number-card expressions, and complete an independently authored
                four-task exit ticket. Teacher-reviewed explanations remain
                separate from automatically checked mathematics.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson1Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Grade 2 lesson activities &amp; Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L02" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Original Edulytics ten-cube activities">
            <h2>Edulytics · ten-cube activities and Cool-down</h2>
            <p>Build two-color towers of ten, find hidden cube parts, connect
                addition and subtraction, and answer the independently
                authored end-of-lesson questions.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson2Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open ten-cube activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L03" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics twenty-cube activities">
            <h2>Edulytics · twenty-cube activities and Cool-down</h2>
            <p>Work with two groups of ten, find missing parts of twenty,
            test addition/subtraction equations, and explain your strategy
            using original Edulytics diagrams.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson3Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open twenty-cube activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L04" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics How Close and Cool-down">
            <h2>Edulytics · How Close and Cool-down</h2>
            <p>Use three of five digit cards to get close to twenty,
            solve addition and subtraction problems, and explain a make-ten
            or other valid strategy. Exercises use original Edulytics cards.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson4Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open How Close and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L05" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics How Close with seven cards and sums to 50">
            <h2>Edulytics · How Close to 50 and Cool-down</h2>
            <p>Choose four of seven digit cards, build two two-digit
            numbers, and practice composing tens while adding within 50.
            Use our original Edulytics assessment and teacher rubric.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson5Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open seven-card game and Cool-down</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L06" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics optional Number Puzzles">
            <h2>Edulytics · Number Puzzles center</h2>
            <p>Place digit cards exactly once across a four-equation board,
                practise two-digit sums, and reflect on your choice of center.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson6Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open Number Puzzles and reflection</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L07" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original real classroom survey">
            <h2>Edulytics · collect and organize real classroom data</h2>
            <p>Record anonymous, authentic travel-to-school observations,
                compare the unordered classroom display with a grouped
                pictorial representation, and complete an independently
                authored Cool-down using those same observations.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson7Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open real-class-data activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L08" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Original Edulytics picture graphs and Cool-down">
            <h2>Edulytics · interpreting picture graphs and Cool-down</h2>
            <p>Read first-party child, adult and art-supply pictographs,
                use the one-symbol key to compare categories, and explain
                which questions the graph can and cannot answer.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson8Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open picture graphs and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L09" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original numbered-scale bar graph activities">
            <h2>Edulytics · bar graphs and Cool-down</h2>
            <p>Compare a picture graph to numbered-scale bar graphs,
                write original true class-choice statements, read season
                totals and complete a first-party bar-graph exit ticket.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson9Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open bar-graph activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L10" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original picture and bar graph authoring">
            <h2>Edulytics · make your own picture graph and bar graph</h2>
            <p>Create a picture graph with an original symbol and a key,
                exchange your data table with a partner, draw a correctly
                scaled bar graph, and complete an independently authored
                same-data exit ticket.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson10Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open graph-making activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L11" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics learner-written questions about previous graphs">
            <h2>Edulytics · create and exchange graph questions</h2>
            <p>Revisit the two graphs made in Lesson 10, write four
                original questions (two for each graph), include a
                category-combine or comparison question, and exchange
                answers with a partner. Finish our independent Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson11Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Write my graph questions and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L12" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics Sort and Display optional center">
            <h2>Edulytics · sort real objects and create a graph</h2>
            <p>Sort 20–30 real objects into three categories, represent the
                actual counts with an original picture OR bar graph,
                ask a partner two questions, and choose a previously
                learned arithmetic center.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson12Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open Sort and Display Stage 2
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L13" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original bar graph comparison with counting on and back">
            <h2>Edulytics · compare bar graphs two ways</h2>
            <p>Use first-party pet and dog bar graphs to explain the
                unknown difference by counting ON and counting BACK,
                then write corresponding addition and subtraction equations.
                Finish an independently authored Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson13Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open bar comparison activities and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L14" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics bar graph to tape diagrams">
            <h2>Edulytics · draw tape diagrams to compare</h2>
            <p>Translate source bar-graph comparisons into two labelled,
                aligned rectangular strips. Mark the dashed missing part,
                write inverse equations for both Party Time comparisons,
                and complete a new first-party Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson14Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open tape diagram lessons and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U01:L15" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Edulytics original compare cards with three unknown positions">
            <h2>Edulytics · match Compare stories, tapes and equations</h2>
            <p>Explore unknown smaller, larger and difference in first-party
                rectangular tape diagrams, match each story to MULTIPLE
                equivalent equations, discuss your choice with a partner
                and finish a new Edulytics Cool-down.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson15Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">
                Open compare card sort and Cool-down
            </a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L11" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Original grade2 saree silk ribbon length take-from and start unknown">
            <h2>Edulytics · saree silk ribbon stories</h2>
            <p>Original Priya, Elena and Han take-from ribbon tasks
            with tape diagrams, including Priya's START unknown
            from25 inches cut and38 inches left. Teacher reviews
            source pictures and genuine partner MLR8 explanations.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson45Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open original ribbon stories</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L10" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Original Grade2 torn tape nonzero ruler measurement">
            <h2>Edulytics · measure with a torn tape</h2>
            <p>Use true/false constant differences, Han and Jada's
            same8-inch notebook from different ruler starts, and
            Lin's desktop16→34 short side. Measure genuine objects
            with a partner; teacher checks source long-side image.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson44Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open torn-tape source activities</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L09" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade2 real fish tape lengths in feet and inches">
            <h2>Edulytics · measuring fish floor tapes in feet and inches</h2>
            <p>Use teacher-built source fish tape A2ft B4ft C3ft
            and D2ft6in, repeat genuine12-inch ruler spans,
            compare physical unit counts, and choose the
            right tool for real object length. Grade2 does not
            require abstract unit conversion algorithms.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson43Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open fish measurement center</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L08" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade2 original physical inch tiles and whole inch ruler">
            <h2>Edulytics · what is an inch?</h2>
            <p>Compare actual inch and centimeter rulers,
            estimate and measure classroom objects using real
            inch tiles and rulers, then estimate and measure original
            rectangle/square/triangle sides. First-party numeric
            illustrations never replace teacher-observed measurements.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson42Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open inch measurement</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L07" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Optional Grade2 Stage2 real estimate and measure in centimeters">
            <h2>Edulytics · optional real Estimate and Measure Stage 2</h2>
            <p>Practise original subtract-from37 Number Talk,
            source notebook20/31 example and mathematically
            separate numerical gaps. Genuine object estimate-before-
            measuring in centimeters and center choice require teacher.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson41Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open optional estimation center</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L06" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade2 original reptile length compare-story problems">
            <h2>Edulytics · compare reptiles using centimeter tape diagrams</h2>
            <p>Solve source Lin/Jada62 and19 longer-unknown, and
            Mai/Diego71 and17 smaller-unknown; check genuine
            secret partner choices from two source reptile lists,
            and independently authored digital arithmetic.
            Teacher verifies real tape diagrams and partner MLR8.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson40Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open original reptile comparisons</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L05" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade2 original reptile tape meters and centimeters">
            <h2>Edulytics · measure in meters</h2>
            <p>Practice the original floor tape models for seven
            reptiles, convert centimeters to meterstick lengths and
            explain why a longer tool helps. Source A–G exact tape
            lengths are available; real physical measuring, zero
            alignment and MLR2 discussion need teacher review.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson39Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open reptile-tape meter activities</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L04" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade2 source centimeter estimates and ruler measurement">
            <h2>Edulytics · estimate and measure in centimeters</h2>
            <p>Study original A–D centimeter-ruler images with your teacher,
            estimate real classroom objects, measure from the TRUE zero tick,
            compare estimates, and iterate the ruler on a long object.
            First-party numeric examples are separate from real measurement.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson38Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open centimeter estimation activities</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L03" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Source Grade2 create ruler and compare lengths">
            <h2>Edulytics · create and use a ruler</h2>
            <p>Draw a real 0–25 centimeter ruler using authentic
            one-centimeter cubes to space tick marks. Measure the
            original A–F rectangles with your teacher; the online
            interval and comparison examples are independently authored.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson37Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open centimeter ruler activities</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L02" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Source Grade 2 bearded dragon and centimeter measurement">
            <h2>Edulytics · measure in centimeters</h2>
            <p>Compare centimeter cubes with ten-centimeter
            tools for the original 24cm bearded-dragon drawing.
            Authentic reptile printouts and day-gecko/threadsnake
            difference require teacher measurement; the digital
            extra numbers are original Edulytics examples.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson36Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open centimeter measurement work</a>
        </section>
    }

    @if (Model.LessonCode == "PED:US-CCSS-MATH:G2:U03:L01" &&
         unifiedPracticeAdoptionId.HasValue)
    {
        <section class="student-card" aria-label="Grade2 actual standard units of length source activity">
            <h2>Edulytics · Priya's Pet and standard centimeter units</h2>
            <p>Compare a source forty-centimeter string measured
            in five- and ten-centimeter straws, then with
            uniform one-centimeter cubes. Real physical alignment,
            no gaps or overlaps, and original partner discussion
            remain teacher-observed.</p>
            <a class="school-button school-button-primary"
               asp-controller="Grade2Lesson34Activities" asp-action="Index"
               asp-route-curriculumAdoptionId="@unifiedPracticeAdoptionId.Value"
               asp-route-lessonId="@Model.Id">Open standard-unit measurement</a>
        </section>
    }

