@model Edulytics.Web.ViewModels.StudentPortal.StudentDashboardViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.StudentResource> S
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = S["StudentDashboard"].Value;
    var enrollment = Model.Workspace.Enrollments.FirstOrDefault();
}
<section class="student-hero">
    <div>
        <span class="student-eyebrow">@S["WelcomeBack"]</span>
        <h1>@Model.Workspace.DisplayName</h1>
        <p>@S["DashboardSubtitle"]</p>
    </div>
    <div class="student-profile-pill">
        <span>@S["StudentNumber"]</span>
        <strong>@Model.Workspace.StudentNumber</strong>
    </div>
</section>

<section class="student-summary-grid">
    <article class="student-summary-card">
        <span>@S["TasksToDo"]</span>
        <strong>@Model.ToDoAssessments.Count</strong>
    </article>
    <article class="student-summary-card">
        <span>@S["AwaitingResult"]</span>
        <strong>@(Model.SubmittedOnlineAssessments.Count + Model.AwaitingOfflineResults.Count)</strong>
    </article>
    <article class="student-summary-card">
        <span>@S["CompletedResults"]</span>
        <strong>@Model.Workspace.Results.Count</strong>
    </article>
    <article class="student-summary-card">
        <span>@S["RecentAverage"]</span>
        <strong>@(Model.RecentAverage.HasValue ? $"{Model.RecentAverage.Value:0.#}%" : "—")</strong>
    </article>
    <article class="student-summary-card">
        <span>@S["UnreadNotifications"]</span>
        <strong>@Model.UnreadNotifications</strong>
    </article>
</section>

<section class="student-dashboard-status-grid">
    <article class="student-panel student-dashboard-priority">
        <div class="student-panel-heading">
            <div>
                <span class="student-eyebrow">@S["TasksToDo"]</span>
                <h2>@S["OnlineAssessments"]</h2>
            </div>
            <a class="student-secondary-link" asp-action="Assessments">@S["ViewAssessments"]</a>
        </div>

        @if (Model.ToDoAssessments.Count == 0)
        {
            <p class="student-empty">@S["NoTasksToDo"]</p>
        }
        else
        {
            <div class="student-dashboard-task-list">
                @foreach (var item in Model.ToDoAssessments.Take(5))
                {
                    <article class="student-dashboard-task">
                        <div>
                            <strong>@item.Title</strong>
                            <span>@item.SubjectName · @item.ClassName</span>
                            <small>@S["AssessmentDate"]: @item.AssessmentDate.ToString("yyyy-MM-dd")</small>
                        </div>
                        <a class="student-button student-button-primary"
                           asp-action="TakeAssessment"
                           asp-route-id="@item.AssessmentId">
                            @S["StartAssessment"]
                        </a>
                    </article>
                }
            </div>
        }
    </article>

    <article class="student-panel student-dashboard-priority">
        <div class="student-panel-heading">
            <div>
                <span class="student-eyebrow">@S["AwaitingResult"]</span>
                <h2>@(Model.SubmittedOnlineAssessments.Count + Model.AwaitingOfflineResults.Count)</h2>
            </div>
        </div>

        @if (Model.SubmittedOnlineAssessments.Count == 0 &&
             Model.AwaitingOfflineResults.Count == 0)
        {
            <p class="student-empty">@S["NothingAwaitingResult"]</p>
        }
        else
        {
            <div class="student-compact-list">
                @foreach (var item in Model.SubmittedOnlineAssessments.Take(3))
                {
                    <div>
                        <strong>@item.Title</strong>
                        <span>@S["SubmittedInReview"] · @S["OnlineAssessment"]</span>
                    </div>
                }
                @foreach (var item in Model.AwaitingOfflineResults.Take(3))
                {
                    <div>
                        <strong>@item.Title</strong>
                        <span>@S["WaitingForTeacherResult"] · @S["OfflineAssessment"]</span>
                    </div>
                }
            </div>
        }
    </article>
</section>

<section class="student-dashboard-grid">
    <article class="student-panel student-learning-panel">
        <div class="student-panel-heading">
            <div>
                <span class="student-eyebrow">@S["LearnAndPractice"]</span>
                <h2>@S["MyLearning"]</h2>
            </div>
        </div>

        @if (Model.Workspace.Learning.Count == 0)
        {
            <p class="student-empty">@S["NoLearningYet"]</p>
        }
        else
        {
            <div class="student-subject-chips student-subject-tiles">
                @foreach (var item in Model.Workspace.Learning.Take(6))
                {
                    <a class="student-subject-tile"
                       asp-action="Learning"
                       asp-route-curriculumAdoptionId="@item.CurriculumAdoptionId"
                       asp-route-classGroupId="@item.ClassGroupId"
                       asp-fragment="selected-curriculum-context">
                        <strong>@item.SubjectName</strong>
                        <small>@item.GradeName</small>
                        <small>@item.FrameworkName · @item.ClassName</small>
                        <span aria-hidden="true">→</span>
                    </a>
                }
            </div>
        }
    </article>

    <article class="student-panel student-dashboard-list-panel">
        <div class="student-panel-heading">
            <div>
                <span class="student-eyebrow">@S["CompletedResults"]</span>
                <h2>@S["RecentResults"]</h2>
            </div>
            <a class="student-secondary-link" asp-action="Results">@S["ViewResults"]</a>
        </div>

        @if (Model.RecentResults.Count == 0)
        {
            <p class="student-empty">@S["NoResultsYet"]</p>
        }
        else
        {
            <div class="student-result-stack">
                @foreach (var item in Model.RecentResults)
                {
                    <div>
                        <span>
                            <strong>@item.AssessmentTitle</strong>
                            <small>@item.SubjectName · @item.AssessmentDate.ToString("yyyy-MM-dd")</small>
                        </span>
                        <strong>@item.Percentage.ToString("0.##")%</strong>
                    </div>
                }
            </div>
        }
    </article>
</section>

