@using System.Globalization
@model Edulytics.Web.ViewModels.StudentPortal.StudentDashboardViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.StudentResource> S
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = S["StudentDashboard"].Value;

    var awaitingResultCount =
        Model.SubmittedOnlineAssessments.Count +
        Model.AwaitingOfflineResults.Count;

    var recentAverage =
        Math.Clamp(Model.RecentAverage ?? 0m, 0m, 100m);

    var recentAverageCss =
        recentAverage.ToString(
            "0.##",
            CultureInfo.InvariantCulture);
}

<section class="student-hero student-dashboard-hero">
    <div>
        <span class="student-eyebrow">@S["WelcomeBack"]</span>
        <h1>@Model.Workspace.DisplayName</h1>
        <p>@S["DashboardSubtitle"]</p>
    </div>
    <div class="student-profile-pill">
        <span>@S["StudentNumber"]</span>
        <strong>@Model.Workspace.StudentNumber</strong>
    </div>
</section>

<section class="student-dashboard-overview-grid">
    <article class="student-panel student-progress-overview">
        <div class="student-panel-heading student-progress-heading">
            <div>
                <span class="student-eyebrow">@S["RecentResults"]</span>
                <h2>@S["RecentAverage"]</h2>
            </div>
            <a class="student-secondary-link"
               asp-action="Results">
                @S["ViewResults"]
            </a>
        </div>

        <div class="student-progress-overview-body">
            <div class="student-average-donut-wrap">
                <div class="student-average-donut"
                     style="--student-average:@recentAverageCss"
                     role="img"
                     aria-label="@S["RecentAverage"]: @(Model.RecentAverage.HasValue ? $"{Model.RecentAverage.Value:0.#}%" : "—")">
                    <div class="student-average-donut-center">
                        <strong>@(Model.RecentAverage.HasValue ? $"{Model.RecentAverage.Value:0.#}%" : "—")</strong>
                        <span>@S["RecentAverage"]</span>
                    </div>
                </div>
            </div>

            <div class="student-dashboard-stat-grid">
                <article class="student-dashboard-stat">
                    <span>@S["TasksToDo"]</span>
                    <strong>@Model.ToDoAssessments.Count</strong>
                </article>
                <article class="student-dashboard-stat">
                    <span>@S["CompletedResults"]</span>
                    <strong>@Model.Workspace.Results.Count</strong>
                </article>
                <article class="student-dashboard-stat">
                    <span>@S["UnreadNotifications"]</span>
                    <strong>@Model.UnreadNotifications</strong>
                </article>
            </div>
        </div>
    </article>

    <article class="student-panel student-awaiting-panel">
        <div class="student-panel-heading">
            <div>
                <span class="student-eyebrow">@S["AssessmentStatus"]</span>
                <h2>@S["AwaitingResult"]</h2>
            </div>
            <span class="student-awaiting-count"
                  aria-label="@S["AwaitingResult"]: @awaitingResultCount">
                @awaitingResultCount
            </span>
        </div>

        @if (awaitingResultCount == 0)
        {
            <p class="student-empty">@S["NothingAwaitingResult"]</p>
        }
        else
        {
            <div class="student-awaiting-list">
                @foreach (var item in Model.SubmittedOnlineAssessments.Take(2))
                {
                    <div class="student-awaiting-item">
                        <span class="student-awaiting-dot" aria-hidden="true"></span>
                        <span>
                            <strong>@item.Title</strong>
                            <small>@S["SubmittedInReview"] · @S["OnlineAssessment"]</small>
                        </span>
                    </div>
                }

                @foreach (var item in Model.AwaitingOfflineResults.Take(2))
                {
                    <div class="student-awaiting-item">
                        <span class="student-awaiting-dot" aria-hidden="true"></span>
                        <span>
                            <strong>@item.Title</strong>
                            <small>@S["WaitingForTeacherResult"] · @S["OfflineAssessment"]</small>
                        </span>
                    </div>
                }
            </div>
        }

        <a class="student-panel-text-link"
           asp-action="Assessments">
            @S["ViewAssessments"] <span aria-hidden="true">→</span>
        </a>
    </article>
</section>

@if (Model.Evaluation is not null)
{
    var evaluation = Model.Evaluation;
    var official = evaluation.OfficialEvaluation;

    <section class="student-panel student-dashboard-evaluation-card">
        <div class="student-panel-heading">
            <div>
                <span class="student-eyebrow">@S["MyEvaluation"]</span>
                <h2>@official.SubjectName · @S["MyProgress"]</h2>
            </div>
            <a class="student-secondary-link"
               asp-action="Progress"
               asp-route-academicYearId="@official.AcademicYearId"
               asp-route-classGroupId="@official.ClassGroupId"
               asp-route-subjectId="@official.SubjectId">
                @S["OpenFullEvaluation"]
            </a>
        </div>

        <div class="student-dashboard-evaluation-grid">
            <div>
                <span>@S["CurrentMastery"]</span>
                <strong>@(official.CurrentMasteryPercentage.HasValue ? $"{official.CurrentMasteryPercentage.Value:0.#}%" : "—")</strong>
            </div>
            <div>
                <span>@S["AssessmentMastery"]</span>
                <strong>@(official.AssessmentMasteryPercentage.HasValue ? $"{official.AssessmentMasteryPercentage.Value:0.#}%" : "—")</strong>
            </div>
            <div>
                <span>@S["PrivatePracticeMastery"]</span>
                <strong>@(evaluation.PrivatePractice.MasteryPercentage.HasValue ? $"{evaluation.PrivatePractice.MasteryPercentage.Value:0.#}%" : "—")</strong>
            </div>
            <div>
                <span>@S["CurriculumCoverage"]</span>
                <strong>@official.CurriculumCoveragePercentage.ToString("0.#")%</strong>
            </div>
            <div>
                <span>@S["SkillsToStrengthen"]</span>
                <strong>@official.CriticalSkillCount</strong>
                <small>@official.NeedsFocusSkillCount @S["NeedsFocus"].Value.ToLowerInvariant()</small>
            </div>
        </div>
    </section>
}

<section class="student-dashboard-content-grid">
    <article class="student-panel student-dashboard-priority student-dashboard-list-panel">
        <div class="student-panel-heading">
            <div>
                <span class="student-eyebrow">@S["TasksToDo"]</span>
                <h2>@S["OnlineAssessments"]</h2>
            </div>
            <a class="student-secondary-link"
               asp-action="Assessments">
                @S["ViewAssessments"]
            </a>
        </div>

        @if (Model.ToDoAssessments.Count == 0)
        {
            <div class="student-dashboard-empty-callout">
                <span class="student-dashboard-empty-icon" aria-hidden="true">✓</span>
                <p class="student-empty">@S["NoTasksToDo"]</p>
            </div>
        }
        else
        {
            <div class="student-dashboard-task-list">
                @foreach (var item in Model.ToDoAssessments)
                {
                    <article class="student-dashboard-task">
                        <div>
                            <strong>@item.Title</strong>
                            <span>@item.SubjectName · @item.ClassName</span>
                            <small>@S["AssessmentDate"]: @item.AssessmentDate.ToString("yyyy-MM-dd")</small>
                        </div>
                        <a class="student-button student-button-primary"
                           asp-action="TakeAssessment"
                           asp-route-id="@item.AssessmentId">
                            @S["StartAssessment"]
                        </a>
                    </article>
                }
            </div>
        }
    </article>

    <article class="student-panel student-dashboard-list-panel">
        <div class="student-panel-heading">
            <div>
                <span class="student-eyebrow">@S["CompletedResults"]</span>
                <h2>@S["RecentResults"]</h2>
            </div>
            <a class="student-secondary-link"
               asp-action="Results">
                @S["ViewResults"]
            </a>
        </div>

        @if (Model.RecentResults.Count == 0)
        {
            <p class="student-empty">@S["NoResultsYet"]</p>
        }
        else
        {
            <div class="student-result-stack student-result-stack-modern">
                @foreach (var item in Model.RecentResults)
                {
                    <div class="student-result-row">
                        <span class="student-result-copy">
                            <strong>@item.AssessmentTitle</strong>
                            <small>@item.SubjectName · @item.AssessmentDate.ToString("yyyy-MM-dd")</small>
                        </span>
                        <span class="student-result-score">
                            @item.Percentage.ToString("0.##")%
                        </span>
                    </div>
                }
            </div>
        }
    </article>
</section>

<section class="student-panel student-learning-panel student-learning-panel-wide">
    <div class="student-panel-heading">
        <div>
            <span class="student-eyebrow">@S["LearnAndPractice"]</span>
            <h2>@S["MyLearning"]</h2>
        </div>
    </div>

    @if (Model.Workspace.Learning.Count == 0)
    {
        <p class="student-empty">@S["NoLearningYet"]</p>
    }
    else
    {
        <div class="student-subject-chips student-subject-tiles student-subject-tiles-dashboard">
            @foreach (var item in Model.Workspace.Learning.Take(6))
            {
                <a class="student-subject-tile"
                   asp-action="Learning"
                   asp-route-curriculumAdoptionId="@item.CurriculumAdoptionId"
                   asp-route-classGroupId="@item.ClassGroupId"
                   asp-fragment="selected-curriculum-context">
                    <span class="student-subject-tile-copy">
                        <strong>@item.SubjectName</strong>
                        <small>@item.GradeName</small>
                        <small>@item.FrameworkName · @item.ClassName</small>
                    </span>
                    <span class="student-subject-tile-arrow" aria-hidden="true">→</span>
                </a>
            }
        </div>
    }
</section>
