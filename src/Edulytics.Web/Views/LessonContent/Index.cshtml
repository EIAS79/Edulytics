@model Edulytics.Web.ViewModels.LessonContent.LessonContentIndexViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Edulytics.Web.LessonContentResource> L
@using Edulytics.Core.Enums
@{
    Layout = "_AppLayout";
    ViewData["Title"] = L["PageTitle"].Value;

    var options = Model.Dashboard.Options;
    var years = options
        .GroupBy(x => new { x.AcademicYearId, x.AcademicYearName })
        .Select(x => x.Key)
        .OrderByDescending(x => x.AcademicYearName)
        .ToArray();
    var programs = options
        .GroupBy(x => new
        {
            x.AcademicYearId,
            x.AcademicProgramId,
            x.AcademicProgramName,
            x.AcademicProgramCode
        })
        .Select(x => x.Key)
        .OrderBy(x => x.AcademicProgramName)
        .ToArray();
}

<div class="lesson-library">
    <header class="lesson-library-hero">
        <div class="lesson-library-hero__copy">
            <p class="lesson-library-eyebrow">@L["CanonicalLibrary"]</p>
            <h1>@L["PageTitle"]</h1>
            <p class="lesson-library-hero__subtitle">@L["PageSubtitle"]</p>
        </div>

        <div class="lesson-library-hero__mark" aria-hidden="true">
            <span>∑</span>
        </div>
    </header>

    <div class="lesson-library-notice">
        <span class="lesson-library-notice__icon" aria-hidden="true">i</span>
        <span>@L["CanonicalNotice"]</span>
    </div>

    @if (options.Count == 0)
    {
        <div class="lesson-content-empty">
            @L["NoAdoptedCurricula"]
        </div>
    }
    else
    {
        <form method="get"
              asp-controller="LessonContent"
              asp-action="Index"
              class="lesson-content-filter app-surface-card"
              id="lessonContentFilter">
            <div class="lesson-content-filter__field">
                <span class="lesson-content-filter__step" aria-hidden="true">1</span>
                <label for="academicYearId">@L["AcademicYear"]</label>
                <select id="academicYearId" name="academicYearId" class="lesson-content-select" required>
                    <option value="">@L["SelectAcademicYear"]</option>
                    @foreach (var year in years)
                    {
                        <option value="@year.AcademicYearId"
                                selected="@(Model.Dashboard.SelectedAcademicYearId == year.AcademicYearId ? "selected" : null)">
                            @year.AcademicYearName
                        </option>
                    }
                </select>
            </div>

            <div class="lesson-content-filter__field">
                <span class="lesson-content-filter__step" aria-hidden="true">2</span>
                <label for="academicProgramId">@L["ProgramStream"]</label>
                <select id="academicProgramId" name="academicProgramId" class="lesson-content-select" required>
                    <option value="">@L["SelectProgramStream"]</option>
                    @foreach (var program in programs)
                    {
                        <option value="@program.AcademicProgramId"
                                data-year="@program.AcademicYearId"
                                selected="@(Model.Dashboard.SelectedAcademicYearId == program.AcademicYearId && Model.Dashboard.SelectedAcademicProgramId == program.AcademicProgramId ? "selected" : null)">
                            @program.AcademicProgramName
                        </option>
                    }
                </select>
            </div>

            <div class="lesson-content-filter__field">
                <span class="lesson-content-filter__step" aria-hidden="true">3</span>
                <label for="curriculumAdoptionId">@L["CurriculumLevel"]</label>
                <select id="curriculumAdoptionId" name="curriculumAdoptionId" class="lesson-content-select" required>
                    <option value="">@L["SelectCurriculumLevel"]</option>
                    @foreach (var option in options)
                    {
                        var pathway = string.IsNullOrWhiteSpace(option.CurriculumPathway)
                            ? string.Empty
                            : $" — {option.CurriculumPathway}";
                        <option value="@option.CurriculumAdoptionId"
                                data-year="@option.AcademicYearId"
                                data-program="@option.AcademicProgramId"
                                selected="@(Model.Dashboard.SelectedCurriculumAdoptionId == option.CurriculumAdoptionId ? "selected" : null)">
                            @option.FrameworkName — @option.CurriculumLevelLabel@pathway
                        </option>
                    }
                </select>
            </div>

            <div class="lesson-content-filter__action">
                <button type="submit" class="school-button school-button-primary">
                    @L["ShowLessons"]
                </button>
            </div>
        </form>

        @if (!Model.Dashboard.SelectedCurriculumAdoptionId.HasValue)
        {
            <div class="lesson-content-empty lesson-content-empty--prompt">
                @L["ChooseContextPrompt"]
            </div>
        }
        else if (Model.Dashboard.Curricula.Count == 0)
        {
            <div class="lesson-content-empty">
                @L["NoCanonicalLessons"]
            </div>
        }
        else
        {
            <div class="lesson-content-topic-stack">
                @foreach (var group in Model.Dashboard.Curricula)
                {
                    var supportingCount = group.Lessons.Count(x => x.IsSupporting);

                    <section class="lesson-content-topic-card">
                        <header class="lesson-content-topic-card__header">
                            <div class="lesson-content-topic-card__identity">
                                <span class="student-subject-code">@group.SubjectCode</span>
                                <div>
                                    <h2>@group.FrameworkName</h2>
                                    <div class="lesson-content-meta">
                                        <span>@L["AcademicYear"]: <strong>@group.AcademicYearName</strong></span>
                                        <span>@L["ProgramStream"]: <strong>@group.AcademicProgramName</strong></span>
                                        <span>@L["CurriculumLevel"]: <strong>@group.CurriculumLevelLabel</strong></span>
                                        @if (!string.IsNullOrWhiteSpace(group.CurriculumPathway))
                                        {
                                            <span>@L["Pathway"]: <strong>@group.CurriculumPathway</strong></span>
                                        }
                                        <span>@L["Version"]: <strong>@group.FrameworkVersionName</strong></span>
                                    </div>
                                </div>
                            </div>
                        </header>

                        <div class="lesson-content-metrics">
                            <div class="lesson-content-metric">
                                <span class="lesson-content-metric__value">@group.TotalLessons</span>
                                <span class="lesson-content-metric__label">@L["TotalLessons"]</span>
                            </div>
                            <div class="lesson-content-metric">
                                <span class="lesson-content-metric__value">@group.ProductionReadyLessons</span>
                                <span class="lesson-content-metric__label">@L["ProductionReady"]</span>
                            </div>
                            <div class="lesson-content-metric lesson-content-metric--supporting">
                                <span class="lesson-content-metric__value">@supportingCount</span>
                                <span class="lesson-content-metric__label">@L["SupportingLessons"]</span>
                            </div>
                        </div>

                        @if (group.Lessons.Count == 0)
                        {
                            <p class="lesson-content-empty">@L["NoCanonicalLessons"]</p>
                        }
                        else
                        {
                            <div class="lesson-content-list" role="list">
                                @foreach (var lesson in group.Lessons)
                                {
                                    var isSupporting = lesson.IsSupporting;
                                    var statusText = isSupporting
                                        ? L["SupportingLesson"].Value
                                        : lesson.Status switch
                                        {
                                            CanonicalLessonContentStatus.Draft => L["InPreparation"].Value,
                                            CanonicalLessonContentStatus.Verified => L["Verified"].Value,
                                            CanonicalLessonContentStatus.Published => L["PublishedLesson"].Value,
                                            _ => L["NotStarted"].Value
                                        };
                                    var statusClass = isSupporting
                                        ? "supporting"
                                        : lesson.Status switch
                                        {
                                            CanonicalLessonContentStatus.Draft => "draft",
                                            CanonicalLessonContentStatus.Verified => "verified",
                                            CanonicalLessonContentStatus.Published => "published",
                                            _ => "notstarted"
                                        };

                                    <a class="lesson-content-row @(isSupporting ? "lesson-content-row--supporting" : "")"
                                       role="listitem"
                                       asp-controller="LessonContent"
                                       asp-action="Detail"
                                       asp-route-id="@lesson.LessonId"
                                       asp-route-academicYearId="@Model.Dashboard.SelectedAcademicYearId"
                                       asp-route-academicProgramId="@Model.Dashboard.SelectedAcademicProgramId"
                                       asp-route-curriculumAdoptionId="@Model.Dashboard.SelectedCurriculumAdoptionId">
                                        <span class="lesson-content-row__order">@lesson.SortOrder</span>
                                        <span class="lesson-content-row__title">
                                            @lesson.LessonTitle
                                            @if (!string.IsNullOrWhiteSpace(lesson.UnitTitle))
                                            {
                                                <small>@lesson.UnitTitle</small>
                                            }
                                        </span>
                                        <span class="lesson-content-status lesson-content-status--@statusClass">@statusText</span>
                                        @if (isSupporting)
                                        {
                                            <span class="lesson-content-row__support"
                                                  title="@L["SupportingLessonHelp"]"
                                                  aria-label="@L["SupportingLessonHelp"]">i</span>
                                        }
                                        else
                                        {
                                            <span class="lesson-content-row__chevron" aria-hidden="true">→</span>
                                        }
                                    </a>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
    }
</div>

<script>
(() => {
    const year = document.getElementById('academicYearId');
    const program = document.getElementById('academicProgramId');
    const adoption = document.getElementById('curriculumAdoptionId');
    if (!year || !program || !adoption) return;

    const filter = () => {
        const yearValue = year.value;
        const programValue = program.value;

        for (const option of program.options) {
            if (!option.value) continue;
            option.disabled = !!yearValue && option.dataset.year !== yearValue;
        }
        if (program.selectedOptions.length && program.selectedOptions[0].disabled) {
            program.value = '';
        }

        for (const option of adoption.options) {
            if (!option.value) continue;
            option.disabled =
                (!!yearValue && option.dataset.year !== yearValue) ||
                (!!program.value && option.dataset.program !== program.value);
        }
        if (adoption.selectedOptions.length && adoption.selectedOptions[0].disabled) {
            adoption.value = '';
        }
    };

    year.addEventListener('change', filter);
    program.addEventListener('change', filter);
    filter();
})();
</script>
