@using System.Globalization
@{
    Layout = "_PublicLayout";
    var polish = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "pl", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = polish ? "Umowa powierzenia przetwarzania danych" : "Data Processing Agreement";
    string L(string en, string pl) => polish ? pl : en;
}

<div class="ed-home ed-legal-page">
    <partial name="_PublicSiteHeader" />

    <main class="ed-legal-shell">
        <header class="ed-legal-hero">
            <span class="ed-legal-eyebrow">@L("Legal", "Informacje prawne")</span>
            <h1 class="ed-legal-default">@L("Data Processing Agreement", "Umowa powierzenia przetwarzania danych")</h1>
            <h1 class="ed-legal-ar">اتفاقية معالجة البيانات</h1>
            <p class="ed-legal-default">@L("Standard data-processing terms for school customers using Edulytics.", "Standardowe warunki przetwarzania danych dla szkół korzystających z Edulytics.")</p>
            <p class="ed-legal-ar">الشروط القياسية لمعالجة البيانات لعملاء المدارس الذين يستخدمون Edulytics.</p>
        </header>

        <article class="ed-legal-document ed-legal-default">
            <section>
                <p>@L("This Data Processing Agreement (DPA) applies where it is incorporated into or accepted as part of the agreement between the school or educational organisation (the Controller) and OUR-CS Sp. z o.o. (the Processor) concerning the use of Edulytics.", "Niniejsza umowa powierzenia przetwarzania danych (DPA) ma zastosowanie, gdy zostanie włączona do umowy lub zaakceptowana jako część umowy pomiędzy szkołą lub organizacją edukacyjną (Administratorem) a OUR-CS Sp. z o.o. (Podmiotem przetwarzającym) dotyczącej korzystania z Edulytics.")</p>
            </section>
            <section><h2>@L("1. Subject matter", "1. Przedmiot przetwarzania")</h2><p>@L("The Processor processes personal data only as necessary to provide Edulytics and related services to the Controller.", "Podmiot przetwarzający przetwarza dane osobowe wyłącznie w zakresie niezbędnym do świadczenia Edulytics i usług powiązanych na rzecz Administratora.")</p></section>
            <section><h2>@L("2. Duration", "2. Czas trwania")</h2><p>@L("Processing continues for the duration of the school's use of Edulytics and for any additional period necessary to complete agreed data return, deletion, legal, accounting, security or dispute-related obligations.", "Przetwarzanie trwa przez okres korzystania przez szkołę z Edulytics oraz przez dodatkowy okres niezbędny do wykonania uzgodnionego zwrotu lub usunięcia danych oraz obowiązków prawnych, księgowych, bezpieczeństwa lub związanych ze sporami.")</p></section>
            <section><h2>@L("3. Nature and purpose of processing", "3. Charakter i cel przetwarzania")</h2><p>@L("Processing may include collection, recording, organisation, storage, retrieval, consultation, analysis, calculation, transmission where necessary, restriction and deletion. Purposes may include account administration, educational assessment, curriculum delivery, student learning analysis, progress and mastery measurement, diagnostic and adaptive learning, reporting, security and technical support.", "Przetwarzanie może obejmować zbieranie, utrwalanie, organizowanie, przechowywanie, pobieranie, przeglądanie, analizę, obliczanie, przekazywanie w niezbędnym zakresie, ograniczanie i usuwanie. Cele mogą obejmować zarządzanie kontami, ocenianie edukacyjne, realizację programu nauczania, analizę uczenia się uczniów, pomiar postępów i opanowania materiału, nauczanie diagnostyczne i adaptacyjne, raportowanie, bezpieczeństwo i wsparcie techniczne.")</p></section>
            <section><h2>@L("4. Categories of data subjects", "4. Kategorie osób, których dane dotyczą")</h2><p>@L("Data subjects may include students, teachers, school administrators, subject supervisors and other authorised school staff.", "Osobami, których dane dotyczą, mogą być uczniowie, nauczyciele, administratorzy szkolni, koordynatorzy przedmiotowi i inni upoważnieni pracownicy szkoły.")</p></section>
            <section><h2>@L("5. Types of personal data", "5. Rodzaje danych osobowych")</h2><p>@L("Personal data may include names, email addresses, user identifiers, school and class information, account roles, curriculum data, assessment questions and responses, assessment results, learning outcomes, mastery and confidence indicators, learning activity, and technical or audit records.", "Dane osobowe mogą obejmować imiona i nazwiska, adresy e-mail, identyfikatory użytkowników, informacje o szkole i klasie, role kont, dane programowe, pytania i odpowiedzi w ocenianiu, wyniki oceniania, efekty uczenia się, wskaźniki opanowania i pewności, aktywność edukacyjną oraz zapisy techniczne lub audytowe.")</p></section>
            <section><h2>@L("6. Controller instructions", "6. Polecenia Administratora")</h2><p>@L("The Processor processes personal data only on documented instructions from the Controller unless processing is required by applicable law. If the Processor believes an instruction infringes applicable data-protection law, it will inform the Controller unless legally prohibited from doing so.", "Podmiot przetwarzający przetwarza dane osobowe wyłącznie na udokumentowane polecenie Administratora, chyba że przetwarzanie jest wymagane przez obowiązujące prawo. Jeżeli Podmiot przetwarzający uzna, że polecenie narusza przepisy o ochronie danych, poinformuje Administratora, chyba że prawo zabrania takiego powiadomienia.")</p></section>
            <section><h2>@L("7. Confidentiality", "7. Poufność")</h2><p>@L("Persons authorised to process personal data are subject to appropriate confidentiality obligations or an appropriate statutory duty of confidentiality.", "Osoby upoważnione do przetwarzania danych osobowych podlegają odpowiednim zobowiązaniom do zachowania poufności lub właściwemu ustawowemu obowiązkowi poufności.")</p></section>
            <section><h2>@L("8. Security", "8. Bezpieczeństwo")</h2><p>@L("The Processor implements technical and organisational measures designed to provide a level of security appropriate to the risk. Measures may include access controls, authentication, role-based permissions, logging and monitoring, encryption in transit, security testing, vulnerability analysis, backup and recovery processes, and controlled administrative access.", "Podmiot przetwarzający wdraża środki techniczne i organizacyjne mające zapewnić poziom bezpieczeństwa odpowiedni do ryzyka. Środki mogą obejmować kontrolę dostępu, uwierzytelnianie, uprawnienia oparte na rolach, rejestrowanie i monitorowanie, szyfrowanie transmisji, testy bezpieczeństwa, analizę podatności, procedury kopii zapasowych i odtwarzania oraz kontrolowany dostęp administracyjny.")</p></section>
            <section><h2>@L("9. Other processors", "9. Dalsze podmioty przetwarzające")</h2><p>@L("The Controller authorises the Processor to use other processors where necessary to provide, secure and operate Edulytics, subject to applicable data-protection law and the commercial agreement. The Processor ensures that such providers are bound by appropriate data-protection obligations. Relevant information about such processing is made available to the Controller where required by law or contract.", "Administrator upoważnia Podmiot przetwarzający do korzystania z dalszych podmiotów przetwarzających, gdy jest to niezbędne do świadczenia, zabezpieczenia i obsługi Edulytics, z zastrzeżeniem obowiązujących przepisów o ochronie danych oraz umowy handlowej. Podmiot przetwarzający zapewnia, że dostawcy ci są związani odpowiednimi obowiązkami w zakresie ochrony danych. Wymagane prawem lub umową informacje dotyczące takiego przetwarzania są udostępniane Administratorowi.")</p></section>
            <section><h2>@L("10. International transfers", "10. Przekazywanie danych poza EOG")</h2><p>@L("The Processor does not transfer personal data outside the European Economic Area without applying a lawful transfer mechanism where required by applicable data-protection law.", "Podmiot przetwarzający nie przekazuje danych osobowych poza Europejski Obszar Gospodarczy bez zastosowania zgodnego z prawem mechanizmu przekazywania, jeżeli jest on wymagany przez obowiązujące przepisy o ochronie danych.")</p></section>
            <section><h2>@L("11. Assistance with data-subject rights", "11. Wsparcie w realizacji praw osób")</h2><p>@L("Taking into account the nature of the processing, the Processor provides reasonable assistance to the Controller in responding to requests relating to data-subject rights.", "Uwzględniając charakter przetwarzania, Podmiot przetwarzający udziela Administratorowi rozsądnego wsparcia w odpowiadaniu na żądania dotyczące praw osób, których dane dotyczą.")</p></section>
            <section><h2>@L("12. Personal-data breaches", "12. Naruszenia ochrony danych")</h2><p>@L("The Processor notifies the Controller without undue delay after becoming aware of a personal-data breach affecting data processed on behalf of the Controller and provides available information reasonably necessary for the Controller to meet its legal obligations.", "Podmiot przetwarzający zawiadamia Administratora bez zbędnej zwłoki po stwierdzeniu naruszenia ochrony danych osobowych dotyczącego danych przetwarzanych w imieniu Administratora i przekazuje dostępne informacje rozsądnie niezbędne do realizacji obowiązków prawnych Administratora.")</p></section>
            <section><h2>@L("13. Data-protection impact assessments", "13. Oceny skutków dla ochrony danych")</h2><p>@L("Where reasonably required and taking into account the nature of the processing, the Processor assists the Controller with information necessary for data-protection impact assessments and related consultations.", "W rozsądnie wymaganym zakresie i z uwzględnieniem charakteru przetwarzania Podmiot przetwarzający wspiera Administratora informacjami niezbędnymi do przeprowadzenia ocen skutków dla ochrony danych i związanych z nimi konsultacji.")</p></section>
            <section><h2>@L("14. Return and deletion", "14. Zwrot i usunięcie danych")</h2><p>@L("At the end of the service, the Processor, according to the Controller's instructions and applicable law, returns personal data, makes an appropriate export available and/or deletes personal data. This does not apply to data that must be retained under applicable law.", "Po zakończeniu świadczenia usługi Podmiot przetwarzający, zgodnie z poleceniami Administratora i obowiązującym prawem, zwraca dane osobowe, udostępnia odpowiedni eksport i/lub usuwa dane osobowe. Nie dotyczy to danych, których dalsze przechowywanie jest wymagane przez obowiązujące prawo.")</p></section>
            <section><h2>@L("15. Information and audits", "15. Informacje i audyty")</h2><p>@L("The Processor makes available information reasonably necessary to demonstrate compliance with its data-processing obligations. Any audit arrangement must reasonably account for security, confidentiality, operational impact and the protection of other customers' information.", "Podmiot przetwarzający udostępnia informacje rozsądnie niezbędne do wykazania zgodności z obowiązkami dotyczącymi przetwarzania danych. Ustalenia audytowe muszą w rozsądny sposób uwzględniać bezpieczeństwo, poufność, wpływ operacyjny oraz ochronę informacji innych klientów.")</p></section>
            <section><h2>@L("16. Liability and governing terms", "16. Odpowiedzialność i warunki nadrzędne")</h2><p>@L("Liability, commercial terms and governing-law provisions are subject to the main service agreement except where mandatory data-protection law requires otherwise.", "Odpowiedzialność, warunki handlowe i prawo właściwe podlegają głównej umowie o świadczenie usługi, chyba że bezwzględnie obowiązujące przepisy o ochronie danych stanowią inaczej.")</p></section>
            <section class="ed-legal-contact-card"><h2>@L("17. Contact", "17. Kontakt")</h2><p><strong>OUR-CS Sp. z o.o.</strong><br />Aleje Jerozolimskie 81, lok. 7.10<br />02-001 Warszawa, Poland</p><p><strong>@L("Data-protection enquiries:", "Zapytania dotyczące ochrony danych:")</strong> <a href="/contact/message">info@our-cs.com</a></p></section>
        </article>

        <article class="ed-legal-document ed-legal-ar" lang="ar" dir="rtl">
            <section><p>تنطبق اتفاقية معالجة البيانات هذه عندما يتم إدراجها في الاتفاقية أو قبولها كجزء من الاتفاقية بين المدرسة أو المؤسسة التعليمية بصفتها المتحكم في البيانات وبين OUR-CS Sp. z o.o. بصفتها معالج البيانات فيما يتعلق باستخدام Edulytics.</p></section>
            <section><h2>1. موضوع المعالجة</h2><p>يعالج معالج البيانات البيانات الشخصية فقط بالقدر اللازم لتقديم Edulytics والخدمات المرتبطة بها للمتحكم.</p></section>
            <section><h2>2. المدة</h2><p>تستمر المعالجة طوال مدة استخدام المدرسة لـ Edulytics وأي مدة إضافية لازمة لاستكمال إعادة البيانات أو حذفها أو تنفيذ الالتزامات القانونية أو المحاسبية أو الأمنية أو المتعلقة بالنزاعات.</p></section>
            <section><h2>3. طبيعة المعالجة وغرضها</h2><p>قد تشمل المعالجة الجمع والتسجيل والتنظيم والتخزين والاسترجاع والاطلاع والتحليل والحساب والنقل عند الضرورة والتقييد والحذف. وقد تشمل الأغراض إدارة الحسابات والتقييم التعليمي وتقديم المناهج وتحليل تعلّم الطلاب وقياس التقدم والإتقان والتعلّم التشخيصي والتكيفي والتقارير والأمان والدعم التقني.</p></section>
            <section><h2>4. فئات أصحاب البيانات</h2><p>قد تشمل الطلاب والمعلمين ومسؤولي المدارس ومشرفي المواد وغيرهم من موظفي المدرسة المصرح لهم.</p></section>
            <section><h2>5. أنواع البيانات الشخصية</h2><p>قد تشمل الأسماء وعناوين البريد الإلكتروني ومعرفات المستخدم ومعلومات المدرسة والفصل وأدوار الحساب وبيانات المنهج وأسئلة التقييم وإجاباته ونتائجه ونتائج التعلّم ومؤشرات الإتقان والثقة والنشاط التعليمي والسجلات التقنية أو سجلات التدقيق.</p></section>
            <section><h2>6. تعليمات المتحكم</h2><p>يعالج المعالج البيانات فقط وفق تعليمات موثقة من المتحكم ما لم يفرض القانون معالجة معينة. وإذا رأى المعالج أن تعليمات ما تخالف قانون حماية البيانات، فسيبلغ المتحكم ما لم يمنعه القانون من ذلك.</p></section>
            <section><h2>7. السرية</h2><p>يخضع الأشخاص المصرح لهم بمعالجة البيانات لالتزامات مناسبة بالسرية أو لواجب قانوني مناسب بالحفاظ عليها.</p></section>
            <section><h2>8. الأمان</h2><p>يطبق المعالج تدابير تقنية وتنظيمية تهدف إلى توفير مستوى أمان مناسب للمخاطر، وقد تشمل ضوابط الوصول والمصادقة والصلاحيات حسب الدور والتسجيل والمراقبة وتشفير الاتصالات واختبارات الأمان وتحليل الثغرات والنسخ الاحتياطي والاستعادة والتحكم في الوصول الإداري.</p></section>
            <section><h2>9. معالجون آخرون</h2><p>يفوض المتحكم المعالج باستخدام معالجين آخرين عند الضرورة لتقديم Edulytics وتأمينها وتشغيلها، وفق قانون حماية البيانات والاتفاقية التجارية. ويلتزم المعالج بضمان خضوع هؤلاء المزودين لالتزامات مناسبة لحماية البيانات، كما يتيح للمتحكم المعلومات ذات الصلة عندما يتطلب القانون أو العقد ذلك.</p></section>
            <section><h2>10. النقل الدولي</h2><p>لا ينقل المعالج البيانات الشخصية خارج المنطقة الاقتصادية الأوروبية دون تطبيق آلية نقل قانونية عندما يتطلب قانون حماية البيانات ذلك.</p></section>
            <section><h2>11. المساعدة في حقوق أصحاب البيانات</h2><p>مع مراعاة طبيعة المعالجة، يقدم المعالج مساعدة معقولة للمتحكم للاستجابة للطلبات المتعلقة بحقوق أصحاب البيانات.</p></section>
            <section><h2>12. خروقات البيانات الشخصية</h2><p>يبلغ المعالج المتحكم دون تأخير غير مبرر بعد علمه بخرق للبيانات الشخصية التي يعالجها نيابةً عن المتحكم، ويقدم المعلومات المتاحة اللازمة بصورة معقولة لمساعدة المتحكم على الوفاء بالتزاماته القانونية.</p></section>
            <section><h2>13. تقييمات الأثر على حماية البيانات</h2><p>عند الحاجة المعقولة وبالنظر إلى طبيعة المعالجة، يقدم المعالج للمتحكم المعلومات اللازمة لتقييمات الأثر والمشاورات المرتبطة بها.</p></section>
            <section><h2>14. إعادة البيانات وحذفها</h2><p>عند انتهاء الخدمة، ووفق تعليمات المتحكم والقانون المطبق، يعيد المعالج البيانات أو يتيح تصديرًا مناسبًا لها و/أو يحذفها، باستثناء البيانات التي يفرض القانون الاحتفاظ بها.</p></section>
            <section><h2>15. المعلومات والتدقيق</h2><p>يتيح المعالج المعلومات اللازمة بصورة معقولة لإثبات الالتزام بواجباته في معالجة البيانات. ويجب أن تراعي أي ترتيبات تدقيق الأمان والسرية والأثر التشغيلي وحماية معلومات العملاء الآخرين.</p></section>
            <section><h2>16. المسؤولية والشروط الحاكمة</h2><p>تخضع المسؤولية والشروط التجارية والقانون الحاكم للاتفاقية الرئيسية للخدمة، إلا إذا فرض قانون حماية البيانات الإلزامي خلاف ذلك.</p></section>
            <section class="ed-legal-contact-card"><h2>17. التواصل</h2><p><strong>OUR-CS Sp. z o.o.</strong><br />Aleje Jerozolimskie 81, lok. 7.10<br />02-001 Warszawa, Poland</p><p><strong>استفسارات حماية البيانات:</strong> <a href="/contact/message">info@our-cs.com</a></p></section>
        </article>
    </main>

