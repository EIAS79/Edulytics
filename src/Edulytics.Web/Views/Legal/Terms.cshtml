@using System.Globalization
@{
    Layout = "_PublicLayout";
    var polish = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "pl", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = polish ? "Regulamin korzystania" : "Terms of Use";
    string L(string en, string pl) => polish ? pl : en;
}

<div class="ed-home ed-legal-page">
    <partial name="_PublicSiteHeader" />

    <main class="ed-legal-shell">
        <header class="ed-legal-hero">
            <span class="ed-legal-eyebrow">@L("Legal", "Informacje prawne")</span>
            <h1 class="ed-legal-default">@L("Terms of Use", "Regulamin korzystania")</h1>
            <h1 class="ed-legal-ar">شروط الاستخدام</h1>
            <p class="ed-legal-default">@L("These Terms govern access to and use of the Edulytics platform operated by OUR-CS Sp. z o.o.", "Niniejszy Regulamin określa zasady dostępu do platformy Edulytics prowadzonej przez OUR-CS Sp. z o.o. oraz korzystania z niej.")</p>
            <p class="ed-legal-ar">تنظم هذه الشروط الوصول إلى منصة Edulytics التي تديرها OUR-CS Sp. z o.o. واستخدامها.</p>
        </header>

        <article class="ed-legal-document ed-legal-default">
            <section><h2>@L("1. The service", "1. Usługa")</h2><p>@L("Edulytics is an educational technology platform designed for schools. The platform may include curriculum management, classes and school users, learning outcomes, assessments, practice activities, student learning profiles, mastery and progress analysis, diagnostic and adaptive assessment, and school and learning analytics.", "Edulytics jest platformą technologii edukacyjnej przeznaczoną dla szkół. Platforma może obejmować zarządzanie programem nauczania, klasami i użytkownikami szkolnymi, efektami uczenia się, ocenianiem, ćwiczeniami, profilami uczenia się uczniów, analizą opanowania i postępów, ocenianiem diagnostycznym i adaptacyjnym oraz analityką szkolną i edukacyjną.")</p></section>
            <section><h2>@L("2. Customers", "2. Klienci")</h2><p>@L("Edulytics subscriptions are available to schools and educational organisations. Edulytics is not currently sold directly to individual students or parents as a consumer subscription. The school or educational organisation entering into the applicable agreement with OUR-CS Sp. z o.o. is the customer.", "Subskrypcje Edulytics są dostępne dla szkół i organizacji edukacyjnych. Edulytics nie jest obecnie sprzedawany bezpośrednio indywidualnym uczniom ani rodzicom jako subskrypcja konsumencka. Klientem jest szkoła lub organizacja edukacyjna zawierająca właściwą umowę z OUR-CS Sp. z o.o.")</p></section>
            <section><h2>@L("3. School accounts", "3. Konta szkolne")</h2><p>@L("The school is responsible for determining which authorised users may access its Edulytics environment. The school may create or authorise accounts for school administrators, subject supervisors, teachers and students. Student accounts are created or authorised through the school and may be activated through an invitation sent to the student's registered email address.", "Szkoła odpowiada za określenie, którzy upoważnieni użytkownicy mogą uzyskać dostęp do jej środowiska Edulytics. Szkoła może tworzyć lub autoryzować konta administratorów szkolnych, koordynatorów przedmiotowych, nauczycieli i uczniów. Konta uczniów są tworzone lub autoryzowane przez szkołę i mogą być aktywowane za pomocą zaproszenia wysłanego na zarejestrowany adres e-mail ucznia.")</p></section>
            <section><h2>@L("4. Account security", "4. Bezpieczeństwo kont")</h2><p>@L("Users must keep login credentials confidential, use only accounts assigned to them, provide accurate information and notify the school or Edulytics of suspected unauthorised access. Users must not attempt to access information or functionality for which they have not been authorised.", "Użytkownicy muszą zachować poufność danych logowania, korzystać wyłącznie z przypisanych im kont, podawać prawidłowe informacje oraz powiadomić szkołę lub Edulytics o podejrzeniu nieuprawnionego dostępu. Użytkownicy nie mogą próbować uzyskać dostępu do informacji ani funkcji, do których nie zostali upoważnieni.")</p></section>
            <section><h2>@L("5. Subscription and contract term", "5. Subskrypcja i okres umowy")</h2><p>@L("Subscription duration, pricing, authorised usage and any applicable limits are specified in the relevant proposal, order form, contract, invoice or other written commercial agreement. Edulytics may support monthly or annual subscription arrangements. The commercial terms agreed with the school take precedence in relation to pricing and subscription duration.", "Okres subskrypcji, ceny, uprawniony zakres korzystania i ewentualne limity są określane w odpowiedniej ofercie, formularzu zamówienia, umowie, fakturze lub innym pisemnym uzgodnieniu handlowym. Edulytics może obsługiwać subskrypcje miesięczne lub roczne. Uzgodnione ze szkołą warunki handlowe mają pierwszeństwo w zakresie ceny i czasu trwania subskrypcji.")</p></section>
            <section><h2>@L("6. Payment", "6. Płatności")</h2><p>@L("Unless otherwise agreed in writing, payments are made by bank transfer against invoice. Payment instructions are stated on the relevant invoice or commercial documentation.", "O ile nie uzgodniono inaczej na piśmie, płatności są dokonywane przelewem bankowym na podstawie faktury. Instrukcje dotyczące płatności są wskazane na właściwej fakturze lub w dokumentacji handlowej.")</p></section>
            <section><h2>@L("7. Renewal", "7. Odnowienie")</h2><p>@L("Renewal conditions are determined by the applicable contract or commercial agreement. Where automatic renewal has not been expressly agreed, no automatic renewal should be assumed solely from these Terms.", "Warunki odnowienia określa właściwa umowa lub uzgodnienie handlowe. Jeżeli automatyczne odnowienie nie zostało wyraźnie uzgodnione, nie należy go domniemywać wyłącznie na podstawie niniejszego Regulaminu.")</p></section>
            <section><h2>@L("8. Acceptable use", "8. Dozwolone korzystanie")</h2><p>@L("Users must not use Edulytics unlawfully, upload unlawful or harmful content, interfere with platform security, attempt unauthorised access, introduce malicious code, impersonate another user, misuse student or staff information, or use automated methods intended to overload or disrupt the service.", "Użytkownicy nie mogą korzystać z Edulytics niezgodnie z prawem, przesyłać treści bezprawnych lub szkodliwych, ingerować w bezpieczeństwo platformy, podejmować prób nieuprawnionego dostępu, wprowadzać złośliwego kodu, podszywać się pod inne osoby, niewłaściwie wykorzystywać dane uczniów lub pracowników ani stosować automatycznych metod służących przeciążeniu lub zakłóceniu usługi.")</p></section>
            <section><h2>@L("9. Educational responsibility", "9. Odpowiedzialność edukacyjna")</h2><p>@L("Edulytics provides tools to assist schools and teachers. Analytics, mastery indicators, diagnostic results, recommendations and adaptive learning functionality are intended to support professional educational judgement. The school remains responsible for educational decisions affecting its students. Edulytics should not be used as the sole basis for significant decisions concerning a student without appropriate review by authorised school personnel.", "Edulytics dostarcza narzędzia wspierające szkoły i nauczycieli. Analityka, wskaźniki opanowania, wyniki diagnostyczne, rekomendacje i funkcje adaptacyjne służą wspieraniu profesjonalnego osądu edukacyjnego. Szkoła pozostaje odpowiedzialna za decyzje edukacyjne dotyczące swoich uczniów. Edulytics nie powinien stanowić jedynej podstawy istotnych decyzji dotyczących ucznia bez odpowiedniej oceny przez upoważniony personel szkoły.")</p></section>
            <section><h2>@L("10. Content created by schools", "10. Treści tworzone przez szkoły")</h2><p>@L("The school remains responsible for content it creates, uploads or provides through Edulytics. The school grants OUR-CS Sp. z o.o. the limited rights necessary to host, process, display and technically operate such content solely for the purpose of providing the service.", "Szkoła pozostaje odpowiedzialna za treści, które tworzy, przesyła lub udostępnia za pośrednictwem Edulytics. Szkoła udziela OUR-CS Sp. z o.o. ograniczonych praw niezbędnych do hostowania, przetwarzania, wyświetlania i technicznej obsługi takich treści wyłącznie w celu świadczenia usługi.")</p></section>
            <section><h2>@L("11. Edulytics intellectual property", "11. Własność intelektualna Edulytics")</h2><p>@L("Unless otherwise stated, the Edulytics software, interface, design, platform architecture, branding and original platform content are owned by or licensed to OUR-CS Sp. z o.o. No ownership rights are transferred to the school or users. The school receives only the access and use rights granted by its subscription or contract.", "O ile nie wskazano inaczej, oprogramowanie Edulytics, interfejs, projekt, architektura platformy, oznaczenia marki i oryginalne treści platformy stanowią własność OUR-CS Sp. z o.o. lub są przez nią licencjonowane. Żadne prawa własności nie są przenoszone na szkołę ani użytkowników. Szkoła otrzymuje wyłącznie prawa dostępu i korzystania wynikające z subskrypcji lub umowy.")</p></section>
            <section><h2>@L("12. Third-party and curriculum content", "12. Treści zewnętrzne i programowe")</h2><p>@L("Some educational or curriculum-related materials may originate from third-party, public-sector or openly licensed sources. Such materials remain subject to their respective rights, licences, attribution requirements and terms. Additional information is available on the Content Sources & Licences page.", "Niektóre materiały edukacyjne lub programowe mogą pochodzić ze źródeł zewnętrznych, publicznych lub objętych otwartymi licencjami. Materiały te podlegają właściwym prawom, licencjom, wymogom oznaczenia autorstwa i warunkom. Dodatkowe informacje są dostępne na stronie Źródła treści i licencje.")</p></section>
            <section><h2>@L("13. Service availability", "13. Dostępność usługi")</h2><p>@L("We aim to provide a reliable service but cannot guarantee uninterrupted or error-free operation. The service may occasionally be unavailable due to maintenance, upgrades, security work, infrastructure failure or circumstances outside our reasonable control.", "Dążymy do zapewnienia niezawodnej usługi, ale nie możemy zagwarantować nieprzerwanego i całkowicie bezbłędnego działania. Usługa może być okresowo niedostępna z powodu prac konserwacyjnych, aktualizacji, działań bezpieczeństwa, awarii infrastruktury lub okoliczności pozostających poza naszą rozsądną kontrolą.")</p></section>
            <section><h2>@L("14. Suspension", "14. Zawieszenie dostępu")</h2><p>@L("Access may be suspended where reasonably necessary due to a material breach of contract, security threat, unlawful use, non-payment, risk to other users or the platform, or a legal or regulatory requirement. Where reasonably possible, the school will be informed of the reason.", "Dostęp może zostać zawieszony, gdy jest to rozsądnie konieczne z powodu istotnego naruszenia umowy, zagrożenia bezpieczeństwa, bezprawnego użycia, braku płatności, ryzyka dla innych użytkowników lub platformy albo wymogu prawnego lub regulacyjnego. Jeżeli będzie to rozsądnie możliwe, szkoła zostanie poinformowana o przyczynie.")</p></section>
            <section><h2>@L("15. Termination", "15. Zakończenie umowy")</h2><p>@L("Termination rights are governed by the applicable contract or commercial agreement. Following termination, access may be disabled and school data may be returned, exported or deleted according to the applicable contract and Data Processing Agreement.", "Uprawnienia dotyczące zakończenia umowy określa właściwa umowa lub uzgodnienie handlowe. Po zakończeniu umowy dostęp może zostać wyłączony, a dane szkoły mogą zostać zwrócone, wyeksportowane lub usunięte zgodnie z właściwą umową i umową powierzenia przetwarzania danych.")</p></section>
            <section><h2>@L("16. Data protection", "16. Ochrona danych")</h2><p>@L("Processing of personal data is governed by applicable data-protection law, our Privacy Policy and, where applicable, the Data Processing Agreement entered into with the school.", "Przetwarzanie danych osobowych podlega obowiązującym przepisom o ochronie danych, naszej Polityce prywatności oraz, w stosownych przypadkach, umowie powierzenia przetwarzania danych zawartej ze szkołą.")</p></section>
            <section><h2>@L("17. Liability", "17. Odpowiedzialność")</h2><p>@L("To the maximum extent permitted by applicable law, OUR-CS Sp. z o.o. is not responsible for educational decisions made solely by a school, teacher or other authorised user based on their interpretation of platform information. Any contractual limitation of liability applicable to a school is specified in the relevant commercial agreement. Nothing in these Terms excludes liability that cannot legally be excluded.", "W maksymalnym zakresie dozwolonym przez obowiązujące prawo OUR-CS Sp. z o.o. nie odpowiada za decyzje edukacyjne podejmowane samodzielnie przez szkołę, nauczyciela lub innego upoważnionego użytkownika na podstawie ich interpretacji informacji z platformy. Wszelkie umowne ograniczenia odpowiedzialności dotyczące szkoły są określone we właściwej umowie handlowej. Niniejszy Regulamin nie wyłącza odpowiedzialności, której zgodnie z prawem wyłączyć nie można.")</p></section>
            <section><h2>@L("18. Complaints and support", "18. Reklamacje i wsparcie")</h2><p>@L("Schools may contact Edulytics regarding technical problems, account issues, service complaints, billing questions or data-protection matters. We will review complaints and respond within a reasonable period.", "Szkoły mogą kontaktować się z Edulytics w sprawie problemów technicznych, kont użytkowników, reklamacji dotyczących usługi, rozliczeń lub ochrony danych. Reklamacje będą rozpatrywane i obsługiwane w rozsądnym terminie.")</p></section>
            <section><h2>@L("19. Governing law", "19. Prawo właściwe")</h2><p>@L("Unless otherwise agreed in writing, the contractual relationship with OUR-CS Sp. z o.o. is governed by the laws of Poland. Any dispute will be handled in accordance with the applicable contract and mandatory provisions of law.", "O ile nie uzgodniono inaczej na piśmie, stosunek umowny z OUR-CS Sp. z o.o. podlega prawu polskiemu. Wszelkie spory będą rozstrzygane zgodnie z właściwą umową i bezwzględnie obowiązującymi przepisami prawa.")</p></section>
            <section class="ed-legal-contact-card"><h2>@L("20. Contact", "20. Kontakt")</h2><p><strong>OUR-CS Sp. z o.o.</strong><br />Aleje Jerozolimskie 81, lok. 7.10<br />02-001 Warszawa, Poland</p><p><strong>@L("Email:", "E-mail:")</strong> <a href="/contact/message">info@our-cs.com</a></p></section>
        </article>

        <article class="ed-legal-document ed-legal-ar" lang="ar" dir="rtl">
            <section><h2>1. الخدمة</h2><p>Edulytics منصة تقنية تعليمية مخصصة للمدارس، وقد تشمل إدارة المناهج والفصول والمستخدمين ونتائج التعلّم والتقييمات والتدريب وملفات تعلّم الطلاب وتحليل الإتقان والتقدم والتقييم التشخيصي والتكيفي والتحليلات التعليمية.</p></section>
            <section><h2>2. العملاء</h2><p>تتاح اشتراكات Edulytics للمدارس والمؤسسات التعليمية. لا تُباع الخدمة حاليًا مباشرةً للطلاب أو أولياء الأمور كاشتراك استهلاكي. وتكون المدرسة أو المؤسسة التعليمية التي تبرم الاتفاقية مع OUR-CS Sp. z o.o. هي العميل.</p></section>
            <section><h2>3. حسابات المدرسة</h2><p>تحدد المدرسة المستخدمين المصرح لهم بالدخول إلى بيئة Edulytics الخاصة بها، ويمكنها إنشاء أو اعتماد حسابات مسؤولي المدرسة ومشرفي المواد والمعلمين والطلاب. يتم إنشاء حسابات الطلاب أو اعتمادها من خلال المدرسة وقد يتم تفعيلها عبر دعوة مرسلة إلى البريد الإلكتروني المسجل للطالب.</p></section>
            <section><h2>4. أمان الحساب</h2><p>يجب على المستخدمين الحفاظ على سرية بيانات الدخول، واستخدام الحسابات المخصصة لهم فقط، وتقديم معلومات صحيحة، والإبلاغ عن أي اشتباه في وصول غير مصرح به. ولا يجوز محاولة الوصول إلى معلومات أو وظائف غير مصرح بها.</p></section>
            <section><h2>5. الاشتراك ومدة العقد</h2><p>تُحدد مدة الاشتراك والسعر وحدود الاستخدام المصرح به في العرض أو نموذج الطلب أو العقد أو الفاتورة أو أي اتفاق تجاري مكتوب ذي صلة. وقد تدعم Edulytics ترتيبات اشتراك شهرية أو سنوية، وتكون الشروط التجارية المتفق عليها مع المدرسة هي المرجع فيما يخص السعر والمدة.</p></section>
            <section><h2>6. الدفع</h2><p>ما لم يُتفق كتابيًا على خلاف ذلك، يتم الدفع عن طريق التحويل البنكي مقابل الفاتورة، وتظهر تعليمات الدفع في الفاتورة أو الوثائق التجارية ذات الصلة.</p></section>
            <section><h2>7. التجديد</h2><p>تحدد الاتفاقية أو الشروط التجارية المعمول بها شروط التجديد. وإذا لم يُتفق صراحةً على التجديد التلقائي فلا يُفترض وجوده بناءً على هذه الشروط وحدها.</p></section>
            <section><h2>8. الاستخدام المقبول</h2><p>يحظر استخدام Edulytics بصورة غير قانونية، أو رفع محتوى غير قانوني أو ضار، أو التدخل في أمان المنصة، أو محاولة الوصول غير المصرح به، أو إدخال شيفرة ضارة، أو انتحال مستخدم آخر، أو إساءة استخدام معلومات الطلاب أو الموظفين، أو استخدام وسائل آلية تهدف إلى تعطيل الخدمة أو إرهاقها.</p></section>
            <section><h2>9. المسؤولية التعليمية</h2><p>توفر Edulytics أدوات لدعم المدارس والمعلمين. وتهدف التحليلات ومؤشرات الإتقان والنتائج التشخيصية والتوصيات والوظائف التكيفية إلى دعم الحكم المهني التعليمي. وتظل المدرسة مسؤولة عن القرارات التعليمية التي تؤثر على طلابها، ولا ينبغي استخدام Edulytics وحدها كأساس لقرار مهم بشأن طالب دون مراجعة مناسبة من موظفي المدرسة المصرح لهم.</p></section>
            <section><h2>10. محتوى المدرسة</h2><p>تظل المدرسة مسؤولة عن المحتوى الذي تنشئه أو ترفعه أو توفره عبر Edulytics، وتمنح OUR-CS Sp. z o.o. فقط الحقوق المحدودة اللازمة لاستضافة هذا المحتوى ومعالجته وعرضه وتشغيله تقنيًا بهدف تقديم الخدمة.</p></section>
            <section><h2>11. الملكية الفكرية لـ Edulytics</h2><p>ما لم يُذكر خلاف ذلك، فإن البرمجيات والواجهة والتصميم وبنية المنصة والعلامة والمحتوى الأصلي في Edulytics مملوكة لـ OUR-CS Sp. z o.o. أو مرخصة لها. ولا تنتقل حقوق الملكية إلى المدرسة أو المستخدمين، بل تحصل المدرسة فقط على حقوق الوصول والاستخدام المقررة في الاشتراك أو العقد.</p></section>
            <section><h2>12. محتوى الأطراف الأخرى والمناهج</h2><p>قد تأتي بعض المواد التعليمية أو المتعلقة بالمناهج من مصادر خارجية أو عامة أو ذات تراخيص مفتوحة، وتظل خاضعة للحقوق والتراخيص ومتطلبات الإسناد والشروط الخاصة بها. وتوجد معلومات إضافية في صفحة مصادر المحتوى والتراخيص.</p></section>
            <section><h2>13. توفر الخدمة</h2><p>نسعى إلى تقديم خدمة موثوقة، لكننا لا نضمن تشغيلًا دون انقطاع أو أخطاء. وقد تتوقف الخدمة مؤقتًا بسبب الصيانة أو التحديثات أو أعمال الأمان أو أعطال البنية التحتية أو ظروف خارجة عن سيطرتنا المعقولة.</p></section>
            <section><h2>14. تعليق الوصول</h2><p>يجوز تعليق الوصول عند الضرورة المعقولة بسبب خرق جوهري للعقد أو تهديد أمني أو استخدام غير قانوني أو عدم السداد أو خطر على مستخدمين آخرين أو على المنصة أو بسبب متطلبات قانونية أو تنظيمية. وسيتم إبلاغ المدرسة بالسبب متى كان ذلك ممكنًا بصورة معقولة.</p></section>
            <section><h2>15. إنهاء الخدمة</h2><p>تحدد الاتفاقية المعمول بها حقوق الإنهاء. وبعد الإنهاء قد يتم تعطيل الوصول وإعادة بيانات المدرسة أو تصديرها أو حذفها وفق العقد واتفاقية معالجة البيانات المعمول بهما.</p></section>
            <section><h2>16. حماية البيانات</h2><p>تخضع معالجة البيانات الشخصية لقانون حماية البيانات المعمول به وسياسة الخصوصية، وكذلك لاتفاقية معالجة البيانات المبرمة مع المدرسة عند انطباقها.</p></section>
            <section><h2>17. المسؤولية</h2><p>في أقصى نطاق يسمح به القانون، لا تتحمل OUR-CS Sp. z o.o. مسؤولية القرارات التعليمية التي تتخذها المدرسة أو المعلم أو مستخدم مصرح له اعتمادًا فقط على تفسيرهم لمعلومات المنصة. وتحدد الاتفاقية التجارية أي حدود تعاقدية للمسؤولية. ولا تستبعد هذه الشروط أي مسؤولية لا يجوز استبعادها قانونًا.</p></section>
            <section><h2>18. الشكاوى والدعم</h2><p>يمكن للمدارس التواصل مع Edulytics بشأن المشكلات التقنية أو الحسابات أو الشكاوى المتعلقة بالخدمة أو الفوترة أو مسائل حماية البيانات. وسنراجع الشكاوى ونرد خلال مدة معقولة.</p></section>
