                    @for(var group=0;group<3;group++){
                        <div style="display:flex;flex-wrap:wrap;align-content:center;justify-content:center;gap:7px;width:95px;height:65px;border:2px dashed #426a83;border-radius:48px">
                            @for(var i=0;i<5;i++){<span class="first-party-dot" aria-hidden="true"></span>}
