                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
                    @foreach(var card in firstPartyCards) {
                        <article style="border:2px solid #38758c;border-radius:8px;padding:10px" aria-label="Edulytics first-party visual card @card.Id">
