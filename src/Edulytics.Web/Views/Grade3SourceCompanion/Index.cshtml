@model Edulytics.Web.ViewModels.LessonContent.Grade3SourceCompanionPage
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Grade 3 · First-party lesson companion";
    var l = Model.Lesson;
    var roadSigns = Edulytics.Web.Curriculum.Grade3.Grade3SourceCompanionCatalogue.Local2021RoadSignGraph;
    var showRoadSigns = l.UnitNumber == 1 && (l.LessonNumber == 9 || l.LessonNumber == 10);
    var showMinuteClock = l.UnitNumber == 6 && l.LessonNumber == 9;
}
<style>
.g3-original{max-width:940px;margin:0 auto;padding:20px;color:#1e3d54}
.g3-original .panel{background:#fff;border:1px solid #d9e4ec;border-radius:14px;padding:22px;margin:16px 0}
.g3-original label{display:block;font-weight:700;margin:12px 0 5px}
.g3-original textarea,.g3-original input{padding:10px;width:100%;max-width:700px;border:1px solid #7d93a8;border-radius:8px;font:inherit}
.g3-original textarea:focus,.g3-original input:focus{outline:3px solid #b5dce8}
.g3-original button{padding:12px 20px;border:0;border-radius:8px;background:#167789;color:white;font:inherit;cursor:pointer}
.g3-original .ok{border-left:4px solid #21805a;padding-left:10px}
.g3-original .no{border-left:4px solid #ad3b45;padding-left:10px}
.g3-original .human{border-left:4px solid #b08b24;padding-left:10px}
.g3-original .source-chart{border-collapse:collapse;width:100%;margin:14px 0}
.g3-original .source-chart th,.g3-original .source-chart td{padding:9px;text-align:left;border-bottom:1px solid #d4e1e8}
.g3-original .source-pictogram{font-size:1.3rem;display:inline-block;margin-right:.35rem;color:#147b96}
.g3-original .source-scale{display:flex;justify-content:space-between;max-width:360px;font-variant-numeric:tabular-nums}
.g3-original .source-key{font-weight:700}
.g3-original .first-party-array{display:grid;gap:7px;width:max-content;max-width:100%;margin:12px 0;padding:12px;border:2px solid #8daeb7;border-radius:8px}
.g3-original .first-party-dot{display:block;background:#147b96;border-radius:50%;width:17px;height:17px}

</style>
<main class="g3-original">
    <a asp-controller="StudentPortal" asp-action="Lesson" asp-route-id="@Model.LessonId">← Back to lesson</a>
    <p>EDULYTICS · ORIGINAL COMPANION · GRADE 3 UNIT @l.UnitNumber LESSON @l.LessonNumber</p>
    <h1>@l.Title</h1>
    <p><strong>Learning goal:</strong> @l.StudentFacingGoal</p>
    <p>This is a separately authored skill practice supplement, not the original publisher worksheet or an approved school assessment. Teacher-led activities and original images must be studied with the teacher.</p>
    <form asp-controller="Grade3SourceCompanion" asp-action="Submit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="curriculumAdoptionId" value="@Model.CurriculumAdoptionId" />
        <input type="hidden" name="lessonId" value="@Model.LessonId" />
        @if(l.IndependentTeachingGuidance is not null) {
            <section class="panel">
                <h2>How to approach this lesson</h2>
                <ol>
                @foreach(var step in l.IndependentTeachingGuidance.TeachingSteps) {
                    <li>@step</li>
                }
                </ol>
                <p><strong>Check carefully:</strong> @l.IndependentTeachingGuidance.Caution</p>
                <p>These independently written learning notes supplement the 2021 source goal;
                    they do not replace teacher materials or certify the published Rich V2 content.</p>
            </section>
        }
        <section class="panel">
            <h2>1. Source activity context and teacher work</h2>
            <p>Read, discuss, or construct the named original 2021 lesson activities under your teacher's guidance. Their original figures and materials are not reproduced by this supplemental page.</p>
            <ul>
            @foreach(var name in l.SourceActivityNames) {
                <li>@name</li>
            }
            </ul>
            <p>@l.OpenTeacherTask</p>
            <label for="original-work">How did you represent and explain the original source activity?</label>
            <textarea id="original-work" name="SourceWorkReflection" rows="4" maxlength="2000">@Model.Answers.SourceWorkReflection</textarea>
        </section>
        @if(showRoadSigns) {
            <section class="panel" aria-label="Independently reconstructed 2021 road-sign data">
                <h2>Road signs as equal groups</h2>
                <p class="source-key">Key: one picture symbol represents two road signs.</p>
                <p>The numerical values below come from the local 2021 source description.
                    This is an original Edulytics data representation, not publisher artwork.</p>
                <table class="source-chart">
                    <caption>Signs observed on the way home</caption>
                    <thead>
                        <tr>
                            <th scope="col">Category</th>
                            <th scope="col">Picture symbols</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var category in roadSigns) {
                            <tr>
                                <th scope="row">@category.Category</th>
                                <td>
                                    @for(var symbol=0;symbol<category.SymbolCount;symbol++){
                                        <span class="source-pictogram" aria-hidden="true">■</span>
                                    }
                                    <span class="visually-hidden">@category.SymbolCount independently drawn symbols; two road signs per symbol</span>
                                </td>
                                    </tr>
                        }
                    </tbody>
                </table>
                <p>Count the picture symbols and use the key to work out the total. Symbol-count scale: 0, 1, 2, 3, 4, 5.
                    To count signs, multiply each category's symbol count by two.</p>
                <p><strong>Think and draw:</strong> Show the speed-limit signs as three
                    equal groups of two. Make a diagram for a different category and
                    compare your representation with your teacher or partner.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 9) {
            <section class="panel" aria-label="Source-aligned equal-groups constructions">
                <h2>Source Number Talk — four addition expressions in order</h2>
                <p>Mentally calculate 40 + 35, 45 + 35, 45 + 36, and 34 + 58. Discuss where a new ten is composed, and why each related expression changes from the previous one.</p>
                <h2>Source road-sign graph: three separate tasks</h2>
                <ol>
                    <li>Represent speed-limit signs using three groups of two.</li>
                    <li>Choose and justify the statement: three pictures, with two speed-limit signs per picture. Explain why the alternatives three pictures of one and two pictures of two are false.</li>
                    <li>Explain how five groups of two dots model the street-sign category.</li>
                </ol>
                <h2>Source equal-group situations: three different contexts</h2>
                <ol>
                    <li>Four people, each wearing two shoes: model four groups of two and explain the total.</li>
                    <li>Two boxes containing ten markers each: model two groups of ten and explain the total.</li>
                    <li>Three basketball teams with five players each: model three groups of five and explain the total.</li>
                </ol>
                <p>Use the original-work response field above for your calculations, diagrams and explanations. Draw the groups or use counters with a teacher; an integer-only response does not certify the source representations or partner discussion.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 10) {
            <section class="panel" aria-label="Public lesson ten source drawing and sorting tasks">
                <h2>Source warm-up: six pairs of socks</h2>
                <p>Notice and wonder about six pairs of socks. Describe six equal groups with two socks each and explain different ways of counting all 12 socks. Compare ideas aloud with a partner.</p>
                <h2>Source Activity 1: from the sign graph to a tape diagram</h2>
                <p>The speed-limit category has three picture symbols; the key shows two signs in each symbol. Represent the six signs with three equal tape-diagram sections labelled 2. Compare this drawing with the scaled picture graph above, then draw a DIFFERENT sign category as a tape diagram. Explain how the representations are similar and different.</p>
                <h2>Source Activity 2: equal-groups card sort and two original situations</h2>
                <p>Your teacher provides the original card-sort blackline materials, which have not been independently inspected here. In pairs, match the original situations, drawings and diagrams, and justify each match. Do not substitute an invented card set and call it the source card sort.</p>
                <ol>
                    <li>Draw or construct four equal groups of two strawberries in four bags; explain how eight strawberries are represented.</li>
                    <li>Draw or construct four equal groups of five fingers on four hands; explain how twenty fingers are represented.</li>
                </ol>
                <p>Use the original-work field above to describe the diagram, partner matches and equations. A teacher must review the actual card sorting, group sizes and diagram meaning; a correct numeric answer alone cannot certify these tasks.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 11) {
            <section class="panel" aria-label="Source 2021 multiplication expressions: three learning activities">
                <h2>Source warm-up: choral count in twos and fives</h2>
                <p>Count by 5 from 0 to 50. Notice how the ones digits alternate. Repeat by 2 from 0 to 20, and explain the pattern with your partner.</p>
                <h2>Source Activity 1: match real cards to five expressions</h2>
                <p>The teacher supplies one original diagram, drawing or situation card from the previous lesson to each pair of students. Match it to exactly one displayed expression: 3 × 5, 4 × 3, 3 × 2, 2 × 10, or 3 × 10. Identify which factor represents the number of groups and which represents the group size. Original card artwork has not been reproduced or verified here.</p>
                <h2>Source Activity 2: draw and explain</h2>
                <ol>
                    <li>Draw five groups of two for 5 × 2; explain your grouping.</li>
                    <li>Draw three groups of four for 3 × 4; compare a picture with an equivalent tape diagram.</li>
                    <li>Draw three groups of ten for 3 × 10; justify the group labels.</li>
                    <li>Invent an expression and draw a matching diagram. Explain it to your partner.</li>
                </ol>
                <p>Teacher synthesis: compare 3 × 4, 5 × 4 and 3 × 5; distinguish adding groups from changing objects per group.</p>
                <h2>Source Activity 3: write the expression, not merely the total</h2>
                <ol>
                    <li>Three dot cubes each with three dots: write 3 × 3 and justify it.</li>
                    <li>A tape diagram with two equal parts each labelled four: write 2 × 4.</li>
                    <li>Two water packs holding six bottles each: write 2 × 6.</li>
                </ol>
                <p>The diagrams, explanation, partner card sorting and teacher-only original Cool-down require independent teacher review. Enter your drawings and reasoning in the source-work field above.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 12) {
            <section class="panel" aria-label="Source lesson twelve teacher-led visual and problem posing tasks">
                <h2>Source warm-up: groups of dots</h2>
                <p>The first published description has four groups, each formed by two rows of five dots (40 dots altogether). The second picture's precise dot arrangement is not independently verified here. With your teacher, explain different grouping methods without replacing the unread figure by a guessed one.</p>
                <h2>Source Activity 1: co-craft a question before solving</h2>
                <p>The teacher first displays ONLY the statement that Tyler has three boxes. Partners invent plausible mathematical questions before the teacher reveals the full five-baseballs-per-box problem. A machine-graded answer to 3 × 5 does not demonstrate question posing.</p>
                <h2>Source Activity 2: five original story settings</h2>
                <p>In each of the six numeric tasks above, write an equation and create a matching diagram or model; compare one strategy with a partner. The five contexts involve teams, panes of glass, earrings, pencils and carrots. The teacher checks group count, group size, correct units and reasoning individually.</p>
                <p>Only a teacher can verify the original problem-posing dialogue, drawing validity, dot-image interpretation and which method you found useful. The publisher's Cool-down is teacher-access controlled; the other Cool-down here is independently written by Edulytics.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 13) {
            <section class="panel" aria-label="Source multiplication equations visual and pedagogical context">
                <h2>Source warm-up: which one doesn't belong?</h2>
                <p>Compare a drawing of 3 groups of 5 dots, the expression 3 × 5, the equation 2 × 5 = 10 and the addition equation 7 + 8 = 15. Give more than one defensible answer and justify your classification with a partner. Original artwork is not copied here.</p>
                <h2>Source Activity 1: equation matching</h2>
                <p>The publisher's available equation list includes 3 × 5 = 15, 4 × 10 = 40, 2 × 10 = 20, 10 = 5 × 2, 30 = 6 × 5, 4 × 2 = 8, 16 = 8 × 2, 4 × 5 = 20, and 50 = 5 × 10. Match these with the nine original diagram or story cards as directed by your teacher. The third and eighth source pictures require original-material inspection; no substitute is presented as the original.</p>
                <h2>Source Activity 2: write an equation for every representation</h2>
                <p>Use the separately identified items below for all seven visible public descriptions. A full multiplication equation needs the correct factors, a product and the equals sign. Record the model, label the groups, and explain how factors and product connect to the drawing. The teacher compares original representations and confirms answers.</p>
                <p>During synthesis, explain the distinction between an expression such as 3 × 5 and a true equation such as 3 × 5 = 15.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 14) {
            <section class="panel" aria-label="Source multiplication with an unknown number">
                <h2>Source warm-up — multiplication by five</h2>
                <p>Work in the original order: 1 × 5, 2 × 5, 3 × 5, 4 × 5. Explain why the products increase by five as the number of groups increases.</p>
                <h2>Activity 1: original unknown-number card sort</h2>
                <p>The teacher supplies the actual printed Card Sort: Unknown Numbers. Match a situation, diagram and equation, and show whether the unknown is a FACTOR or the PRODUCT. The original card art is not available for first-party substitution.</p>
                <h2>Activity 2: represent both types of missing numbers</h2>
                <p>For 45 cards in packs of five, use □ × 5 = 45, not 5 × □ = 45 if the first factor is meant to count the packs. For five tape sections labelled two, use 5 × 2 = □; for six bags of ten balls, use 6 × 10 = □. Explain the meaning of the box and write the complete equation after finding its value.</p>
                <p>The two remaining publisher diagrams have ambiguous accessible image descriptions and require original-image teacher inspection. Do not assume their missing factors from alt text alone. Include a description in each teacher-only row.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 15) {
            <section class="panel" aria-label="Source three locations of a missing multiplication quantity">
                <h2>Source warm-up: tens in increasing equal groups</h2>
                <p>Calculate 1 × 10, 2 × 10, 3 × 10 and 4 × 10 mentally. Explain why the result increases by exactly ten.</p>
                <h2>Source Activity 1: three stories, different unknowns</h2>
                <p>For fifteen plates on tables of five, □ × 5 = 15 asks for the number of TABLES. Six sandwiches with two bread slices each, 6 × 2 = □ asks for a TOTAL. Sixty ice cubes in trays of ten, □ × 10 = 60 asks for the number of TRAYS. Include a drawing, equation, units and solution for each.</p>
                <h2>Source Activity 2: multiplication mashup</h2>
                <p>Find all five answers in the individual source items below. The sequence of sixteen socks in piles of two, eight piles of two, and sixteen socks divided into eight same-sized groups deliberately changes what is unknown: number of groups, total number of objects, and number in each group. Do NOT mark all three as the same question family. Teachers review the model and missing-variable meaning, not merely the correct number.</p>
                <p>In the lesson's comparison discussion, explain when drawings, tape diagrams, skip-counting or equations help. Repeated addition may be a calculation method but should not be presented as the complete meaning of multiplication.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 16) {
            <section class="panel" aria-label="Original Edulytics array representation, not publisher artwork">
                <h2>Source activity guidance: build arrays with actual cubes</h2>
                <p>For the original activity, groups use actual connecting cubes: six groups of five, then twenty cubes, then twenty-four cubes. The teacher checks arrangement, groups and the explanations. A correct product alone cannot approve an array drawing.</p>
                <p>The following 6-row by 5-column diagram is independently created for Edulytics and is an EXAMPLE, not the publisher's source image.</p>
                <div class="first-party-array" style="grid-template-columns:repeat(5,17px)" role="img" aria-label="A first-party illustration of 6 equal rows containing 5 dots each">
                    @for(var i=0;i<30;i++){<span class="first-party-dot" aria-hidden="true"></span>}
                </div>
                <p>Compare these six equal rows to six equal groups of five. You can also read five equal columns of six. For 20 cubes, try more than one rectangular arrangement. For 24 cubes, find several — do not insist on finding every factor pair.</p>
                <p>The warm-up original carton image and Noah's two drawings still require a teacher to inspect the source visual. Discuss whether both circles and rectangular arrays can show the same equal groups.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 17) {
            <section class="panel" aria-label="Source arrays built from original grouped drawings">
                <h2>Original picture and card-sort work</h2>
                <p>For the original four warm-up illustrations, images A, B and C each contain 15 dots, and D contains 16. But their arrangements differ: an answer of just “D has more dots” misses other potential valid array/non-array explanations. Examine the original pictures with the teacher.</p>
                <p>The original Card Sort Arrays is a separate physical matching task: keep and discuss the group sizes as drawings transform into rows or columns, then edit your written explanation after discussing it with a partner.</p>
                <h2>Source Activity 2: draw, rather than just count</h2>
                <p>Reorganize 4 groups of 3 into a rectangular array; use 12 dots. Then use all 16 dots of the other source figure in two different arrays. Here is an independently drawn EXAMPLE of three rows of four dots; it does not replace the original source card artwork.</p>
                <div class="first-party-array" style="grid-template-columns:repeat(4,17px)" role="img" aria-label="Independent example: three complete rows, four dots per row">
                    @for(var i=0;i<12;i++){<span class="first-party-dot" aria-hidden="true"></span>}
                </div>
                <p>Show why all rows and columns form valid equal-sized groupings. Teacher evaluates your own drawings and actual peer explanation revision.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 18) {
            <section class="panel" aria-label="Source arrays, expressions and human arrays">
                <h2>Warm-up: a five-by-four triangle array</h2>
                <p>Observe five rows of four triangles (20 in total), and explain how equal-size rows or columns help you count. The publisher's actual figure has not been copied.</p>
                <h2>Source Activity 1: draw a separate array and write a multiplication expression</h2>
                <p>The four original array contexts are three rows of five chairs, four rows of five cars, two rows of six eggs, and two lines of ten pupils. Use objects or diagrams for each; enter the ROW count × GROUP size in the appropriate individual source task. Entering the total alone cannot demonstrate writing the expression.</p>
                <p>Here is an independently authored three-row by five-column array illustration (not original publisher artwork):</p>
                <div class="first-party-array" style="grid-template-columns:repeat(5,17px)" role="img" aria-label="Three rows with five dots each">
                    @for(var i=0;i<15;i++){<span class="first-party-dot" aria-hidden="true"></span>}
                </div>
                <h2>Source Activity 2: arrays from an expression</h2>
                <p>Work as a class to form a human 4 × 6 array (adjustable for actual class size), then individually draw arrays for 2 × 3, 5 × 2 and 4 × 4. Teacher checks whether each array actually consists of equal rows and columns, rather than merely a set of isolated dots.</p>
            </section>
        }
        @if(showMinuteClock) {
            <section class="panel" aria-label="Edulytics original analogue clock reading">
                <h2>Read an original analogue clock</h2>
                <p>The time is in the afternoon. Read the hour and minute hands,
                    then enter the complete time. This diagram is independently
                    drawn for this lesson's skill and is not copied publisher artwork.</p>
                <svg viewBox="0 0 240 240" width="240" height="240"
                     role="img" aria-label="An analogue dial showing the hour hand a little past two and the minute hand one tick past the seven; count the minute marks accurately">
                    <title>Read the hour and minute hands</title>
                    <circle cx="120" cy="120" r="94" stroke="#244860"
                            stroke-width="3" fill="#ffffff" />
                    @for(var tick=0;tick<60;tick++) {
                        var theta=tick*Math.PI/30.0;
                        var outer=87;
                        var inner=tick%5==0?75:82;
                        var x1=(120+inner*Math.Sin(theta)).ToString(System.Globalization.CultureInfo.InvariantCulture);
                        var y1=(120-inner*Math.Cos(theta)).ToString(System.Globalization.CultureInfo.InvariantCulture);
                        var x2=(120+outer*Math.Sin(theta)).ToString(System.Globalization.CultureInfo.InvariantCulture);
                        var y2=(120-outer*Math.Cos(theta)).ToString(System.Globalization.CultureInfo.InvariantCulture);
                        <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                              stroke="#244860" stroke-width="@(tick%5==0?2.5:1)" />
                    }
                    <text x="120" y="48" text-anchor="middle" font-size="18">12</text>
                    <text x="192" y="126" text-anchor="middle" font-size="18">3</text>
                    <text x="120" y="197" text-anchor="middle" font-size="18">6</text>
                    <text x="48" y="126" text-anchor="middle" font-size="18">9</text>
                    <line x1="120" y1="120" x2="164" y2="111"
                          stroke="#22445b" stroke-width="7" stroke-linecap="round" />
                    <line x1="120" y1="120" x2="82" y2="173"
                          stroke="#167b91" stroke-width="4" stroke-linecap="round" />
                    <circle cx="120" cy="120" r="5" fill="#22445b" />
                </svg>
                <p>Use the small marks for individual minutes, not only the
                    5-minute numbers. The clock alone cannot tell a.m. from p.m.</p>
            </section>
        }
        @if(l.SourceSubtasks.Count > 0) {
            <section class="panel" aria-label="Individual published source-aligned mathematical subtasks">
                <h2>Original public source: individually checked numerical tasks</h2>
                <p>These short independently worded prompts preserve the source contexts and numerical constraints. For every answer, construct a drawing, tape diagram or expression and explain why it matches. The teacher evaluates the representation; a number alone never completes this activity.</p>
                @for(var i=0;i<l.SourceSubtasks.Count;i++){
                    var task=l.SourceSubtasks[i];
                    <div class="panel">
                        <h3>@task.SourceActivity — task @(i+1)</h3>
                        <p>@task.Prompt</p>
                        <label for="source-sub-answer-@i">My calculated response</label>
                        @if(task.AnswerType!="teacher"){
                            <input id="source-sub-answer-@i" name="SourceSubtaskAnswers[@i]" maxlength="100"
                                value="@Model.Answers.SourceSubtaskAnswers.ElementAtOrDefault(i)" inputmode="text" />
                        } else {
                            <input type="hidden" name="SourceSubtaskAnswers[@i]" value="" />
                        }
                        <label for="source-sub-explain-@i">My matching diagram, equation or explanation</label>
                        <textarea id="source-sub-explain-@i" name="SourceSubtaskReasoning[@i]"
                            rows="3" maxlength="2000">@Model.Answers.SourceSubtaskReasoning.ElementAtOrDefault(i)</textarea>
                    </div>
                }
                <p>Source task PDF figures, co-crafted oral questions and the publisher Cool-down are NOT automatically certified by these entries.</p>
            </section>
        }
        @if(l.SourceBasedCheck is not null) {
            <section class="panel">
                <h2>Source-aligned skill check — locally reviewed text</h2>
                <p>@l.SourceBasedCheck.Prompt</p>
                <p>The mathematical situation is adapted from the original public 2021 Student Facing HTML. Publisher figures and teacher-only Cool-downs are not reproduced.</p>
                @if(l.SourceBasedCheck.AnswerType != "teacher") {
                    <label for="source-check-answer">My answer</label>
                    <input id="source-check-answer" name="SourceCheckAnswer" value="@Model.Answers.SourceCheckAnswer" maxlength="100" inputmode="text" required />
                } else {
                    <p>This source-based problem requires a drawing, measurement, reasoning or project. A teacher must evaluate it; the numeric grader cannot approve it.</p>
                }
                <label for="source-check-reason">My drawing, equation and explanation</label>
                <textarea id="source-check-reason" name="SourceCheckReasoning" rows="3" maxlength="2000">@Model.Answers.SourceCheckReasoning</textarea>
            </section>
        }
        <section class="panel">
            <h2>2. New Edulytics skill practice</h2>
            <p>@l.IndependentPractice!.Prompt</p>
            @if(l.IndependentPractice.AnswerType != "teacher") {
                <label for="practice">My answer</label>
                <input id="practice" name="PracticeAnswer" value="@Model.Answers.PracticeAnswer" maxlength="100" inputmode="text" required />
            } else {
                <p>This task requires a teacher to evaluate your design or original reasoning. There is no numeric pass.</p>
            }
            <label for="practice-reasoning">Drawing, equation or explanation</label>
            <textarea id="practice-reasoning" name="PracticeReasoning" rows="4" maxlength="2000">@Model.Answers.PracticeReasoning</textarea>
        </section>
        <section class="panel">
            <h2>3. New Edulytics Cool-down</h2>
            <p>@l.OriginalEdulyticsCoolDown!.Prompt</p>
            @if(l.OriginalEdulyticsCoolDown.AnswerType != "teacher") {
                <label for="cool-answer">My answer</label>
                <input id="cool-answer" name="CoolDownAnswer" value="@Model.Answers.CoolDownAnswer" maxlength="100" inputmode="text" required />
            } else {
                <p>Your teacher reviews the response or constructed work; no automated grade is possible.</p>
            }
            <label for="cool-reasoning">Explain my strategy with a representation</label>
            <textarea id="cool-reasoning" name="CoolDownReasoning" rows="4" maxlength="2000">@Model.Answers.CoolDownReasoning</textarea>
        </section>
        <section class="panel">
            <h2>4. Teacher-only evaluation rubric</h2>
            <p>@l.TeacherReviewNote</p>
            <p>Correct numeric values are only mathematical checks. They do not prove source task parity, actual classroom participation, a correct diagram, or completion of this lesson.</p>
        </section>
        <button type="submit">Check eligible numeric answers</button>
    </form>
    @if(Model.Submitted) {
        <section class="panel" aria-live="polite">
            <h2>Mathematical feedback (not a school grade)</h2>
            @if(Model.SourceSubtaskFeedback is not null) {
                @for(var i=0;i<Model.SourceSubtaskFeedback.Count;i++){
                    var feedback=Model.SourceSubtaskFeedback[i];
                    <div class="@(feedback.NumericCorrect==true?"ok":feedback.NumericCorrect==false?"no":"human")">
                        <h3>Source subtask @(i+1): @l.SourceSubtasks[i].SourceActivity</h3>
                        <p>@(feedback.NumericCorrect==true?"Numerical result correct.":feedback.NumericCorrect==false?"Numerical answer needs revision.":"Requires teacher judgment.") @feedback.Message</p>
                        <p><em>Individual drawings and reasoning remain teacher-reviewed, even if the integer is correct.</em></p>
                    </div>
                }
            }
            @foreach(var item in new[] {
                (Name:"Source-aligned numerical check",Feedback:Model.SourceCheckFeedback),
                (Name:"Original skill practice",Feedback:Model.PracticeFeedback),
                (Name:"Edulytics Cool-down",Feedback:Model.CoolDownFeedback)
            }) {
                @if(item.Feedback is not null) {
                <div class="@(item.Feedback.NumericCorrect==true?"ok":item.Feedback.NumericCorrect==false?"no":"human")">
                    <h3>@item.Name</h3>
                    <p>@(item.Feedback.NumericCorrect==true?"Numerical result correct.":item.Feedback.NumericCorrect==false?"Numerical result needs revision.":"Requires teacher judgment.") @item.Feedback.Message</p>
                    <p><em>Reasoning, drawings, representations and human tasks remain teacher-reviewed.</em></p>
                </div>
                }
            }
        </section>
    }
    <p>Academic alignment reference: <a href="https://im.kendallhunt.com/k5/teachers/grade-3/unit-@l.UnitNumber/lesson-@l.LessonNumber/lesson.html" rel="noopener noreferrer">Illustrative Mathematics K–5 Grade 3, First Edition (2021)</a> (CC BY 4.0 where applicable). This independently written companion is an authoring candidate and has not passed source-perfect acceptance or CI.</p>
</main>
