@model Edulytics.Web.ViewModels.LessonContent.Grade3SourceCompanionPage
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Grade 3 · First-party lesson companion";
    var l = Model.Lesson;
    var roadSigns = Edulytics.Web.Curriculum.Grade3.Grade3SourceCompanionCatalogue.Local2021RoadSignGraph;
    var showRoadSigns = l.UnitNumber == 1 && (l.LessonNumber == 9 || l.LessonNumber == 10);
    var showMinuteClock = l.UnitNumber == 6 && l.LessonNumber == 9;
}
<style>
.g3-original{max-width:940px;margin:0 auto;padding:20px;color:#1e3d54}
.g3-original .panel{background:#fff;border:1px solid #d9e4ec;border-radius:14px;padding:22px;margin:16px 0}
.g3-original label{display:block;font-weight:700;margin:12px 0 5px}
.g3-original textarea,.g3-original input{padding:10px;width:100%;max-width:700px;border:1px solid #7d93a8;border-radius:8px;font:inherit}
.g3-original textarea:focus,.g3-original input:focus{outline:3px solid #b5dce8}
.g3-original button{padding:12px 20px;border:0;border-radius:8px;background:#167789;color:white;font:inherit;cursor:pointer}
.g3-original .ok{border-left:4px solid #21805a;padding-left:10px}
.g3-original .no{border-left:4px solid #ad3b45;padding-left:10px}
.g3-original .human{border-left:4px solid #b08b24;padding-left:10px}
.g3-original .source-chart{border-collapse:collapse;width:100%;margin:14px 0}
.g3-original .source-chart th,.g3-original .source-chart td{padding:9px;text-align:left;border-bottom:1px solid #d4e1e8}
.g3-original .source-pictogram{font-size:1.3rem;display:inline-block;margin-right:.35rem;color:#147b96}
.g3-original .source-scale{display:flex;justify-content:space-between;max-width:360px;font-variant-numeric:tabular-nums}
.g3-original .source-key{font-weight:700}
.g3-original .first-party-array{display:grid;gap:7px;width:max-content;max-width:100%;margin:12px 0;padding:12px;border:2px solid #8daeb7;border-radius:8px}
.g3-original .first-party-dot{display:block;background:#147b96;border-radius:50%;width:17px;height:17px}

</style>
<main class="g3-original">
    <a asp-controller="StudentPortal" asp-action="Lesson" asp-route-id="@Model.LessonId">← Back to lesson</a>
    <p>EDULYTICS · ORIGINAL COMPANION · GRADE 3 UNIT @l.UnitNumber LESSON @l.LessonNumber</p>
    <h1>@l.Title</h1>
    <p><strong>Learning goal:</strong> @l.StudentFacingGoal</p>
    <p>This is a separately authored skill practice supplement, not the original publisher worksheet or an approved school assessment. Teacher-led activities and original images must be studied with the teacher.</p>
    <form asp-controller="Grade3SourceCompanion" asp-action="Submit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="curriculumAdoptionId" value="@Model.CurriculumAdoptionId" />
        <input type="hidden" name="lessonId" value="@Model.LessonId" />
        @if(l.IndependentTeachingGuidance is not null) {
            <section class="panel">
                <h2>How to approach this lesson</h2>
                <ol>
                @foreach(var step in l.IndependentTeachingGuidance.TeachingSteps) {
                    <li>@step</li>
                }
                </ol>
                <p><strong>Check carefully:</strong> @l.IndependentTeachingGuidance.Caution</p>
                <p>These independently written learning notes supplement the 2021 source goal;
                    they do not replace teacher materials or certify the published Rich V2 content.</p>
            </section>
        }
        <section class="panel">
            <h2>1. Source activity context and teacher work</h2>
            <p>Read, discuss, or construct the named original 2021 lesson activities under your teacher's guidance. Their original figures and materials are not reproduced by this supplemental page.</p>
            <ul>
            @foreach(var name in l.SourceActivityNames) {
                <li>@name</li>
            }
            </ul>
            <p>@l.OpenTeacherTask</p>
            <label for="original-work">How did you represent and explain the original source activity?</label>
            <textarea id="original-work" name="SourceWorkReflection" rows="4" maxlength="2000">@Model.Answers.SourceWorkReflection</textarea>
        </section>
        @if(showRoadSigns) {
            <section class="panel" aria-label="Independently reconstructed 2021 road-sign data">
                <h2>Road signs as equal groups</h2>
                <p class="source-key">Key: one picture symbol represents two road signs.</p>
                <p>The numerical values below come from the local 2021 source description.
                    This is an original Edulytics data representation, not publisher artwork.</p>
                <table class="source-chart">
                    <caption>Signs observed on the way home</caption>
                    <thead>
                        <tr>
                            <th scope="col">Category</th>
                            <th scope="col">Picture symbols</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var category in roadSigns) {
                            <tr>
                                <th scope="row">@category.Category</th>
                                <td>
                                    @for(var symbol=0;symbol<category.SymbolCount;symbol++){
                                        <span class="source-pictogram" aria-hidden="true">■</span>
                                    }
                                    <span class="visually-hidden">@category.SymbolCount independently drawn symbols; two road signs per symbol</span>
                                </td>
                                    </tr>
                        }
                    </tbody>
                </table>
                <p>Count the picture symbols and use the key to work out the total. Symbol-count scale: 0, 1, 2, 3, 4, 5.
                    To count signs, multiply each category's symbol count by two.</p>
                <p><strong>Think and draw:</strong> Show the speed-limit signs as three
                    equal groups of two. Make a diagram for a different category and
                    compare your representation with your teacher or partner.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 9) {
            <section class="panel" aria-label="Source-aligned equal-groups constructions">
                <h2>Source Number Talk — four addition expressions in order</h2>
                <p>Mentally calculate 40 + 35, 45 + 35, 45 + 36, and 34 + 58. Discuss where a new ten is composed, and why each related expression changes from the previous one.</p>
                <h2>Source road-sign graph: three separate tasks</h2>
                <ol>
                    <li>Represent speed-limit signs using three groups of two.</li>
                    <li>Choose and justify the statement: three pictures, with two speed-limit signs per picture. Explain why the alternatives three pictures of one and two pictures of two are false.</li>
                    <li>Explain how five groups of two dots model the street-sign category.</li>
                </ol>
                <h2>Source equal-group situations: three different contexts</h2>
                <ol>
                    <li>Four people, each wearing two shoes: model four groups of two and explain the total.</li>
                    <li>Two boxes containing ten markers each: model two groups of ten and explain the total.</li>
                    <li>Three basketball teams with five players each: model three groups of five and explain the total.</li>
                </ol>
                <p>Use the original-work response field above for your calculations, diagrams and explanations. Draw the groups or use counters with a teacher; an integer-only response does not certify the source representations or partner discussion.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 10) {
            <section class="panel" aria-label="First edition 2021 lesson 10 original source sequence">
                <h2>Warm-up — six pairs of socks (10 minutes)</h2>
                <p>Notice and wonder: draw six SEPARATE pairs with TWO socks in each. There are 6 groups of 2, 12 socks. Explain your observations and question with a partner; the teacher checks the discussion.</p>
                <h2>Activity 1 — picture graph to equal-part tape (15 minutes)</h2>
                <p>Elena's scaled road-sign graph above has key one square = TWO signs. The three speed-limit squares correspond to this independently drawn tape model, not copied publisher artwork:</p>
                <div role="img" aria-label="A tape diagram with three equal partitions, each labelled two signs, so three groups of two total six" style="display:flex;max-width:480px;border:2px solid #1d5264;border-radius:6px;overflow:hidden;margin:12px 0;">
                    @for(var part=0;part<3;part++) {
                        <span style="flex:1;border-right:1px solid #1d5264;text-align:center;padding:18px 0;font-weight:700">2</span>
                    }
                </div>
                <p>Select and DRAW a different original category: Stop 2 groups of 2, Yield 1 group of 2, or Street 5 groups of 2. Explain what is the same and different compared with a picture graph. A teacher checks the representation and the partner dialogue.</p>
                <h2>Activity 2 — original A–L 12-card equal-groups sort (20 minutes)</h2>
                <p>The original first-edition card deck was examined: it has four situation cards A, B, D and J, and eight corresponding drawing/diagram cards. Use the source cards with your partner; match all FIVE sets: A–F–L (three groups of five), B–H–K (four groups of three), C–I (three groups of two), D–G (two groups of ten), E–J (three groups of ten). TWO are triples and THREE are pairs; the original deck does not have four matching triples. Explain how group counts and sizes agree. Give each pair ONE original printed deck.</p>
                <p><a href="https://cms-assets.illustrativemathematics.org/hed6b8kerveg64nag78blbcvj1jk" target="_blank" rel="noopener noreferrer">Official 2021 blackline masters ZIP — obtain the Equal Groups cards with your teacher</a>. This links to publisher-hosted source materials; Edulytics does not copy or claim rights over the original card images.</p>
                <ul>
                    <li>Situation A: THREE bags, FIVE footballs per bag → 3 groups of 5.</li>
                    <li>Situation B: FOUR boxes, THREE toy cars per box → 4 groups of 3.</li>
                    <li>Situation D: TWO boxes, TEN doughnuts per box → 2 groups of 10.</li>
                    <li>Situation J: THREE bins, TEN ice cubes per bin → 3 groups of 10.</li>
                    <li>Additional card-only pair C–I: three groups of two (no separate situation card).</li>
                </ul>
                <p>Now complete TWO DIFFERENT Student Facing source drawings: FOUR bags of TWO strawberries, and FOUR hands with FIVE fingers each. Draw group boundaries, not just the totals 8 and 20. Teacher reviews both drawings and explanations; the printed source card sort is teacher-led.</p>
                <h2>Lesson synthesis — FIRST introduce multiplication expressions (10 minutes)</h2>
                <p>Show a four-part tape, with each partition equal to five. FIRST NOW introduce the notation <strong>4 × 5</strong> as “four groups of five,” and explain which factor counts groups and which counts members. Do not present multiplication notation as a requirement during the two earlier activities.</p>
                <h2>Original 2021 Cool-down — Boxes of Shirts (5 minutes)</h2>
                <p>The first-edition teacher guide asks whether four boxes with ten shirts each match this mathematical tape structure. The diagram below is independently drawn, not publisher artwork:</p>
                <div role="img" aria-label="Four equal tape sections each labelled ten, representing four boxes with ten shirts apiece" style="display:flex;max-width:520px;border:2px solid #1d5264;border-radius:6px;overflow:hidden;margin:12px 0;">
                    @for(var box=0;box<4;box++){
                        <span style="flex:1;border-right:1px solid #1d5264;text-align:center;padding:18px 0;font-weight:700">10</span>
                    }
                </div>
                <p>The correct yes/no judgment is YES: there are four equal parts, each worth ten shirts. But the original task also requires the student's explanation, which ONLY a teacher judges. Complete source subtask 8 below.</p>
                <p>Extra independent Edulytics skill practice and its first-party Cool-down after the source task are OPTIONAL, not replacements for the original.</p>
                <p><a href="https://cms-assets.illustrativemathematics.org/o2ira4alq51xndabaydw0w2w0h1s" target="_blank" rel="noopener noreferrer">2021 original four-page Student Task Statements PDF (publisher)</a>. Teacher-only suggested centers: Capture Squares Stage 4 and Five in a Row Stage 7.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 11) {
            <section class="panel" aria-label="First-edition 2021 multiplication expression source activity">
                <h2>Warm-up (10 minutes): choral count</h2>
                <p>Count by 5 from 0 through 50, and by 2 from 0 through 20. Discuss why the last digits in the fives pattern alternate between 0 and 5. A teacher reviews the pattern explanation.</p>
                <h2>Activity 1 (10 minutes): source A–L card to expression</h2>
                <p>Your teacher distributes ONE source card from last lesson to each pair. Stand next to ONE of the five published expressions: <strong>3 × 5</strong>, <strong>4 × 3</strong>, <strong>3 × 2</strong>, <strong>2 × 10</strong>, <strong>3 × 10</strong>, then justify why the original card matches.</p>
                <p>The source deck matching sets have been visually checked: A–F–L ↔ 3 × 5, B–H–K ↔ 4 × 3, C–I ↔ 3 × 2, D–G ↔ 2 × 10, E–J ↔ 3 × 10. They are TWO triples and THREE pairs, not four triples. <a href="https://cms-assets.illustrativemathematics.org/hed6b8kerveg64nag78blbcvj1jk" target="_blank" rel="noopener noreferrer">Official original 2021 source card deck</a>.</p>
                <h2>Activity 2 (15 minutes): independently draw all four parts</h2>
                <ol>
                    <li>Draw FIVE equal groups of TWO for 5 × 2.</li>
                    <li>Draw THREE equal groups of FOUR for 3 × 4, then compare a drawing to a tape.</li>
                    <li>Draw THREE equal groups of TEN for 3 × 10.</li>
                    <li>Write an expression of your choice, create a correct matching diagram, and explain your reasoning.</li>
                </ol>
                <p>During source synthesis, discuss how 3 × 4 changes for 5 × 4 (more groups) or 3 × 5 (more in each group). The teacher must inspect all drawings and partner talk.</p>
                <h2>Activity 3 (10 minutes): ordered written expressions</h2>
                <p>Read the original first-edition student representations. Three dot cubes with three dots each → <strong>3 × 3</strong>; two equal tape sections each labelled four → <strong>2 × 4</strong>; two packs of water holding six bottles each → <strong>2 × 6</strong>. Write the expression for EACH source subtask below; an integer product alone does not pass.</p>
                <h2>Original first-edition 2021 Cool-down: Write an Expression (5 minutes)</h2>
                <p>Six envelopes each hold two notes. Enter the ordered multiplication expression <strong>6 × 2</strong> in source subtask 11 and explain which factor identifies envelopes and which identifies notes. A teacher judges the explanation. The OTHER first-party Edulytics 4 × 6 practice Cool-down is independent and OPTIONAL.</p>
                <p><a href="https://cms-assets.illustrativemathematics.org/0r8jr6l17d3mkw2bgcw14kewtax8" target="_blank" rel="noopener noreferrer">Original four-page 2021 Student Task Statements PDF</a>. Optional original centers: Capture Squares Stage 4 and Five in a Row Stage 7.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 12) {
            <section class="panel" aria-label="Independently drawn first-edition 2021 equal-group source lesson">
                <h2>Warm-up (10 minutes): two source-counted dot arrangements</h2>
                <p>The official 2021 publisher SVGs were checked. Picture A has FOUR arrays of two rows of FIVE dots (40 altogether). Picture B has THIRTY dots (six rows of five). The following dots are independently drawn Edulytics models, not publisher artwork. Explain how you grouped them with your partner.</p>
                <h3>Model A — four groups of ten (40)</h3>
                <div role="img" aria-label="Four bordered groups each containing a two-row-by-five-dot array, total forty dots" style="display:grid;grid-template-columns:repeat(2,max-content);gap:10px;max-width:100%">
                @for (var group=0;group<4;group++) {
                    <div style="display:grid;grid-template-columns:repeat(5,17px);gap:8px;padding:10px;border:2px solid #54798b">
                        @for (var i=0;i<10;i++) { <span class="first-party-dot" aria-hidden="true"></span> }
                    </div>
                }
                </div>
                <h3>Model B — six rows of five (30)</h3>
                <div role="img" aria-label="Thirty dots organised as six rows of five" style="display:grid;grid-template-columns:repeat(5,17px);gap:8px;padding:10px;border:2px solid #54798b;width:max-content;max-width:100%">
                    @for (var i=0;i<30;i++) { <span class="first-party-dot" aria-hidden="true"></span> }
                </div>
                <h2>Activity 1 (15 minutes): Co-Craft Questions BEFORE the full Tyler problem</h2>
                <p><strong>FIRST:</strong> Tyler has three boxes. Generate mathematical questions from this partial information: 2 minutes alone, then 2–3 minutes with a partner. Do NOT guess how many baseballs there are before the next reveal.</p>
                <p><strong>THEN:</strong> Each box contains exactly FIVE baseballs. Draw three groups of five and explain how a three-part tape represents <strong>3 × 5 = 15 baseballs</strong>.</p>
                <div role="img" aria-label="Three equal tape parts labelled five baseballs each, fifteen in total" style="display:flex;border:2px solid #54798b;max-width:450px">
                    @for (var part=0;part<3;part++) { <span style="flex:1;padding:16px;text-align:center;border-right:1px solid #54798b">5</span> }
                </div>
                <h2>Activity 2 (20 minutes): five source story contexts</h2>
                <ol><li>4 fields × 2 teams = 8 teams</li><li>7 windows × 2 glass panes = 14 panes</li><li>5 bags × 10 earrings = 50 earrings</li><li>4 boxes × 5 pencils = 20 pencils</li><li>3 bags × 10 carrots = 30 carrots</li></ol>
                <p>Enter each numeric total in its source-specific field below and provide a DIFFERENT labelled diagram or tape explanation in EACH corresponding reasoning field. Teacher checks the five representations; numeric correctness never substitutes for human review.</p>
                <h2>Lesson synthesis (10 minutes), then independent Cool-down (5 minutes)</h2>
                <p>Explain which representation helped you most: a drawing of groups, tape diagram or multiplication equation, and why. Teacher checks the response. Separate Edulytics original Cool-down: three groups of eight flags = 24. This does not copy the original educator-only Ducks in a Pond Cool-down. Teacher-led centers: Capture Squares Stage 5 and Five in a Row Stage 7.</p>
                <p>Original sources: <a href="https://cms-assets.illustrativemathematics.org/l4x26uaxct8u8w8giavhu61jlb8o" target="_blank" rel="noopener noreferrer">Student Task Statements (four-page publisher PDF)</a>, <a href="https://cms-assets.illustrativemathematics.org/7joeg3fb91042g156ctkkewns45f" target="_blank" rel="noopener noreferrer">warm-up SVG A</a>, <a href="https://cms-assets.illustrativemathematics.org/sqvpvucqrrlz1iihakjyzv051d7f" target="_blank" rel="noopener noreferrer">warm-up SVG B</a>. No original publisher images or third-party photographs are embedded in Edulytics.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 13) {
            <section class="panel" aria-label="Source multiplication equations visual and pedagogical context">
                <h2>Source warm-up: which one doesn't belong?</h2>
                <p>Compare a drawing of 3 groups of 5 dots, the expression 3 × 5, the equation 2 × 5 = 10 and the addition equation 7 + 8 = 15. Give more than one defensible answer and justify your classification with a partner. Original artwork is not copied here.</p>
                <h2>Source Activity 1: equation matching</h2>
                <p>The publisher's available equation list includes 3 × 5 = 15, 4 × 10 = 40, 2 × 10 = 20, 10 = 5 × 2, 30 = 6 × 5, 4 × 2 = 8, 16 = 8 × 2, 4 × 5 = 20, and 50 = 5 × 10. Match these with the nine original diagram or story cards as directed by your teacher. The third and eighth source pictures require original-material inspection; no substitute is presented as the original.</p>
                <h2>Source Activity 2: write an equation for every representation</h2>
                <p>Use the separately identified items below for all seven visible public descriptions. A full multiplication equation needs the correct factors, a product and the equals sign. Record the model, label the groups, and explain how factors and product connect to the drawing. The teacher compares original representations and confirms answers.</p>
                <p>During synthesis, explain the distinction between an expression such as 3 × 5 and a true equation such as 3 × 5 = 15.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 14) {
            <section class="panel" aria-label="Source multiplication with an unknown number">
                <h2>Source warm-up — multiplication by five</h2>
                <p>Work in the original order: 1 × 5, 2 × 5, 3 × 5, 4 × 5. Explain why the products increase by five as the number of groups increases.</p>
                <h2>Activity 1: original unknown-number card sort</h2>
                <p>The teacher supplies the actual printed Card Sort: Unknown Numbers. Match a situation, diagram and equation, and show whether the unknown is a FACTOR or the PRODUCT. The original card art is not available for first-party substitution.</p>
                <h2>Activity 2: represent both types of missing numbers</h2>
                <p>For 45 cards in packs of five, use □ × 5 = 45, not 5 × □ = 45 if the first factor is meant to count the packs. For five tape sections labelled two, use 5 × 2 = □; for six bags of ten balls, use 6 × 10 = □. Explain the meaning of the box and write the complete equation after finding its value.</p>
                <p>The two remaining publisher diagrams have ambiguous accessible image descriptions and require original-image teacher inspection. Do not assume their missing factors from alt text alone. Include a description in each teacher-only row.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 15) {
            <section class="panel" aria-label="Source three locations of a missing multiplication quantity">
                <h2>Source warm-up: tens in increasing equal groups</h2>
                <p>Calculate 1 × 10, 2 × 10, 3 × 10 and 4 × 10 mentally. Explain why the result increases by exactly ten.</p>
                <h2>Source Activity 1: three stories, different unknowns</h2>
                <p>For fifteen plates on tables of five, □ × 5 = 15 asks for the number of TABLES. Six sandwiches with two bread slices each, 6 × 2 = □ asks for a TOTAL. Sixty ice cubes in trays of ten, □ × 10 = 60 asks for the number of TRAYS. Include a drawing, equation, units and solution for each.</p>
                <h2>Source Activity 2: multiplication mashup</h2>
                <p>Find all five answers in the individual source items below. The sequence of sixteen socks in piles of two, eight piles of two, and sixteen socks divided into eight same-sized groups deliberately changes what is unknown: number of groups, total number of objects, and number in each group. Do NOT mark all three as the same question family. Teachers review the model and missing-variable meaning, not merely the correct number.</p>
                <p>In the lesson's comparison discussion, explain when drawings, tape diagrams, skip-counting or equations help. Repeated addition may be a calculation method but should not be presented as the complete meaning of multiplication.</p>
                <h2>First-party visual model — eight equal groups of two</h2>
                <p>In the source Student Section Summary, Diego's eight groups of two socks
                    are explained by a group drawing, an eight-part tape and the
                    expression 8 × 2 and equation 8 × 2 = 16.
                    The boxes below are a NEW Edulytics representation of the
                    verified group counts, not the publisher's original picture.</p>
                <div role="img" aria-label="Eight equal boxes, each with the number two: 8 groups of 2 socks, total 16 socks."
                     style="display:flex;flex-wrap:wrap;gap:0;max-width:680px;border:2px solid #54798b;border-radius:5px;overflow:hidden;margin:12px 0">
                    @for(var group=0;group<8;group++){
                        <div style="box-sizing:border-box;flex:1 0 12.5%;min-width:68px;padding:14px 3px;border-right:1px solid #54798b;text-align:center;font-variant-numeric:tabular-nums">2</div>
                    }
                </div>
                <h3>New Edulytics group drawing — sixteen as eight pairs</h3>
                <p>The first-edition source drawing contains eight separate equal groups,
                    arranged in two rows of four, with two countable objects in every group.
                    The drawing below was independently constructed for Edulytics.
                    Each outlined region represents ONE group, not an individual object.</p>
                <div role="img" aria-label="Eight distinct groups in two rows of four. Each group encloses exactly two countable dots, representing sixteen socks in total."
                     style="display:grid;grid-template-columns:repeat(4,minmax(48px,1fr));gap:12px;max-width:560px;margin:12px 0">
                    @for(var pair=0;pair<8;pair++){
                        <div aria-hidden="true" style="display:flex;align-items:center;justify-content:center;gap:8px;min-height:62px;border:2px dashed #346982;border-radius:18px;background:#f4f9fb">
                            <span style="display:block;width:18px;height:18px;border-radius:50%;background:#147b96"></span>
                            <span style="display:block;width:18px;height:18px;border-radius:50%;background:#147b96"></span>
                        </div>
                    }
                </div>
                <p><strong>Compare the two representations:</strong> count the groups,
                    then count the objects in each group. Both show 8 × 2 = 16.
                    A teacher reviews the learner's explanation; the picture alone
                    is not an automatically graded source task.</p>
                <p><strong>Groups:</strong> eight. <strong>Each group:</strong> two.
                    <strong>Total:</strong> sixteen. <strong>Expression:</strong> 8 × 2.
                    <strong>Equation:</strong> 8 × 2 = 16.
                    Have the teacher compare this independently drawn model with
                    the actual 2021 Section Summary before claiming visual parity.</p>
                <h2>Reasoning, access and suggested practice centers</h2>
                <p>Engagement support for Activity 1: break each of the three
                    equation-and-solution stories into smaller steps and check progress.
                    MLR8 Discussion Supports for Activity 2: identify unfamiliar
                    vocabulary before the partner work, then ask the learner to
                    explain which quantity is missing in each of the five stories.</p>
                <p>After this source lesson, teacher-led suggested centers are
                    Capture Squares, Stage 5 (Multiply with 2, 5, and 10),
                    and Five in a Row, Stage 8 (Add within 1,000 with Composing).
                    These are optional classroom centers, not an automatic score.</p>
                <p>Teacher reflection: consider whose strategies were heard,
                    valued and accepted within the small-group conversation.
                    The independently authored Edulytics socks Cool-down below
                    is separate from the publisher's first-edition Solve the Problem assessment.</p>
                <h2>Verified first-edition 2021 source Cool-down — two independent tasks</h2>
                <p>The first-edition 2021 IM teacher guide (Unit 1 Lesson 15,
                    <a href="https://device.report/m/3299ef5a5a01a797f481c7adad78de2329a1c9b37d3043db91142e3cb01028cf"
                       target="_blank" rel="noopener noreferrer">K5_v1 teacher guide source</a>)
                    identifies two mathematics problems: four boxes with ten toys
                    each (unknown total), and ten socks distributed into equal
                    piles of two (unknown number of piles). The two individually
                    paraphrased source items appear BELOW; enter their answers
                    separately and SHOW the reasoning for each. A teacher must
                    assess the strategy. The source's original teacher-facing
                    printed layout and associated media have not been reused.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 16) {
            <section class="panel" aria-label="Original Edulytics array representation, not publisher artwork">

                <h2>Three independent Edulytics representations of the 2021 source mathematics</h2>
                <p>The first-edition source warm-up shows twelve eggs in two equal rows of six.
                    The first-party diagram below uses counting tokens rather than the publisher photograph.
                    Notice and wonder, then identify equal rows and columns without changing the total.</p>
                <div role="img" aria-label="First-party twelve-token egg-carton mathematical model: two rows with six tokens in each row; six columns with two tokens each."
                     style="display:grid;grid-template-columns:repeat(6,minmax(28px,40px));gap:6px;max-width:300px;margin:12px 0">
                    @for(var egg=0;egg<12;egg++){
