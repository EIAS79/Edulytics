                             style="display:grid;grid-template-columns:repeat(4,13px);gap:6px;margin-top:8px">
                            @for(var tree=0;tree<8;tree++){
                                <span aria-hidden="true" style="width:11px;height:11px;border-radius:50% 50% 35% 35%;background:#41795d;border-bottom:3px solid #81674b"></span>
                            }
                        </div>
                    </div>
                </div>                <p>The original coconut-tree photograph may have third-party attribution; it is not reproduced here. Teacher checks actual diagrams and source question discussions.</p>
            </section>
        }
        @if(l.UnitNumber == 1 && l.LessonNumber == 20) {
            <section class="panel" aria-label="Source commutative array tasks">
                <h2>Warm-up: subtract by place value</h2>
                <p>Calculate 70 − 10, 68 − 10, 70 − 12 and 68 − 12 mentally, in that order. Discuss the tens and ones, then compare strategies with a partner.</p>
                <h2>Activity 1: same ten dots, two array situations</h2>
                <p>These two arrays are independently drawn examples, not copied publisher images. Invent a different REAL-WORLD situation for each array. Describe 2 groups of 5 in Image A and 5 groups of 2 in Image B.</p>
                <div class="two">
                    <div><strong>Image A: two horizontal groups of five</strong>
                        <div role="img" aria-label="Independent model: two horizontal enclosed groups, five blue dots in each group, total ten."
                             style="display:flex;flex-direction:column;gap:8px;max-width:240px;margin-top:12px">
                            @for(var row=0;row<2;row++){
