      "LessonCode": "PED:UAE-MOE-MATH:L8:GENERAL:01:01:RATIONAL-NUMBERS",
      "CultureCode": "ar",
      "Title": "الأعداد النسبية",
      "ExplanationParagraphs": [
        "العدد النسبي يمكن كتابته أ/ب حيث أ وب صحيحان وب≠0، فتندرج فيه الأعداد الصحيحة والكسور والعشريات المنتهية والدورية.",
        "3/8 = 0.375 عشري منتهٍ، و2/3 = 0.666... عشري دوري. التوسع غير المنتهي غير الدوري ليس عددًا نسبيًا.",
        "لاستخراج كسر من عشري دوري اضرب قيمة س في قوة 10 بطول الدورة ثم اطرح س لإزالة التكرار."
      ],
      "KeyConcepts": [
        {
          "Title": "تعريف العدد النسبي",
          "Definition": "كسر أ/ب ببسط ومقام صحيحين ومقام غير صفري.",
          "Rule": "القسمة على صفر غير معرفة.",
          "Example": "-4=-4/1، 3/8=0.375"
        },
        {
          "Title": "عشري منتهٍ",
          "Definition": "ينتهي بعد عدد محدد من المنازل.",
          "Rule": "عشري إلى كسر مقامه قوة للعدد عشرة، ثم تبسيط.",
          "Example": "0.125=1/8"
        },
        {
          "Title": "عشري دوري",
          "Definition": "يحتوي تسلسلًا يتكرر بلا توقف.",
          "Rule": "أزل الدورة بالطرح بعد الضرب في 10 أو 100.",
          "Example": "0.272727...=3/11"
        },
        {
          "Title": "احتواء المجموعات",
          "Definition": "الطبيعية ضمن الكلية ضمن الصحيحة ضمن النسبية.",
          "Rule": "كل صحيح نسبي وليس كل نسبي صحيحًا.",
          "Example": "1/2 نسبي وليس صحيحًا."
        }
      ],
      "WorkedExamples": [
        {
          "Title": "كسر وعشري",
          "Question": "كم يساوي 5/8؟",
          "Method": "القسمة",
          "Steps": [
            "اقسم 5 على 8.",
            "الناتج 0.625.",
            "تحقق 0.625×8=5."
          ],
          "Answer": "0.625",
          "Check": "المقام 8 غير صفري."
        },
        {
          "Title": "تكرار خانتين",
          "Question": "حول 0.272727... إلى كسر.",
          "Method": "معادلة الدورة",
          "Steps": [
            "ضع س=0.272727...",
            "اضرب 100س=27.272727...",
            "اطرح، فيكون 99س=27.",
            "س=27/99=3/11."
          ],
          "Answer": "3/11",
          "Check": "3÷11=0.272727..."
        },
        {
          "Title": "تحويل منتهٍ",
          "Question": "ما أبسط صورة لـ0.45؟",
          "Method": "اكتب مقام 100",
          "Steps": [
            "0.45=45/100",
            "اقسم البسط والمقام على 5.",
            "الناتج 9/20."
          ],
          "Answer": "9/20",
          "Check": "9÷20=0.45."
        }
      ],
      "CommonMistakes": [
        {
          "Mistake": "كل عدد عشري غير منتهٍ غير نسبي.",
          "WhyWrong": "العشري الدوري نسبي.",
          "Correction": "0.333...=1/3."
        },
        {
          "Mistake": "0.272727... يساوي 27/100.",
          "WhyWrong": "27/100 منتهٍ.",
          "Correction": "27/99=3/11."
        },
        {
          "Mistake": "فقدان إشارة السالب.",
          "WhyWrong": "-5/8 لا يساوي 0.625.",
          "Correction": "-5/8=-0.625."
        }
      ],
      "SummaryPoints": [
        "أحدد أ/ب بشرط ب≠0.",
        "أميز بين العشري المنتهي والدوري.",
        "أحول الكسور والعشريات وأتحقق بعكس العملية.",
        "Cool-down أصلي: -3/8 عشريًا، 0.24 كسرًا مبسطًا، و0.454545... كسرًا مع برهان يراجعه المعلم."
      ],
