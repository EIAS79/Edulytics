          "Answer": "٤س(٣س−٢)",
          "Check": "التوزيع ١٢س²−٨س"
        },
        {
          "Title": "سالب في التحليل",
          "Question": "حلل −١٠س−١٥.",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "العامل المشترك ٥ ويمكن اختيار −٥.",
            "اقسم كل حد على −٥.",
            "اكتب −٥(٢س+٣)."
          ],
          "Answer": "−٥(٢س+٣)",
          "Check": "التوزيع −١٠س−١٥"
        },
        {
          "Title": "مساحة مستطيل",
          "Question": "إذا كانت المساحة ٨س+١٢، فاكتب حاصل ضرب مع طول ٤.",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "٤ يقسم كلا الحدين.",
            "٨س÷٤=٢س و١٢÷٤=٣.",
            "الأبعاد ٤ و(٢س+٣)."
          ],
          "Answer": "٤(٢س+٣)",
          "Check": "٤×(٢س+٣)=٨س+١٢"
        }
      ],
      "CommonMistakes": [
