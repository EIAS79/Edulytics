      "Title": "الأسس النسبية",
      "ExplanationParagraphs": [
        "الأس م/ن يمكن تفسيره بأنه الجذر النوني ثم الرفع إلى قوة البسط م، مع التأكد من وجود الجذر في مجموعة الأعداد المعنية.",
        "إذا كان الأس سالبًا نحسب مقلوب قيمة الأس الموجب، بشرط ألا يساوي الأساس صفرًا.",
        "الجذر الزوجي الحقيقي للعدد السالب غير موجود، بينما الجذر الفردي الحقيقي لعدد سالب موجود.",
        "في الأسس الكسرية التي لا تعطي نتيجة صحيحة نكتب الناتج الجذري الدقيق، ولا ننسب للتصحيح الرقمي قدرة على تقييم التبرير الرمزي."
      ],
      "KeyConcepts": [
        {
          "Title": "الأس الكسري والجذر",
          "Definition": "مقام الأس يمثل رتبة الجذر وبسطه قوة الناتج.",
          "Rule": "أ^(م/ن)=(ⁿ√أ)^م حيث الجذر معرف.",
          "Example": "٢٧^(٢/٣)=٩."
        },
        {
          "Title": "الأس الكسري السالب",
          "Definition": "الأس السالب يطلب المقلوب.",
          "Rule": "أ^(−م/ن)=١/أ^(م/ن) عندما أ≠٠.",
          "Example": "١٦^(−٣/٤)=١/٨."
        },
        {
          "Title": "مجال الجذور",
          "Definition": "الجذر النوني الزوجي للعدد السالب غير معرف على الأعداد الحقيقية.",
          "Rule": "إذا ن زوجي نحتاج أ≥٠؛ والأس السالب يتطلب أيضًا أ≠٠.",
          "Example": "(−١٦)^(١/٤) ليس عددًا حقيقيًا."
        }
      ],
