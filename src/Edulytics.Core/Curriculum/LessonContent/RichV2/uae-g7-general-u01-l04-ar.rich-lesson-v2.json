      "Title": "العلاقات التناسبية وغير التناسبية",
      "ExplanationParagraphs": [
        "النسبة الثابتة بين قيمتين متناظرتين تؤكد التناسب عندما يكون النموذج y=kx ويمر بالأصل.",
        "الزيادة الثابتة قد تنتج من قاعدة y=kx+b برسم بدء b؛ هذه ليست تناسبًا عندما b لا يساوي الصفر.",
        "أجب عن سؤال لكل صف في الجدول: هل النسبة y/x متساوية؟ وقارنها بالرسم والسيناريو. يراجع المعلم صحة المحاور وتبرير الطالب."
      ],
      "KeyConcepts": [
        {
          "Title": "تناسب مباشر",
          "Definition": "نسبة ثابتة ومبدأ عند الصفر",
          "Rule": "y=kx",
          "Example": "x=1،2،3؛ y=5،10،15."
        },
        {
          "Title": "غير تناسبي",
          "Definition": "نسب مختلفة أو رسم بدء غير صفري",
          "Rule": "y=kx+b عندما b لا يساوي صفرًا غير تناسب مباشر",
          "Example": "y=4x+9."
        },
        {
          "Title": "ثابت التناسب",
          "Definition": "الناتج الدقيق y÷x",
          "Rule": "k=y/x مع x≠0، وواحدات صحيحة",
          "Example": "63 درهمًا/7 ساعات =9 دراهم/ساعة."
        }
      ],
      "WorkedExamples": [
        {
          "Title": "جدول ثابت النسبة",
          "Question": "وزن الفاكهة 1،2،3 كغ وكلفتها 5،10،15 درهمًا؛ هل العلاقة تناسبية؟",
          "Method": "قسمة المخرجات على المدخلات",
          "Steps": [
            "5/1=5 و10/2=5 و15/3=5.",
            "كل النسب تساوي 5.",
            "المعادلة y=5x وتمُر بالأصل."
          ],
          "Answer": "تناسبية وثابت التناسب 5 دراهم/كغ",
          "Check": "3×5=15."
        },
        {
          "Title": "رسوم بداية",
          "Question": "شركة توصيل تتقاضى 9 دراهم رسم بدء و4 لكل صندوق؛ هل الأسعار متناسبة مع عدد الصناديق؟",
          "Method": "فحص الصفر ونسب الجدول",
          "Steps": [
            "0 صناديق يكلف 9 دراهم.",
            "1،2،3 صناديق تكلف 13،17،21.",
            "النسب 13،8.5،7 ليست ثابتة."
          ],
          "Answer": "غير تناسبية",
          "Check": "y=4x+9."
        },
        {
          "Title": "صف شاذ",
          "Question": "قرأ متعلم 6،12،19 صفحة في 4،8،12 دقيقة؛ هل المعدل ثابت؟",
          "Method": "فحص جميع الصفوف",
          "Steps": [
            "6/4=1.5 و12/8=1.5.",
            "19/12 مختلف عن 1.5.",
            "العلاقة ليست تناسبية رغم أول صفين."
          ],
          "Answer": "غير تناسبية",
          "Check": "12×1.5=18 وليس 19."
        }
      ],
      "CommonMistakes": [
        {
          "Mistake": "كل زيادة ثابتة تعني تناسبًا.",
          "WhyWrong": "وجود رسم ثابت قد يجعل النسبة مختلفة.",
          "Correction": "احسب y/x لكل زوج وافحص y عند الصفر."
        },
        {
          "Mistake": "التحقق من نقطتين فقط.",
          "WhyWrong": "قد توجد قيمة شاذة في صف لاحق.",
          "Correction": "افحص كل أزواج المصدر."
        },
        {
          "Mistake": "حساب 0/0 ضمن ثابت التناسب.",
          "WhyWrong": "هذه القسمة غير معرفة.",
          "Correction": "افحص الأصل دون قسمة على صفر."
        }
      ],
      "SummaryPoints": [
        "علاقة y=kx تناسب مباشر.",
        "علاقة y=kx+b ليست تناسبًا مباشرًا إذا b≠0.",
        "ثابت التناسب حاصل y/x بوحدته.",
        "رسم المستقيم يجب أن يمر بالأصل.",
        "Cool-down: جداول تناسبية وغير تناسبية، وشرح أثر رسم البدء؛ الرسم يراجع بواسطة المعلم."
      ],
