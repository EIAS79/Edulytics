    {
      "LessonCode": "PED:UAE-MOE-MATH:L10:GENERAL:UNIFIED:U14:L02:C108",
      "CultureCode": "ar",
      "Title": "الزوايا وقياسها",
      "ExplanationParagraphs": [
        "الزاوية في الوضع القياسي يبدأ ضلعها الابتدائي من محور السينات الموجب. الدورة الكاملة ٣٦٠°=٢π راديان؛ لذا التحويل إلى راديان يكون بالضرب في π/١٨٠، وإلى درجات بالضرب في ١٨٠/π. الزوايا المشتركة في ضلع الانتهاء تختلف بمضاعفات ٣٦٠°.",
        "تكون الزاوية موجبة عند الدوران عكس عقارب الساعة وسالبة مع عقاربها. تحدد الزاوية الموجهة مقدار الدوران واتجاهه، وقد تتجاوز دورة كاملة. إذا كانت θ بالدرجات فإن جميع الزوايا المشتركة في ضلع الانتهاء هي θ+360k حيث k عدد صحيح. لإيجاد ممثلها ضمن [0°,360°) أضف أو اطرح دورات كاملة.",
        "الراديان هو قياس زاوية مركزية طول قوسها يساوي نصف قطر الدائرة. بما أن محيط الدائرة 2πr، فإن الدورة الكاملة 2π راديان. احسب طول القوس s=rθ عندما θ بالراديان وθ≥0؛ إذا كانت بالدرجات حوّلها أولًا. ولإيجاد زاوية من طول القوس استعمل θ=s/r.",
        "من التطبيقات دوران جسم بعدد دورات كسري، وتحديد موضع ضلع الانتهاء، وحساب المسافة المقطوعة على مسار دائري. عند حساب المسافة لا تستخدم قياسًا سالبًا للطول؛ فرّق بين اتجاه الدوران ومقداره.",
        "استقصاء هندسي ملحق: إذا كان ضلعا متوازي الأضلاع a وb والزاوية المحصورة θ بينهما، فإن الارتفاع إلى القاعدة b هو a sin θ، ومن ثم A=ab sin θ. للزاوية المنفرجة تكون قيمة الجيب مساوية لجيب الزاوية المكملة، وتبقى المساحة موجبة."
      ],
      "KeyConcepts": [
        {
          "Title": "الوضع القياسي",
          "Definition": "رأس الزاوية الأصل وضلع ابتدائي على محور x الموجب",
          "Rule": "عكس عقارب الساعة موجب، ومعها سالب",
          "Example": "−90° ينتهي على محور y السالب"
        },
        {
          "Title": "زوايا مشتركة",
          "Definition": "ضلع انتهاء واحد",
          "Rule": "θ+360°k أو θ+2πk",
          "Example": "750° و30°"
        },
        {
          "Title": "تحويل الوحدات",
          "Definition": "الدورة =360°=2π rad",
          "Rule": "درجات×π/180؛ راديان×180/π",
          "Example": "−225°=−5π/4"
        },
        {
          "Title": "طول القوس",
          "Definition": "القياس بالراديان",
          "Rule": "s=rθ، θ=s/r",
          "Example": "r=6، θ=π/3: s=2π"
        },
        {
          "Title": "متوازي الأضلاع",
          "Definition": "قاعدة × ارتفاع",
          "Rule": "A=ab sin θ",
          "Example": "a=8,b=5,θ=30°: A=20"
        }
      ],
      "WorkedExamples": [
        {
          "Title": "مثال حساب مثلثي 1",
          "Question": "حوّل ١٨٠° إلى راديان",
          "Method": "الزوايا وقياسها",
          "Steps": [
            "١٨٠×π/١٨٠",
            "إذن النتيجة π"
          ],
          "Answer": "π",
          "Check": "تحقق باستخدام 180°=π أو بطرح الدورات الكاملة."
        },
        {
          "Title": "مثال حساب مثلثي 2",
          "Question": "حوّل ٩٠° إلى راديان",
          "Method": "الزوايا وقياسها",
          "Steps": [
            "٩٠×π/١٨٠",
            "إذن النتيجة π/٢"
          ],
          "Answer": "π/٢",
          "Check": "تحقق باستخدام 180°=π أو بطرح الدورات الكاملة."
        },
        {
          "Title": "مثال حساب مثلثي 3",
          "Question": "حوّل ٦٠° إلى راديان",
          "Method": "الزوايا وقياسها",
          "Steps": [
            "٦٠×π/١٨٠",
            "إذن النتيجة π/٣"
          ],
          "Answer": "π/٣",
          "Check": "تحقق باستخدام 180°=π أو بطرح الدورات الكاملة."
        },
        {
          "Title": "مثال حساب مثلثي 4",
          "Question": "حوّل ٣π/٢ إلى درجات",
          "Method": "الزوايا وقياسها",
          "Steps": [
            "(٣π/٢)×١٨٠/π",
            "إذن النتيجة ٢٧٠°"
          ],
          "Answer": "٢٧٠°",
          "Check": "تحقق باستخدام 180°=π أو بطرح الدورات الكاملة."
        },
        {
          "Title": "مثال حساب مثلثي 5",
          "Question": "زاوية مشتركة مع ٣٠° بعد دورة موجبة؟",
          "Method": "الزوايا وقياسها",
          "Steps": [
            "٣٠+٣٦٠",
            "إذن النتيجة ٣٩٠°"
          ],
          "Answer": "٣٩٠°",
          "Check": "تحقق باستخدام 180°=π أو بطرح الدورات الكاملة."
        },
        {
          "Title": "مثال حساب مثلثي 6",
          "Question": "زاوية مشتركة مع ٣٠° بعد دورة سالبة؟",
          "Method": "الزوايا وقياسها",
          "Steps": [
            "٣٠−٣٦٠",
            "إذن النتيجة −٣٣٠°"
          ],
          "Answer": "−٣٣٠°",
          "Check": "تحقق باستخدام 180°=π أو بطرح الدورات الكاملة."
        },
        {
          "Title": "زاوية موجهة",
          "Question": "حدد ضلع انتهاء −450°.",
          "Method": "قياس الزوايا",
          "Steps": [
            "أضف 720° فنحصل على 270°",
            "270° على محور y السالب"
          ],
          "Answer": "محور y السالب",
          "Check": "−450+720=270."
        },
        {
          "Title": "دوران أكبر من دورة",
          "Question": "أوجد ممثل 1170° في [0°,360°).",
          "Method": "قياس الزوايا",
          "Steps": [
            "1170−3×360=90"
          ],
          "Answer": "90°",
          "Check": "0≤90<360."
        },
        {
          "Title": "زاويتان مشتركتان",
          "Question": "أوجد زاوية موجبة وأخرى سالبة مشتركتين مع 135°.",
          "Method": "قياس الزوايا",
          "Steps": [
            "135+360=495",
            "135−360=−225"
          ],
          "Answer": "495°، −225°",
          "Check": "الفرق مع 135 مضاعف صحيح لـ360."
        },
        {
          "Title": "الدرجات السالبة",
          "Question": "حوّل −225° إلى راديان.",
          "Method": "قياس الزوايا",
          "Steps": [
            "−225×π/180",
            "اختصر 225/180=5/4"
          ],
          "Answer": "−5π/4",
          "Check": "−5π/4×180/π=−225."
        },
        {
          "Title": "راديان إلى درجات",
          "Question": "حوّل 7π/6 إلى درجات.",
          "Method": "قياس الزوايا",
          "Steps": [
            "7π/6×180/π=7×30"
          ],
          "Answer": "210°",
          "Check": "210° في الربع الثالث."
        },
        {
          "Title": "الزاوية المكافئة بالراديان",
          "Question": "أوجد ممثل −7π/4 في [0,2π).",
          "Method": "قياس الزوايا",
          "Steps": [
            "−7π/4+8π/4=π/4"
          ],
          "Answer": "π/4",
          "Check": "الفرق دورة كاملة."
        },
        {
          "Title": "طول القوس",
          "Question": "دائرة نصف قطرها 9 سم وزاوية مركزية π/3. أوجد طول القوس.",
          "Method": "قياس الزوايا",
          "Steps": [
            "s=9×π/3"
          ],
          "Answer": "3π سم",
          "Check": "القوس سدس المحيط."
        },
        {
          "Title": "قوس بالدرجات",
          "Question": "نصف القطر 12 م وزاوية 150°. أوجد طول القوس.",
          "Method": "قياس الزوايا",
          "Steps": [
            "150°=5π/6",
            "s=12×5π/6"
          ],
          "Answer": "10π م",
          "Check": "10π<24π."
        },
        {
          "Title": "إيجاد القياس",
          "Question": "قوس طوله 7 سم ونصف قطره 4 سم. أوجد زاويته بالراديان.",
          "Method": "قياس الزوايا",
          "Steps": [
            "θ=s/r=7/4"
          ],
          "Answer": "7/4 راديان",
          "Check": "4×7/4=7."
        },
        {
          "Title": "إيجاد نصف القطر",
          "Question": "طول قوس 15 سم وقياس زاويته 2.5 راديان.",
          "Method": "قياس الزوايا",
          "Steps": [
            "r=s/θ=15/2.5"
          ],
          "Answer": "6 سم",
          "Check": "6×2.5=15."
        },
        {
          "Title": "دوران عجلة",
          "Question": "عجلة نصف قطرها 0.4 م تدور 2.5 دورة دون انزلاق. أوجد المسافة.",
          "Method": "قياس الزوايا",
          "Steps": [
            "θ=2.5×2π=5π",
            "s=0.4×5π"
          ],
          "Answer": "2π م ≈ 6.28 م",
          "Check": "دورة واحدة طولها 0.8π."
        },
        {
          "Title": "مساحة متوازي الأضلاع",
          "Question": "ضلعان متجاوران طولهما 8 و5 سم والزاوية المحصورة 30°. أوجد المساحة.",
          "Method": "قياس الزوايا",
          "Steps": [
            "h=8 sin30=4",
            "A=5×4"
          ],
          "Answer": "20 سم²",
          "Check": "8×5×1/2=20."
        },
        {
          "Title": "زاوية منفرجة ومساحة",
          "Question": "ضلعان 10 و6 والزاوية المحصورة 150°.",
          "Method": "قياس الزوايا",
          "Steps": [
            "sin150=sin30=1/2",
            "A=10×6×1/2"
          ],
          "Answer": "30 وحدة²",
          "Check": "الارتفاع العمودي موجب."
        }
