      "Title": "طرح التعابير الخطية",
      "ExplanationParagraphs": [
        "لطرح تعبير خطي من تعبير خطي آخر، نكتب الفرق بين التعبيرين داخل أقواس ونوزّع الإشارة السالبة على كل حد في التعبير الثاني، ثم نجمع الحدود المتشابهة. مثال: (٧س+٥)−(٣س+٨)=٧س+٥−٣س−٨=٤س−٣.",
        "طرح سالب يعني إضافة المقابل: (٢س−٤)−(−٣س+٦)=٢س−٤+٣س−٦=٥س−١٠. لا يجوز تغيير إشارة أول حد فقط في القوس المطروح؛ يجب عكس إشارات جميع حدود القوس.",
        "يمكن استخدام التعابير الخطية للمقارنة بين تكلفة خطتين أو فارق محيطين. إذا كانت تكلفة أ =٤س+٢٠ وتكلفة ب =٢س+٣٢، فالفرق أ−ب=٢س−١٢، وقد يكون سالبًا عندما ب أغلى. التحقق يكون بإحلال قيم مناسبة وإيجاد الفرق مباشرة."
      ],
      "KeyConcepts": [
        {
          "Title": "طرح الأقواس",
          "Definition": "عكس إشارة كل حد في التعبير المطروح",
          "Rule": "أ−(ب+ج)=أ−ب−ج",
          "Example": "(٧س+٥)−(٣س+٨)=٤س−٣"
        },
        {
          "Title": "طرح تعبير سالب",
          "Definition": "طرح السالب يصبح جمع المقابل",
          "Rule": "أ−(−ب)=أ+ب",
          "Example": "٢س−(−٣س)=٥س"
        },
        {
          "Title": "تجميع متشابه",
          "Definition": "بعد إزالة الأقواس أجمع المعاملات والثوابت",
          "Rule": "٧س−٣س=٤س",
          "Example": "٥−٨=−٣"
        },
        {
          "Title": "فرق موجه",
          "Definition": "قيمة أ−ب قد تكون سالبة",
          "Rule": "الفرق يتأثر بترتيب التعبيرين",
          "Example": "عندما س=٢، ٢س−١٢=−٨"
        }
      ],
      "WorkedExamples": [
        {
          "Title": "فرق تعبيرين",
          "Question": "بسط (٧س+٥)−(٣س+٨).",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "افتح السالب: ٧س+٥−٣س−٨.",
            "اجمع ٧س−٣س=٤س.",
            "٥−٨=−٣."
          ],
          "Answer": "٤س−٣",
          "Check": "س=٢ يعطي ٥"
        },
        {
          "Title": "طرح سالب",
          "Question": "احسب (٢س−٤)−(−٣س+٦).",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "اقلب إشارات القوس الثاني.",
            "٢س−٤+٣س−٦.",
            "النتيجة ٥س−١٠."
          ],
          "Answer": "٥س−١٠",
          "Check": "س=٢ يعطي صفرًا"
        },
        {
          "Title": "فرق تكاليف",
          "Question": "أ=٤س+٢٠، ب=٢س+٣٢. اكتب أ−ب.",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "ضع الأقواس.",
            "٤س+٢٠−٢س−٣٢.",
            "اجمع إلى ٢س−١٢."
          ],
          "Answer": "٢س−١٢",
          "Check": "س=١٠ يعطي ٨"
        },
        {
          "Title": "طرح متغيرين",
          "Question": "بسط (٥س+٢ص)−(س−٣ص).",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "اقلب إشارات الثاني إلى −س+٣ص.",
            "٥س−س=٤س.",
            "٢ص+٣ص=٥ص."
          ],
          "Answer": "٤س+٥ص",
          "Check": "س=١ وص=١ يعطي ٩"
        }
      ],
      "CommonMistakes": [
        {
          "Mistake": "عكس إشارة أول حد فقط",
          "WhyWrong": "الطرح يطبق على جميع حدود القوس",
          "Correction": "وزّع −١ على الكل"
        },
