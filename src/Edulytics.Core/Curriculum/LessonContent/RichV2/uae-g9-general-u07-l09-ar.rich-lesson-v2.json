        {
          "Title": "حل باستخدام ±",
          "Question": "حل (س−٢)²=٢٥.",
          "Method": "إخراج الجذر مع ±.",
          "Steps": [
            "س−٢=±٥.",
            "س=٢+٥ أو س=٢−٥.",
            "س=٧ أو س=−٣."
          ],
          "Answer": "س=−٣ أو س=٧",
          "Check": "(−٣−٢)²=٢٥ و(٧−٢)²=٢٥."
        },
        {
          "Title": "عدد غير مربع كامل",
          "Question": "حل س²=١٠.",
          "Method": "الحل الجذري الدقيق.",
          "Steps": [
            "س=±√١٠.",
            "لا نختزل √١٠ إلى عدد صحيح.",
            "التعويض يعيد ١٠ في الحالتين."
          ],
          "Answer": "س=−√١٠ أو √١٠",
          "Check": "(±√١٠)²=١٠."
