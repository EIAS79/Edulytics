      "Title": "ترتيب العمليات",
      "ExplanationParagraphs": [
        "التعبير الرياضي يحتوي أعدادًا وعمليات، وقد يتضمن أقواسًا أو متغيرات.",
        "وجود الأقواس يعني تنفيذ ما بداخلها أولًا، ثم الضرب والقسمة، ثم الجمع والطرح.",
        "الالتزام بترتيب العمليات يجعل الجميع يصل إلى الناتج نفسه."
      ],
      "KeyConcepts": [
        {
          "Title": "الأقواس",
          "Definition": "رموز تحدد مجموعة عمليات تُنفذ أولًا.",
          "Rule": "أحسب داخل القوس أولًا.",
          "Example": "(٨+٥)×٢=٢٦."
        },
        {
          "Title": "أولوية الضرب والقسمة",
          "Definition": "تسبق الجمع والطرح في التعبير بلا أقواس.",
          "Rule": "٨+٥×٢=٨+١٠=١٨.",
          "Example": "١٥−٤×٢=٧."
        },
        {
          "Title": "التعبير",
          "Definition": "أعداد ومتغيرات وعمليات دون علامة مساواة ضرورية.",
          "Rule": "أحسبه حسب ترتيب العمليات.",
          "Example": "٣×٨+٥×٥."
        }
      ],
      "WorkedExamples": [
        {
          "Title": "تذاكر السينما",
          "Question": "ثلاث تذاكر للكبار بسعر ٨ دراهم وخمس للأطفال بسعر ٥ دراهم. ما المجموع؟",
          "Method": "الضرب أولًا ثم الجمع.",
          "Steps": [
            "٣×٨=٢٤.",
            "٥×٥=٢٥.",
            "٢٤+٢٥=٤٩."
          ],
          "Answer": "٤٩ درهمًا",
          "Check": "يمثل عدد التذاكر وثمن كل نوع."
        },
        {
          "Title": "تعبير من عمليتين",
          "Question": "احسب ٨+٥×٢.",
          "Method": "أبدأ بالضرب.",
          "Steps": [
            "٥×٢=١٠.",
            "٨+١٠=١٨.",
            "لا أجمع ٨+٥ أولًا."
          ],
          "Answer": "١٨",
          "Check": "حساب الأولوية."
        },
        {
          "Title": "أقواس تغير القيمة",
          "Question": "احسب (٨+٥)×٢.",
          "Method": "أحسب داخل القوس.",
          "Steps": [
            "٨+٥=١٣.",
            "١٣×٢=٢٦.",
            "تختلف عن ٨+٥×٢."
          ],
          "Answer": "٢٦",
          "Check": "نفذت الأقواس أولًا."
        }
      ],
      "CommonMistakes": [
        {
          "Mistake": "الجمع قبل الضرب دون أقواس.",
          "WhyWrong": "تتغير قيمة التعبير.",
          "Correction": "أنفذ الضرب والقسمة قبل الجمع والطرح."
        },
        {
          "Mistake": "تجاهل الأقواس.",
