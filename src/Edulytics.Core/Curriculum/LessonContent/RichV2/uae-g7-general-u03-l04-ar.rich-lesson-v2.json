          "Rule": "الناتج موجب.",
          "Example": "−٤×−١٥=+٦٠."
        },
        {
          "Title": "إشارتان مختلفتان",
          "Definition": "عامل موجب والآخر سالب.",
          "Rule": "الناتج سالب.",
          "Example": "−١٢×٨=−٩٦."
