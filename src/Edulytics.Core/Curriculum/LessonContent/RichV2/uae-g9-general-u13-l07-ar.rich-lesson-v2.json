      "Title": "تحويلات التطابق",
      "ExplanationParagraphs": [
        "الانسحاب يغير موقع كل نقطة بالمتجه نفسه؛ الانعكاس يقلب الشكل على محور معلوم؛ الدوران يغير اتجاه الشكل حول مركز وزاوية.",
        "كل هذه تحويلات تطابق تحفظ الأطوال والزوايا. التكبير غير الوحدي ليس تحويل تطابق.",
        "عند الإحداثيات تُطبّق قاعدة التحويل على كل رأس، ثم يتحقق من أن المسافات المناظرة متساوية."
      ],
      "KeyConcepts": [
        {
          "Title": "الانسحاب",
          "Definition": "نقل كل نقطة بالمتجه نفسه.",
          "Rule": "(س،ص)↦(س+أ،ص+ب).",
          "Example": "(٢،٣)+(٤،−١)=(٦،٢)."
        },
        {
          "Title": "الانعكاس",
          "Definition": "صورة مرآوية عبر محور.",
          "Rule": "حول السينات (س،−ص)، حول الصادات (−س،ص).",
          "Example": "(٢،٣) حول السينات→(٢،−٣)."
        },
        {
          "Title": "الدوران",
          "Definition": "حركة حول مركز وزاوية معلومة.",
          "Rule": "٩٠° عكس عقارب الساعة حول الأصل (−ص،س)، ١٨٠° (−س،−ص).",
          "Example": "(٢،٣)→(−٣،٢) عند ٩٠° عكس الساعة."
        }
      ],
      "WorkedExamples": [
        {
          "Title": "صورة انسحاب",
          "Question": "انقل النقطة (٢،٣) بأربع وحدات يمينًا ووحدة إلى أسفل.",
          "Method": "أضف متجه الانسحاب.",
          "Steps": [
            "(٢+٤،٣−١).",
            "الصورة (٦،٢)."
          ],
          "Answer": "(٦،٢)",
          "Check": "التغير (+٤،−١)."
        },
        {
          "Title": "انعكاس على محور السينات",
          "Question": "ما صورة النقطة (٢،٣) بعد الانعكاس على محور السينات؟",
          "Method": "غيّر إشارة الصاد.",
          "Steps": [
            "السين تبقى ٢.",
            "الصاد تتحول إلى −٣."
          ],
          "Answer": "(٢،−٣)",
          "Check": "البعد عن المحور متساوٍ."
        },
        {
          "Title": "دوران ٩٠°",
          "Question": "أوجد صورة (٢،٣) بعد دوران ٩٠° عكس اتجاه عقارب الساعة حول الأصل.",
          "Method": "(س،ص)↦(−ص،س).",
          "Steps": [
            "الصاد القديمة ٣ تصبح سين الصورة −٣.",
            "السين القديمة ٢ تصبح صاد الصورة ٢."
          ],
          "Answer": "(−٣،٢)",
          "Check": "المسافة عن الأصل √١٣ في الحالتين."
        }
      ],
      "CommonMistakes": [
        {
          "Mistake": "التكبير بمعامل ٢ تحويل تطابق.",
          "WhyWrong": "يضاعف الأطوال، فلا يحفظ القياسات.",
          "Correction": "تحويلات التطابق تحفظ الأطوال والزوايا."
        },
        {
          "Mistake": "انعكاس حول السينات يغير إشارة السين.",
          "WhyWrong": "التغير يكون في الصاد.",
          "Correction": "استخدم (س،−ص)."
        }
