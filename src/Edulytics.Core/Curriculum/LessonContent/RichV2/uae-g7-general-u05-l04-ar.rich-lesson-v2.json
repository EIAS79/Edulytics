          "Answer": "−٦س+٨",
          "Check": "س=١: −٢(−١)=٢"
        },
        {
          "Title": "توزيع كسر",
          "Question": "بسط ١/٢(٦ع+٨).",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "اضرب ٦ع×١/٢=٣ع.",
            "اضرب ٨×١/٢=٤.",
            "اجمع."
          ],
          "Answer": "٣ع+٤",
          "Check": "ع=٢ يعطي ١٠"
        },
        {
          "Title": "تحقق عددي",
          "Question": "احسب ٣(٤+٧) بطريقتين.",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
