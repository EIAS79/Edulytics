      "Title": "خاصية التوزيع",
      "ExplanationParagraphs": [
        "تربط خاصية التوزيع الضرب بالجمع والطرح: أ(ب+ج)=أب+أج وأ(ب−ج)=أب−أج. إذا كان لدينا ٣ صناديق يحتوي كل منها على ٤ دفاتر و٢ قلم، فإن العدد الكلي ٣(٤+٢)=١٨، وهو نفسه ٣×٤+٣×٢.",
        "للأعداد السالبة يجب توزيع الإشارة على كل حد: −٢(٣س−٤)=−٦س+٨، وليس −٦س−٨. وعندما يكون العامل كسريًا مثل ١/٢(٦س+٨)، نضرب كلا الحدين في نصف فنحصل على ٣س+٤.",
        "تستعمل الخاصية لتكوين تعابير مكافئة أو إعادة التحليل عند الحاجة. يمكن التحقق بالتعويض العشوائي الثابت غير الصفر أو برسم مستطيل مقسم إلى منطقتين، لكن الرسم الأصلي لا يُعتبر دليلًا وحده على كل قيمة سالبة؛ يعتمد التحقق الجبري على القانون."
      ],
      "KeyConcepts": [
        {
          "Title": "التوزيع على الجمع",
          "Definition": "ضرب العامل في كل حد مجموع",
          "Rule": "أ(ب+ج)=أب+أج",
          "Example": "٥(س+٢)=٥س+١٠"
        },
        {
          "Title": "التوزيع على الطرح",
          "Definition": "ضرب العامل في كل حد مع علامته",
          "Rule": "أ(ب−ج)=أب−أج",
          "Example": "٣(س−٤)=٣س−١٢"
        },
        {
          "Title": "توزيع سالب",
          "Definition": "يتغير اتجاه إشارات الحدود حسب الضرب",
          "Rule": "−(أ−ب)=−أ+ب",
          "Example": "−٢(٣س−٤)=−٦س+٨"
        },
        {
          "Title": "المكافأة الجبرية",
          "Definition": "صورتان لهما القيمة ذاتها لكل تعويض",
          "Rule": "أ(ب+ج)≡أب+أج",
          "Example": "س=٢: ٥(س+٢)=٢٠"
        }
      ],
      "WorkedExamples": [
        {
          "Title": "توزيع موجب",
          "Question": "بسط ٥(٣س+٢).",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "اضرب ٥×٣س=١٥س.",
            "اضرب ٥×٢=١٠.",
            "اجمع الحدين."
          ],
          "Answer": "١٥س+١٠",
          "Check": "س=٢ يعطي ٤٠ في الصورتين"
        },
        {
          "Title": "توزيع سالب",
          "Question": "بسط −٢(٣س−٤).",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "−٢×٣س=−٦س.",
            "−٢×−٤=+٨.",
            "الناتج −٦س+٨."
