          "Steps": [
            "٠٫٢ ÷ ١٠٠ = ٠٫٠٠٢.",
            "٠٫٠٠٢ = ٢/١٠٠٠.",
            "بأبسط صورة ١/٥٠٠."
          ],
          "Answer": "٠٫٠٠٢، و١/٥٠٠",
          "Check": "٠٫٠٠٢×١٠٠=٠٫٢%."
