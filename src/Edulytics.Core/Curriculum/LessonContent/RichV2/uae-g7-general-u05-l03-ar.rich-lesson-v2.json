      "Title": "خواص العمليات",
      "ExplanationParagraphs": [
        "خواص العمليات تشرح متى يمكن تبديل ترتيب الأعداد أو إعادة تجميعها دون تغيير الناتج. خاصية الإبدال للجمع أ+ب=ب+أ وللضرب أ×ب=ب×أ، وخاصية التجميع للجمع (أ+ب)+ج=أ+(ب+ج)، ومثلها للضرب.",
        "الصفر عنصر محايد في الجمع: أ+٠=أ، والواحد محايد في الضرب: أ×١=أ. الصفر يمتص حاصل الضرب أ×٠=٠. لا تنطبق خاصيتا الإبدال والتجميع على الطرح أو القسمة عمومًا؛ فـ١٢−٥ يختلف عن ٥−١٢.",
        "تسهل الخواص الحساب الذهني: ٢٥+١٧+٧٥=(٢٥+٧٥)+١٧=١١٧، و٤×٣×٢٥=(٤×٢٥)×٣=٣٠٠. عند تبسيط تعبير رمزي لا نغيّر إشارات الحدود، وإذا وزعنا عاملًا على مجموع نستخدم قاعدة التوزيع التي ستدرس بالتفصيل لاحقًا."
      ],
      "KeyConcepts": [
        {
          "Title": "الإبدال",
          "Definition": "تبديل ترتيب طرفين في الجمع أو الضرب",
          "Rule": "أ+ب=ب+أ، أب=بأ",
          "Example": "٨+٣=٣+٨"
        },
        {
          "Title": "التجميع",
          "Definition": "تغيير الأقواس في جمع/ضرب دون تغيير الترتيب القيمي",
          "Rule": "(أ+ب)+ج=أ+(ب+ج)",
          "Example": "(٥+٧)+٣=٥+(٧+٣)"
        },
        {
          "Title": "العنصر المحايد",
          "Definition": "قيمة لا تغير الطرف الآخر عند العملية",
          "Rule": "أ+٠=أ، أ×١=أ",
          "Example": "١٣×١=١٣"
        },
        {
          "Title": "الضرب في صفر",
          "Definition": "يمحو حاصل الضرب",
          "Rule": "٠×أ=٠",
          "Example": "٠×(س+٥)=٠"
        }
      ],
      "WorkedExamples": [
        {
          "Title": "إبدال وتجميع",
          "Question": "احسب ٢٥+١٧+٧٥ بسهولة.",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "استخدم الإبدال لوضع ٢٥ قرب ٧٥.",
            "اجمع ٢٥+٧٥=١٠٠.",
            "أضف ١٧."
          ],
          "Answer": "١١٧",
          "Check": "الحساب الأصلي يعطي ١١٧"
        },
        {
          "Title": "ضرب تجميعي",
          "Question": "احسب ٤×٣×٢٥.",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "بدّل الترتيب إلى ٤×٢٥×٣.",
            "٤×٢٥=١٠٠.",
            "١٠٠×٣=٣٠٠."
          ],
          "Answer": "٣٠٠",
          "Check": "١٢×٢٥=٣٠٠"
        },
        {
          "Title": "خواص محايدة",
          "Question": "بسط (٣س+٠)×١.",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "الصفر لا يغير جمع ٣س.",
            "الواحد لا يغير ضرب ٣س.",
            "تبقى ٣س."
          ],
          "Answer": "٣س",
          "Check": "إذا س=٢ فإن الناتج ٦"
        },
        {
          "Title": "كشف خطأ",
          "Question": "هل ١٢−٥=٥−١٢؟",
          "Method": "تطبيق القاعدة مع تحقق مستقل",
          "Steps": [
            "احسب ١٢−٥=٧.",
            "احسب ٥−١٢=−٧.",
            "الطرح غير إبدالي."
          ],
          "Answer": "لا",
