      "LessonCode": "PED:UAE-MOE-MATH:L4:COMMON:07:05",
      "CultureCode": "ar",
      "Title": "قواعد الجمع والطرح",
      "ExplanationParagraphs": [
        "جدول المدخل والمخرج يمثل تطبيق قاعدة محددة على كل قيمة داخلة.",
        "أبحث عن عدد ثابت يُضاف إلى كل مدخل أو يُطرح منه، ثم أكتب معادلة مناسبة.",
        "أستخدم القاعدة لحساب مخرجات جديدة وأتحقق من القيم المعطاة."
      ],
      "KeyConcepts": [
        {
          "Title": "المدخل والمخرج",
          "Definition": "المدخل هو القيمة الأصلية والمخرج ناتج تطبيق قاعدة.",
          "Rule": "y = x + ثابت أو y = x − ثابت.",
          "Example": "٢→٩ عندما القاعدة +٧."
        },
        {
          "Title": "قاعدة الجمع",
          "Definition": "زيادة كل مدخل بمقدار ثابت.",
          "Rule": "المخرج − المدخل = الثابت.",
          "Example": "٦+٧=١٣."
        },
        {
          "Title": "قاعدة الطرح",
          "Definition": "إنقاص كل مدخل بمقدار ثابت.",
          "Rule": "المدخل − المخرج = الثابت.",
          "Example": "١٨−٣=١٥."
        }
      ],
      "WorkedExamples": [
        {
          "Title": "جدول الأستاذ",
          "Question": "المدخلات ٢ و٤ و٦ والمخرجات ٩ و١١ و١٣. ما القاعدة؟",
          "Method": "أحسب الفرق.",
          "Steps": [
            "٩−٢=٧.",
            "١١−٤=٧ و١٣−٦=٧.",
            "المعادلة y=x+٧."
          ],
          "Answer": "قاعدة إضافة ٧",
          "Check": "٦+٧=١٣."
        },
        {
          "Title": "خصم مطعم",
          "Question": "خصم مطعم ٣ دراهم من كل طلب. ما أسعار ١٢ و١٤ و١٦ بعد الخصم؟",
          "Method": "قاعدة الطرح.",
          "Steps": [
            "أكتب d=c−٣.",
            "١٢−٣=٩، ١٤−٣=١١.",
            "١٦−٣=١٣."
          ],
          "Answer": "٩،١١،١٣ درهمًا",
          "Check": "كل مخرج أقل من مدخله بثلاثة."
        },
        {
          "Title": "جدول +٧",
          "Question": "استخدم f=d+٧ للمدخلات ٢١ و٢٤ و٢٧.",
          "Method": "التعويض.",
          "Steps": [
            "٢١+٧=٢٨.",
            "٢٤+٧=٣١.",
            "٢٧+٧=٣٤."
          ],
          "Answer": "٢٨،٣١،٣٤",
          "Check": "جميع الفروق ٧."
        }
      ],
      "CommonMistakes": [
        {
          "Mistake": "عكس اتجاه المدخل والمخرج.",
          "WhyWrong": "يغيّر العملية المطلوبة.",
          "Correction": "أبدأ بالمدخل وأطبق عليه القاعدة."
        },
        {
          "Mistake": "افتراض قاعدة مختلفة لكل صف.",
          "WhyWrong": "النمط يتطلب قاعدة واحدة.",
          "Correction": "أتحقق من جميع الصفوف."
        }
      ],
      "SummaryPoints": [
        "أقرأ قيم المدخل والمخرج.",
        "أحدد ثابت الجمع أو الطرح.",
        "أكتب معادلة وأملأ الجدول."
      ],
      "Visuals": [
