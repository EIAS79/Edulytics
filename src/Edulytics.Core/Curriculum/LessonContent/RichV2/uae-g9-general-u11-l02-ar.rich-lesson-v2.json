      "Title": "البرهان الجبري",
      "ExplanationParagraphs": [
        "البرهان الجبري يثبت أن كل معادلة تالية مكافئة للسابقة بذكر خاصية مساواة أو تعريف.",
        "الجمع والطرح والضرب والقسمة غير الصفرية على طرفي معادلة يحافظ على المساواة، وكذلك التوزيع والتعويض.",
        "في برهان العمودين تكتب العبارات في عمود، وتكتب الأسباب الموافقة لكل عبارة في العمود الثاني؛ يمكن استعمال هذا النمط في قياسات الزوايا والقطع."
      ],
      "KeyConcepts": [
        {
          "Title": "خواص المساواة",
          "Definition": "قواعد التحويلات المكافئة.",
          "Rule": "أ=ب ⇒ أ+ج=ب+ج، وأ−ج=ب−ج؛ القسمة على ج تتطلب ج≠٠.",
          "Example": "−٥س=٩٠ ⇒ س=−١٨ بقسمة الطرفين على −٥."
        },
        {
          "Title": "انعكاس وتناظر وتعدي",
          "Definition": "خواص ربط قيم مساوية.",
          "Rule": "أ=أ؛ أ=ب⇒ب=أ؛ أ=ب وب=ج⇒أ=ج.",
          "Example": "إذا أب=بج وبج=جد فإن أب=جد."
        },
        {
          "Title": "برهان ذو عمودين",
          "Definition": "سلسلة عبارات لكل منها مبرر.",
          "Rule": "سمّ التوزيع والتعويض والطرح/الجمع والضرب/القسمة بدقة.",
          "Example": "٣س+٧=٢س+١٩ ⇒ س=١٢."
        }
      ],
      "WorkedExamples": [
        {
          "Title": "برهان معادلة متعددة الخطوات",
          "Question": "حل −٥(س+٤)=٧٠ مع مبرر كل خطوة.",
          "Method": "توزيع ثم جمع ثم قسمة.",
          "Steps": [
            "−٥س−٢٠=٧٠ (التوزيع).",
            "−٥س=٩٠ (جمع ٢٠ للطرفين).",
            "س=−١٨ (قسمة الطرفين على −٥).",
            "التحقق: −٥(−١٨+٤)=٧٠."
          ],
          "Answer": "س=−١٨",
          "Check": "الناتج صحيح بالتعويض."
        },
        {
          "Title": "خواص التعدي",
          "Question": "إذا أ=ب وب=ج، ماذا نستنتج؟",
