          "Steps": [
            "أ=ب معطى.",
            "ب=ج معطى.",
            "أ=ج بخاصية التعدي."
          ],
          "Answer": "أ=ج",
          "Check": "العلاقة تستخدم حدًا وسيطًا ب."
        },
        {
          "Title": "مساواة بمتغير في الطرفين",
          "Question": "حل ٣س+٧=٢س+١٩ واذكر المبرر.",
          "Method": "طرح مقدار متساوٍ من الطرفين.",
          "Steps": [
            "س+٧=١٩ بطرح ٢س.",
            "س=١٢ بطرح ٧.",
            "التحقق ٣×١٢+٧=٢×١٢+١٩=٤٣."
