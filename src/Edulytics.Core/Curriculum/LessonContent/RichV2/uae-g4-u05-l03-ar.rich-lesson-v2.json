      "Title": "نشاط عملي: استخدام خاصية التوزيع في الضرب",
      "ExplanationParagraphs": [
        "نموذج المساحة يبين تقسيم أحد العاملين إلى عشرات وآحاد.",
        "مساحة كل جزء تمثل ناتج ضرب العامل الآخر في قسم من العدد.",
        "نجمع الناتجين الجزئيين للحصول على المساحة الكلية أو حاصل الضرب."
      ],
      "KeyConcepts": [
        {
          "Title": "خاصية التوزيع",
          "Definition": "ضرب العدد في مجموع عددين يساوي جمع ناتجي ضربه بكل عدد.",
          "Rule": "أ×(ب+ج)=أب+أج.",
          "Example": "١٢×(١٠+٥)=١٢٠+٦٠."
        },
        {
          "Title": "نموذج المساحة",
          "Definition": "مستطيل مقسم إلى منطقتين تمثلان ناتجي الضرب الجزئيين.",
          "Rule": "المساحة الكلية = مجموع المساحتين.",
          "Example": "٣٦×٢٤=٧٢٠+١٤٤."
        },
        {
          "Title": "النواتج الجزئية",
          "Definition": "نتيجة ضرب كل قسم من العامل بعد التفكيك.",
          "Rule": "أجمع نواتج العشرات والآحاد.",
          "Example": "٢٦×٢٥=٥٢٠+١٣٠=٦٥٠."
        }
      ],
      "WorkedExamples": [
        {
          "Title": "نموذج ١٢ في ١٥",
