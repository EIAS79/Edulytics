      "LessonCode": "PED:UAE-MOE-MATH:L8:GENERAL:01:02:POWERS-AND-EXPONENTS",
      "CultureCode": "ar",
      "Title": "القوى والأسس",
      "ExplanationParagraphs": [
        "الأساس هو العامل الذي يتكرر ضربه، والأس الموجب هو عدد مرات ذلك التكرار. لا تعني القوة ضرب الأساس في الأس؛ مثل 4^3=64 وليس 12.",
        "أقواس العدد السالب جزء من المسألة: (-2)^4 موجب، أما -2^4 فسالب. والقوة الزوجية للعدد السالب موجب، والفردية سالب.",
        "أحسب القوى للكسور والأعداد العشرية كما للأعداد الصحيحة. في (3/4)^2 أرفع البسط والمقام فيكون 9/16، وأراعي ترتيب العمليات."
      ],
      "KeyConcepts": [
        {
          "Title": "الأساس والأس",
          "Definition": "العامل المتكرر وعدد تكراره.",
          "Rule": "أ^ن يعني ن عوامل من أ عندما ن موجب صحيح.",
          "Example": "3^4=3×3×3×3=81"
        },
        {
          "Title": "القوة وقوس السالب",
          "Definition": "الإشارة داخل القوس جزء من الأساس.",
          "Rule": "(-2)^4=16 بينما -2^4=-16.",
          "Example": "(-3)^3=-27"
        },
        {
          "Title": "قوة كسر",
          "Definition": "رفع البسط والمقام للأس نفسه.",
          "Rule": "(أ/ب)^ن=أ^ن/ب^ن إذا ب≠0 ون صحيح موجب.",
          "Example": "(2/5)^3=8/125"
        }
      ],
      "WorkedExamples": [
        {
          "Title": "كتابة ضرب متكرر",
          "Question": "اكتب 7×7×7×7 بصورة قوة.",
          "Method": "الأساس وعدد العوامل",
          "Steps": [
            "الأساس 7.",
            "عدد عوامل 7 يساوي 4.",
            "7^4=2401."
          ],
          "Answer": "7^4=2401",
          "Check": "7×7×7×7=2401."
        },
        {
          "Title": "قوى السالب",
          "Question": "قارن (-3)^2 و-3^2.",
          "Method": "الأقواس وترتيب العمليات",
          "Steps": [
            "(-3)^2=(-3)×(-3)=9.",
            "-3^2=-(3×3)=-9.",
            "سبب الفرق هو موضع السالب."
          ],
          "Answer": "9 و-9",
          "Check": "الأس الزوجي داخل القوس موجب."
        },
        {
          "Title": "قوى الكسور",
          "Question": "احسب (2/5)^3.",
          "Method": "رفع البسط والمقام",
          "Steps": [
            "2×2×2=8.",
            "5×5×5=125.",
            "8/125 في أبسط صورة."
          ],
          "Answer": "8/125",
          "Check": "مقام الكسر لا يساوي صفرًا."
        }
      ],
      "CommonMistakes": [
        {
          "Mistake": "حساب 4^3 على أنه 4×3.",
          "WhyWrong": "الأس عدد عوامل الضرب لا مضروب الأساس.",
          "Correction": "4×4×4=64."
        },
        {
          "Mistake": "اعتبار (-2)^4 مساويًا -2^4.",
          "WhyWrong": "الأقواس تحدد هل السالب داخل القوة.",
          "Correction": "16 مقابل -16."
        },
        {
          "Mistake": "اعتبار (2/3)^2 مساويًا 4/3.",
          "WhyWrong": "المقام أيضًا مرفوع للأس.",
          "Correction": "4/9."
        }
      ],
      "SummaryPoints": [
        "أكتب الضرب المتكرر قوة وأميز الأساس عن الأس.",
        "أقيم قوى صحيحة وكسور وأعدادًا عشرية مع الأقواس الصحيحة.",
        "أعوض في تعبير جبري وأراعي ترتيب القوى.",
        "Cool-down أصلي: 6^3، (-4)^2 مقابل -4^2، (2/3)^3؛ التفسير المكتوب يراجعه المعلم."
      ],
