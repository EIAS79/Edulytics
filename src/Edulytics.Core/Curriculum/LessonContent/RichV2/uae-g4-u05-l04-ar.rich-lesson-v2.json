      "Title": "الضرب في عدد مكون من رقمين",
      "ExplanationParagraphs": [
        "أضرب عاملًا من رقمين في عامل من رقمين باستخدام ناتجين جزئيين.",
        "أبدأ بضرب آحاد العامل الثاني في الأول، ثم أضرب عشرات العامل الثاني في الأول.",
        "أجمع النواتج الجزئية مع مراعاة المنازل وأتحقق بنموذج المساحة."
      ],
      "KeyConcepts": [
        {
          "Title": "الضرب الرأسي",
          "Definition": "طريقة مرتبة لمضاعفة عوامل من رقمين.",
          "Rule": "أضرب آحاد العامل الثاني ثم عشراته.",
          "Example": "٥٦ × ٢٩."
        },
        {
          "Title": "الناتج الجزئي للعشرات",
          "Definition": "ضرب العامل الأول في قيمة العشرات من العامل الثاني.",
          "Rule": "الضرب في ٢٠ وليس في ٢.",
          "Example": "٥٦×٢٠=١١٢٠."
        },
        {
          "Title": "الجمع النهائي",
          "Definition": "جمع النواتج الجزئية للوصول إلى حاصل الضرب.",
          "Rule": "ناتج الآحاد + ناتج العشرات.",
          "Example": "٥٠٤+١١٢٠=١٦٢٤."
        }
      ],
      "WorkedExamples": [
        {
          "Title": "ضرب ٥٦ في ٢٩",
          "Question": "احسب ٥٦×٢٩ بالطريقة الرأسية.",
          "Method": "ناتجان جزئيان.",
          "Steps": [
            "٥٦×٩=٥٠٤.",
            "٥٦×٢٠=١١٢٠.",
            "٥٠٤+١١٢٠=١٦٢٤."
          ],
          "Answer": "١٦٢٤",
          "Check": "قريب من ٦٠×٣٠=١٨٠٠."
        },
        {
          "Title": "سعر الأغراض",
          "Question": "ما ناتج ٣٥×٢٤؟",
          "Method": "ضرب آحاد وعشرات العامل الثاني.",
          "Steps": [
            "٣٥×٤=١٤٠.",
            "٣٥×٢٠=٧٠٠.",
            "١٤٠+٧٠٠=٨٤٠."
          ],
          "Answer": "٨٤٠",
          "Check": "٣٥×(٢٠+٤)=٨٤٠."
        },
        {
          "Title": "ضرب ٤٢ في ٣٨",
          "Question": "احسب ٤٢×٣٨.",
          "Method": "توزيع العشرات والآحاد.",
          "Steps": [
            "٤٢×٨=٣٣٦.",
            "٤٢×٣٠=١٢٦٠.",
            "٣٣٦+١٢٦٠=١٥٩٦."
          ],
          "Answer": "١٥٩٦",
          "Check": "٤٢×(٣٠+٨)=١٥٩٦."
        }
      ],
      "CommonMistakes": [
        {
          "Mistake": "عدم محاذاة الناتج الجزئي للعشرات.",
          "WhyWrong": "ينقص حاصل الضرب بعامل عشرة.",
          "Correction": "أكتب ناتج العشرات في منزلة العشرات."
        },
        {
          "Mistake": "جمع العاملين بدل الناتجين الجزئيين.",
          "WhyWrong": "ينتج جمعًا لا ضربًا.",
          "Correction": "أحسب كل ناتج جزئي ثم أجمعهما."
        }
      ],
      "SummaryPoints": [
