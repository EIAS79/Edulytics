        },
        {
          "Title": "معكوس الجمع",
          "Definition": "طرح الكمية نفسها من الطرفين",
          "Rule": "إذا س+ب=ج فإن س=ج−ب",
          "Example": "س+٧=١٩ ⇒ س=١٢"
