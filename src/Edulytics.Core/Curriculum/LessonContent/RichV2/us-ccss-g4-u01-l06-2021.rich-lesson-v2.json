    {
      "LessonCode": "PED:US-CCSS-MATH:G4:U01:L06",
      "CultureCode": "en",
      "Title": "The Locker Problem",
      "ExplanationParagraphs": [
        "Original 2021 Grade4 Unit1 Lesson6 has twenty students and twenty lockers. Grade4 factors and multiples goal; original four-page student PDF and teacher tasks read from local source.",
        "Warm-up 10min: count by2 0..30 and by4 0..60, investigate common multiples orally.",
        "Activity1 10min: in groups, make a model of 20 numbered lockers and 20 students with coins, cards or counters. Initially closed; student1 opens every locker; student k toggles every kth locker. Teacher evaluates diagrams, relationships and open/closed representation.",
        "Activity2 25min: student3 touches 3,6,9,12,15,18; student5 touches 5,10,15,20; 17 has factors1,17; exactly2 touches for primes2,3,5,7,11,13,17,19; exactly3 touches for squares4,9,16; most touches for locker12 with6. Explain all original tasks.",
        "Optional source extension: after all twenty toggles, only locker numbers1,4,9,16 remain OPEN (odd divisor count); not mandatory for all learners.",
        "Edulytics first-party 5min Cool-down, not publisher original: Which students touch locker16? It has1,2,4,8,16 (5 touches), so it stays open. Teacher reviews full mathematical reasoning."
      ],
      "KeyConcepts": [
        {
          "Title": "Students touching lockers",
          "Definition": "A student touches each locker labeled a multiple of their number.",
          "Rule": "Student k touches locker n iff n%k=0.",
          "Example": "Student3 touches3,6,9,12,15,18."
        },
        {
          "Title": "Number of touches",
          "Definition": "Count the distinct positive factors of a locker label.",
          "Rule": "One student per factor.",
          "Example": "Locker17 has 2 touches; locker16 has 5."
        },
        {
          "Title": "Final open state",
          "Definition": "Toggle starts from closed.",
          "Rule": "Odd touch count leaves locker open.",
          "Example": "1,4,9,16 are open."
        }
      ],
      "WorkedExamples": [
        {
          "Title": "Student5",
          "Question": "Which lockers does student5 touch?",
          "Method": "List multiples of5.",
          "Steps": [
            "Start5.",
            "Add5 until20.",
            "Collect5,10,15,20."
          ],
          "Answer": "5,10,15,20",
          "Check": "All divisible by5."
        },
        {
          "Title": "Locker16",
          "Question": "How many times touched and final state?",
          "Method": "Find distinct factors.",
          "Steps": [
            "Divisors:1,2,4,8,16.",
            "Five students touch it.",
            "Odd toggles leave open."
          ],
          "Answer": "5 touches, OPEN.",
          "Check": "16 is perfect square."
        }
      ],
      "CommonMistakes": [
        {
          "Mistake": "Counting factor PAIRS as students.",
          "WhyWrong": "Each factor represents a student.",
          "Correction": "List all positive divisors."
        },
        {
          "Mistake": "Assuming prime lockers are open.",
          "WhyWrong": "Primes have exactly two touches.",
          "Correction": "Even toggles lead to closed."
        }
      ],
      "SummaryPoints": [
        "Source original PDF p2 class representation and p3–4 six tasks plus optional final-state extension included.",
        "Warm-up two/four choral count included.",
        "Original photo not copied; teacher leads model and explanation.",
        "Numeric divisibility and touch counts can use exact grading, but free explanations remain teacher reviewed.",
        "Independent Edulytics Cool-down not identical to original gated publisher prompt."
      ],
