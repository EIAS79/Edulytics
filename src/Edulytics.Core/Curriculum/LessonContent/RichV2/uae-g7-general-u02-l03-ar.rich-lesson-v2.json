          "Answer": "٧٠",
          "Check": "٧٠/٢٥٠=٠٫٢٨."
        },
        {
          "Title": "إيجاد الكل",
          "Question": "إذا كانت ٤٢ درهمًا تمثل ٣٥٪ من الثمن الأصلي، فما الثمن؟",
          "Method": "حل تناسب عكسي",
          "Steps": [
            "٤٢/ك=٣٥/١٠٠.",
            "٣٥ك=٤٢٠٠.",
            "ك=١٢٠ درهمًا."
          ],
          "Answer": "١٢٠ درهمًا",
          "Check": "٠٫٣٥×١٢٠=٤٢."
        }
      ],
      "CommonMistakes": [
