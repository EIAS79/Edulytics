        {
          "Title": "الجمع والطرح",
          "Definition": "الاتجاه لا يتغير عند إضافة أو طرح نفس العدد",
          "Rule": "إذا أ<ب فإن أ+ج<ب+ج",
          "Example": "س+٤≤١٢ ⇒ س≤٨"
