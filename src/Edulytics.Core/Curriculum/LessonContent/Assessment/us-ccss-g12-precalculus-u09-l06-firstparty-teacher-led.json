      "IndependentMathValidated": true,
      "PublisherQuestionCopied": false
    },
    {
      "OriginalExercise": 3,
      "IndependentStudentMathQuestion": "Are row-operation sequences unique?",
      "TeacherMathAnswer": "No; elementary row-equivalent paths can differ.",
